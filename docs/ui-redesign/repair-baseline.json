    {
      "id": "SOG-UI-001",
      "severity": "blocker",
      "status": "confirmed",
      "title": "Public output contains multiple data generations",
      "evidence": "Canonical repository, public HTML, and public machine-readable files report 92, 82, and 70 stable assets respectively.",
      "target_prs": [2, 3]
