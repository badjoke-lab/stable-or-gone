    {
      "id": "SOG-UI-002",
      "severity": "high",
      "status": "confirmed",
      "title": "Legacy status and canonical lifecycle labels diverge",
      "evidence": "Lists expose legacy labels such as Failed and Discontinued while detail and statistics use Collapsed, Terminated, Restricted, and Winding down.",
      "target_prs": [5, 6]
    },
    {
      "id": "SOG-UI-003",
      "severity": "high",
      "status": "confirmed",
      "title": "Model filters are generated from arbitrary descriptive values",
      "evidence": "The stablecoin index enumerates every unique collateral_model string, including long protocol-specific descriptions.",
      "target_prs": [5, 8, 24]
    },
    {
      "id": "SOG-UI-004",
      "severity": "high",
      "status": "confirmed",
