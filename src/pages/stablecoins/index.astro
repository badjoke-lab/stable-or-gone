---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StablecoinIndexRow from '../../components/StablecoinIndexRow.astro';
import StablecoinIndexCard from '../../components/StablecoinIndexCard.astro';
import StablecoinComparisonSource from '../../components/StablecoinComparisonSource.astro';
import '../../styles/stablecoin-index.css';
import '../../styles/ui-remediation-r3.css';
import { formatPublicLabel } from '../../utils/displayLabels';
import { formatIssuanceLabel, formatLifecycleLabel } from '../../utils/publicTaxonomy';
import { getReferenceFilterOptions, resolveReferenceTarget } from '../../utils/referenceTarget';
import { getPublicBackingModelFilterOptions, resolveBackingModel } from '../../utils/backingModel';
import { resolvePrimaryRelationshipForStablecoin } from '../../utils/primaryDisplayRelationship';
import { getDeployments, getEvents, getKnownUnknowns, getOrganizations, getRelationships, getStablecoins } from '../../lib/data/registry';
import { getCanonicalEvidenceRelations } from '../../lib/data/evidenceSources';

const PAGE_SIZE = 20;
const stablecoins = getStablecoins();
const organizations = getOrganizations();
const relationships = getRelationships();
const events = getEvents();
const knownUnknowns = getKnownUnknowns();
const deployments = getDeployments();
const evidenceRelations = getCanonicalEvidenceRelations();
const organizationById = new Map(organizations.map((organization) => [organization.id, organization] as const));
const unique = <T,>(values: T[]) => [...new Set(values)];
const label = (value?: string | null, fallback = 'Not recorded') => value ? formatPublicLabel(value) : fallback;
const recordDomain = (coin: unknown) => {
  const candidate = coin as { official_domain?: string; official_url?: string };
  if (candidate.official_domain) return candidate.official_domain;
  if (!candidate.official_url) return '';
  try { return new URL(candidate.official_url).hostname; } catch { return ''; }
};

const records = stablecoins.map((coin) => {
  const coinRelationships = relationships.filter((relationship) => relationship.stablecoin_id === coin.id);
  const primaryRelationship = resolvePrimaryRelationshipForStablecoin(coin.id, relationships).relationship;
  const primaryOrganization = primaryRelationship ? organizationById.get(primaryRelationship.organization_id) : undefined;
  const connectedOrganizations = unique(coinRelationships.map((relationship) => organizationById.get(relationship.organization_id)).filter(Boolean));
  const organizationNames = connectedOrganizations.map((organization) => organization!.name);
  const organizationRoles = unique(coinRelationships.map((relationship) => relationship.role));
  const reference = resolveReferenceTarget(coin);
  const backing = resolveBackingModel(coin);
  const assetClass = coin.asset_class ?? 'unknown';
  const stabilization = backing.stabilization_mechanism || 'not_recorded';
  const linkedRelations = evidenceRelations.filter((relation) => relation.stablecoin_ids.includes(coin.id));
  const sourceIdentityCount = new Set(linkedRelations.map((relation) => relation.evidence_id)).size;
  const linkedEvents = events.filter((event) => event.stablecoin_id === coin.id || (event.subject_stablecoin_ids ?? []).includes(coin.id));
  const linkedUnknowns = knownUnknowns.filter((item) => item.stablecoin_id === coin.id);
  const linkedDeployments = deployments.filter((deployment) => deployment.stablecoin_id === coin.id);
  const officialDomain = recordDomain(coin);
  const search = [coin.name, coin.symbol, coin.slug, ...(coin.aliases ?? []), officialDomain, ...organizationNames]
    .filter(Boolean).join(' ').normalize('NFKC').toLocaleLowerCase().trim().replace(/\s+/g, ' ');
  const organizationSummary = organizationNames.length
    ? `${organizationNames.join(', ')} · ${coinRelationships.length} relationship${coinRelationships.length === 1 ? '' : 's'} across ${organizationRoles.map((role) => formatPublicLabel(role)).join(', ')}`
    : 'No organization relationship recorded';
  return {
    id: coin.id,
    slug: coin.slug,
    name: coin.name,
    symbol: coin.symbol ?? '',
    search,
    lifecycle: coin.lifecycle_status ?? 'unknown',
    issuance: coin.issuance_status ?? 'unknown',
    assetClass,
    assetClassLabel: label(assetClass),
    referenceCategory: reference.comparison_category,
    referenceLabel: reference.public_label,
    backingCategory: backing.public_category,
    backingLabel: backing.public_label,
    stabilization,
    stabilizationLabel: label(stabilization),
    launchDate: coin.launch_date ?? '',
    reviewedAt: coin.last_verified_at ?? '',
    primaryOrganizationName: primaryOrganization?.name ?? 'No primary organization recorded',
    primaryOrganizationSlug: primaryOrganization?.slug ?? '',
    primaryRoleLabel: label(primaryRelationship?.role),
    relationshipCount: coinRelationships.length,
    organizationCount: connectedOrganizations.length,
    organizationSummary,
    reserveSummary: label(coin.reserve_disclosure_status),
    redemptionSummary: label(coin.redemption_status),
    deploymentCount: linkedDeployments.length,
    eventCount: linkedEvents.length,
    sourceIdentityCount,
    evidenceRelationCount: linkedRelations.length,
    knownUnknownCount: linkedUnknowns.length
  };
}).sort((left, right) => left.name.localeCompare(right.name));

const option = (value: string, publicLabel = label(value)) => ({ value, publicLabel });
const lifecycleOptions = unique(records.map((record) => record.lifecycle)).sort().map((value) => option(value, formatLifecycleLabel(value)));
const issuanceOptions = unique(records.map((record) => record.issuance)).sort().map((value) => option(value, formatIssuanceLabel(value)));
const assetClassOptions = unique(records.map((record) => record.assetClass)).sort().map((value) => option(value));
const referenceOptions = getReferenceFilterOptions().map((item) => option(item.value, item.public_label));
const backingOptions = getPublicBackingModelFilterOptions().map((item) => option(item.value, item.public_label));
const stabilizationOptions = unique(records.map((record) => record.stabilization)).sort().map((value) => option(value));
const filters = [
  { id: 'lifecycle', label: 'Lifecycle', copy: 'Current recorded operating state', options: lifecycleOptions },
  { id: 'issuance', label: 'Issuance', copy: 'Whether new units can be issued', options: issuanceOptions },
  { id: 'asset_class', label: 'Asset class', copy: 'Registry classification of the asset', options: assetClassOptions },
  { id: 'reference', label: 'Reference', copy: 'Target or comparison reference', options: referenceOptions },
  { id: 'backing', label: 'Backing', copy: 'Public backing-model category', options: backingOptions },
  { id: 'stabilization', label: 'Stabilization', copy: 'Mechanism used to pursue the reference', options: stabilizationOptions }
];
const title = 'Stablecoin Register — Stable or Gone';
const description = 'Search and filter canonical stablecoin records by lifecycle, issuance, reference target, model, organization, evidence, and review context.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Stablecoin Register', url: 'https://sog.badjoke-lab.com/stablecoins/', description, isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' } };
---
<BaseLayout title={title} description={description} canonicalPath="/stablecoins/" jsonLd={jsonLd}>
  <div class="stablecoin-index-page stablecoin-index-page-r3" data-stablecoin-index data-page-size={PAGE_SIZE} data-register-version="r3">
    <header class="stablecoin-register-header">
      <div>
        <p class="stablecoin-index-eyebrow">Canonical register · {records.length} records</p>
        <h1>Stablecoin register</h1>
        <p>Search current lifecycle, reference target, issuer, backing model, and source coverage. Unknown values remain explicit.</p>
        <nav class="stablecoin-register-links" aria-label="Related registry tools">
          <a href="/compare/">Compare</a><a href="/timeline/">Timeline</a><a href="/access-regulation/">Access</a><a href="/methodology/">Methodology</a>
        </nav>
      </div>
    </header>

    <section class="stablecoin-index-registry" aria-labelledby="stablecoin-index-heading">
      <h2 class="visually-hidden" id="stablecoin-index-heading">Search and filter stablecoin records</h2>
      <section class="stablecoin-index-controls" aria-label="Register controls">
        <div class="stablecoin-index-toolbar">
          <label class="stablecoin-index-search"><span>Search</span><input class="ui-field" data-index-search type="search" name="q" placeholder="Name, symbol, organization" autocomplete="off" /></label>
          <label><span>Sort</span><select class="ui-field" data-index-sort name="sort"><option value="name_asc">Name A–Z</option><option value="name_desc">Name Z–A</option><option value="lifecycle_then_name">Lifecycle, then name</option><option value="launch_oldest">Launch: oldest first</option><option value="launch_newest">Launch: newest first</option><option value="evidence_most">Most source identities</option></select></label>
          <button class="ui-button stablecoin-index-action" type="button" data-clear-all>Clear</button>
        </div>

        <details class="stablecoin-filter-panel">
          <summary><span>Filters</span><small>Lifecycle, issuance, asset class, reference, backing, and stabilization</small></summary>
          <div class="stablecoin-index-filter-grid" aria-label="Stablecoin filter groups">
            {filters.map((filter) => (
              <details class="stablecoin-index-filter">
                <summary data-summary-label="All"><span><strong>{filter.label}</strong><small>{filter.copy}</small></span><span aria-hidden="true" data-filter-count={filter.id} data-option-total={filter.options.length}>{filter.options.length}</span></summary>
                <div class="stablecoin-index-filter-options">
                  {filter.options.map((item) => <label><input type="checkbox" data-filter-group={filter.id} data-label={item.publicLabel} value={item.value} /><span>{item.publicLabel}</span></label>)}
                </div>
              </details>
            ))}
          </div>
        </details>
      </section>

      <div class="stablecoin-index-summary" data-register-summary>
        <div><span class="stablecoin-index-summary-label">Active filters</span><div class="stablecoin-index-active-filters" data-active-filters aria-label="Active filters"></div></div>
        <div class="stablecoin-index-result-count" aria-live="polite"><strong><span data-visible-range>1–{Math.min(PAGE_SIZE, records.length)}</span></strong> of <strong><span data-result-count>{records.length}</span></strong></div>
      </div>

      <section class="stablecoin-index-comparison" data-comparison-panel hidden aria-labelledby="comparison-heading">
        <div class="comparison-heading"><div><p class="stablecoin-index-eyebrow">Selected records</p><h2 id="comparison-heading">Comparison workspace</h2><p data-comparison-status aria-live="polite">Select two to four records.</p></div><button class="ui-button stablecoin-index-action" type="button" data-clear-comparison>Clear comparison</button></div>
        <div class="comparison-alert" data-comparison-alert aria-live="assertive"></div>
        <div class="comparison-grid" data-comparison-grid></div>
        <p class="comparison-disclaimer">Historical registry context, not a ranking or recommendation.</p>
      </section>

      <div class="stablecoin-index-results-heading"><div><h2>Register results</h2><p>Open a record for reserves, redemption, events, deployments, and full evidence.</p></div><span>{PAGE_SIZE} per page</span></div>

      <div class="stablecoin-index-table">
        <table data-table-kind="stablecoin-index" data-mobile-table="scroll-preserve">
          <caption class="visually-hidden">Stablecoin register results.</caption>
          <thead><tr><th>Asset</th><th>Lifecycle</th><th>Reference</th><th>Issuer</th><th>Model</th><th>Updated / evidence</th></tr></thead>
          <tbody data-registry-body>{records.map((record, index) => <StablecoinIndexRow record={record} initiallyVisible={index < PAGE_SIZE} />)}</tbody>
        </table>
      </div>

      <div class="stablecoin-index-cards" data-card-body aria-label="Stablecoin compact records">{records.map((record, index) => <StablecoinIndexCard record={record} initiallyVisible={index < PAGE_SIZE} />)}</div>
      <div class="stablecoin-index-no-results" data-no-results hidden><strong>No records match.</strong><span>Clear the current search and filters.</span><button class="ui-button stablecoin-index-action" type="button" data-clear-all>Clear all filters</button></div>

      <nav class="stablecoin-index-pagination" data-pagination aria-label="Stablecoin register pages">
        <button class="ui-button" type="button" data-page-prev>Previous</button><span data-page-status aria-live="polite">Page 1 of {Math.max(1, Math.ceil(records.length / PAGE_SIZE))}</span><button class="ui-button" type="button" data-page-next>Next</button>
      </nav>
    </section>

    <div hidden>{records.map((record) => <StablecoinComparisonSource record={record} />)}</div>
  </div>
  <script>import '../../scripts/stablecoin-index';</script>
</BaseLayout>
