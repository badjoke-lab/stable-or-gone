---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Methodology — Stable or Gone';
const description = 'How Stable or Gone assigns status labels, records depegs and other events, selects sources, and handles incomplete information.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  url: 'https://sog.badjoke-lab.com/methodology/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  about: ['stablecoin methodology', 'stablecoin status labels', 'depeg handling', 'reserve disclosure']
};
---
<BaseLayout title={title} description={description} canonicalPath="/methodology/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">How records are built</div>
      <h1>Methodology</h1>
      <p>This page explains how status labels are assigned, which events are recorded, how sources are chosen, and how unresolved questions are shown.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Main unit</span><strong>Record</strong></div>
      <div class="stat"><span>Review basis</span><strong>Sources</strong></div>
    </div>
  </section>

  <section class="section-grid">
    <a class="panel mini-card" href="/guides/status-vs-event/"><h2>Status labels</h2><p>See how a stablecoin’s current state is kept separate from past incidents.</p></a>
    <a class="panel mini-card" href="/guides/what-is-a-depeg/"><h2>Event selection</h2><p>Learn which depegs and other changes are significant enough to record.</p></a>
    <a class="panel mini-card" href="/guides/reserve-disclosure-basics/"><h2>Source types</h2><p>Compare issuer statements, reports, regulatory documents, and protocol data.</p></a>
  </section>

  <section class="panel registry">
    <div class="bar">Core approach</div>
    <table><tbody>
      <tr><th>Separate records and events</th><td>A stablecoin record describes the asset. Event records describe dated changes such as launches, depegs, migrations, or wind-downs.</td></tr>
      <tr><th>Prefer primary sources</th><td>Issuer statements, official notices, reports, regulatory documents, repositories, and verified contract references are preferred where available.</td></tr>
      <tr><th>Keep context attached</th><td>A source is linked to the claim or event it supports rather than treated as proof of the whole record.</td></tr>
    </tbody></table>
  </section>

  <section class="panel registry">
    <div class="bar">Status labels</div>
    <table><tbody>
      <tr><th>Active</th><td>Operating or available according to the most recent sources reviewed.</td></tr>
      <tr><th>Limited</th><td>Still operating, but with important restrictions on access, minting, redemption, geography, or market availability.</td></tr>
      <tr><th>Impaired</th><td>Facing material problems without enough evidence to classify it as discontinued or failed.</td></tr>
      <tr><th>Discontinued</th><td>Issuance, support, or operation has ended or entered a formal wind-down.</td></tr>
      <tr><th>Failed</th><td>The stablecoin no longer functions as intended after a severe event or collapse.</td></tr>
      <tr><th>Rebranded / migrated</th><td>The product moved to a new name, contract, structure, or successor asset.</td></tr>
      <tr><th>Unknown</th><td>Available information is not sufficient for a reliable classification.</td></tr>
    </tbody></table>
  </section>

  <section class="panel registry">
    <div class="bar">Depegs and other events</div>
    <table><tbody>
      <tr><th>Small price movement</th><td>Short or minor deviations are normally not recorded as separate events.</td></tr>
      <tr><th>Notable depeg</th><td>A depeg may be included when it is material, sustained, historically important, or well documented.</td></tr>
      <tr><th>Major event</th><td>The entry should identify what happened, when it happened, whether the peg recovered, and which sources support the account.</td></tr>
      <tr><th>Status impact</th><td>A depeg does not automatically mean failure. Recovery and long-term outcome are considered separately.</td></tr>
    </tbody></table>
  </section>

  <section class="panel registry">
    <div class="bar">Incomplete or conflicting information</div>
    <table><tbody>
      <tr><th>Open questions</th><td>Missing dates, unclear reserve histories, uncertain issuer roles, and conflicting claims are listed explicitly.</td></tr>
      <tr><th>Confidence</th><td>Confidence describes how complete and well supported the record is. It is not a judgment on the asset itself.</td></tr>
      <tr><th>Corrections</th><td>Corrections and additional sources can be submitted through the contact page or GitHub Issues.</td></tr>
    </tbody></table>
  </section>
</BaseLayout>