---
import BaseLayout from '../../layouts/BaseLayout.astro';
const models = [
  ['fiat_backed', 'Fiat-backed stablecoins backed by cash, T-bills, or other off-chain reserve assets.'],
  ['crypto_collateralized', 'Stablecoins backed by on-chain crypto collateral.'],
  ['algorithmic', 'Stablecoins relying primarily on algorithmic or reflexive peg mechanisms.'],
  ['hybrid', 'Stablecoins using more than one backing or stabilization mechanism.'],
  ['synthetic', 'Synthetic dollar or synthetic stable value instruments.'],
  ['yield_bearing', 'Stablecoins or stable-value tokens designed with yield-bearing mechanics.'],
  ['commodity_backed', 'Stablecoins backed by commodities or commodity claims.'],
  ['multi_collateral', 'Stablecoins backed by several collateral categories.'],
  ['unknown', 'Collateral model requires further source review.']
];
---
<BaseLayout title="Models — Stable or Gone">
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">&gt; cat collateral_models.txt</div>
      <h1>Collateral Models</h1>
      <p>Working categories for stablecoin design and reserve/collateral structure.</p>
    </div>
  </section>
  <section class="section-grid">
    {models.map(([name, description]) => (
      <div class="panel mini-card">
        <h2>{name}</h2>
        <p>{description}</p>
      </div>
    ))}
  </section>
</BaseLayout>
