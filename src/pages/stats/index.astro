---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPublicLabel } from '../../utils/displayLabels';
import { getPublicStats, getPublicStatsHistory, getStatsReviewDate } from '../../lib/statsData.mjs';
import { loadStatsInput } from '../../../scripts/stats/load-stats-input.mjs';

const stats = getPublicStats() as any;
const history = getPublicStatsHistory() as any;
const input = loadStatsInput(process.cwd()) as any;
const reviewDate = getStatsReviewDate(stats, history);
const totalAssets = Number(stats.totals?.assets ?? 0);

type DistributionRow = {
  key: string;
  label: string;
  count: number;
  percentage: number;
};

type FailureRateRow = {
  key: string;
  label: string;
  failed: number;
  denominator: number;
  percentage: number;
};

const percentage = (count: number, denominator: number) => denominator > 0 ? Number(((count / denominator) * 100).toFixed(1)) : 0;
const distribution = (value: unknown): DistributionRow[] => Object.entries((value && typeof value === 'object' ? value : {}) as Record<string, any>)
  .map(([key, row]) => ({
    key,
    label: formatPublicLabel(key),
    count: Number(row?.count ?? row ?? 0),
    percentage: Number(row?.percentage ?? 0)
  }))
  .filter((row) => row.count > 0)
  .sort((left, right) => right.count - left.count || left.label.localeCompare(right.label));

const compactRows = (value: unknown, limit = 6) => distribution(value).slice(0, limit);
const lifecycleGroups = distribution(stats.lifecycle?.groups);
const lifecycleGroupByKey = new Map(lifecycleGroups.map((row) => [row.key, row]));
const lifecycleColors: Record<string, string> = {
  operating: '#58d7a0',
  constrained: '#f0c75e',
  historical_non_failure: '#91a0aa',
  failed: '#ff727b',
  other: '#9a8cff'
};
let lifecycleCursor = 0;
const lifecycleStops = lifecycleGroups.map((row) => {
  const start = lifecycleCursor;
  lifecycleCursor += row.percentage;
  return `${lifecycleColors[row.key] ?? '#68d7ff'} ${start}% ${lifecycleCursor}%`;
});
const lifecycleGradient = lifecycleStops.length ? `conic-gradient(${lifecycleStops.join(',')})` : 'conic-gradient(#25384a 0 100%)';
const largestLifecycle = [...lifecycleGroups].sort((a, b) => b.count - a.count)[0];

const referenceRows = compactRows(stats.classification?.reference_target, 6);
const backingRows = compactRows(stats.classification?.backing_type, 6);
const redemptionRows = compactRows(stats.redemption?.status, 6);

const deploymentRows = Object.entries((stats.deployments?.by_chain ?? {}) as Record<string, any>)
  .map(([chain, row]) => ({
    key: chain,
    label: formatPublicLabel(chain),
    assets: Number(row?.asset_count ?? 0),
    deployments: Number(row?.deployment_count ?? 0),
    percentage: percentage(Number(row?.asset_count ?? 0), totalAssets)
  }))
  .filter((row) => row.deployments > 0)
  .sort((left, right) => right.assets - left.assets || right.deployments - left.deployments || left.label.localeCompare(right.label))
  .slice(0, 6);

const failureRates = (allValue: unknown, failedValue: unknown): FailureRateRow[] => {
  const allRows = new Map(distribution(allValue).map((row) => [row.key, row]));
  return distribution(failedValue)
    .map((row) => {
      const denominator = Number(allRows.get(row.key)?.count ?? 0);
      return {
        key: row.key,
        label: row.label,
        failed: row.count,
        denominator,
        percentage: percentage(row.count, denominator)
      };
    })
    .filter((row) => row.denominator > 0)
    .sort((left, right) => right.percentage - left.percentage || right.failed - left.failed || left.label.localeCompare(right.label));
};

const mechanismFailureRates = failureRates(stats.classification?.stabilization_mechanism, stats.failures?.by_stabilization_mechanism).slice(0, 6);
const backingFailureRates = failureRates(stats.classification?.backing_type, stats.failures?.by_backing_type).slice(0, 6);
const failurePatternRows = [
  ...mechanismFailureRates.map((row) => ({ ...row, dimension: 'Mechanism' })),
  ...backingFailureRates.map((row) => ({ ...row, dimension: 'Backing' }))
]
  .sort((left, right) => right.percentage - left.percentage || right.failed - left.failed)
  .slice(0, 5);
const topFailurePattern = failurePatternRows[0];
const depegOutcomeRows = compactRows(stats.events?.depeg_outcomes, 6);

const eventMonthMap = new Map<string, { total: number; types: Record<string, number> }>();
for (const event of input.events ?? []) {
  const match = String(event?.event_date ?? '').match(/^(\d{4})-(\d{2})/);
  if (!match) continue;
  const month = `${match[1]}-${match[2]}`;
  const eventType = String(event?.event_type ?? 'unknown');
  const bucket = eventMonthMap.get(month) ?? { total: 0, types: {} };
  bucket.total += 1;
  bucket.types[eventType] = (bucket.types[eventType] ?? 0) + 1;
  eventMonthMap.set(month, bucket);
}
const recordedMonths = [...eventMonthMap.keys()].sort();
const recentMonthKeys = recordedMonths.slice(-12);
const recentTypeTotals = new Map<string, number>();
for (const month of recentMonthKeys) {
  const bucket = eventMonthMap.get(month)!;
  for (const [eventType, count] of Object.entries(bucket.types)) recentTypeTotals.set(eventType, (recentTypeTotals.get(eventType) ?? 0) + count);
}
const seriesKeys = [...recentTypeTotals.entries()]
  .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0]))
  .slice(0, 4)
  .map(([key]) => key);
const seriesColors = ['#68d7ff', '#f0c75e', '#ff727b', '#9a8cff'];
const monthRows = recentMonthKeys.map((month) => {
  const bucket = eventMonthMap.get(month)!;
  const selected = seriesKeys.map((key, index) => ({ key, label: formatPublicLabel(key), count: bucket.types[key] ?? 0, color: seriesColors[index] }));
  const selectedTotal = selected.reduce((sum, item) => sum + item.count, 0);
  return { month, total: bucket.total, selected, other: Math.max(0, bucket.total - selectedTotal) };
});
const maxMonthTotal = Math.max(1, ...monthRows.map((row) => row.total));
const recentEventTotal = monthRows.reduce((sum, row) => sum + row.total, 0);

const evidenceDepth = stats.data_quality?.evidence_per_asset?.distribution ?? {};
const zeroEvidenceAssets = Number(evidenceDepth?.['0']?.count ?? 0);
const assetsWithEvidence = Math.max(0, totalAssets - zeroEvidenceAssets);
const recency = stats.data_quality?.verification_recency ?? {};
const fresh90 = Number(recency?.['0_30_days']?.count ?? 0) + Number(recency?.['31_90_days']?.count ?? 0);
const reserveReportAssets = new Set((input.reserve_reports ?? []).map((row: any) => row?.stablecoin_id).filter(Boolean)).size;
const deploymentCoverage = Number(stats.data_quality?.coverage?.deployment?.count ?? 0);
const knownUnknowns = Number(stats.data_quality?.known_unknowns?.total ?? 0);
const highUnknownAssets = Number(stats.data_quality?.known_unknowns?.assets_with_high_or_critical ?? 0);

const confidenceCards = [
  { label: 'Evidence coverage', value: `${percentage(assetsWithEvidence, totalAssets)}%`, note: `${assetsWithEvidence} of ${totalAssets} assets have at least one evidence item`, tone: 'cyan' },
  { label: 'Fresh review ≤ 90d', value: `${percentage(fresh90, totalAssets)}%`, note: `${fresh90} of ${totalAssets} assets`, tone: 'green' },
  { label: 'Reserve-report coverage', value: `${percentage(reserveReportAssets, totalAssets)}%`, note: `${reserveReportAssets} of ${totalAssets} assets`, tone: 'amber' },
  { label: 'Deployment coverage', value: `${percentage(deploymentCoverage, totalAssets)}%`, note: `${deploymentCoverage} of ${totalAssets} assets`, tone: 'violet' },
  { label: 'Known unknowns', value: String(knownUnknowns), note: `${highUnknownAssets} assets have high/critical unknowns`, tone: 'slate' }
];

const kpis = [
  { label: 'Stable assets', value: Number(stats.totals?.assets ?? 0), note: 'Canonical records' },
  { label: 'Organizations', value: Number(stats.totals?.organizations ?? 0), note: 'Reviewed organizations' },
  { label: 'Material events', value: Number(stats.totals?.events ?? 0), note: 'Historical events' },
  { label: 'Evidence', value: Number(stats.totals?.evidence ?? 0), note: 'Reviewed evidence items' }
];

const failedCount = Number(lifecycleGroupByKey.get('failed')?.count ?? stats.failures?.count ?? 0);
const constrainedCount = Number(lifecycleGroupByKey.get('constrained')?.count ?? 0);
const depegEventCount = Number(stats.events?.by_type?.depeg?.count ?? 0);
const summaryLines = [
  largestLifecycle ? `${largestLifecycle.label} is the largest lifecycle group at ${largestLifecycle.count} of ${totalAssets} assets (${largestLifecycle.percentage}%).` : null,
  topFailurePattern ? `${topFailurePattern.label} has ${topFailurePattern.failed} failed assets among ${topFailurePattern.denominator} recorded in that ${topFailurePattern.dimension.toLowerCase()} category (${topFailurePattern.percentage}%).` : null,
  recentMonthKeys.length ? `The latest ${recentMonthKeys.length} recorded months contain ${recentEventTotal} material events.` : null
].filter(Boolean);

const title = 'Stablecoin Registry Statistics — Stable or Gone';
const description = 'Public statistics for the Stable or Gone registry: lifecycle state, asset composition, historical failure concentration, material-event trends, and evidence coverage.';
---
<BaseLayout title={title} description={description} canonicalPath="/stats/">
  <article class="stats-public-page">
    <header class="stats-public-hero">
      <div>
        <p class="stats-public-kicker">Public analytics</p>
        <h1>Statistics</h1>
        <p>Understand the reviewed stablecoin registry at a glance: what state assets are in, what kinds of models are recorded, where historical failures cluster, what changed recently, and how much evidence supports the view.</p>
      </div>
      <dl class="stats-public-meta">
        <div><dt>Reviewed checkpoint</dt><dd><time datetime={reviewDate}>{reviewDate}</time></dd></div>
        <div><dt>Canonical assets</dt><dd>{totalAssets}</dd></div>
        <div><dt>Scope</dt><dd>Historical registry</dd></div>
      </dl>
    </header>

    <nav class="stats-public-jump" aria-label="Statistics sections">
      <a href="#summary">Summary</a>
      <a href="#state">Current state</a>
      <a href="#composition">Composition</a>
      <a href="#failure-patterns">Failure patterns</a>
      <a href="#change">Change over time</a>
      <a href="#confidence">Coverage</a>
    </nav>

    <section id="summary" class="stats-public-section stats-public-section--summary">
      <div class="stats-public-heading stats-public-heading--compact">
        <div><p class="stats-public-kicker">Executive summary</p><h2>What the registry says now</h2></div>
        <p>Inventory and historical context only. No market-share, price, safety, or investment scoring.</p>
      </div>
      <dl class="stats-public-kpis">
        {kpis.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
            <p>{item.note}</p>
          </div>
        ))}
      </dl>
      <div class="stats-public-insight-strip" aria-label="Current registry observations">
        <strong>Current read</strong>
        <ul>{summaryLines.map((line) => <li>{line}</li>)}</ul>
      </div>
    </section>

    <section id="state" class="stats-public-section stats-public-section--state">
      <div class="stats-public-heading">
        <div><p class="stats-public-kicker">Current state</p><h2>Lifecycle distribution</h2></div>
        <p>Operating, constrained, historical non-failure, and failed records stay separate so an orderly migration or termination is not presented as a collapse.</p>
      </div>
      <div class="stats-state-layout">
        <div class="stats-state-chart-wrap">
          <div class="stats-donut" style={`background:${lifecycleGradient}`} role="img" aria-label={`Lifecycle distribution across ${totalAssets} stable assets`}>
            <div><strong>{totalAssets}</strong><span>stable assets</span></div>
          </div>
          <div class="stats-state-legend">
            {lifecycleGroups.map((row) => (
              <div>
                <span class="stats-state-dot" style={`background:${lifecycleColors[row.key] ?? '#68d7ff'}`}></span>
                <strong>{row.label}</strong>
                <span>{row.count}</span>
                <small>{row.percentage}%</small>
              </div>
            ))}
          </div>
        </div>
        <aside class="stats-state-reading">
          <p class="stats-public-kicker">How to read this</p>
          <h3>State first, interpretation second</h3>
          <ul>
            {largestLifecycle && <li><strong>{largestLifecycle.label}</strong> accounts for {largestLifecycle.count} of {totalAssets} records.</li>}
            <li><strong>{failedCount}</strong> assets are in the canonical failed group.</li>
            <li><strong>{constrainedCount}</strong> assets are currently constrained by lifecycle classification.</li>
            <li>Underlying canonical statuses remain available in the machine-readable statistics and record pages.</li>
          </ul>
          <a href="/methodology/">Read lifecycle methodology →</a>
        </aside>
      </div>
    </section>

    <section id="composition" class="stats-public-section">
      <div class="stats-public-heading">
        <div><p class="stats-public-kicker">Composition</p><h2>What kinds of stable assets are recorded</h2></div>
        <p>Four high-value dimensions replace the previous wall of equally weighted classification panels. Unknown values remain explicit.</p>
      </div>
      <div class="stats-composition-grid">
        <section class="stats-chart-panel">
          <header><h3>Reference target</h3><span>Asset share</span></header>
          <div class="stats-bar-list">
            {referenceRows.map((row) => (
              <div class="stats-bar-row">
                <div><span>{row.label}</span><strong>{row.count}</strong></div>
                <div class="stats-bar-track"><i style={`width:${Math.min(100, row.percentage)}%`}></i></div>
                <small>{row.percentage}%</small>
              </div>
            ))}
          </div>
        </section>

        <section class="stats-chart-panel">
          <header><h3>Backing type</h3><span>Multi-select</span></header>
          <div class="stats-bar-list">
            {backingRows.map((row) => (
              <div class="stats-bar-row">
                <div><span>{row.label}</span><strong>{row.count}</strong></div>
                <div class="stats-bar-track"><i style={`width:${Math.min(100, row.percentage)}%`}></i></div>
                <small>{row.percentage}%</small>
              </div>
            ))}
          </div>
          <p class="stats-panel-note">Backing categories can overlap; percentages do not sum to 100%.</p>
        </section>

        <section class="stats-chart-panel">
          <header><h3>Redemption status</h3><span>Asset share</span></header>
          <div class="stats-bar-list">
            {redemptionRows.map((row) => (
              <div class="stats-bar-row">
                <div><span>{row.label}</span><strong>{row.count}</strong></div>
                <div class="stats-bar-track"><i style={`width:${Math.min(100, row.percentage)}%`}></i></div>
                <small>{row.percentage}%</small>
              </div>
            ))}
          </div>
        </section>

        <section class="stats-chart-panel">
          <header><h3>Deployment chains</h3><span>Assets / deployments</span></header>
          <div class="stats-bar-list">
            {deploymentRows.map((row) => (
              <div class="stats-bar-row stats-bar-row--deployment">
                <div><span>{row.label}</span><strong>{row.assets}</strong></div>
                <div class="stats-bar-track"><i style={`width:${Math.min(100, row.percentage)}%`}></i></div>
                <small>{row.assets} assets · {row.deployments} deployments</small>
              </div>
            ))}
          </div>
        </section>
      </div>
    </section>

    <section id="failure-patterns" class="stats-public-section stats-public-section--failure">
      <div class="stats-public-heading">
        <div><p class="stats-public-kicker">Historical failure patterns</p><h2>Where recorded failures are concentrated</h2></div>
        <p>These are descriptive historical shares: failed assets in a category divided by all recorded assets in that same category. They are not forecasts or safety scores.</p>
      </div>
      <div class="stats-failure-grid">
        <section class="stats-chart-panel stats-chart-panel--failure">
          <header><h3>By stabilization mechanism</h3><span>Failed / category total</span></header>
          <div class="stats-rate-list">
            {mechanismFailureRates.map((row) => (
              <div class="stats-rate-row">
                <div><span>{row.label}</span><strong>{row.percentage}%</strong></div>
                <div class="stats-rate-track"><i style={`width:${Math.min(100, row.percentage)}%`}></i></div>
                <small>{row.failed} / {row.denominator} assets</small>
              </div>
            ))}
          </div>
        </section>

        <section class="stats-chart-panel stats-chart-panel--failure">
          <header><h3>By backing type</h3><span>Failed / category total</span></header>
          <div class="stats-rate-list">
            {backingFailureRates.map((row) => (
              <div class="stats-rate-row">
                <div><span>{row.label}</span><strong>{row.percentage}%</strong></div>
                <div class="stats-rate-track"><i style={`width:${Math.min(100, row.percentage)}%`}></i></div>
                <small>{row.failed} / {row.denominator} assets</small>
              </div>
            ))}
          </div>
          <p class="stats-panel-note">Backing types overlap; each rate uses that backing category's own denominator.</p>
        </section>

        <aside class="stats-failure-ranked">
          <p class="stats-public-kicker">Highest observed shares</p>
          <h3>Failure concentration</h3>
          <ol>
            {failurePatternRows.map((row) => (
              <li>
                <div><strong>{row.label}</strong><span>{row.dimension}</span></div>
                <b>{row.percentage}%</b>
                <small>{row.failed}/{row.denominator}</small>
              </li>
            ))}
          </ol>
        </aside>
      </div>
      {depegOutcomeRows.length > 0 && (
        <div class="stats-depeg-outcomes">
          <div><p class="stats-public-kicker">Recorded depeg outcomes</p><h3>What happened after depeg events</h3></div>
          <dl>{depegOutcomeRows.map((row) => <div><dt>{row.label}</dt><dd>{row.count}</dd><small>{row.percentage}%</small></div>)}</dl>
        </div>
      )}
    </section>

    <section id="change" class="stats-public-section">
      <div class="stats-public-heading">
        <div><p class="stats-public-kicker">Change over time</p><h2>Material events in the latest recorded months</h2></div>
        <p>Canonical event dates are grouped into month buckets at build time. Undated events are not assigned to a month.</p>
      </div>
      <div class="stats-change-layout">
        <div class="stats-month-chart" aria-label="Material events by month">
          <div class="stats-month-legend">
            {seriesKeys.map((key, index) => <span><i style={`background:${seriesColors[index]}`}></i>{formatPublicLabel(key)}</span>)}
            <span><i style="background:#62717d"></i>Other event types</span>
          </div>
          <div class="stats-month-rows">
            {monthRows.map((row) => (
              <div class="stats-month-row">
                <time datetime={row.month}>{row.month}</time>
                <div class="stats-month-track" aria-label={`${row.month}: ${row.total} events`}>
                  {row.selected.map((segment) => segment.count > 0 && <i style={`width:${(segment.count / maxMonthTotal) * 100}%;background:${segment.color}`} title={`${segment.label}: ${segment.count}`}></i>)}
                  {row.other > 0 && <i style={`width:${(row.other / maxMonthTotal) * 100}%;background:#62717d`} title={`Other event types: ${row.other}`}></i>}
                </div>
                <strong>{row.total}</strong>
              </div>
            ))}
          </div>
        </div>
        <aside class="stats-change-summary">
          <p class="stats-public-kicker">Latest recorded period</p>
          <strong>{recentEventTotal}</strong>
          <span>events across {recentMonthKeys.length} recorded months</span>
          <dl>
            {seriesKeys.map((key) => <div><dt>{formatPublicLabel(key)}</dt><dd>{recentTypeTotals.get(key) ?? 0}</dd></div>)}
          </dl>
          <a href="/events/">Open the material-events register →</a>
        </aside>
      </div>
    </section>

    <section id="confidence" class="stats-public-section stats-public-section--confidence">
      <div class="stats-public-heading">
        <div><p class="stats-public-kicker">Coverage and confidence</p><h2>How complete and current is this view?</h2></div>
        <p>Coverage describes the registry's evidence and review state. It does not rate the safety or transparency of a stablecoin.</p>
      </div>
      <div class="stats-confidence-grid">
        {confidenceCards.map((item) => (
          <article data-tone={item.tone}>
            <span>{item.label}</span>
            <strong>{item.value}</strong>
            <p>{item.note}</p>
          </article>
        ))}
      </div>
      <div class="stats-health-link">
        <div><strong>Need the operational view?</strong><span>Review freshness, corpus growth, data gaps, and public maintenance checks now live in Registry Health.</span></div>
        <a href="/maintenance/">Open Registry Health →</a>
      </div>
    </section>

    <section class="stats-public-section stats-public-section--next">
      <div class="stats-public-heading stats-public-heading--compact">
        <div><p class="stats-public-kicker">Explore next</p><h2>Move from aggregate patterns to records</h2></div>
        <p>Every card opens an existing public registry surface or supported filter.</p>
      </div>
      <div class="stats-next-grid">
        <a href="/stablecoins/?lifecycle=collapsed"><span>Failed assets</span><strong>{failedCount}</strong><small>Open canonical collapsed records →</small></a>
        <a href="/stablecoins/?lifecycle=restricted,suspended,winding_down"><span>Constrained assets</span><strong>{constrainedCount}</strong><small>Open the constrained lifecycle set →</small></a>
        <a href="/stablecoins/?event_lifecycle=depeg"><span>Recorded depeg history</span><strong>{depegEventCount}</strong><small>Explore assets with canonical depeg events →</small></a>
        <a href="/maintenance/"><span>Registry Health</span><strong>{percentage(fresh90, totalAssets)}%</strong><small>Freshly reviewed within 90 days →</small></a>
      </div>
    </section>

    <aside class="stats-public-boundary">
      <strong>Method boundary</strong>
      <p>Historical failure concentration is descriptive registry context, not a prediction. Unknown values remain visible. Backing categories are multi-select. Full current statistics remain available through the public machine-readable layer.</p>
      <nav aria-label="Statistics references"><a href="/data/stats.json">Stats JSON</a><a href="/methodology/">Methodology</a><a href="/data/manifest.json">Data manifest</a></nav>
    </aside>
  </article>

  <style>
    .stats-public-page{display:grid;gap:22px}.stats-public-page section+section{margin-top:0}.stats-public-hero,.stats-public-section,.stats-public-boundary{border:1px solid var(--ui-line);border-radius:var(--ui-radius);background:linear-gradient(180deg,rgba(14,24,35,.94),rgba(7,14,22,.97))}.stats-public-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(330px,.7fr);gap:28px;align-items:end;padding:30px}.stats-public-hero h1{margin:5px 0 12px}.stats-public-hero>div>p:last-child{max-width:800px;color:var(--ui-copy);font-size:1.04rem}.stats-public-kicker{margin:0;color:var(--ui-muted)!important;font:750 11px/1.2 var(--ui-sans)!important;letter-spacing:.09em!important;text-transform:uppercase}.stats-public-meta{margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));overflow:hidden;border:1px solid var(--ui-line);border-radius:var(--ui-radius-small);background:#08121b}.stats-public-meta>div{padding:13px;border-left:1px solid var(--ui-line-soft)}.stats-public-meta>div:first-child{border-left:0}.stats-public-meta dt{color:var(--ui-muted);font:700 11px/1.2 var(--ui-sans);letter-spacing:.05em;text-transform:uppercase}.stats-public-meta dd{margin:5px 0 0;color:var(--ui-text);font-size:13px}.stats-public-jump{position:sticky;z-index:20;top:117px;display:flex;gap:4px;overflow-x:auto;padding:7px;border:1px solid var(--ui-line);border-radius:var(--ui-radius-small);background:rgba(7,14,22,.95);backdrop-filter:blur(12px);scrollbar-width:none}.stats-public-jump a{flex:0 0 auto;min-height:36px;display:inline-flex;align-items:center;padding:0 10px;border-radius:6px;color:var(--ui-muted);font-size:12px;font-weight:680}.stats-public-jump a:hover{background:rgba(104,215,255,.06);color:var(--ui-hover);text-decoration:none}.stats-public-section{padding:24px}.stats-public-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.7fr);gap:18px;align-items:end;margin-bottom:18px;padding-bottom:15px;border-bottom:1px solid var(--ui-line)}.stats-public-hea