---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPublicLabel } from '../../utils/displayLabels';
import { getPublicStats, getPublicStatsHistory, getStatsReviewDate } from '../../lib/statsData.mjs';

const stats = getPublicStats() as any;
const history = getPublicStatsHistory() as any;
const reviewDate = getStatsReviewDate(stats, history);
const snapshots = Array.isArray(history.snapshots) ? history.snapshots : [];

const distribution = (value: unknown) => Object.entries((value && typeof value === 'object' ? value : {}) as Record<string, any>)
  .map(([key, row]) => ({
    key,
    label: formatPublicLabel(key),
    count: Number(row?.count ?? row ?? 0),
    percentage: Number(row?.percentage ?? 0)
  }))
  .sort((left, right) => right.count - left.count || left.label.localeCompare(right.label));

const lifecycleGroups = distribution(stats.lifecycle?.groups);
const lifecycleStatuses = distribution(stats.lifecycle?.statuses);
const classificationPanels = [
  ['Asset class', stats.classification?.asset_class],
  ['Reference target', stats.classification?.reference_target],
  ['Stabilization mechanism', stats.classification?.stabilization_mechanism],
  ['Governance model', stats.classification?.governance_model],
  ['Backing type', stats.classification?.backing_type],
  ['Fiat reference currency', stats.classification?.fiat_currency],
  ['Legal classification', stats.classification?.legal_classification]
].map(([title, value]) => ({ title: String(title), rows: distribution(value) }));

const eventYears = Object.entries((stats.events?.by_year ?? {}) as Record<string, any>)
  .map(([year, row]) => ({ year, total: Number(row?.total ?? 0) }))
  .sort((left, right) => left.year.localeCompare(right.year));
const maxEventYear = Math.max(1, ...eventYears.map((row) => row.total));
const eventTypes = distribution(stats.events?.by_type);
const eventDetailKinds = distribution(stats.events?.detail_kind);
const depegOutcomes = distribution(stats.events?.depeg_outcomes);
const transitions = Object.entries((stats.lifecycle?.transitions ?? {}) as Record<string, unknown>)
  .map(([key, value]) => ({ label: formatPublicLabel(key), count: Number(value ?? 0) }))
  .sort((left, right) => right.count - left.count || left.label.localeCompare(right.label));

const failurePanels = [
  ['Stabilization mechanism', stats.failures?.by_stabilization_mechanism],
  ['Backing type', stats.failures?.by_backing_type],
  ['Governance model', stats.failures?.by_governance_model],
  ['Launch year', stats.failures?.by_launch_year],
  ['Collapse year', stats.failures?.by_collapse_year]
].map(([title, value]) => ({ title: String(title), rows: distribution(value) }));

const deploymentChains = Object.entries((stats.deployments?.by_chain ?? {}) as Record<string, any>)
  .map(([chain, row]) => ({
    chain: formatPublicLabel(chain),
    assets: Number(row?.asset_count ?? 0),
    deployments: Number(row?.deployment_count ?? 0)
  }))
  .sort((left, right) => right.deployments - left.deployments || left.chain.localeCompare(right.chain));
const maxDeployments = Math.max(1, ...deploymentChains.map((row) => row.deployments));
const deploymentPanels = [
  ['Canonicality', stats.deployments?.canonicality],
  ['Deployment type', stats.deployments?.deployment_type],
  ['Verification status', stats.deployments?.verification_status]
].map(([title, value]) => ({ title: String(title), rows: distribution(value) }));

const organizationRoles = Object.entries((stats.organizations?.by_role ?? {}) as Record<string, any>)
  .map(([role, row]) => ({
    role: formatPublicLabel(role),
    relationships: Number(row?.relationship_count ?? 0),
    organizations: Number(row?.organization_count ?? 0),
    assets: Number(row?.asset_count ?? 0)
  }))
  .sort((left, right) => right.relationships - left.relationships || left.role.localeCompare(right.role));

const coverageRows = Object.entries((stats.data_quality?.coverage ?? {}) as Record<string, any>)
  .map(([key, row]) => ({
    label: formatPublicLabel(key),
    count: Number(row?.count ?? 0),
    denominator: Number(row?.denominator ?? 0),
    percentage: Number(row?.percentage ?? 0)
  }))
  .sort((left, right) => right.percentage - left.percentage || left.label.localeCompare(right.label));
const evidenceDepth = distribution(stats.data_quality?.evidence_per_asset?.distribution);
const recency = distribution(stats.data_quality?.verification_recency);
const typedEventCoverage = stats.data_quality?.typed_event_details ?? {};

const kpis = [
  ['Stable assets', stats.totals?.assets, 'Canonical asset records'],
  ['Organizations', stats.totals?.organizations, 'Canonical organization records'],
  ['Events', stats.totals?.events, 'Material historical events'],
  ['Evidence', stats.totals?.evidence, 'Evidence records'],
  ['Operating', stats.lifecycle?.groups?.operating?.count, `${stats.lifecycle?.groups?.operating?.percentage ?? 0}% of assets`],
  ['Constrained', stats.lifecycle?.groups?.constrained?.count, `${stats.lifecycle?.groups?.constrained?.percentage ?? 0}% of assets`],
  ['Historical non-failure', stats.lifecycle?.groups?.historical_non_failure?.count, `${stats.lifecycle?.groups?.historical_non_failure?.percentage ?? 0}% of assets`],
  ['Failed', stats.lifecycle?.groups?.failed?.count, `${stats.lifecycle?.groups?.failed?.percentage ?? 0}% of assets`]
].map(([label, value, note]) => ({ label: String(label), value: Number(value ?? 0), note: String(note) }));

const title = 'Registry Statistics — Stable or Gone';
const description = 'Derived statistics for the Stable or Gone canonical registry, including lifecycle, classifications, historical events, deployments, organizations, and data-quality coverage.';
---
<BaseLayout title={title} description={description} canonicalPath="/stats/">
  <article class="stats-page">
    <header class="stats-header">
      <div>
        <p class="stats-kicker">Registry analysis</p>
        <h1>Statistics</h1>
        <p class="stats-lead">A derived view of registry composition, historical change, infrastructure coverage, and evidence quality. These figures describe reviewed records; they are not rankings, scores, or investment recommendations.</p>
      </div>
      <dl class="stats-header-meta">
        <div><dt>Reviewed checkpoint</dt><dd><time datetime={reviewDate}>{reviewDate}</time></dd></div>
        <div><dt>Asset denominator</dt><dd>{stats.totals?.assets ?? 0}</dd></div>
        <div><dt>History snapshots</dt><dd>{snapshots.length}</dd></div>
      </dl>
    </header>

    <aside class="stats-methodology-notice">
      <div><p class="stats-kicker">Reading boundary</p><h2>Counts come from reviewed canonical records</h2></div>
      <p>Unknown states remain visible. Multi-select dimensions may exceed 100% in total. Market price, APY, yield ranking, safety scoring, transparency scoring, and risk scoring are excluded.</p>
      <a href="/methodology/">Read methodology</a>
    </aside>

    <section class="stats-section">
      <div class="stats-section-heading section-heading"><div><p class="stats-kicker">Current checkpoint</p><h2>Registry at a glance</h2></div><p>Exact counts from the audited canonical registry and supporting records.</p></div>
      <dl class="stats-kpi-grid">
        {kpis.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd><p>{item.note}</p></div>)}
      </dl>
    </section>

    <section class="stats-section">
      <div class="stats-section-heading section-heading"><div><p class="stats-kicker">Lifecycle</p><h2>Recorded lifecycle composition</h2></div><p>Operating, constrained, historical non-failure, and failed records remain separate.</p></div>
      <div class="stats-lifecycle-layout">
        <div class="stats-bar-list">
          {lifecycleGroups.map((row) => <div class="stats-bar-row"><div class="stats-bar-row__label"><span>{row.label}</span><strong>{row.count}</strong></div><meter class="stats-bar-meter" min="0" max="100" value={Math.max(row.percentage, 1)} aria-label={`${row.label}: ${row.percentage}%`}></meter><p>{row.percentage}% of assets</p></div>)}
        </div>
        <div class="stats-table-wrap"><table><caption>Canonical lifecycle statuses</caption><thead><tr><th>Status</th><th>Count</th><th>Share</th></tr></thead><tbody>{lifecycleStatuses.map((row) => <tr><th scope="row">{row.label}</th><td>{row.count}</td><td>{row.percentage}%</td></tr>)}</tbody></table></div>
      </div>
    </section>

    <section class="stats-section">
      <div class="stats-section-heading section-heading"><div><p class="stats-kicker">Classification</p><h2>What the registry contains</h2></div><p>Economic class, reference target, mechanism, governance, backing, currency, and legal classification remain separate dimensions.</p></div>
      <div class="stats-analysis-grid stats-analysis-grid--three">
        {classificationPanels.map((panel) => <section class="stats-analysis-panel"><h3>{panel.title}</h3><div class="stats-compact-bars">{panel.rows.map((row) => <div class="stats-compact-bar"><div><span>{row.label}</span><strong>{row.count}</strong></div><meter class="stats-bar-meter" min="0" max="100" value={Math.min(100, Math.max(row.percentage, 1))} aria-label={`${row.label}: ${row.percentage}%`}></meter><small>{row.percentage}%</small></div>)}</div></section>)}
      </div>
    </section>

    <section class="stats-section">
      <div class="stats-section-heading section-heading"><div><p class="stats-kicker">Historical analysis</p><h2>Events, transitions, and failures</h2></div><p>Incidents, migrations, regulatory actions, wind-downs, recoveries, and collapses are not collapsed into one category.</p></div>
      <div class="stats-analysis-grid">
        <section class="stats-analysis-panel"><h3>Events by year</h3><div class="stats-year-list">{eventYears.map((row) => <div class="stats-year-row"><span>{row.year}</span><meter class="stats-bar-meter" min="0" max="100" value={(row.total / maxEventYear) * 100} aria-label={`${row.year}: ${row.total} events`}></meter><strong>{row.total}</strong></div>)}</div></section>
        <section class="stats-analysis-panel"><h3>Event types</h3><div class="stats-table-wrap"><table><thead><tr><th>Type</th><th>Count</th><th>Share</th></tr></thead><tbody>{eventTypes.map((row) => <tr><th scope="row">{row.label}</th><td>{row.count}</td><td>{row.percentage}%</td></tr>)}</tbody></table></div></section>
      </div>
      <div class="stats-analysis-grid stats-analysis-grid--three">
        <section class="stats-analysis-panel"><h3>Lifecycle transitions</h3><dl class="stats-metric-list">{transitions.map((row) => <div><dt>{row.label}</dt><dd>{row.count}</dd></div>)}</dl></section>
        <section class="stats-analysis-panel"><h3>Typed event details</h3><dl class="stats-metric-list">{eventDetailKinds.map((row) => <div><dt>{row.label}</dt><dd>{row.count}</dd></div>)}</dl></section>
        <section class="stats-analysis-panel"><h3>Depeg outcomes</h3><dl class="stats-metric-list">{depegOutcomes.map((row) => <div><dt>{row.label}</dt><dd>{row.count}</dd></div>)}</dl></section>
      </div>
      <div class="stats-failure-header"><div><p class="stats-kicker">Failure analysis</p><h3>{stats.failures?.count ?? 0} failed assets</h3></div><p>Breakdowns use the canonical failed lifecycle group. Backing type remains multi-select.</p></div>
      <div class="stats-analysis-grid stats-analysis-grid--three">{failurePanels.map((panel) => <section class="stats-analysis-panel"><h3>{panel.title}</h3><div class="stats-table-wrap"><table><thead><tr><th>Category</th><th>Count</th><th>Share</th></tr></thead><tbody>{panel.rows.map((row) => <tr><th scope="row">{row.label}</th><td>{row.count}</td><td>{row.percentage}%</td></tr>)}</tbody></table></div></section>)}</div>
    </section>

    <section class="stats-section">
      <div class="stats-section-heading section-heading"><div><p class="stats-kicker">Deployments</p><h2>Chain and deployment structure</h2></div><p>Deployment rows and distinct asset reach are shown separately.</p></div>
      <dl class="stats-mini-kpi-grid"><div><dt>Total deployments</dt><dd>{stats.deployments?.total_deployments ?? 0}</dd></div><div><dt>Assets with deployments</dt><dd>{stats.deployments?.assets_with_deployments ?? 0}</dd></div><div><dt>Freeze capability known</dt><dd>{stats.deployments?.control_capability_knowledge?.freeze_capability_known ?? 0}</dd></div><div><dt>Blacklist capability known</dt><dd>{stats.deployments?.control_capability_knowledge?.blacklist_capability_known ?? 0}</dd></div></dl>
      <div class="stats-analysis-grid">
        <section class="stats-analysis-panel"><h3>Chain coverage</h3><div class="stats-chain-list">{deploymentChains.map((row) => <div class="stats-chain-row"><div><strong>{row.chain}</strong><span>{row.assets} assets</span></div><meter class="stats-bar-meter" min="0" max="100" value={(row.deployments / maxDeployments) * 100} aria-label={`${row.chain}: ${row.deployments} deployments`}></meter><strong>{row.deployments}</strong></div>)}</div></section>
        <section class="stats-analysis-panel"><h3>Exact chain counts</h3><div class="stats-table-wrap"><table><thead><tr><th>Chain</th><th>Assets</th><th>Deployments</th></tr></thead><tbody>{deploymentChains.map((row) => <tr><th scope="row">{row.chain}</th><td>{row.assets}</td><td>{row.deployments}</td></tr>)}</tbody></table></div></section>
      </div>
      <div class="stats-analysis-grid stats-analysis-grid--three">{deploymentPanels.map((panel) => <section class="stats-analysis-panel"><h3>{panel.title}</h3><dl class="stats-metric-list">{panel.rows.map((row) => <div><dt>{row.label}</dt><dd>{row.count}</dd></div>)}</dl></section>)}</div>
    </section>

    <section class="stats-section">
      <div class="stats-section-heading section-heading"><div><p class="stats-kicker">Organizations</p><h2>Roles around stable assets</h2></div><p>An organization may hold multiple roles; role rows describe relationship structure.</p></div>
      <div class="stats-table-wrap"><table class="stats-wide-table"><thead><tr><th>Role</th><th>Relationships</th><th>Organizations</th><th>Asset reach</th></tr></thead><tbody>{organizationRoles.map((row) => <tr><th scope="row">{row.role}</th><td>{row.relationships}</td><td>{row.organizations}</td><td>{row.assets}</td></tr>)}</tbody></table></div>
    </section>

    <section class="stats-section">
      <div class="stats-section-heading section-heading"><div><p class="stats-kicker">Data quality</p><h2>Coverage, evidence depth, and freshness</h2></div><p>These metrics describe registry completeness and review coverage, not the safety of an asset.</p></div>
      <div class="stats-analysis-grid">
        <section class="stats-analysis-panel"><h3>Coverage</h3><div class="stats-table-wrap"><table><thead><tr><th>Metric</th><th>Coverage</th><th>Share</th></tr></thead><tbody>{coverageRows.map((row) => <tr><th scope="row">{row.label}</th><td>{row.count} / {row.denominator}</td><td>{row.percentage}%</td></tr>)}</tbody></table></div></section>
        <section class="stats-analysis-panel"><h3>Evidence and typed events</h3><dl class="stats-metric-list"><div><dt>Average evidence per asset</dt><dd>{stats.data_quality?.evidence_per_asset?.average ?? 0}</dd></div><div><dt>Median evidence per asset</dt><dd>{stats.data_quality?.evidence_per_asset?.median ?? 0}</dd></div><div><dt>Known unknowns</dt><dd>{stats.data_quality?.known_unknowns?.total ?? 0}</dd></div><div><dt>Typed event coverage</dt><dd>{typedEventCoverage.count ?? 0} / {typedEventCoverage.denominator ?? 0}</dd></div></dl></section>
      </div>
      <div class="stats-analysis-grid"><section class="stats-analysis-panel"><h3>Evidence depth</h3><dl class="stats-metric-list">{evidenceDepth.map((row) => <div><dt>{row.label}</dt><dd>{row.count}</dd></div>)}</dl></section><section class="stats-analysis-panel"><h3>Verification recency</h3><dl class="stats-metric-list">{recency.map((row) => <div><dt>{row.label}</dt><dd>{row.count}</dd></div>)}</dl></section></div>
    </section>

    <section class="stats-section">
      <div class="stats-section-heading section-heading"><div><p class="stats-kicker">History</p><h2>Registry growth snapshots</h2></div><p>Append-only snapshots show changes in reviewed inventory, not market performance.</p></div>
      <div class="stats-table-wrap"><table><thead><tr><th>Recorded at</th><th>Assets</th><th>Events</th><th>Evidence</th></tr></thead><tbody>{snapshots.map((snapshot: any) => <tr><th scope="row">{snapshot.recorded_at}</th><td>{snapshot.asset_count}</td><td>{snapshot.totals?.events ?? 0}</td><td>{snapshot.totals?.evidence ?? 0}</td></tr>)}</tbody></table></div>
    </section>
  </article>
</BaseLayout>
