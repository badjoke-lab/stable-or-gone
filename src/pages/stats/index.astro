---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPublicLabel } from '../../utils/displayLabels';
import { getPublicStats, getPublicStatsHistory, getStatsReviewDate } from '../../lib/statsData.mjs';

const stats = getPublicStats() as any;
const history = getPublicStatsHistory() as any;
const reviewDate = getStatsReviewDate(stats, history);
const snapshots = Array.isArray(history.snapshots) ? history.snapshots : [];

type DistributionRow = {
  key: string;
  label: string;
  count: number;
  percentage: number;
};

const distribution = (value: unknown): DistributionRow[] => Object.entries((value && typeof value === 'object' ? value : {}) as Record<string, any>)
  .map(([key, row]) => ({
    key,
    label: formatPublicLabel(key),
    count: Number(row?.count ?? row ?? 0),
    percentage: Number(row?.percentage ?? 0)
  }))
  .filter((row) => row.count > 0)
  .sort((left, right) => right.count - left.count || left.label.localeCompare(right.label));

const compactRows = (rows: DistributionRow[], limit = 5): DistributionRow[] => {
  if (rows.length <= limit) return rows;
  const visible = rows.slice(0, limit);
  const remainder = rows.slice(limit);
  return [
    ...visible,
    {
      key: 'other-recorded-values',
      label: 'Other recorded values',
      count: remainder.reduce((sum, row) => sum + row.count, 0),
      percentage: Number(remainder.reduce((sum, row) => sum + row.percentage, 0).toFixed(1))
    }
  ];
};

const lifecycleGroups = distribution(stats.lifecycle?.groups);
const lifecycleStatuses = distribution(stats.lifecycle?.statuses);

const compositionPanels = [
  ['Asset class', stats.classification?.asset_class],
  ['Reference target', stats.classification?.reference_target],
  ['Stabilization mechanism', stats.classification?.stabilization_mechanism],
  ['Governance model', stats.classification?.governance_model],
  ['Backing type', stats.classification?.backing_type],
  ['Fiat reference currency', stats.classification?.fiat_currency],
  ['Legal classification', stats.classification?.legal_classification]
].map(([title, value]) => ({ title: String(title), rows: compactRows(distribution(value), 5) }));

const eventYears = Object.entries((stats.events?.by_year ?? {}) as Record<string, any>)
  .map(([year, row]) => ({ year, total: Number(row?.total ?? 0) }))
  .filter((row) => row.total > 0)
  .sort((left, right) => left.year.localeCompare(right.year));
const recentEventYears = eventYears.slice(-12);
const maxEventYear = Math.max(1, ...recentEventYears.map((row) => row.total));
const eventTypes = compactRows(distribution(stats.events?.by_type), 7);
const depegRecoveryRows = distribution(stats.events?.depeg_outcomes);
const typedLifecycleRows = compactRows(distribution(stats.events?.detail_kind), 8);
const lifecycleQuality = stats.events?.lifecycle_quality ?? {};
const lifecycleCoveragePanels = [
  ['Depeg events', lifecycleQuality.depeg],
  ['Regulatory events', lifecycleQuality.regulatory],
  ['Redemption changes', lifecycleQuality.redemption_change],
  ['Migration / termination', lifecycleQuality.migration_or_termination]
].map(([label, value]) => ({
  label: String(label),
  eventCount: Number((value as any)?.event_count ?? 0),
  assetCount: Number((value as any)?.asset_coverage?.count ?? 0),
  assetDenominator: Number((value as any)?.asset_coverage?.denominator ?? stats.totals?.assets ?? 0),
  assetPercentage: Number((value as any)?.asset_coverage?.percentage ?? 0)
}));
const depegRecoveryCoverage = lifecycleQuality.depeg?.recovery_state_recorded ?? {};

const failurePanels = [
  ['Leading stabilization mechanism', stats.failures?.by_stabilization_mechanism],
  ['Leading backing type', stats.failures?.by_backing_type],
  ['Leading governance model', stats.failures?.by_governance_model],
  ['Most common collapse year', stats.failures?.by_collapse_year]
].map(([label, value]) => ({ label: String(label), row: distribution(value)[0] })).filter((item) => item.row);

const deploymentChains = Object.entries((stats.deployments?.by_chain ?? {}) as Record<string, any>)
  .map(([chain, row]) => ({
    chain: formatPublicLabel(chain),
    assets: Number(row?.asset_count ?? 0),
    deployments: Number(row?.deployment_count ?? 0)
  }))
  .filter((row) => row.deployments > 0)
  .sort((left, right) => right.deployments - left.deployments || left.chain.localeCompare(right.chain));
const topDeploymentChains = deploymentChains.slice(0, 10);
const maxDeployments = Math.max(1, ...topDeploymentChains.map((row) => row.deployments));

const organizationRoles = Object.entries((stats.organizations?.by_role ?? {}) as Record<string, any>)
  .map(([role, row]) => ({
    role: formatPublicLabel(role),
    relationships: Number(row?.relationship_count ?? 0),
    organizations: Number(row?.organization_count ?? 0),
    assets: Number(row?.asset_count ?? 0)
  }))
  .filter((row) => row.relationships > 0)
  .sort((left, right) => right.relationships - left.relationships || left.role.localeCompare(right.role))
  .slice(0, 8);

const coverageRows = Object.entries((stats.data_quality?.coverage ?? {}) as Record<string, any>)
  .map(([key, row]) => ({
    label: formatPublicLabel(key),
    count: Number(row?.count ?? 0),
    denominator: Number(row?.denominator ?? 0),
    percentage: Number(row?.percentage ?? 0)
  }))
  .sort((left, right) => right.percentage - left.percentage || left.label.localeCompare(right.label));
const evidenceDepth = distribution(stats.data_quality?.evidence_per_asset?.distribution);
const recency = distribution(stats.data_quality?.verification_recency);
const typedEventCoverage = stats.data_quality?.typed_event_details ?? {};

const snapshotSignature = (snapshot: any) => [
  snapshot?.asset_count ?? 0,
  snapshot?.totals?.events ?? 0,
  snapshot?.totals?.evidence ?? 0
].join(':');
const distinctSnapshots = snapshots.filter((snapshot: any, index: number) => index === 0 || snapshotSignature(snapshot) !== snapshotSignature(snapshots[index - 1]));
const recentSnapshots = distinctSnapshots.slice(-8);
const firstSnapshot = distinctSnapshots[0] ?? {};
const latestSnapshot = distinctSnapshots.at(-1) ?? {};
const growth = {
  assets: Number(latestSnapshot.asset_count ?? 0) - Number(firstSnapshot.asset_count ?? 0),
  events: Number(latestSnapshot.totals?.events ?? 0) - Number(firstSnapshot.totals?.events ?? 0),
  evidence: Number(latestSnapshot.totals?.evidence ?? 0) - Number(firstSnapshot.totals?.evidence ?? 0)
};

const kpis = [
  ['Stable assets', stats.totals?.assets, 'Canonical asset records'],
  ['Organizations', stats.totals?.organizations, 'Canonical organization records'],
  ['Events', stats.totals?.events, 'Material historical events'],
  ['Evidence', stats.totals?.evidence, 'Reviewed evidence records']
].map(([label, value, note]) => ({ label: String(label), value: Number(value ?? 0), note: String(note) }));

const title = 'Registry Statistics — Stable or Gone';
const description = 'A concise analytical view of the Stable or Gone canonical registry: lifecycle, composition, historical activity, deployments, organizations, evidence quality, and record growth.';
---
<BaseLayout title={title} description={description} canonicalPath="/stats/">
  <article class="stats-page stats-v4">
    <header class="stats-v4-hero">
      <div class="stats-v4-hero-copy">
        <p class="stats-kicker">Registry analysis</p>
        <h1>Statistics</h1>
        <p>A readable analytical summary of the reviewed registry. This page prioritizes the patterns that explain the corpus; exhaustive machine-readable records remain available separately.</p>
      </div>
      <dl class="stats-v4-meta">
        <div><dt>Reviewed checkpoint</dt><dd><time datetime={reviewDate}>{reviewDate}</time></dd></div>
        <div><dt>Canonical denominator</dt><dd>{stats.totals?.assets ?? 0} assets</dd></div>
        <div><dt>Distinct growth checkpoints</dt><dd>{distinctSnapshots.length}</dd></div>
      </dl>
    </header>

    <nav class="stats-v4-jump" aria-label="Statistics sections">
      <a href="#overview">Overview</a>
      <a href="#lifecycle">Lifecycle</a>
      <a href="#composition">Composition</a>
      <a href="#activity">Historical activity</a>
      <a href="#network">Network</a>
      <a href="#quality">Data quality</a>
      <a href="#growth">Growth</a>
    </nav>

    <section id="overview" class="stats-v4-section stats-v4-section--overview">
      <div class="stats-v4-section-heading">
        <div><p class="stats-kicker">Current checkpoint</p><h2>Registry at a glance</h2></div>
        <p>Exact audited counts. These are inventory measures, not rankings, market-share estimates, or safety scores.</p>
      </div>
      <dl class="stats-v4-kpis">
        {kpis.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd><p>{item.note}</p></div>)}
      </dl>
      <aside class="stats-v4-boundary">
        <div><strong>Reading boundary</strong><span>Unknown states remain visible and multi-select dimensions can exceed 100% in total.</span></div>
        <a href="/methodology/">Methodology</a>
      </aside>
    </section>

    <section id="lifecycle" class="stats-v4-section">
      <div class="stats-v4-section-heading">
        <div><p class="stats-kicker">Lifecycle</p><h2>Where the registry stands now</h2></div>
        <p>Operating, constrained, historical non-failure, and failed records remain separate so closure is not confused with collapse.</p>
      </div>
      <div class="stats-v4-lifecycle-grid">
        {lifecycleGroups.map((row) => (
          <article class="stats-v4-lifecycle-card">
            <div><span>{row.label}</span><strong>{row.count}</strong></div>
            <meter min="0" max="100" value={Math.min(100, Math.max(0, row.percentage))} aria-label={`${row.label}: ${row.percentage}%`}></meter>
            <p>{row.percentage}% of canonical assets</p>
          </article>
        ))}
      </div>
      <div class="stats-v4-ledger" aria-label="Canonical lifecycle statuses">
        {lifecycleStatuses.map((row) => (
          <div class="stats-v4-ledger-row">
            <strong>{row.label}</strong>
            <span>{row.count} records</span>
            <span>{row.percentage}%</span>
          </div>
        ))}
      </div>
    </section>

    <section id="composition" class="stats-v4-section">
      <div class="stats-v4-section-heading">
        <div><p class="stats-kicker">Composition</p><h2>What kinds of assets are recorded</h2></div>
        <p>Each panel is a separate classification dimension. Long tails are combined into “Other recorded values” instead of being dumped into an unreadable wall.</p>
      </div>
      <div class="stats-v4-panel-grid">
        {compositionPanels.map((panel) => (
          <section class="stats-v4-panel">
            <h3>{panel.title}</h3>
            <div class="stats-v4-bar-list">
              {panel.rows.map((row) => (
                <div class="stats-v4-bar-row">
                  <div><span>{row.label}</span><strong>{row.count}</strong></div>
                  <meter min="0" max="100" value={Math.min(100, Math.max(0, row.percentage))} aria-label={`${row.label}: ${row.percentage}%`}></meter>
                  <small>{row.percentage}%</small>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section id="activity" class="stats-v4-section">
      <div class="stats-v4-section-heading">
        <div><p class="stats-kicker">Historical activity</p><h2>Events and failure patterns</h2></div>
        <p>The page shows the recent historical shape and leading categories rather than hundreds of individual event rows.</p>
      </div>
      <div class="stats-v4-split">
        <section class="stats-v4-panel">
          <h3>Events by year</h3>
          <div class="stats-v4-year-list">
            {recentEventYears.map((row) => (
              <div class="stats-v4-year-row">
                <span>{row.year}</span>
                <meter min="0" max="100" value={(row.total / maxEventYear) * 100} aria-label={`${row.year}: ${row.total} events`}></meter>
                <strong>{row.total}</strong>
              </div>
            ))}
          </div>
        </section>
        <section class="stats-v4-panel">
          <h3>Leading event types</h3>
          <div class="stats-v4-bar-list">
            {eventTypes.map((row) => (
              <div class="stats-v4-bar-row">
                <div><span>{row.label}</span><strong>{row.count}</strong></div>
                <meter min="0" max="100" value={Math.min(100, Math.max(0, row.percentage))} aria-label={`${row.label}: ${row.percentage}%`}></meter>
                <small>{row.percentage}%</small>
              </div>
            ))}
          </div>
        </section>
      </div>

      <div class="stats-v4-section-heading">
        <div><p class="stats-kicker">Recorded event lifecycle</p><h3>What happened after stress or policy change</h3></div>
        <p>These counts summarize reviewed canonical event records only. Missing event coverage means “not recorded in the canonical registry”, not proof that an event never occurred.</p>
      </div>
      <dl class="stats-v4-mini-kpis">
        {lifecycleCoveragePanels.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.eventCount}</dd>
            <small>{item.assetCount} / {item.assetDenominator} assets · {item.assetPercentage}%</small>
          </div>
        ))}
      </dl>
      <div class="stats-v4-split">
        <section class="stats-v4-panel">
          <h3>Depeg recovery status</h3>
          <div class="stats-v4-bar-list">
            {depegRecoveryRows.map((row) => (
              <div class="stats-v4-bar-row">
                <div><span>{row.label}</span><strong>{row.count}</strong></div>
                <meter min="0" max="100" value={Math.min(100, Math.max(0, row.percentage))} aria-label={`${row.label}: ${row.percentage}%`}></meter>
                <small>{row.percentage}%</small>
              </div>
            ))}
          </div>
          <p>{depegRecoveryCoverage.count ?? 0} / {depegRecoveryCoverage.denominator ?? 0} recorded depeg events have an explicit recovery-state value ({depegRecoveryCoverage.percentage ?? 0}%).</p>
        </section>
        <section class="stats-v4-panel">
          <h3>Typed lifecycle-event kinds</h3>
          <div class="stats-v4-bar-list">
            {typedLifecycleRows.map((row) => (
              <div class="stats-v4-bar-row">
                <div><span>{row.label}</span><strong>{row.count}</strong></div>
                <meter min="0" max="100" value={Math.min(100, Math.max(0, row.percentage))} aria-label={`${row.label}: ${row.percentage}%`}></meter>
                <small>{row.percentage}%</small>
              </div>
            ))}
          </div>
        </section>
      </div>

      <div class="stats-v4-failure-summary">
        <div class="stats-v4-failure-count"><span>Canonical failed assets</span><strong>{stats.failures?.count ?? 0}</strong></div>
        {failurePanels.map((item) => (
          <div><span>{item.label}</span><strong>{item.row.label}</strong><small>{item.row.count} records · {item.row.percentage}%</small></div>
        ))}
      </div>
    </section>

    <section id="network" class="stats-v4-section">
      <div class="stats-v4-section-heading">
        <div><p class="stats-kicker">Network and institutions</p><h2>Where assets are deployed and who supports them</h2></div>
        <p>Chain rows count deployments; organization rows count recorded relationships. Neither is a market-share measure.</p>
      </div>
      <dl class="stats-v4-mini-kpis">
        <div><dt>Total deployments</dt><dd>{stats.deployments?.total_deployments ?? 0}</dd></div>
        <div><dt>Assets with deployments</dt><dd>{stats.deployments?.assets_with_deployments ?? 0}</dd></div>
        <div><dt>Freeze capability known</dt><dd>{stats.deployments?.control_capability_knowledge?.freeze_capability_known ?? 0}</dd></div>
        <div><dt>Blacklist capability known</dt><dd>{stats.deployments?.control_capability_knowledge?.blacklist_capability_known ?? 0}</dd></div>
      </dl>
      <div class="stats-v4-split">
        <section class="stats-v4-panel">
          <h3>Top deployment chains</h3>
          <div class="stats-v4-chain-list">
            {topDeploymentChains.map((row) => (
              <div class="stats-v4-chain-row">
                <div><strong>{row.chain}</strong><span>{row.assets} assets</span></div>
                <meter min="0" max="100" value={(row.deployments / maxDeployments) * 100} aria-label={`${row.chain}: ${row.deployments} deployments`}></meter>
                <strong>{row.deployments}</strong>
              </div>
            ))}
          </div>
        </section>
        <section class="stats-v4-panel">
          <h3>Leading organization roles</h3>
          <div class="stats-v4-role-list">
            {organizationRoles.map((row) => (
              <div class="stats-v4-role-row">
                <strong>{row.role}</strong>
                <span>{row.relationships} relationships</span>
                <small>{row.organizations} organizations · {row.assets} assets</small>
              </div>
            ))}
          </div>
        </section>
      </div>
    </section>

    <section id="quality" class="stats-v4-section">
      <div class="stats-v4-section-heading">
        <div><p class="stats-kicker">Data quality</p><h2>Coverage, evidence depth, and freshness</h2></div>
        <p>These figures measure registry completeness and review recency. They do not rate the safety or transparency of an asset.</p>
      </div>
      <div class="stats-v4-quality-grid">
        <section class="stats-v4-panel stats-v4-panel--wide">
          <h3>Coverage</h3>
          <div class="stats-v4-coverage-list">
            {coverageRows.map((row) => (
              <div class="stats-v4-coverage-row">
                <div><strong>{row.label}</strong><span>{row.count} / {row.denominator}</span></div>
                <meter min="0" max="100" value={Math.min(100, Math.max(0, row.percentage))} aria-label={`${row.label}: ${row.percentage}%`}></meter>
                <span>{row.percentage}%</span>
              </div>
            ))}
          </div>
        </section>
        <section class="stats-v4-panel">
          <h3>Evidence profile</h3>
          <dl class="stats-v4-metric-list">
            <div><dt>Average evidence per asset</dt><dd>{stats.data_quality?.evidence_per_asset?.average ?? 0}</dd></div>
            <div><dt>Median evidence per asset</dt><dd>{stats.data_quality?.evidence_per_asset?.median ?? 0}</dd></div>
            <div><dt>Known unknowns</dt><dd>{stats.data_quality?.known_unknowns?.total ?? 0}</dd></div>
            <div><dt>Typed event coverage</dt><dd>{typedEventCoverage.count ?? 0} / {typedEventCoverage.denominator ?? 0}</dd></div>
          </dl>
        </section>
        <section class="stats-v4-panel">
          <h3>Evidence depth</h3>
          <dl class="stats-v4-metric-list">{evidenceDepth.map((row) => <div><dt>{row.label}</dt><dd>{row.count}</dd></div>)}</dl>
        </section>
        <section class="stats-v4-panel">
          <h3>Verification recency</h3>
          <dl class="stats-v4-metric-list">{recency.map((row) => <div><dt>{row.label}</dt><dd>{row.count}</dd></div>)}</dl>
        </section>
      </div>
    </section>

    <section id="growth" class="stats-v4-section">
      <div class="stats-v4-section-heading">
        <div><p class="stats-kicker">Growth</p><h2>How the reviewed corpus changed</h2></div>
        <p>Repeated checkpoints with identical totals are removed here. The remaining rows show material inventory changes, not market performance.</p>
      </div>
      <dl class="stats-v4-growth-kpis">
        <div><dt>Assets added</dt><dd>+{growth.assets}</dd></div>
        <div><dt>Events added</dt><dd>+{growth.events}</dd></div>
        <div><dt>Evidence added</dt><dd>+{growth.evidence}</dd></div>
      </dl>
      <div class="stats-v4-growth-list">
        {recentSnapshots.map((snapshot: any) => (
          <article class="stats-v4-growth-row">
            <time datetime={snapshot.recorded_at}>{String(snapshot.recorded_at ?? '').slice(0, 10)}</time>
            <div><span>Assets</span><strong>{snapshot.asset_count ?? 0}</strong></div>
            <div><span>Events</span><strong>{snapshot.totals?.events ?? 0}</strong></div>
            <div><span>Evidence</span><strong>{snapshot.totals?.evidence ?? 0}</strong></div>
          </article>
        ))}
      </div>
    </section>

    <aside class="stats-v4-data-access">
      <div>
        <p class="stats-kicker">Full public data</p>
        <h2>Use the registry, not a hidden wall of tables</h2>
        <p>The complete reviewed record set remains public through the manifest and machine-readable endpoints. This page is the analytical view; it no longer pretends that an exhaustive dump is a usable interface.</p>
      </div>
      <nav aria-label="Statistics data access">
        <a href="/data/manifest.json">Data manifest</a>
        <a href="/version.json">Version JSON</a>
        <a href="/llms.txt">LLM guide</a>
        <a href="/methodology/">Methodology</a>
      </nav>
    </aside>
  </article>
</BaseLayout>
