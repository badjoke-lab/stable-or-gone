---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  guides,
  guideCategoryDescriptions,
  guideCategoryLabels,
  type GuideCategory
} from '../../data/guideCatalog';

const visibleGuides = guides;
const categoryOrder: GuideCategory[] = ['regulation', 'asset-comparisons', 'core-concepts'];
const visibleCategories = categoryOrder
  .map((category) => ({ category, entries: visibleGuides.filter((guide) => guide.category === category) }))
  .filter((group) => group.entries.length > 0);

const title = 'Guides — Stable or Gone';
const description = 'Beginner-friendly guides to stablecoin regulation, asset structures, depegs, reserves, redemption, lifecycle events, and the records behind each claim.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: 'https://sog.badjoke-lab.com/guides/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  hasPart: visibleGuides.map((guide) => ({
    '@type': 'Article',
    name: guide.title,
    url: `https://sog.badjoke-lab.com/guides/${guide.slug}/`,
    ...(guide.publishedAt ? { datePublished: guide.publishedAt } : {})
  }))
};
---
<BaseLayout title={title} description={description} canonicalPath="/guides/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">Stablecoin guides and explainers</div>
      <h1>Understand stablecoins and the rules around them</h1>
      <p>These guides explain regulation, legal and reserve structures, redemption, lifecycle events, and the distinctions used throughout the archive.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Guides</span><strong>{visibleGuides.length}</strong></div>
      <div class="stat"><span>Sections</span><strong>{visibleCategories.length}</strong></div>
    </div>
  </section>

  {visibleCategories.map(({ category, entries }) => (
    <section aria-labelledby={`guide-category-${category}`}>
      <div class="panel registry">
        <div class="bar" id={`guide-category-${category}`}>{guideCategoryLabels[category]}</div>
        <p>{guideCategoryDescriptions[category]}</p>
      </div>
      <div class="section-grid">
        {entries.map((guide) => (
          <a class="panel mini-card" href={`/guides/${guide.slug}/`}>
            <h2>{guide.title}</h2>
            <p>{guide.summary}</p>
            <p><small>Information current through {guide.informationCurrentThrough}</small></p>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="panel registry">
    <div class="bar">How to read a Stable or Gone record</div>
    <table><tbody>
      <tr><th>Stablecoin page</th><td>Start with lifecycle status, issuance status, peg reference, backing types, organization roles, reserve profile, redemption profile, event timeline, and sources.</td></tr>
      <tr><th>Event page</th><td>Use event pages for dated changes such as depegs, regulatory actions, reserve changes, redemption changes, migrations, wind-downs, and collapses.</td></tr>
      <tr><th>Evidence scope</th><td>Sources are scoped to the specific stablecoin, organization, event, and claim they support. A source does not automatically support every field on a page.</td></tr>
      <tr><th>Open questions</th><td>When public information is incomplete, the archive records the gap instead of guessing.</td></tr>
    </tbody></table>
  </section>

  <section class="panel registry">
    <div class="bar">More reference pages</div>
    <table><tbody>
      <tr><th>Glossary</th><td><a href="/glossary/">Definitions of common terms used across the archive</a></td></tr>
      <tr><th>Methodology</th><td><a href="/methodology/">How records, events, relationships, and status labels are reviewed</a></td></tr>
      <tr><th>Stablecoins</th><td><a href="/stablecoins/">Browse all stablecoin records</a></td></tr>
    </tbody></table>
  </section>
</BaseLayout>
