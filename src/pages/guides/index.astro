---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/guide-index.css';
import {
  guides,
  guideCategoryDescriptions,
  guideCategoryLabels,
  type GuideCategory
} from '../../data/guideCatalog';

const visibleGuides = guides;
const categoryOrder: GuideCategory[] = ['regulation', 'asset-comparisons', 'core-concepts'];
const visibleCategories = categoryOrder
  .map((category) => ({ category, entries: visibleGuides.filter((guide) => guide.category === category) }))
  .filter((group) => group.entries.length > 0);
const datedGuides = visibleGuides.filter((guide) => Boolean(guide.publishedAt));
const featuredGuide = [...datedGuides]
  .filter((guide) => guide.featured)
  .sort((a, b) => String(b.publishedAt).localeCompare(String(a.publishedAt)) || a.title.localeCompare(b.title))[0] ?? datedGuides[0];

const title = 'Guides — Stable or Gone';
const description = 'Beginner-friendly guides to stablecoin regulation, asset structures, depegs, reserves, redemption, lifecycle events, and the records behind each claim.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: 'https://sog.badjoke-lab.com/guides/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  hasPart: visibleGuides.map((guide) => ({
    '@type': 'Article',
    name: guide.title,
    url: `https://sog.badjoke-lab.com/guides/${guide.slug}/`,
    ...(guide.publishedAt ? { datePublished: guide.publishedAt } : {})
  }))
};
---
<BaseLayout title={title} description={description} canonicalPath="/guides/" jsonLd={jsonLd}>
  <article class="guide-index-page" data-ui-v3-guides-index>
    <header class="guide-index-masthead">
      <div class="guide-index-overline"><span>Editorial guides</span><span>Stablecoin regulation, structure, and history</span></div>
      <div class="guide-index-heading">
        <h1>Guides</h1>
        <p>Source-backed explanations for reading stablecoin laws, reserve structures, redemption systems, lifecycle changes, and the records behind each claim.</p>
      </div>
      <dl class="guide-index-summary" aria-label="Guide collection summary">
        <div><dt>Public guides</dt><dd>{visibleGuides.length}</dd></div>
        <div><dt>Dated articles</dt><dd>{datedGuides.length}</dd></div>
        <div><dt>Sections</dt><dd>{visibleCategories.length}</dd></div>
      </dl>
    </header>

    <nav class="guide-index-nav" aria-label="Guide categories">
      {visibleCategories.map(({ category }) => <a href={`#guide-category-${category}`}>{guideCategoryLabels[category]}</a>)}
    </nav>

    {featuredGuide && (
      <section class="guide-index-feature" aria-labelledby="featured-guide-title">
        <div>
          <p>Latest featured guide</p>
          <h2 id="featured-guide-title"><a href={`/guides/${featuredGuide.slug}/`}>{featuredGuide.title}</a></h2>
        </div>
        <div>
          <p>{featuredGuide.summary}</p>
          <small>{featuredGuide.regionLabel ?? guideCategoryLabels[featuredGuide.category]} · information current through {featuredGuide.informationCurrentThrough}</small>
          <a href={`/guides/${featuredGuide.slug}/`}>Read the guide</a>
        </div>
      </section>
    )}

    {visibleCategories.map(({ category, entries }) => (
      <section class="guide-category" id={`guide-category-${category}`} aria-labelledby={`guide-category-title-${category}`}>
        <div class="guide-category-heading">
          <h2 id={`guide-category-title-${category}`}>{guideCategoryLabels[category]}</h2>
          <p>{guideCategoryDescriptions[category]}</p>
        </div>
        <div class="guide-index-list">
          {entries.map((guide) => (
            <article class="guide-index-entry">
              <div class="guide-index-entry-meta">
                <span>{guide.regionLabel ?? guideCategoryLabels[guide.category]}</span>
                <time datetime={guide.publishedAt ?? undefined}>{guide.publishedAt ?? 'Evergreen'}</time>
              </div>
              <div class="guide-index-entry-copy">
                <h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3>
                <p>{guide.summary}</p>
              </div>
              <div class="guide-index-entry-action">
                <a href={`/guides/${guide.slug}/`}>Open guide</a>
                <small>Current through {guide.informationCurrentThrough}</small>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="guide-index-reference" aria-labelledby="guide-reference-title">
      <div><h2 id="guide-reference-title">Read the archive with the guides</h2></div>
      <div>
        <p>Guide articles explain concepts and regulatory transitions. Canonical stablecoin, organization, event, and evidence records remain the source-backed registry layer.</p>
        <nav aria-label="Related reference pages">
          <a href="/stablecoins/">Browse stablecoin records</a>
          <a href="/glossary/">Open the glossary</a>
          <a href="/methodology/">Read the methodology</a>
        </nav>
      </div>
    </section>
  </article>
</BaseLayout>
