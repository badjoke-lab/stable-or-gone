---
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = [
  {
    title: 'What Is a Depeg?',
    href: '/guides/what-is-a-depeg/',
    summary: 'Learn what counts as a depeg, how recoveries are recorded, and when a depeg becomes part of a larger collapse.'
  },
  {
    title: 'Status and Event Records',
    href: '/guides/status-vs-event/',
    summary: 'See why a stablecoin can remain active after an incident, and how status labels differ from dated events.'
  },
  {
    title: 'Reading Reserve Disclosures',
    href: '/guides/reserve-disclosure-basics/',
    summary: 'Understand issuer reports, attestations, audits, protocol collateral data, and gaps in public reporting.'
  },
  {
    title: 'Stablecoin Lifecycle Terms',
    href: '/guides/stablecoin-lifecycle-terms/',
    summary: 'A guide to launches, migrations, rebrands, wind-downs, failures, and post-collapse trading.'
  }
];
---
<BaseLayout title="Guides — Stable or Gone" description="Guides to stablecoin depegs, status labels, reserve disclosures, and lifecycle changes.">
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">Stablecoin reference guides</div>
      <h1>Understand the records</h1>
      <p>These guides explain the terms and distinctions used throughout the archive, with examples from existing stablecoin records.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Guides</span><strong>{guides.length}</strong></div>
      <div class="stat"><span>Topics</span><strong>4</strong></div>
    </div>
  </section>

  <section class="section-grid">
    {guides.map((guide) => (
      <a class="panel mini-card" href={guide.href}>
        <h2>{guide.title}</h2>
        <p>{guide.summary}</p>
      </a>
    ))}
  </section>

  <section class="panel registry">
    <div class="bar">More reference pages</div>
    <table><tbody>
      <tr><th>Glossary</th><td><a href="/glossary/">Definitions of common terms used across the archive</a></td></tr>
      <tr><th>Methodology</th><td><a href="/methodology/">How records, events, and status labels are reviewed</a></td></tr>
      <tr><th>Stablecoins</th><td><a href="/stablecoins/">Browse all stablecoin records</a></td></tr>
    </tbody></table>
  </section>
</BaseLayout>