---
import EventEditorialRecordV3 from '../../components/EventEditorialRecordV3.astro';
import { getEvents } from '../../lib/data/registry';

export function getStaticPaths() {
  return getEvents().map((event) => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props;
---
<EventEditorialRecordV3 event={event} />
