---
import EventEditorialRecord from '../../components/EventEditorialRecord.astro';
import { getEvents } from '../../lib/data/registry';

export function getStaticPaths() {
  return getEvents().map((event) => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props;
---
<EventEditorialRecord event={event} />
