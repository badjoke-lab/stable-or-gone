---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredEventDetail from '../../components/StructuredEventDetail.astro';
import EvidenceSourceTable from '../../components/EvidenceSourceTable.astro';
import { formatPublicLabel } from '../../utils/displayLabels';
import { cleanPublicText } from '../../utils/publicText';
import { eventPublicCopy } from '../../data/eventPublicCopy';
import { resolveEventTaxonomy } from '../../utils/eventTaxonomy';
import { getEvents, getStablecoins, getOrganizations, getEvidence } from '../../lib/data/registry';

export function getStaticPaths() {
  return getEvents().map((event) => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props;
const structuredEvent = event as typeof event & Record<string, any>;
const allStablecoins = getStablecoins();
const allOrganizations = getOrganizations();
const allEvidence = getEvidence();
const subjectStablecoins = (event.subject_stablecoin_ids?.length ? event.subject_stablecoin_ids : event.stablecoin_id ? [event.stablecoin_id] : []).map((id) => allStablecoins.find((item) => item.id === id) ?? { id, name: id, slug: '' });
const subjectOrganizations = (event.subject_organization_ids?.length ? event.subject_organization_ids : event.issuer_id ? [event.issuer_id] : []).map((id) => allOrganizations.find((item) => item.id === id) ?? { id, name: id, slug: '' });
const evidence = allEvidence.filter((source) => source.event_ids?.includes(event.id) || source.event_id === event.id);
const publicCopy = eventPublicCopy[event.id];
const eventTitle = publicCopy?.title ?? event.title;
const eventDescription = publicCopy?.description ?? event.description ?? 'A description has not yet been added for this event.';
const taxonomy = resolveEventTaxonomy(event);
const title = `${eventTitle} — Stablecoin Event | Stable or Gone`;
const description = eventDescription;
const detailFamilies = [
  'depeg_detail', 'regulatory_detail', 'reserve_change_detail', 'redemption_change_detail',
  'migration_detail', 'issuer_control_detail', 'security_incident_detail', 'oracle_failure_detail',
  'collateral_impairment_detail', 'insolvency_detail', 'governance_change_detail',
  'bridge_or_chain_incident_detail', 'termination_detail', 'launch_detail'
];
const hasStructuredDetail = detailFamilies.some((field) => structuredEvent[field] && typeof structuredEvent[field] === 'object');
const detailSummary = detailFamilies
  .map((field) => structuredEvent[field]?.cause_summary ?? structuredEvent[field]?.summary)
  .find((value) => typeof value === 'string' && value.length > 0);
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: eventTitle, url: `https://sog.badjoke-lab.com/event/${event.id}/`, description, datePublished: event.event_date, isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' }, about: [...subjectStablecoins.map((item) => item.name), ...subjectOrganizations.map((item) => item.name), taxonomy.public_category_label, taxonomy.canonical_subtype_label, 'stablecoin event'].filter(Boolean) };
---
<BaseLayout title={title} description={description} canonicalPath={`/event/${event.id}/`} jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main"><div class="prompt">Stablecoin event</div><h1>{eventTitle}</h1><p>{eventDescription}</p></div>
    <div class="panel stats"><div class="stat"><span>Category</span><strong>{taxonomy.public_category_label}</strong></div><div class="stat"><span>Impact</span><strong>{formatPublicLabel(event.impact_level)}</strong></div><div class="stat"><span>Sources</span><strong>{evidence.length}</strong></div></div>
  </section>

  <section class="section-grid" aria-label="Related pages">
    {subjectStablecoins.map((item) => item.slug ? <a class="panel mini-card" href={`/stablecoin/${item.slug}/`}><h2>{item.name}</h2><p>Open the stablecoin record connected to this event.</p></a> : <div class="panel mini-card"><h2>{item.name}</h2><p>Stablecoin subject record is not linked yet.</p></div>)}
    {subjectOrganizations.map((item) => item.slug ? <a class="panel mini-card" href={`/issuer/${item.slug}/`}><h2>{item.name}</h2><p>View the issuer, protocol, or organization connected to this event.</p></a> : <div class="panel mini-card"><h2>{item.name}</h2><p>Organization subject record is not linked yet.</p></div>)}
    <a class="panel mini-card" href="/events/"><h2>All events</h2><p>Browse the complete stablecoin event history.</p></a>
  </section>

  <section class="panel registry"><div class="bar">Event details</div><table data-table-kind="event-details" data-mobile-table="scroll-preserve"><tbody>
    <tr><th>Date</th><td>{event.event_date ?? '—'}</td></tr>
    <tr><th>Public event category</th><td>{taxonomy.public_category_label}</td></tr>
    <tr><th>Canonical event subtype</th><td>{taxonomy.canonical_subtype_label}</td></tr>
    <tr><th>Structured detail kind</th><td>{taxonomy.detail_kind_label}</td></tr>
    <tr><th>Stablecoin subjects</th><td>{subjectStablecoins.map((item) => item.slug ? <a href={`/stablecoin/${item.slug}/`}>{item.name}</a> : item.name).reduce((acc, item, index) => index === 0 ? [item] : [...acc, ', ', item], [])}</td></tr>
    <tr><th>Organization subjects</th><td>{subjectOrganizations.map((item) => item.slug ? <a href={`/issuer/${item.slug}/`}>{item.name}</a> : item.name).reduce((acc, item, index) => index === 0 ? [item] : [...acc, ', ', item], [])}</td></tr>
    <tr><th>Impact</th><td>{formatPublicLabel(event.impact_level)}</td></tr>
    <tr><th>Effect on stablecoin lifecycle</th><td>{taxonomy.status_effect_label}</td></tr>
    <tr><th>Canonical status-effect value</th><td>{formatPublicLabel(taxonomy.canonical_status_effect)}</td></tr>
    <tr><th>Recovery or reversal</th><td>{taxonomy.recovery_label}</td></tr>
    <tr><th>Recovery date</th><td>{event.depeg_detail?.recovery_date ?? event.recovery_date ?? '—'}</td></tr>
    <tr><th>Cause or mechanism</th><td>{cleanPublicText(detailSummary ?? event.failure_mechanism, 'Public information is incomplete.')}</td></tr>
    <tr><th>Structured detail coverage</th><td>{hasStructuredDetail ? 'Structured fields available below' : 'Description and source record only'}</td></tr>
    <tr><th>Record confidence</th><td>{formatPublicLabel(event.confidence)}</td></tr>
  </tbody></table></section>

  <!-- Structured event detail is rendered by the shared component for every supported detail family. -->
  <StructuredEventDetail event={structuredEvent} />

  <section class="panel registry"><div class="bar">Sources</div><EvidenceSourceTable evidence={evidence} tableKind="event-sources" emptyMessage="No event-specific sources have been added yet." /></section>

  <section class="panel report-box"><h2>Suggest a correction</h2><p>Report an incorrect date, outcome, description, or source, or suggest a missing event.</p><div class="report-actions"><a data-primary="true" href="https://github.com/badjoke-lab/stable-or-gone/issues/new/choose">Start a report</a><a href="/contact/">Submission guide</a></div></section>
</BaseLayout>
