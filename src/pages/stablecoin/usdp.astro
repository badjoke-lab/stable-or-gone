---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExtraRecordTables from '../../components/ExtraRecordTables.astro';
import stablecoinsExtraData from '../../../data/stablecoins-extra.json';
const coin = (stablecoinsExtraData as any[]).find((item) => item.slug === 'usdp');
const title = 'Pax Dollar (USDP) stablecoin record — Stable or Gone';
const description = 'Pax Dollar / USDP stablecoin record in Stable or Gone.';
---
<BaseLayout title={title} description={description} canonicalPath="/stablecoin/usdp/">
  <section class="hero"><div class="panel hero-main"><div class="prompt">&gt; open stablecoin/usdp</div><h1>{coin.name}</h1><p>{coin.summary}</p></div><div class="panel stats"><div class="stat"><span>Status</span><strong>{coin.status}</strong></div><div class="stat"><span>Symbol</span><strong>{coin.symbol}</strong></div></div></section>
  <section class="panel registry"><div class="bar">record facts</div><table><tbody><tr><th>Issuer</th><td>Paxos</td></tr><tr><th>Peg asset</th><td>{coin.peg_asset}</td></tr><tr><th>Collateral model</th><td>{coin.collateral_model}</td></tr><tr><th>Reserve disclosure</th><td>{coin.reserve_disclosure_status}</td></tr><tr><th>Redemption status</th><td>{coin.redemption_status}</td></tr><tr><th>Last verified</th><td>{coin.last_verified_at}</td></tr></tbody></table></section>
  <section class="section-grid"><a class="panel mini-card" href="/stablecoins/"><h2>Stablecoin registry</h2><p>Return to all records.</p></a><a class="panel mini-card" href="/issuer/paxos/"><h2>Paxos issuer file</h2><p>Open the linked issuer page.</p></a><a class="panel mini-card" href="/guides/status-vs-event/"><h2>Status guide</h2><p>Read the status guide.</p></a></section>
  <ExtraRecordTables stablecoinId={coin.id} />
</BaseLayout>
