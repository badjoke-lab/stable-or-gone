---
import StablecoinDetailView from '../../components/StablecoinDetailView.astro';
import { getStablecoins } from '../../lib/data/registry';

export function getStaticPaths() {
  return getStablecoins().map((coin) => ({ params: { slug: coin.slug }, props: { coin } }));
}

const { coin } = Astro.props;
---
<StablecoinDetailView coin={coin} />