---
import StablecoinDetailView from '../../components/StablecoinDetailView.astro';
import stablecoinsData from '../../../data/stablecoins.json';
import stablecoinsExtraData from '../../../data/stablecoins-extra.json';
import stablecoinOverridesPr033Data from '../../../data/stablecoin-overrides-pr033.json';

type StablecoinRow = { id: string; slug: string; name: string; summary?: string; symbol?: string; status?: string; peg_asset?: string; collateral_model?: string; issuer_id?: string; reserve_disclosure_status?: string; redemption_status?: string; who_can_redeem?: string; retail_redemption?: string; institutional_redemption?: string; minimum_redemption?: string; redemption_region_notes?: string; redemption_notes?: string; launch_date?: string; discontinued_date?: string | null; confidence?: string; last_verified_at?: string; notes?: string; };

type StablecoinOverride = Partial<StablecoinRow> & { id: string };

const overridesById = new Map((stablecoinOverridesPr033Data as StablecoinOverride[]).map((row) => [row.id, row]));
const applyOverride = (coin: StablecoinRow): StablecoinRow => ({ ...coin, ...(overridesById.get(coin.id) ?? {}) });

export function getStaticPaths() {
  const records = [...(stablecoinsData as StablecoinRow[]), ...(stablecoinsExtraData as StablecoinRow[])].map(applyOverride);
  return records.map((coin) => ({ params: { slug: coin.slug }, props: { coin } }));
}

const { coin } = Astro.props as { coin: StablecoinRow };
---
<StablecoinDetailView coin={coin} />
