---
import BaseLayout from '../../layouts/BaseLayout.astro';
import eventsData from '../../../data/events.json';
import eventsPr036Data from '../../../data/events-pr036.json';
import eventsPr037Data from '../../../data/events-pr037.json';
import eventsPr038Data from '../../../data/events-pr038.json';
import stablecoinsData from '../../../data/stablecoins.json';
import stablecoinsExtraData from '../../../data/stablecoins-extra.json';

type EventRow = {
  id: string;
  stablecoin_id?: string;
  title: string;
  event_date?: string | null;
  event_type?: string;
  impact_level?: string;
  recovered?: boolean | null;
  source_count?: number;
};

type StablecoinRow = {
  id: string;
  name: string;
  symbol?: string;
};

const events = [...(eventsData as EventRow[]), ...(eventsPr036Data as EventRow[]), ...(eventsPr037Data as EventRow[]), ...(eventsPr038Data as EventRow[])];
const stablecoins = [...(stablecoinsData as StablecoinRow[]), ...(stablecoinsExtraData as StablecoinRow[])];
const stablecoinById = new Map(stablecoins.map((coin) => [coin.id, coin] as const));
const uniqueSorted = (values: Array<string | undefined>) => Array.from(new Set(values.filter(Boolean) as string[])).sort((a, b) => a.localeCompare(b));
const typeOptions = uniqueSorted(events.map((event) => event.event_type));
const impactOptions = uniqueSorted(events.map((event) => event.impact_level));
const coveredStablecoins = new Set(events.map((event) => event.stablecoin_id).filter(Boolean)).size;
const title = 'Stablecoin Event Log — Stable or Gone';
const description = 'Browse and filter stablecoin depeg events, wind-downs, collapses, launches, protocol transitions, regulatory context, recovery status, and source-backed event records.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: 'https://sog.badjoke-lab.com/events/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  about: ['stablecoin depeg events', 'stablecoin collapse', 'stablecoin lifecycle events', 'stablecoin regulatory context']
};
---
<BaseLayout title={title} description={description} canonicalPath="/events/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">&gt; query /events --all</div>
      <h1>Event Log</h1>
      <p>Search depegs, launches, reserve and redemption changes, wind-downs, migrations, protocol transitions, regulatory actions, and recovery context.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Events</span><strong>{events.length}</strong></div>
      <div class="stat"><span>Stablecoins</span><strong>{coveredStablecoins}</strong></div>
    </div>
  </section>

  <section class="section-grid" aria-label="Event guide links">
    <a class="panel mini-card" href="/guides/what-is-a-depeg/"><h2>What is a depeg?</h2><p>How SOG separates recovered depegs, major depegs, and collapse outcomes.</p></a>
    <a class="panel mini-card" href="/guides/status-vs-event/"><h2>Status vs event</h2><p>Why an event record is not always the same thing as failed status.</p></a>
    <a class="panel mini-card" href="/stablecoins/"><h2>Stablecoin registry</h2><p>Open the entity records linked to these event records.</p></a>
  </section>

  <section class="panel registry" data-event-registry>
    <div class="bar">source: reviewed event records across the SOG data set</div>
    <div class="registry-controls" aria-label="Event filters">
      <label><span>Search</span><input data-event-search type="search" placeholder="USDC, collapse, launch..." autocomplete="off" /></label>
      <label><span>Type</span><select data-event-type><option value="">All types</option>{typeOptions.map((type) => <option value={type}>{type}</option>)}</select></label>
      <label><span>Impact</span><select data-event-impact><option value="">All impact levels</option>{impactOptions.map((impact) => <option value={impact}>{impact}</option>)}</select></label>
      <label><span>Recovery</span><select data-event-recovery><option value="">All recovery states</option><option value="yes">Recovered</option><option value="no">Not recovered</option><option value="unknown">Not applicable / unknown</option></select></label>
      <label><span>Sort</span><select data-event-sort><option value="date_desc">Newest first</option><option value="date_asc">Oldest first</option><option value="impact">Impact</option><option value="title">Event A-Z</option></select></label>
    </div>
    <div class="registry-summary" aria-live="polite"><span data-event-result-count>{events.length}</span> / {events.length} events shown</div>
    <table>
      <thead><tr><th>Date</th><th>Stablecoin</th><th>Event</th><th>Type</th><th>Impact</th><th>Recovered</th><th>Sources</th></tr></thead>
      <tbody data-event-body>
        {events.length === 0 ? (
          <tr><td colspan="7">No event records yet.</td></tr>
        ) : events.map((event) => {
          const stablecoin = stablecoinById.get(event.stablecoin_id ?? '');
          const stablecoinLabel = stablecoin ? `${stablecoin.name}${stablecoin.symbol ? ` (${stablecoin.symbol})` : ''}` : (event.stablecoin_id ?? '—');
          const recovery = event.recovered === true ? 'yes' : event.recovered === false ? 'no' : 'unknown';
          const searchable = [stablecoinLabel, event.title, event.event_type, event.impact_level, recovery].filter(Boolean).join(' ').toLowerCase();
          return (
            <tr data-event-row data-search={searchable} data-title={event.title.toLowerCase()} data-date={event.event_date ?? ''} data-type={event.event_type ?? ''} data-impact={event.impact_level ?? ''} data-recovery={recovery}>
              <td>{event.event_date ?? '—'}</td>
              <td>{stablecoinLabel}</td>
              <td><a href={`/event/${event.id}/`}>{event.title}</a></td>
              <td>{event.event_type ?? '—'}</td>
              <td>{event.impact_level ?? '—'}</td>
              <td>{recovery === 'yes' ? 'yes' : recovery === 'no' ? 'no' : '—'}</td>
              <td>{event.source_count ?? 0}</td>
            </tr>
          );
        })}
        <tr data-event-no-results hidden><td colspan="7">No event records match the current filters.</td></tr>
      </tbody>
    </table>
  </section>

  <script>
    const registry = document.querySelector('[data-event-registry]');
    const tbody = registry?.querySelector('[data-event-body]');
    const rows = Array.from(registry?.querySelectorAll('[data-event-row]') ?? []);
    const noResults = registry?.querySelector('[data-event-no-results]');
    const resultCount = registry?.querySelector('[data-event-result-count]');
    const controls = {
      search: registry?.querySelector('[data-event-search]'),
      type: registry?.querySelector('[data-event-type]'),
      impact: registry?.querySelector('[data-event-impact]'),
      recovery: registry?.querySelector('[data-event-recovery]'),
      sort: registry?.querySelector('[data-event-sort]')
    };
    const normalize = (value: unknown) => String(value ?? '').trim().toLowerCase();
    const getValue = (control: Element | null | undefined) => control instanceof HTMLInputElement || control instanceof HTMLSelectElement ? control.value : '';
    const impactRank: Record<string, number> = { critical: 0, high: 1, medium: 2, low: 3 };
    function sortRows() {
      if (!tbody) return;
      const mode = getValue(controls.sort) || 'date_desc';
      const sorted = [...rows].sort((a, b) => {
        if (!(a instanceof HTMLElement) || !(b instanceof HTMLElement)) return 0;
        if (mode === 'date_asc') return String(a.dataset.date ?? '').localeCompare(String(b.dataset.date ?? ''));
        if (mode === 'impact') return (impactRank[a.dataset.impact ?? ''] ?? 99) - (impactRank[b.dataset.impact ?? ''] ?? 99) || String(b.dataset.date ?? '').localeCompare(String(a.dataset.date ?? ''));
        if (mode === 'title') return String(a.dataset.title ?? '').localeCompare(String(b.dataset.title ?? ''));
        return String(b.dataset.date ?? '').localeCompare(String(a.dataset.date ?? ''));
      });
      sorted.forEach((row) => tbody.appendChild(row));
      if (noResults) tbody.appendChild(noResults);
    }
    function applyFilters() {
      const query = normalize(getValue(controls.search));
      const type = getValue(controls.type);
      const impact = getValue(controls.impact);
      const recovery = getValue(controls.recovery);
      let visible = 0;
      rows.forEach((row) => {
        if (!(row instanceof HTMLElement)) return;
        const matches = (!query || normalize(row.dataset.search).includes(query)) && (!type || row.dataset.type === type) && (!impact || row.dataset.impact === impact) && (!recovery || row.dataset.recovery === recovery);
        row.hidden = !matches;
        if (matches) visible += 1;
      });
      if (noResults instanceof HTMLElement) noResults.hidden = visible !== 0;
      if (resultCount) resultCount.textContent = String(visible);
    }
    Object.values(controls).forEach((control) => {
      control?.addEventListener('input', () => { sortRows(); applyFilters(); });
      control?.addEventListener('change', () => { sortRows(); applyFilters(); });
    });
    sortRows();
    applyFilters();
  </script>
</BaseLayout>
