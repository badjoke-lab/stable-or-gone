---
import BaseLayout from '../../layouts/BaseLayout.astro';
import eventsData from '../../../data/events.json';
import eventsPr036Data from '../../../data/events-pr036.json';

type EventRow = {
  id: string;
  title: string;
  event_date?: string;
  event_type?: string;
  impact_level?: string;
  recovered?: boolean;
  source_count?: number;
};

const events = [...(eventsData as EventRow[]), ...(eventsPr036Data as EventRow[])].sort((a, b) => String(b.event_date ?? '').localeCompare(String(a.event_date ?? '')));
const title = 'Stablecoin Event Log — Stable or Gone';
const description = 'Browse stablecoin depeg events, wind-downs, collapses, reserve interventions, regulatory context, recovery status, and source-backed event records.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: 'https://sog.badjoke-lab.com/events/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  about: ['stablecoin depeg events', 'stablecoin collapse', 'stablecoin wind-down', 'stablecoin regulatory context']
};
---
<BaseLayout title={title} description={description} canonicalPath="/events/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">&gt; tail /events/depeg.log</div>
      <h1>Event Log</h1>
      <p>Depeg, reserve, redemption, wind-down, migration, regulatory, and related historical events.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Events</span><strong>{events.length}</strong></div>
      <div class="stat"><span>Mode</span><strong>v0</strong></div>
    </div>
  </section>

  <section class="section-grid" aria-label="Event guide links">
    <a class="panel mini-card" href="/guides/what-is-a-depeg/"><h2>What is a depeg?</h2><p>How SOG separates recovered depegs, major depegs, and collapse outcomes.</p></a>
    <a class="panel mini-card" href="/guides/status-vs-event/"><h2>Status vs event</h2><p>Why an event record is not always the same thing as failed status.</p></a>
    <a class="panel mini-card" href="/stablecoins/"><h2>Stablecoin registry</h2><p>Open the entity records linked to these event records.</p></a>
  </section>

  <section class="panel registry">
    <div class="bar">source: data/events.json + data/events-pr036.json</div>
    <table>
      <thead><tr><th>Date</th><th>Event</th><th>Type</th><th>Impact</th><th>Recovered</th><th>Sources</th></tr></thead>
      <tbody>
        {events.length === 0 ? (
          <tr><td colspan="6">No event records yet.</td></tr>
        ) : events.map((event) => (
          <tr>
            <td>{event.event_date ?? '—'}</td>
            <td><a href={`/event/${event.id}/`}>{event.title}</a></td>
            <td>{event.event_type ?? '—'}</td>
            <td>{event.impact_level ?? '—'}</td>
            <td>{event.recovered === true ? 'yes' : event.recovered === false ? 'no' : '—'}</td>
            <td>{event.source_count ?? 0}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</BaseLayout>
