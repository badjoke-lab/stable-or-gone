---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPublicLabel } from '../../utils/displayLabels';
import updatesData from '../../../data/registry-updates.json';

type UpdateRow = {
  id: string;
  date: string;
  title: string;
  category: string;
  summary: string;
  related_paths?: string[];
};

const updates = (updatesData as UpdateRow[]).sort((a, b) => b.date.localeCompare(a.date));
const categoryClass = (category: string) => `chip ${category === 'data' ? 'active' : category === 'foundation' ? 'limited' : 'unknown'}`;
const title = 'Stable or Gone Registry Updates — Stablecoin Data Changes';
const description = 'Reviewed updates for Stable or Gone, including stablecoin data batches, source-deepening passes, guide pages, methodology changes, and registry page changes.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: 'https://sog.badjoke-lab.com/updates/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  about: ['stablecoin registry updates', 'stablecoin data changes', 'source-deepening updates']
};
---
<BaseLayout title={title} description={description} canonicalPath="/updates/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">&gt; tail registry-updates.log</div>
      <h1>Registry Updates</h1>
      <p>Short notes about changes to SOG data, pages, and methodology.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Entries</span><strong>{updates.length}</strong></div>
      <div class="stat"><span>Type</span><strong>Log</strong></div>
    </div>
  </section>

  <section class="panel registry">
    <div class="bar">reviewed public registry changes</div>
    <table>
      <thead><tr><th>Date</th><th>Category</th><th>Update</th><th>Related</th></tr></thead>
      <tbody>
        {updates.map((update) => (
          <tr>
            <td>{update.date}</td>
            <td><span class={categoryClass(update.category)}>{formatPublicLabel(update.category)}</span></td>
            <td><strong>{update.title}</strong><br /><span>{update.summary}</span></td>
            <td>{(update.related_paths ?? []).map((path, index) => (<><a href={path}>{path}</a>{index < (update.related_paths?.length ?? 0) - 1 ? <span> · </span> : null}</>))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="panel support-callout support-callout-updates" aria-labelledby="support-updates-title">
    <div>
      <div class="prompt">&gt; continue updates</div>
      <h2 id="support-updates-title">Support continued updates</h2>
      <p>If SOG’s record updates, source review, and evidence maintenance are useful to you, voluntary support helps sustain the ongoing work. Support never changes classifications, correction decisions, or editorial treatment.</p>
    </div>
    <a class="support-callout-action" href="/support/">Support SOG</a>
  </section>

  <section class="panel registry">
    <div class="bar">scope</div>
    <table><tbody>
      <tr><th>Included</th><td>Registry changes, method changes, data batches, source-deepening passes, guide updates, and page changes.</td></tr>
      <tr><th>Boundaries</th><td>No rankings, no recommendations, no safety score, and no live market signals.</td></tr>
      <tr><th>Corrections</th><td>Send source-backed corrections through <a href="/contact/">Contact</a> or GitHub Issues.</td></tr>
    </tbody></table>
  </section>
</BaseLayout>