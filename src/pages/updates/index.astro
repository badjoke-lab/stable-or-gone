---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPublicLabel } from '../../utils/displayLabels';
import { updatePublicCopy } from '../../data/updatePublicCopy';
import { getRegistryUpdates } from '../../lib/data/registry';

const updates = getRegistryUpdates().sort((a, b) => b.date.localeCompare(a.date));
const categoryClass = (category: string) => `chip ${category === 'data' ? 'active' : category === 'foundation' ? 'limited' : 'unknown'}`;
const latestUpdateDate = updates[0]?.date ?? '—';
const title = 'Updates — Stable or Gone';
const description = 'Recent additions, corrections, source reviews, and page changes across Stable or Gone.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: 'https://sog.badjoke-lab.com/updates/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  about: ['stablecoin record updates', 'source reviews', 'archive changes']
};
---
<BaseLayout title={title} description={description} canonicalPath="/updates/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">Archive change history</div>
      <h1>What changed</h1>
      <p>Recent additions, corrections, source reviews, new guides, and changes to how records are presented.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Published updates</span><strong>{updates.length}</strong></div>
      <div class="stat"><span>Latest update</span><strong>{latestUpdateDate}</strong></div>
    </div>
  </section>

  <section class="panel registry">
    <div class="bar">Update history</div>
    <table>
      <thead><tr><th>Date</th><th>Category</th><th>Change</th><th>Related pages</th></tr></thead>
      <tbody>
        {updates.map((update) => {
          const publicCopy = updatePublicCopy[update.id];
          return (
            <tr>
              <td>{update.date}</td>
              <td><span class={categoryClass(update.category)}>{formatPublicLabel(update.category)}</span></td>
              <td><strong>{publicCopy?.title ?? update.title}</strong><br /><span>{publicCopy?.summary ?? update.summary}</span></td>
              <td>{(update.related_paths ?? []).map((path, index) => (<><a href={path}>{path}</a>{index < (update.related_paths?.length ?? 0) - 1 ? <span> · </span> : null}</>))}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </section>

  <section class="panel support-callout support-callout-updates" aria-labelledby="support-updates-title">
    <div>
      <div class="prompt">Support ongoing maintenance</div>
      <h2 id="support-updates-title">Help fund the next round of updates</h2>
      <p>Support helps cover research, source checks, broken-link review, and new records. It does not affect editorial decisions.</p>
    </div>
    <a class="support-callout-action" href="/support/">Support SOG</a>
  </section>

  <section class="panel registry">
    <div class="bar">Submitting a correction</div>
    <table><tbody>
      <tr><th>Report an error</th><td>Use the <a href="/contact/">contact page</a> to report incorrect wording, missing sources, broken links, or missing records.</td></tr>
      <tr><th>Public discussion</th><td>GitHub Issues can be used for corrections and additions with supporting sources.</td></tr>
    </tbody></table>
  </section>
</BaseLayout>
