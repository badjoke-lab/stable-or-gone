---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="About — Stable or Gone">
  <section class="content-page">
    <span class="command">&gt; whoami</span>
    <h1>About Stable or Gone</h1>
    <p>
      Stable or Gone is a public registry for stablecoin records, issuer files, reserve notes,
      event history, evidence, and visible uncertainty.
    </p>
    <h2>What it is</h2>
    <ul>
      <li>A stablecoin history registry.</li>
      <li>A source-backed reference project.</li>
      <li>A place to inspect stablecoin events and evidence.</li>
    </ul>
    <h2>What it is not</h2>
    <ul>
      <li>Not a trading tool.</li>
      <li>Not a ranking site.</li>
      <li>Not investment advice.</li>
    </ul>
  </section>
</BaseLayout>
