---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'About Stable or Gone — Stablecoin History Archive';
const description = 'Stable or Gone documents stablecoin launches, depegs, recoveries, migrations, wind-downs, and failures, with links to the sources behind each record.';
---
<BaseLayout title={title} description={description} canonicalPath="/about/">
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">About the archive</div>
      <h1>Why Stable or Gone exists</h1>
      <p>Stablecoins change over time. Some grow, some migrate, some lose their peg and recover, and some disappear. Stable or Gone keeps those histories in one place.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Focus</span><strong>History</strong></div>
      <div class="stat"><span>Coverage</span><strong>Sources</strong></div>
    </div>
  </section>

  <section class="section-grid">
    <div class="panel mini-card"><h2>What you can find</h2><p>Stablecoin records, issuer information, event timelines, reserve disclosures, redemption terms, and source links.</p></div>
    <div class="panel mini-card"><h2>Why history matters</h2><p>A current price or market cap does not explain how a stablecoin reached its present state. The timeline does.</p></div>
    <div class="panel mini-card"><h2>How gaps are handled</h2><p>When public information is incomplete or conflicting, the gap is shown rather than filled with a guess.</p></div>
  </section>

  <section class="panel registry">
    <div class="bar">What Stable or Gone covers</div>
    <table><tbody>
      <tr><th>Stablecoins</th><td>Current and historical records for active, limited, migrated, discontinued, and failed stablecoins.</td></tr>
      <tr><th>Events</th><td>Launches, depegs, recoveries, regulatory actions, protocol changes, wind-downs, and collapses.</td></tr>
      <tr><th>Issuers and protocols</th><td>The companies, organizations, and protocols connected to each stablecoin.</td></tr>
      <tr><th>Sources</th><td>Issuer statements, official notices, reports, regulatory documents, archives, and other relevant public material.</td></tr>
    </tbody></table>
  </section>

  <section class="panel support-callout support-callout-about" aria-labelledby="support-about-title">
    <div>
      <div class="prompt">Independent maintenance</div>
      <h2 id="support-about-title">Help keep the archive updated</h2>
      <p>Support helps cover research, source checks, broken-link review, and new records. It does not affect inclusion, wording, corrections, or status labels.</p>
    </div>
    <a class="support-callout-action" href="/support/">Support SOG</a>
  </section>

  <section class="panel registry">
    <div class="bar">Using the information</div>
    <table><tbody>
      <tr><th>Historical reference</th><td>The site is designed for research and comparison rather than live pricing.</td></tr>
      <tr><th>Current information</th><td>Check the latest issuer terms, exchange notices, official reports, and market data before making decisions.</td></tr>
      <tr><th>Corrections</th><td>Source-backed corrections and missing records can be submitted through the contact page or GitHub Issues.</td></tr>
    </tbody></table>
  </section>
</BaseLayout>