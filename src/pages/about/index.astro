---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="About — Stable or Gone">
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">&gt; whoami</div>
      <h1>About Stable or Gone</h1>
      <p>Stable or Gone is a public registry for stablecoin records, issuer files, reserve notes, event history, evidence, and visible uncertainty.</p>
    </div>
  </section>
  <section class="section-grid">
    <div class="panel mini-card"><h2>Registry</h2><p>Stablecoin records with issuers, models, status, and source references.</p></div>
    <div class="panel mini-card"><h2>History</h2><p>Event records for depegs, reserve notes, redemptions, and lifecycle changes.</p></div>
    <div class="panel mini-card"><h2>Not advice</h2><p>SOG is not a trading tool, ranking site, or investment guide.</p></div>
  </section>
</BaseLayout>
