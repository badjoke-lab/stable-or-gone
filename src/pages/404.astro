---
import BrandLockup from '../components/BrandLockup.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#07090b" />
    <title>Page not found — Stable or Gone</title>
    <meta name="description" content="The requested Stable or Gone page was not found." />
    <link rel="icon" href="/brand/sog-mark-on-light.svg" type="image/svg+xml" />
  </head>
  <body class="not-found-page">
    <main id="main-content" class="not-found-main">
      <section class="not-found-panel">
        <BrandLockup surface="dark" />
        <p class="not-found-kicker">404 · Record not found</p>
        <h1>This page is not in the registry.</h1>
        <p class="not-found-copy">The address may be outdated or incomplete. Use the stablecoin register, project navigation, or the BadJoke-Lab project hub to continue.</p>
        <nav class="not-found-actions" aria-label="404 recovery links">
          <a href="/">Return to Stable or Gone</a>
          <a href="/stablecoins/">Open the stablecoin register</a>
          <a href="https://badjoke-lab.com/">BadJoke-Lab projects</a>
        </nav>
      </section>
    </main>
  </body>
</html>
