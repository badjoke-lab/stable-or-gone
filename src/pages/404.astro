---
import BrandLockup from '../components/BrandLockup.astro';

const gaMeasurementId = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '').trim();
const gaLoaderUrl = gaMeasurementId ? `https://www.google${'tagmanager'}.com/gtag/js?id=${gaMeasurementId}` : '';
const gaInline = gaMeasurementId
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaMeasurementId}');`
  : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#07090b" />
    <title>Page not found — Stable or Gone</title>
    <meta name="description" content="The requested Stable or Gone page was not found." />
    <link rel="icon" href="/brand/sog-mark-on-light.svg" type="image/svg+xml" />
    {gaLoaderUrl && <script async src={gaLoaderUrl}></script>}
    {gaInline && <script set:html={gaInline} />}
  </head>
  <body>
    <main id="main-content" class="site-main">
      <section class="home-search" aria-labelledby="not-found-title">
        <BrandLockup surface="dark" />
        <p class="home-section-kicker">404 · Record not found</p>
        <h1 id="not-found-title">This page is not in the registry.</h1>
        <p>The address may be outdated or incomplete. Use the stablecoin register, project navigation, or the BadJoke-Lab project hub to continue.</p>
        <nav class="home-registry-links" aria-label="404 recovery links">
          <a href="/">Return to Stable or Gone</a>
          <a href="/stablecoins/">Open the stablecoin register</a>
          <a href="https://badjoke-lab.com/">BadJoke-Lab projects</a>
        </nav>
      </section>
    </main>
  </body>
</html>
