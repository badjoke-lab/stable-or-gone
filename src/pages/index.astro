---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPublicLabel, formatStatusLabel } from '../utils/displayLabels';
import stablecoinsData from '../../data/stablecoins.json';
import stablecoinsExtraData from '../../data/stablecoins-extra.json';
import issuersData from '../../data/issuers.json';
import issuersExtraData from '../../data/issuers-extra.json';
import eventsData from '../../data/events.json';
import eventsPr036Data from '../../data/events-pr036.json';
import eventsPr037Data from '../../data/events-pr037.json';
import eventsPr038Data from '../../data/events-pr038.json';
import evidenceData from '../../data/evidence.json';
import evidenceExtraData from '../../data/evidence-extra.json';
import evidencePr033Data from '../../data/evidence-pr033.json';
import evidenceEventsPr036Data from '../../data/evidence-events-pr036.json';
import evidenceEventsPr037Data from '../../data/evidence-events-pr037.json';
import evidenceEventsPr038Data from '../../data/evidence-events-pr038.json';

type StablecoinRow = { slug: string; name: string; symbol?: string; peg_asset?: string; collateral_model?: string; status?: string; issuer_id?: string };
type IssuerRow = { id: string; name: string };

const stablecoins = [...(stablecoinsData as StablecoinRow[]), ...(stablecoinsExtraData as StablecoinRow[])];
const issuers = [...(issuersData as IssuerRow[]), ...(issuersExtraData as IssuerRow[])];
const issuerById = new Map(issuers.map((issuer) => [issuer.id, issuer.name] as const));
const events = [...(eventsData as unknown[]), ...(eventsPr036Data as unknown[]), ...(eventsPr037Data as unknown[]), ...(eventsPr038Data as unknown[])];
const evidence = [...(evidenceData as unknown[]), ...(evidenceExtraData as unknown[]), ...(evidencePr033Data as unknown[]), ...(evidenceEventsPr036Data as unknown[]), ...(evidenceEventsPr037Data as unknown[]), ...(evidenceEventsPr038Data as unknown[])];
const statusClass = (status?: string) => `chip ${status ?? 'unknown'}`;

const title = 'Stable or Gone — Stablecoin History Registry';
const description = 'Explore stablecoin histories, depegs, launches, wind-downs, failures, issuers, reserve information, redemption terms, and the sources behind each record.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/', description, inLanguage: 'en', about: ['stablecoins', 'depeg events', 'reserve disclosure', 'stablecoin history'] };
---
<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">Stablecoin history archive</div>
      <h1>Stablecoin histories, major events, and sources.</h1>
      <p>Follow launches, depegs, wind-downs, migrations, failures, reserve disclosures, and redemption terms across the stablecoin market.</p>
    </div>
    <div class="panel stats" aria-label="Registry summary">
      <div class="stat"><span>Stablecoins</span><strong>{stablecoins.length}</strong></div>
      <div class="stat"><span>Issuers</span><strong>{issuers.length}</strong></div>
      <div class="stat"><span>Events</span><strong>{events.length}</strong></div>
      <div class="stat"><span>Sources</span><strong>{evidence.length}</strong></div>
    </div>
  </section>

  <section class="section-grid" aria-label="Main sections">
    <a class="panel mini-card" href="/stablecoins/"><h2>Browse stablecoins</h2><p>Compare status, issuer, peg, backing model, redemption access, and history.</p></a>
    <a class="panel mini-card" href="/events/"><h2>Explore events</h2><p>Review depegs, launches, regulatory actions, migrations, wind-downs, and collapses.</p></a>
    <a class="panel mini-card" href="/issuers/"><h2>View issuers</h2><p>See the companies, protocols, and organizations behind each stablecoin.</p></a>
    <a class="panel mini-card" href="/guides/"><h2>Read the guides</h2><p>Understand depegs, reserve disclosures, status labels, and lifecycle terms.</p></a>
  </section>

  <section class="panel registry">
    <div class="bar">Selected stablecoin records</div>
    <table>
      <thead><tr><th>Name</th><th>Symbol</th><th>Peg</th><th>Model</th><th>Status</th><th>Issuer</th></tr></thead>
      <tbody>{stablecoins.slice(0, 10).map((coin) => (
        <tr>
          <td><a href={`/stablecoin/${coin.slug}/`}>{coin.name}</a></td>
          <td>{coin.symbol ?? '—'}</td>
          <td>{coin.peg_asset ?? '—'}</td>
          <td>{formatPublicLabel(coin.collateral_model)}</td>
          <td><span class={statusClass(coin.status)}>{formatStatusLabel(coin.status)}</span></td>
          <td>{issuerById.get(coin.issuer_id ?? '') ?? 'Unknown issuer'}</td>
        </tr>
      ))}</tbody>
    </table>
  </section>

  <section class="panel support-callout support-callout-home" aria-labelledby="support-home-title">
    <div>
      <div class="prompt">Support the archive</div>
      <h2 id="support-home-title">Help keep the records current</h2>
      <p>Support helps cover research, source checks, link maintenance, and new records. It does not affect how any stablecoin is described.</p>
    </div>
    <a class="support-callout-action" href="/support/">Support SOG</a>
  </section>
</BaseLayout>