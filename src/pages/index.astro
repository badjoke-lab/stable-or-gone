---
import BaseLayout from '../layouts/BaseLayout.astro';
import StablecoinMark from '../components/StablecoinMark.astro';
import { formatLifecycleLabel } from '../utils/publicTaxonomy';
import { formatReferenceTargetLabel } from '../utils/referenceTarget';
import { resolvePrimaryRelationshipForStablecoin } from '../utils/primaryDisplayRelationship';
import { getStablecoins, getOrganizations, getRelationships, getEvents, getEvidence } from '../lib/data/registry';
import { getEvidenceSourceIdentitySummary } from '../lib/data/evidenceSources';
import { getFeaturedGuides } from '../data/guideCatalog';

const stablecoins = getStablecoins();
const organizations = getOrganizations();
const relationships = getRelationships();
const events = getEvents();
const evidence = getEvidence();
const evidenceSummary = getEvidenceSourceIdentitySummary();

const organizationById = new Map(organizations.map((organization) => [organization.id, organization] as const));
const primaryOrganization = (stablecoinId: string) => {
  const relationship = resolvePrimaryRelationshipForStablecoin(stablecoinId, relationships).relationship;
  return relationship ? organizationById.get(relationship.organization_id) : undefined;
};
const recordDomain = (coin: unknown) => {
  const candidate = coin as { official_domain?: string; official_url?: string };
  if (candidate.official_domain) return candidate.official_domain;
  if (!candidate.official_url) return '';
  try { return new URL(candidate.official_url).hostname; } catch { return ''; }
};
const evidenceCount = (stablecoinId: string) => evidence.filter((item) =>
  item.stablecoin_id === stablecoinId || (item.stablecoin_ids ?? []).includes(stablecoinId)
).length;
const eventCount = (stablecoinId: string) => events.filter((event) =>
  event.stablecoin_id === stablecoinId || (event.subject_stablecoin_ids ?? []).includes(stablecoinId)
).length;
const latestVerified = stablecoins.map((coin) => coin.last_verified_at).filter(Boolean).sort().at(-1) ?? '—';

const entryCards = [
  { href: '/stablecoins/', number: '01', title: 'Stablecoin records', text: 'Canonical assets, lifecycle states, reference targets, backing models, and unresolved questions.' },
  { href: '/issuers/', number: '02', title: 'Organizations', text: 'Issuers, operators, reserve managers, custodians, governance bodies, and related institutions.' },
  { href: '/events/', number: '03', title: 'Material events', text: 'Launches, restrictions, depegs, migrations, wind-downs, collapses, recoveries, and regulatory actions.' },
  { href: '/timeline/', number: '04', title: 'Historical timeline', text: 'Chronological access to the events that changed stablecoin records and their institutional context.' },
  { href: '/access-regulation/', number: '05', title: 'Access and regulation', text: 'Market access, regional distribution, regulatory treatment, and documented availability constraints.' },
  { href: '/stats/', number: '06', title: 'Registry statistics', text: 'Lifecycle, model, organization, event, evidence, access, and data-quality distributions.' }
];

const previewRows = [...stablecoins]
  .sort((left, right) => String(right.last_verified_at ?? '').localeCompare(String(left.last_verified_at ?? '')) || left.name.localeCompare(right.name))
  .slice(0, 8)
  .map((coin) => {
    const organization = primaryOrganization(coin.id);
    return {
      coin,
      organization,
      domain: recordDomain(coin),
      lifecycle: coin.lifecycle_status || 'unknown',
      reference: formatReferenceTargetLabel(coin),
      evidence: evidenceCount(coin.id),
      events: eventCount(coin.id)
    };
  });

const featuredGuides = getFeaturedGuides(4);
const leadGuide = featuredGuides.find((guide) => guide.slug === 'global-stablecoin-regulation-2026') ?? featuredGuides[0];
const latestGuides = featuredGuides.filter((guide) => guide.slug !== leadGuide?.slug).slice(0, 3);

const title = 'Stable or Gone — Stablecoin Historical Registry';
const description = 'A source-backed historical registry of stablecoins, connected organizations, material events, access conditions, and evidence.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Stable or Gone',
  url: 'https://www.stableorgone.com/',
  description,
  inLanguage: 'en'
};
---
<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <div class="home-ledger" data-home-priority="recent-records-first">
    <section class="home-intro" aria-labelledby="home-title">
      <div class="home-intro-copy">
        <p class="kicker">Stablecoin history</p>
        <h1 id="home-title">A historical registry of stablecoins.</h1>
        <p class="lede">Track {stablecoins.length} stablecoins, their organizations, material events, access changes, and supporting evidence.</p>
      </div>
      <dl class="home-facts" aria-label="Registry summary">
        <div><dt>Stablecoins</dt><dd>{stablecoins.length}<small> stable assets</small></dd></div>
        <div><dt>Organizations</dt><dd>{organizations.length}<small> organizations</small></dd></div>
        <div><dt>Events</dt><dd>{events.length}<small> events</small></dd></div>
        <div><dt>Evidence</dt><dd>{evidence.length}<small> source records</small><small>Source identities {evidenceSummary.source_identities}</small></dd></div>
      </dl>
    </section>

    <section class="registry-section registry-section--priority" aria-labelledby="registry-title">
      <div class="section-heading home-registry-heading">
        <div>
          <p class="kicker">Recently reviewed</p>
          <h2 id="registry-title">Latest registry entries</h2>
        </div>
        <a class="registry-heading-link" href="/stablecoins/">Browse all {stablecoins.length} records →</a>
      </div>

      <div class="registry-panel">
        <div class="registry-count">
          <span><strong>{previewRows.length}</strong> recently reviewed records</span>
          <span>Last verified <strong>{latestVerified}</strong></span>
        </div>
        <div class="table-wrap home-registry-table-wrap">
          <table class="home-registry-table">
            <thead>
              <tr>
                <th>Stablecoin</th>
                <th>Lifecycle</th>
                <th>Reference</th>
                <th>Organization</th>
                <th>Reviewed</th>
                <th>Evidence / events</th>
              </tr>
            </thead>
            <tbody>
              {previewRows.map(({ coin, organization, domain, lifecycle, reference, evidence: sourceCount, events: linkedEvents }) => (
                <tr class="home-registry-row">
                  <td data-label="Stablecoin">
                    <div class="stablecoin-dossier-heading-identity">
                      <StablecoinMark slug={coin.slug} symbol={coin.symbol || ''} name={coin.name} size="small" loading="eager" />
                      <div>
                        <a href={`/stablecoin/${coin.slug}/`}><strong>{coin.name}</strong></a>
                        <small>{coin.symbol || 'No symbol'}{domain ? ` · ${domain}` : ''}</small>
                      </div>
                    </div>
                  </td>
                  <td data-label="Lifecycle"><span class={`chip chip--${lifecycle}`}>{formatLifecycleLabel(lifecycle)}</span></td>
                  <td data-label="Reference">{reference}</td>
                  <td data-label="Organization">
                    {organization ? <a href={`/issuer/${organization.slug}/`}>{organization.name}</a> : 'Not recorded'}
                  </td>
                  <td data-label="Reviewed"><strong>{coin.last_verified_at || 'Not recorded'}</strong></td>
                  <td data-label="Evidence / events" class="home-registry-evidence">
                    <strong>{sourceCount} sources</strong><small> · {linkedEvents} {linkedEvents === 1 ? 'event' : 'events'}</small>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="registry-count registry-count--footer">
          <a class="support-cta" href="/stablecoins/">Open all stablecoin records</a>
        </div>
      </div>
    </section>

    {leadGuide && (
      <section class="directory-section" aria-labelledby="research-guides-title">
        <div class="section-heading">
          <div>
            <p class="kicker">Research &amp; guides</p>
            <h2 id="research-guides-title">Read the regulatory context</h2>
          </div>
          <a class="registry-heading-link" href="/guides/">All guides →</a>
        </div>
        <div class="panel registry">
          <div class="bar">Featured research</div>
          <h3><a href={`/guides/${leadGuide.slug}/`}>{leadGuide.title}</a></h3>
          <p>{leadGuide.summary}</p>
          <p><strong>{leadGuide.regionLabel ?? 'Global'}</strong> · Published {leadGuide.publishedAt} · Current through {leadGuide.informationCurrentThrough}</p>
          <p><a href={`/guides/${leadGuide.slug}/`}>Open the 2026 global comparison →</a></p>
        </div>
        {latestGuides.length > 0 && (
          <div class="editorial-directory" aria-label="Latest featured guides">
            {latestGuides.map((guide, index) => (
              <a href={`/guides/${guide.slug}/`}>
                <span class="directory-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="directory-copy"><strong>{guide.title}</strong><small>{guide.regionLabel ?? 'Guide'} · Current through {guide.informationCurrentThrough}</small></span>
                <span aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        )}
      </section>
    )}

    <section class="archive-note" aria-label="Registry scope note">
      <span>Evidence-based static registry</span>
      <span>Not a ranking or market dashboard</span>
    </section>

    <section class="directory-section" aria-labelledby="directory-title">
      <div class="section-heading">
        <div>
          <p class="kicker">Archive directory</p>
          <h2 id="directory-title">Explore the record</h2>
        </div>
        <p>Cross-record views for lifecycle, organizations, events, access, evidence, and statistics.</p>
      </div>
      <div class="editorial-directory">
        {entryCards.map((card) => (
          <a href={card.href}>
            <span class="directory-number">{card.number}</span>
            <span class="directory-copy"><strong>{card.title}</strong><small>{card.text}</small></span>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <aside class="context-support-callout" aria-label="Support Stable or Gone">
      <p><strong>Help keep Stable or Gone public.</strong> Support source verification, broken-link review, new records, and archive maintenance.</p>
      <a class="support-cta" href="/support/">View support options</a>
    </aside>
  </div>
</BaseLayout>
