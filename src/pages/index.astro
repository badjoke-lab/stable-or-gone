---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home-v3.css';
import '../styles/ui-remediation-r3.css';
import { formatLifecycleLabel } from '../utils/publicTaxonomy';
import { formatReferenceTargetLabel } from '../utils/referenceTarget';
import { formatPublicBackingModelLabel } from '../utils/backingModel';
import { resolvePrimaryRelationshipForStablecoin } from '../utils/primaryDisplayRelationship';
import { getFeaturedGuides } from '../data/guideCatalog';
import { eventPublicCopy } from '../data/eventPublicCopy';
import { getStablecoins, getOrganizations, getRelationships, getEvents } from '../lib/data/registry';
import { getEvidenceSourceIdentitySummary } from '../lib/data/evidenceSources';
import registryUpdates from '../../data/registry-updates.json';

const stablecoins = getStablecoins();
const organizations = getOrganizations();
const relationships = getRelationships();
const events = getEvents();
const evidenceSummary = getEvidenceSourceIdentitySummary();
const stablecoinById = new Map(stablecoins.map((coin) => [coin.id, coin] as const));
const organizationById = new Map(organizations.map((organization) => [organization.id, organization.name] as const));
const primaryOrganizationName = (stablecoinId: string) => {
  const relationship = resolvePrimaryRelationshipForStablecoin(stablecoinId, relationships).relationship;
  return relationship ? organizationById.get(relationship.organization_id) ?? 'Unknown organization' : 'Unknown organization';
};

const featuredGuides = getFeaturedGuides(3).map((guide) => ({ guide, label: guide.regionLabel ?? 'Guide' }));
const latestMaterialChanges = [...events]
  .filter((event) => Boolean(event.event_date))
  .sort((left, right) => String(right.event_date).localeCompare(String(left.event_date)) || String(right.id).localeCompare(String(left.id)))
  .slice(0, 5)
  .map((event) => {
    const subjectId = event.stablecoin_id ?? event.subject_stablecoin_ids?.[0] ?? null;
    const subject = subjectId ? stablecoinById.get(subjectId) : null;
    return {
      event,
      title: eventPublicCopy[event.id]?.title ?? event.title,
      description: eventPublicCopy[event.id]?.description ?? event.description,
      subjectName: subject?.name ?? 'Registry record',
      subjectHref: subject ? `/stablecoin/${subject.slug}/` : null
    };
  });

const latestPublications = [...registryUpdates]
  .sort((left, right) => String(right.date).localeCompare(String(left.date)) || String(right.id).localeCompare(String(left.id)))
  .slice(0, 3);

const recentlyUpdated = [...stablecoins]
  .sort((left, right) => String(right.last_verified_at ?? '').localeCompare(String(left.last_verified_at ?? '')) || left.name.localeCompare(right.name))
  .slice(0, 6);

const registryReviewDate = [
  ...stablecoins.map((coin) => coin.last_verified_at),
  ...featuredGuides.flatMap(({ guide }) => [guide.updatedAt, guide.publishedAt, guide.informationCurrentThrough])
].filter((value): value is string => Boolean(value)).sort().at(-1) ?? 'Not recorded';

const directLinks = [
  { href: '/stablecoins/', label: 'Stablecoin register', meta: `${stablecoins.length} records` },
  { href: '/events/', label: 'Material events', meta: `${events.length} events` },
  { href: '/issuers/', label: 'Organizations', meta: `${organizations.length} organizations` },
  { href: '/compare/', label: 'Compare records', meta: 'Up to 4 records' },
  { href: '/timeline/', label: 'Change timeline', meta: 'Chronological view' },
  { href: '/methodology/', label: 'Methodology', meta: 'Definitions and limits' }
];

const searchRecords = [
  ...stablecoins.map((coin) => ({
    type: 'Stablecoin',
    title: coin.symbol ? `${coin.name} (${coin.symbol})` : coin.name,
    meta: `${formatLifecycleLabel(coin.lifecycle_status)} · ${formatReferenceTargetLabel(coin)}`,
    href: `/stablecoin/${coin.slug}/`,
    search: [coin.name, coin.symbol, ...(coin.aliases ?? []), coin.summary, formatLifecycleLabel(coin.lifecycle_status), formatReferenceTargetLabel(coin), formatPublicBackingModelLabel(coin)].filter(Boolean).join(' ')
  })),
  ...organizations.map((organization) => ({
    type: 'Organization',
    title: organization.name,
    meta: String(organization.organization_type ?? organization.legacy_issuer_type ?? 'Organization').replaceAll('_', ' '),
    href: `/issuer/${organization.slug}/`,
    search: [organization.name, organization.slug, organization.organization_type, organization.legacy_issuer_type].filter(Boolean).join(' ')
  })),
  ...events.map((event) => ({
    type: 'Event',
    title: eventPublicCopy[event.id]?.title ?? event.title,
    meta: event.event_date ? `Event · ${event.event_date}` : 'Event · Date not recorded',
    href: `/event/${event.id}/`,
    search: [eventPublicCopy[event.id]?.title, eventPublicCopy[event.id]?.description, event.title, event.description, event.id, event.event_date].filter(Boolean).join(' ')
  }))
].map((record) => ({ ...record, search: record.search.normalize('NFKC').toLocaleLowerCase().replace(/\s+/g, ' ').trim() }));
const searchDataJson = JSON.stringify(searchRecords).replace(/</g, '\u003c');

const title = 'Stable or Gone — Stablecoin Historical Register';
const description = 'A source-backed historical register of stablecoins, connected organizations, material events, reserve and redemption structures, and unresolved questions.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Stable or Gone',
  url: 'https://sog.badjoke-lab.com/',
  description,
  inLanguage: 'en',
  about: ['stablecoins', 'stablecoin events', 'stablecoin organizations', 'reserve disclosure', 'stablecoin history', 'stablecoin regulation'],
  hasPart: featuredGuides.map(({ guide }) => ({ '@type': 'Article', name: guide.title, url: `https://sog.badjoke-lab.com/guides/${guide.slug}/` }))
};
---
<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <div class="home-registry home-registry-r3" data-home-registry="r3">
    <section class="home-entry" aria-labelledby="home-title">
      <div class="home-entry__copy">
        <p class="home-eyebrow">Independent evidence registry · reviewed through <time datetime={registryReviewDate}>{registryReviewDate}</time></p>
        <h1 id="home-title">Stablecoins, their history, and the evidence behind each state.</h1>
        <p class="home-entry__deck">Search current lifecycle, connected organizations, material events, reserve and redemption structures, and source-backed changes.</p>
        <div class="home-entry__actions">
          <a class="home-primary-action" href="/stablecoins/">Open the register</a>
          <a class="home-secondary-action" href="/methodology/">Read the methodology</a>
        </div>
      </div>

      <section class="home-search" aria-labelledby="home-search-title" data-home-search>
        <div class="home-search__heading">
          <p class="home-eyebrow">Search canonical records</p>
          <h2 id="home-search-title">Find a stablecoin, organization, or event</h2>
        </div>
        <form class="home-search__form" action="/stablecoins/" method="get" data-home-search-form>
          <label class="visually-hidden" for="home-search-input">Search stablecoins, organizations, and events</label>
          <input id="home-search-input" class="home-search__field" type="search" name="q" placeholder="USDC, Tether, collapse, redemption…" autocomplete="off" aria-controls="home-search-results" aria-expanded="false" data-home-search-input />
          <button type="submit">Search</button>
        </form>
        <div class="home-search__popular"><span>Try</span>{['USDT', 'USDC', 'DAI', 'UST'].map((term) => <button type="button" data-home-search-term={term}>{term}</button>)}</div>
        <div class="home-search__results" id="home-search-results" role="region" aria-live="polite" hidden data-home-search-results></div>
      </section>
    </section>

    <nav class="home-registry-totals" aria-label="Canonical registry totals">
      <a href="/stablecoins/"><span>Stablecoins</span><strong>{stablecoins.length}</strong><small>canonical records</small></a>
      <a href="/issuers/"><span>Organizations</span><strong>{organizations.length}</strong><small>connected entities</small></a>
      <a href="/events/"><span>Events</span><strong>{events.length}</strong><small>material records</small></a>
      <a href="/methodology/"><span>Sources</span><strong>{evidenceSummary.source_identities}</strong><small>distinct identities</small></a>
    </nav>

    <nav class="home-direct-links" aria-label="Explore the registry">
      {directLinks.map((item) => <a href={item.href}><strong>{item.label}</strong><span>{item.meta}</span><b aria-hidden="true">→</b></a>)}
    </nav>

    <section class="home-panel home-material-changes" aria-labelledby="home-events-title">
      <div class="home-section-heading">
        <div><p class="home-eyebrow">Latest changes</p><h2 id="home-events-title">Recent material events</h2></div>
        <a href="/events/">All events</a>
      </div>
      <ol class="home-material-list">
        {latestMaterialChanges.map(({ event, title: eventTitle, description: eventDescription, subjectName, subjectHref }) => (
          <li>
            <div class="home-material-list__meta"><time datetime={event.event_date ?? undefined}>{event.event_date ?? 'Date not recorded'}</time>{subjectHref ? <a href={subjectHref}>{subjectName}</a> : <span>{subjectName}</span>}</div>
            <div><h3><a href={`/event/${event.id}/`}>{eventTitle}</a></h3><p>{eventDescription}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="home-panel home-recent" aria-labelledby="home-recent-title">
      <div class="home-section-heading"><div><p class="home-eyebrow">Recently reviewed</p><h2 id="home-recent-title">Stablecoin records</h2></div><a href="/stablecoins/">All {stablecoins.length}</a></div>
      <div class="home-recent-grid">
        {recentlyUpdated.map((coin) => <a href={`/stablecoin/${coin.slug}/`}><div><strong>{coin.name}</strong><span>{coin.symbol ?? 'No symbol recorded'}</span></div><dl><div><dt>Lifecycle</dt><dd>{formatLifecycleLabel(coin.lifecycle_status)}</dd></div><div><dt>Organization</dt><dd>{primaryOrganizationName(coin.id)}</dd></div><div><dt>Reviewed</dt><dd>{coin.last_verified_at ?? 'Not recorded'}</dd></div></dl></a>)}
      </div>
    </section>

    <div class="home-r3-secondary">
      <section class="home-panel home-publications" aria-labelledby="home-publications-title">
        <div class="home-section-heading"><div><p class="home-eyebrow">Registry maintenance</p><h2 id="home-publications-title">Latest updates</h2></div><a href="/updates/">Full feed</a></div>
        <ol>
          {latestPublications.map((update) => <li><time datetime={update.date}>{update.date}</time><strong>{update.title}</strong><p>{update.summary}</p>{update.related_paths?.[0] && <a href={update.related_paths[0]}>Open update</a>}</li>)}
        </ol>
      </section>

      <section class="home-panel home-guides" aria-labelledby="home-guides-title">
        <div class="home-section-heading"><div><p class="home-eyebrow">Reviewed explanations</p><h2 id="home-guides-title">Guides</h2></div><a href="/guides/">All guides</a></div>
        <div class="home-guide-grid">
          {featuredGuides.map(({ guide, label }) => <article><div><span>{label}</span><time datetime={guide.informationCurrentThrough}>Through {guide.informationCurrentThrough}</time></div><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3><p>{guide.summary}</p></article>)}
        </div>
      </section>
    </div>
  </div>

  <script id="home-search-data" type="application/json" set:html={searchDataJson}></script>
  <script>
    type HomeSearchRecord = { type: string; title: string; meta: string; href: string; search: string };
    const root = document.querySelector('[data-home-search]');
    const input = root?.querySelector('[data-home-search-input]');
    const form = root?.querySelector('[data-home-search-form]');
    const results = root?.querySelector('[data-home-search-results]');
    const dataElement = document.getElementById('home-search-data');
    let records: HomeSearchRecord[] = [];
    try { records = JSON.parse(dataElement?.textContent || '[]') as HomeSearchRecord[]; } catch { records = []; }
    const entities: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    const escapeHtml = (value: unknown): string => String(value).replace(/[&<>"']/g, (character) => entities[character] ?? character);
    const search = (): HomeSearchRecord[] => {
      if (!(input instanceof HTMLInputElement) || !(results instanceof HTMLElement)) return [];
      const query = input.value.normalize('NFKC').toLocaleLowerCase().trim().replace(/\s+/g, ' ');
      if (!query) { results.hidden = true; input.setAttribute('aria-expanded', 'false'); results.innerHTML = ''; return []; }
      const matches = records.filter((record) => record.search.includes(query) || record.title.toLocaleLowerCase().includes(query)).sort((left, right) => left.type.localeCompare(right.type) || left.title.localeCompare(right.title)).slice(0, 12);
      const items = matches.map((record) => `<a class="home-search__record" href="${escapeHtml(record.href)}"><span class="home-search__type">${escapeHtml(record.type)}</span><span class="home-search__copy"><strong>${escapeHtml(record.title)}</strong><span>${escapeHtml(record.meta)}</span></span><span aria-hidden="true">→</span></a>`).join('');
      results.innerHTML = `<div class="home-search__summary">${matches.length ? `${matches.length} matching records` : 'No matching records'}</div>${items}`;
      results.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      return matches;
    };
    input?.addEventListener('input', search);
    form?.addEventListener('submit', (event) => { const matches = search(); const first = matches[0]; if (matches.length === 1 && first) { event.preventDefault(); window.location.href = first.href; } });
    root?.querySelectorAll('[data-home-search-term]').forEach((button) => button.addEventListener('click', () => { if (!(button instanceof HTMLButtonElement) || !(input instanceof HTMLInputElement)) return; input.value = button.dataset.homeSearchTerm || ''; input.focus(); search(); }));
    root?.addEventListener('keydown', (event) => { if (event instanceof KeyboardEvent && event.key === 'Escape' && results instanceof HTMLElement && input instanceof HTMLInputElement) { results.hidden = true; input.setAttribute('aria-expanded', 'false'); input.focus(); } });
    document.addEventListener('click', (event) => { if (root instanceof HTMLElement && event.target instanceof Node && !root.contains(event.target) && results instanceof HTMLElement && input instanceof HTMLInputElement) { results.hidden = true; input.setAttribute('aria-expanded', 'false'); } });
  </script>
</BaseLayout>
