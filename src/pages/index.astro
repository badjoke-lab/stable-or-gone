---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatLifecycleLabel } from '../utils/publicTaxonomy';
import { formatReferenceTargetLabel } from '../utils/referenceTarget';
import { resolvePrimaryRelationshipForStablecoin } from '../utils/primaryDisplayRelationship';
import { getStablecoins, getOrganizations, getRelationships, getEvents, getEvidence } from '../lib/data/registry';
import { getEvidenceSourceIdentitySummary } from '../lib/data/evidenceSources';

const stablecoins = getStablecoins();
const organizations = getOrganizations();
const relationships = getRelationships();
const events = getEvents();
const evidence = getEvidence();
const evidenceSummary = getEvidenceSourceIdentitySummary();

const organizationById = new Map(organizations.map((organization) => [organization.id, organization] as const));
const primaryOrganization = (stablecoinId: string) => {
  const relationship = resolvePrimaryRelationshipForStablecoin(stablecoinId, relationships).relationship;
  return relationship ? organizationById.get(relationship.organization_id) : undefined;
};
const recordDomain = (coin: unknown) => {
  const candidate = coin as { official_domain?: string; official_url?: string };
  if (candidate.official_domain) return candidate.official_domain;
  if (!candidate.official_url) return '';
  try { return new URL(candidate.official_url).hostname; } catch { return ''; }
};
const evidenceCount = (stablecoinId: string) => evidence.filter((item) =>
  item.stablecoin_id === stablecoinId || (item.stablecoin_ids ?? []).includes(stablecoinId)
).length;
const eventCount = (stablecoinId: string) => events.filter((event) =>
  event.stablecoin_id === stablecoinId || (event.subject_stablecoin_ids ?? []).includes(stablecoinId)
).length;
const lifecycleOptions = [...new Set(stablecoins.map((coin) => coin.lifecycle_status || 'unknown'))]
  .sort((left, right) => formatLifecycleLabel(left).localeCompare(formatLifecycleLabel(right)));
const latestVerified = stablecoins.map((coin) => coin.last_verified_at).filter(Boolean).sort().at(-1) ?? '—';

const entryCards = [
  { href: '/stablecoins/', number: '01', title: 'Stablecoin records', text: 'Canonical assets, lifecycle states, reference targets, backing models, and unresolved questions.' },
  { href: '/issuers/', number: '02', title: 'Organizations', text: 'Issuers, operators, reserve managers, custodians, governance bodies, and related institutions.' },
  { href: '/events/', number: '03', title: 'Material events', text: 'Launches, restrictions, depegs, migrations, wind-downs, collapses, recoveries, and regulatory actions.' },
  { href: '/timeline/', number: '04', title: 'Historical timeline', text: 'Chronological access to the events that changed stablecoin records and their institutional context.' },
  { href: '/access-and-regulation/', number: '05', title: 'Access and regulation', text: 'Market access, regional distribution, regulatory treatment, and documented availability constraints.' },
  { href: '/stats/', number: '06', title: 'Registry statistics', text: 'Lifecycle, model, organization, event, evidence, access, and data-quality distributions.' }
];

const rows = [...stablecoins].sort((left, right) => left.name.localeCompare(right.name)).map((coin) => {
  const organization = primaryOrganization(coin.id);
  const domain = recordDomain(coin);
  const lifecycle = coin.lifecycle_status || 'unknown';
  return {
    coin,
    organization,
    domain,
    lifecycle,
    reference: formatReferenceTargetLabel(coin),
    evidence: evidenceCount(coin.id),
    events: eventCount(coin.id),
    search: [
      coin.name,
      coin.symbol,
      coin.slug,
      ...(coin.aliases ?? []),
      domain,
      organization?.name,
      lifecycle,
      formatLifecycleLabel(lifecycle),
      formatReferenceTargetLabel(coin)
    ].filter(Boolean).join(' ').normalize('NFKC').toLocaleLowerCase().replace(/\s+/g, ' ').trim()
  };
});

const title = 'Stable or Gone — Stablecoin Historical Registry';
const description = 'A source-backed historical registry of stablecoins, connected organizations, material events, access conditions, and evidence.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Stable or Gone',
  url: 'https://sog.badjoke-lab.com/',
  description,
  inLanguage: 'en'
};
---
<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <div class="home-ledger">
    <section class="home-intro" aria-labelledby="home-title">
      <div class="home-intro-copy">
        <p class="kicker">Stablecoin history</p>
        <h1 id="home-title">The historical record of stablecoins, issuers, market access, and failure.</h1>
        <p class="lede">Stable or Gone documents how stable assets launched, changed, lost access, migrated, recovered, wound down, or collapsed. It connects asset identity, organizations, events, evidence, and known unknowns.</p>
      </div>
      <dl class="home-facts" aria-label="Registry summary">
        <div><dt>Stablecoins</dt><dd>{stablecoins.length}<small> stable assets</small></dd></div>
        <div><dt>Organizations</dt><dd>{organizations.length}<small> organizations</small></dd></div>
        <div><dt>Events</dt><dd>{events.length}<small> events</small></dd></div>
        <div><dt>Evidence</dt><dd>{evidence.length}<small> source records</small><small>Source identities {evidenceSummary.source_identities}</small></dd></div>
      </dl>
    </section>

    <section class="archive-note" aria-label="Registry scope note">
      <span>Evidence-based static registry</span>
      <span>Last verified {latestVerified}</span>
      <span>Not a ranking or market dashboard</span>
    </section>

    <section class="directory-section" aria-labelledby="directory-title">
      <div class="section-heading">
        <div>
          <p class="kicker">Archive directory</p>
          <h2 id="directory-title">Explore the record</h2>
        </div>
        <p>Cross-record views separate lifecycle, organizations, events, access, evidence, and statistical context.</p>
      </div>
      <div class="editorial-directory">
        {entryCards.map((card) => (
          <a href={card.href}>
            <span class="directory-number">{card.number}</span>
            <span class="directory-copy"><strong>{card.title}</strong><small>{card.text}</small></span>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="registry-section" aria-labelledby="registry-title">
      <div class="section-heading">
        <div>
          <p class="kicker">Stablecoin registry</p>
          <h2 id="registry-title">Browse all records</h2>
        </div>
        <p>Search and filter the complete canonical stablecoin registry. Current view state remains shareable by URL.</p>
      </div>

      <div class="registry-panel">
        <div class="controls" aria-label="Registry filters">
          <label class="control-field search-field">
            <span>Search</span>
            <input id="registrySearch" type="search" placeholder="Name, symbol, alias, domain, organization…" autocomplete="off" />
          </label>
          <label class="control-field">
            <span>Lifecycle</span>
            <select id="lifecycleFilter">
              <option value="">All lifecycle states</option>
              {lifecycleOptions.map((status) => <option value={status}>{formatLifecycleLabel(status)}</option>)}
            </select>
          </label>
          <label class="control-field">
            <span>Sort</span>
            <select id="sortSelect">
              <option value="name-asc">Name A–Z</option>
              <option value="name-desc">Name Z–A</option>
              <option value="review-desc">Recently reviewed</option>
              <option value="evidence-desc">Most evidence</option>
              <option value="lifecycle-asc">Lifecycle A–Z</option>
            </select>
          </label>
          <button id="copyCurrentView" class="ghost-button" type="button">Copy view link</button>
          <button id="clearFilters" class="ghost-button" type="button">Clear</button>
        </div>

        <div class="registry-count" aria-live="polite">
          Showing <strong id="visibleCount">{rows.length}</strong> of <strong>{rows.length}</strong> stablecoins
          <span id="copyStatus" class="copy-status" aria-live="polite"></span>
        </div>

        <div class="table-wrap home-registry-table-wrap">
          <table id="registryTable" class="home-registry-table">
            <thead>
              <tr>
                <th>Stablecoin</th>
                <th>Lifecycle</th>
                <th>Reference</th>
                <th>Primary organization</th>
                <th>Reviewed</th>
                <th>Evidence / events</th>
              </tr>
            </thead>
            <tbody id="registryBody">
              {rows.map(({ coin, organization, domain, lifecycle, reference, evidence: sourceCount, events: linkedEvents, search }) => (
                <tr
                  data-row="stablecoin"
                  data-search={search}
                  data-name={coin.name}
                  data-lifecycle={lifecycle}
                  data-review={coin.last_verified_at || ''}
                  data-evidence={sourceCount}
                >
                  <td data-label="Stablecoin">
                    <a href={`/stablecoin/${coin.slug}/`}><strong>{coin.name}</strong></a>
                    <small>{coin.symbol || 'No symbol'}{domain ? ` · ${domain}` : ''}</small>
                  </td>
                  <td data-label="Lifecycle"><span class={`chip ${lifecycle}`}>{formatLifecycleLabel(lifecycle)}</span></td>
                  <td data-label="Reference">{reference}</td>
                  <td data-label="Primary organization">
                    {organization ? <a href={`/issuer/${organization.slug}/`}>{organization.name}</a> : 'No primary organization recorded'}
                  </td>
                  <td data-label="Reviewed"><strong>{coin.last_verified_at || 'Not recorded'}</strong></td>
                  <td data-label="Evidence / events"><strong>{sourceCount} sources</strong><small>{linkedEvents} events</small></td>
                </tr>
              ))}
            </tbody>
          </table>
          <p id="emptyState" class="empty-state" hidden>No stablecoins match the current filters.</p>
        </div>
      </div>
    </section>
  </div>

  <script>
    const searchInput = document.querySelector('#registrySearch');
    const lifecycleFilter = document.querySelector('#lifecycleFilter');
    const sortSelect = document.querySelector('#sortSelect');
    const copyButton = document.querySelector('#copyCurrentView');
    const clearButton = document.querySelector('#clearFilters');
    const visibleCount = document.querySelector('#visibleCount');
    const emptyState = document.querySelector('#emptyState');
    const copyStatus = document.querySelector('#copyStatus');
    const tbody = document.querySelector('#registryBody');
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('[data-row="stablecoin"]'));
    type RegistryControls = { q: string; lifecycle: string; sort: string };

    function compareRows(a: HTMLTableRowElement, b: HTMLTableRowElement, sort: string) {
      if (!(a instanceof HTMLElement) || !(b instanceof HTMLElement)) return 0;
      if (sort === 'name-desc') return String(b.dataset.name).localeCompare(String(a.dataset.name));
      if (sort === 'review-desc') return String(b.dataset.review).localeCompare(String(a.dataset.review)) || String(a.dataset.name).localeCompare(String(b.dataset.name));
      if (sort === 'evidence-desc') return Number(b.dataset.evidence || 0) - Number(a.dataset.evidence || 0) || String(a.dataset.name).localeCompare(String(b.dataset.name));
      if (sort === 'lifecycle-asc') return String(a.dataset.lifecycle).localeCompare(String(b.dataset.lifecycle)) || String(a.dataset.name).localeCompare(String(b.dataset.name));
      return String(a.dataset.name).localeCompare(String(b.dataset.name));
    }

    function readControls(): RegistryControls {
      return {
        q: searchInput instanceof HTMLInputElement ? searchInput.value.trim() : '',
        lifecycle: lifecycleFilter instanceof HTMLSelectElement ? lifecycleFilter.value : '',
        sort: sortSelect instanceof HTMLSelectElement ? sortSelect.value : 'name-asc'
      };
    }

    function writeUrlState(controls: RegistryControls) {
      const params = new URLSearchParams();
      if (controls.q) params.set('q', controls.q);
      if (controls.lifecycle) params.set('lifecycle', controls.lifecycle);
      if (controls.sort && controls.sort !== 'name-asc') params.set('sort', controls.sort);
      const nextUrl = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ''}`;
      window.history.replaceState(null, '', nextUrl);
    }

    function restoreFromUrl() {
      const params = new URLSearchParams(window.location.search);
      if (searchInput instanceof HTMLInputElement) searchInput.value = params.get('q') || '';
      if (lifecycleFilter instanceof HTMLSelectElement) lifecycleFilter.value = params.get('lifecycle') || '';
      if (sortSelect instanceof HTMLSelectElement) sortSelect.value = params.get('sort') || 'name-asc';
    }

    function applyFilters() {
      if (!(tbody instanceof HTMLElement)) return;
      const controls = readControls();
      const query = controls.q.normalize('NFKC').toLocaleLowerCase().replace(/\s+/g, ' ');
      let shown = 0;
      for (const row of [...rows].sort((a, b) => compareRows(a, b, controls.sort))) {
        if (!(row instanceof HTMLTableRowElement)) continue;
        const visible = (!query || String(row.dataset.search).includes(query))
          && (!controls.lifecycle || row.dataset.lifecycle === controls.lifecycle);
        row.hidden = !visible;
        tbody.appendChild(row);
        if (visible) shown += 1;
      }
      if (visibleCount instanceof HTMLElement) visibleCount.textContent = String(shown);
      if (emptyState instanceof HTMLElement) emptyState.hidden = shown !== 0;
      writeUrlState(controls);
    }

    async function copyCurrentView() {
      writeUrlState(readControls());
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (copyStatus instanceof HTMLElement) copyStatus.textContent = 'View link copied';
      } catch {
        if (copyStatus instanceof HTMLElement) copyStatus.textContent = 'Copy failed';
      }
      window.setTimeout(() => { if (copyStatus instanceof HTMLElement) copyStatus.textContent = ''; }, 1800);
    }

    restoreFromUrl();
    applyFilters();
    searchInput?.addEventListener('input', applyFilters);
    lifecycleFilter?.addEventListener('change', applyFilters);
    sortSelect?.addEventListener('change', applyFilters);
    copyButton?.addEventListener('click', copyCurrentView);
    clearButton?.addEventListener('click', () => {
      if (searchInput instanceof HTMLInputElement) searchInput.value = '';
      if (lifecycleFilter instanceof HTMLSelectElement) lifecycleFilter.value = '';
      if (sortSelect instanceof HTMLSelectElement) sortSelect.value = 'name-asc';
      applyFilters();
    });
  </script>
</BaseLayout>
