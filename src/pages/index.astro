---
import BaseLayout from '../layouts/BaseLayout.astro';
import stablecoinsData from '../../data/stablecoins.json';
import issuersData from '../../data/issuers.json';
import eventsData from '../../data/events.json';
import evidenceData from '../../data/evidence.json';

type StablecoinRow = {
  slug: string;
  name: string;
  symbol?: string;
  peg_asset?: string;
  collateral_model?: string;
  status?: string;
  issuer_id?: string;
};

const stablecoins = stablecoinsData as StablecoinRow[];
const issuers = issuersData as unknown[];
const events = eventsData as unknown[];
const evidence = evidenceData as unknown[];

const stablecoinCount = stablecoins.length;
const issuerCount = issuers.length;
const eventCount = events.length;
const evidenceCount = evidence.length;
---
<BaseLayout>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">&gt; open /registry/stablecoins</div>
      <h1>Stablecoin records, depeg events, and evidence.</h1>
      <p>
        Stable or Gone is a terminal-style registry for stablecoins, issuers, reserve disclosure,
        redemption access, event history, lifecycle changes, and source-backed evidence.
      </p>
    </div>
    <div class="panel stats" aria-label="Registry summary">
      <div class="stat"><span>Stablecoins</span><strong>{stablecoinCount}</strong></div>
      <div class="stat"><span>Issuers</span><strong>{issuerCount}</strong></div>
      <div class="stat"><span>Events</span><strong>{eventCount}</strong></div>
      <div class="stat"><span>Evidence</span><strong>{evidenceCount}</strong></div>
    </div>
  </section>

  <section class="section-grid" aria-label="Registry sections">
    <a class="panel mini-card" href="/stablecoins/">
      <h2>Stablecoin Registry</h2>
      <p>Active, limited, impaired, discontinued, failed, migrated, and unknown stablecoin records.</p>
    </a>
    <a class="panel mini-card" href="/events/">
      <h2>Event Log</h2>
      <p>Depeg, reserve, redemption, wind-down, migration, and related historical events.</p>
    </a>
    <a class="panel mini-card" href="/issuers/">
      <h2>Issuer Files</h2>
      <p>Issuer, protocol, jurisdiction, reserve disclosure, and related stablecoin references.</p>
    </a>
  </section>

  <section class="panel registry">
    <div class="bar">source: data/stablecoins.json</div>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Symbol</th>
          <th>Peg</th>
          <th>Model</th>
          <th>Status</th>
          <th>Issuer</th>
        </tr>
      </thead>
      <tbody>
        {stablecoins.length === 0 ? (
          <tr>
            <td colspan="6">No stablecoin records yet. First seed batch comes next.</td>
          </tr>
        ) : stablecoins.slice(0, 8).map((coin) => (
          <tr>
            <td><a href={`/stablecoin/${coin.slug}/`}>{coin.name}</a></td>
            <td>{coin.symbol ?? '—'}</td>
            <td>{coin.peg_asset ?? '—'}</td>
            <td>{coin.collateral_model ?? '—'}</td>
            <td><span class="chip active">{coin.status ?? 'unknown'}</span></td>
            <td>{coin.issuer_id ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</BaseLayout>
