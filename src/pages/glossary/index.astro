---
import BaseLayout from '../../layouts/BaseLayout.astro';
const terms = [
  ['depeg', 'A material deviation from the target peg. SOG does not record every small movement.'],
  ['redemption', 'The process of converting a stablecoin back under issuer terms.'],
  ['attestation', 'A reserve-related report or statement.'],
  ['wind-down', 'A planned or announced process to discontinue support.'],
  ['collapse', 'A severe historical event requiring stronger supporting sources.'],
  ['open question', 'An explicit uncertainty kept visible instead of being guessed.']
];
---
<BaseLayout title="Glossary — Stable or Gone">
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">&gt; help glossary</div>
      <h1>Glossary</h1>
      <p>Short definitions for terms used across the SOG registry.</p>
    </div>
  </section>
  <section class="panel registry">
    <div class="bar">working glossary</div>
    <table>
      <thead><tr><th>Term</th><th>Definition</th></tr></thead>
      <tbody>
        {terms.map(([term, definition]) => (
          <tr><td>{term}</td><td>{definition}</td></tr>
        ))}
      </tbody>
    </table>
  </section>
</BaseLayout>
