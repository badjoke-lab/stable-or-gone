---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/ui-remediation-r7.css';
const wallets = [
  { asset: 'BTC', name: 'Bitcoin', network: 'Bitcoin network', address: 'bc1qk3y8x72me37aj8d236z9v0gu42t8xxr2ytspmd' },
  { asset: 'ETH', name: 'Ether', network: 'Ethereum Mainnet', address: '0xea2a0fb0def0473d161b7958f6d584533db9202d' },
  { asset: 'USDT', name: 'Tether USD', network: 'Ethereum · ERC-20', address: '0xea2a0fb0def0473d161b7958f6d584533db9202d' },
  { asset: 'USDC', name: 'USD Coin', network: 'Ethereum · ERC-20', address: '0xea2a0fb0def0473d161b7958f6d584533db9202d' },
  { asset: 'SOL', name: 'Solana', network: 'Solana network', address: '9e9kZkwA6tYYAfCzb76aimta26yyPEgR39GZK2oBVH3q' },
  { asset: 'BNB', name: 'BNB', network: 'BNB Smart Chain · BEP-20', address: '0xea2a0fb0def0473d161b7958f6d584533db9202d' },
  { asset: 'DOGE', name: 'Dogecoin', network: 'Dogecoin network', address: 'DP1m7675rSCZC5s5wzWSHNaA9bLVpsyjse' },
  { asset: 'AVAX', name: 'Avalanche', network: 'Avalanche C-Chain', address: '0xea2a0fb0def0473d161b7958f6d584533db9202d' },
  { asset: 'XRP', name: 'XRP', network: 'XRP Ledger', address: 'rUHSmDUteyPSr7FDq4p3BzQV627gSiJdCr', note: 'Destination tag / memo is optional for this address. Leave it blank unless your wallet requires a value.' }
];
const googleFormUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSeEUxdPktIm46X0HgwuYvk8vpx0N3R0EezOaC2fz64nfE6JjA/viewform?usp=dialog';
const githubIssueUrl = 'https://github.com/badjoke-lab/stable-or-gone/issues/new/choose';
const title = 'Support Stable or Gone';
const description = 'Support ongoing research, source checks, link maintenance, and new stablecoin records using the listed crypto addresses.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: 'https://sog.badjoke-lab.com/support/', description, isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' } };
---
<BaseLayout title={title} description={description} canonicalPath="/support/" jsonLd={jsonLd}>
  <article class="r7-page r7-support-page" data-r7-page="support" data-ui-v3-utility="support">
    <header class="r7-masthead"><div class="r7-masthead-copy"><p class="r7-eyebrow">Utility / support</p><h1>Support independent maintenance</h1><p class="r7-lead">Optional support helps cover research, source checks, broken-link review, new records, and public infrastructure. It never changes editorial decisions.</p></div><dl class="r7-facts"><div><dt>Use</dt><dd>Research and maintenance</dd></div><div><dt>Editorial influence</dt><dd>None</dd></div><div><dt>Payment type</dt><dd>Crypto transfer</dd></div><div><dt>Receipts</dt><dd>Not issued</dd></div></dl></header>

    <section class="r7-section"><div class="r7-section-heading"><h2>What support funds</h2><p>Funding is operational, not editorial.</p></div><dl class="r7-row-list"><div><dt>Research</dt><dd>Reviewing issuer documents, regulator notices, repositories, archives, and independent reporting.</dd></div><div><dt>Evidence maintenance</dt><dd>Checking source links, preserving archives, repairing broken references, and clarifying claim scope.</dd></div><div><dt>Registry growth</dt><dd>Adding reviewed stablecoins, organizations, events, deployments, and known unknowns.</dd></div><div><dt>Public infrastructure</dt><dd>Maintaining the site, validation workflows, machine-readable outputs, and monitoring tools.</dd></div></dl></section>

    <section class="r7-section"><div class="r7-section-heading"><h2>Editorial independence</h2><p>Support does not purchase inclusion, wording, priority, or a favorable classification.</p></div><dl class="r7-row-list"><div><dt>No paid listings</dt><dd>A payment cannot add or remove a stablecoin, organization, event, or Evidence source.</dd></div><div><dt>No favorable treatment</dt><dd>Support does not change confidence, lifecycle status, event treatment, corrections, or methodology.</dd></div><div><dt>Open corrections</dt><dd>Anyone may submit a source-backed correction without making a payment.</dd></div></dl></section>

    <details class="r7-disclosure r7-donation-action" data-donation-action data-disclosure><summary><span>Choose a donation asset</span><span>{wallets.length} options</span></summary><div class="r7-disclosure-body"><p>Select the exact asset and network shown. Sending through a different network can result in permanent loss. Check the full address and consider a small test transfer.</p><div class="r7-wallet-list">{wallets.map((wallet) => <div class="r7-wallet-row"><strong>{wallet.asset}</strong><span>{wallet.network}</span><code>{wallet.address}</code><button type="button" data-copy-address={wallet.address} aria-label={`Copy ${wallet.asset} support address`}>Copy</button>{wallet.note && <small>{wallet.note}</small>}</div>)}</div><p class="copy-status" data-copy-status aria-live="polite"></p></div></details>

    <details class="r7-disclosure" data-disclosure><summary>Transfer and tax limits</summary><div class="r7-disclosure-body"><p>Crypto transfers are generally irreversible. Stable or Gone does not provide tax advice, does not issue charitable donation receipts, and cannot recover a transfer sent to the wrong asset, network, or address.</p></div></details>

    <div class="r7-secondary-links"><a href={googleFormUrl} target="_blank" rel="noopener noreferrer">Submit a correction</a><a href={githubIssueUrl} target="_blank" rel="noopener noreferrer">Open public issue</a><a href="/about/">About editorial independence</a></div>

    <script is:inline>
      (() => {
        const status = document.querySelector('[data-copy-status]');
        const buttons = document.querySelectorAll('[data-copy-address]');
        const fallbackCopy = (value) => {
          const textarea = document.createElement('textarea');
          textarea.value = value;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          const copied = document.execCommand('copy');
          textarea.remove();
          return copied;
        };
        buttons.forEach((button) => {
          button.addEventListener('click', async () => {
            const address = button.getAttribute('data-copy-address') || '';
            const originalLabel = button.textContent;
            let copied = false;
            try {
              if (navigator.clipboard && window.isSecureContext) { await navigator.clipboard.writeText(address); copied = true; }
              else copied = fallbackCopy(address);
            } catch { copied = fallbackCopy(address); }
            button.textContent = copied ? 'Copied' : 'Copy failed';
            button.setAttribute('data-copy-state', copied ? 'success' : 'error');
            if (status) status.textContent = copied ? 'Address copied to clipboard.' : 'Could not copy automatically. Select and copy the address manually.';
            window.setTimeout(() => { button.textContent = originalLabel; button.removeAttribute('data-copy-state'); }, 1800);
          });
        });
      })();
    </script>
  </article>
</BaseLayout>
