---
import BaseLayout from '../../layouts/BaseLayout.astro';

const wallets = [
  { asset: 'BTC', name: 'Bitcoin', network: 'Bitcoin network', address: 'bc1qk3y8x72me37aj8d236z9v0gu42t8xxr2ytspmd' },
  { asset: 'ETH', name: 'Ether', network: 'Ethereum Mainnet', address: '0xea2a0fb0def0473d161b7958f6d584533db9202d' },
  { asset: 'USDT', name: 'Tether USD', network: 'Ethereum · ERC-20', address: '0xea2a0fb0def0473d161b7958f6d584533db9202d' },
  { asset: 'USDC', name: 'USD Coin', network: 'Ethereum · ERC-20', address: '0xea2a0fb0def0473d161b7958f6d584533db9202d' },
  { asset: 'SOL', name: 'Solana', network: 'Solana network', address: '9e9kZkwA6tYYAfCzb76aimta26yyPEgR39GZK2oBVH3q' },
  { asset: 'BNB', name: 'BNB', network: 'BNB Smart Chain · BEP-20', address: '0xea2a0fb0def0473d161b7958f6d584533db9202d' },
  { asset: 'DOGE', name: 'Dogecoin', network: 'Dogecoin network', address: 'DP1m7675rSCZC5s5wzWSHNaA9bLVpsyjse' },
  { asset: 'AVAX', name: 'Avalanche', network: 'Avalanche C-Chain', address: '0xea2a0fb0def0473d161b7958f6d584533db9202d' },
  { asset: 'XRP', name: 'XRP', network: 'XRP Ledger', address: 'rUHSmDUteyPSr7FDq4p3BzQV627gSiJdCr', note: 'Destination tag / memo is optional for this address. Leave it blank unless your wallet requires a value.' }
];

const title = 'Support Stable or Gone';
const description = 'Support ongoing research, source checks, link maintenance, and new stablecoin records using the listed crypto addresses.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  url: 'https://sog.badjoke-lab.com/support/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' }
};
---

<BaseLayout title={title} description={description} canonicalPath="/support/" jsonLd={jsonLd}>
  <section class="hero support-hero">
    <div class="panel hero-main">
      <div class="prompt">Support the archive</div>
      <h1>Help keep Stable or Gone updated</h1>
      <p>Support helps cover research, source checks, broken-link review, new records, and ongoing site maintenance.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Supported assets</span><strong>{wallets.length}</strong></div>
      <div class="stat"><span>Use</span><strong>Maintenance</strong></div>
    </div>
  </section>

  <section class="panel support-intro" aria-labelledby="before-sending">
    <div class="bar" id="before-sending">Before sending</div>
    <div class="support-intro-body">
      <p>Select the exact asset and network shown below. Sending through a different network can result in permanent loss. Check the full address before confirming and consider a small test transfer first.</p>
      <p>Support is optional. It does not affect which records are included, how they are written, or how corrections are reviewed. Crypto transfers are generally irreversible, and charitable donation receipts are not issued.</p>
    </div>
  </section>

  <section class="wallet-section" aria-labelledby="wallet-addresses">
    <div class="section-heading">
      <div>
        <div class="prompt">Available payment options</div>
        <h2 id="wallet-addresses">Wallet addresses</h2>
      </div>
      <p>Use only the network shown on each card.</p>
    </div>

    <div class="wallet-grid">
      {wallets.map((wallet) => (
        <article class="panel wallet-card">
          <header class="wallet-card-header">
            <div>
              <span class="asset-symbol">{wallet.asset}</span>
              <h3>{wallet.name}</h3>
            </div>
            <span class="network-chip">{wallet.network}</span>
          </header>

          <div class="address-block">
            <span class="address-label">Address</span>
            <code>{wallet.address}</code>
            <button class="copy-button" type="button" data-copy-address={wallet.address} aria-label={`Copy ${wallet.asset} support address`}>Copy address</button>
          </div>

          {wallet.note && <p class="network-note">{wallet.note}</p>}
        </article>
      ))}
    </div>

    <p class="copy-status" data-copy-status aria-live="polite"></p>
  </section>

  <section class="section-grid support-principles">
    <div class="panel mini-card">
      <h2>What support funds</h2>
      <p>Research, source review, record updates, link maintenance, and expansion of the archive.</p>
    </div>
    <div class="panel mini-card">
      <h2>What support does not buy</h2>
      <p>Listings, favorable wording, faster corrections, status changes, or influence over the methodology.</p>
    </div>
    <div class="panel mini-card">
      <h2>Corrections remain open</h2>
      <p>Anyone can submit a correction or stronger source through the contact page or GitHub Issues.</p>
    </div>
  </section>

  <section class="panel support-footer-note">
    <div class="bar">Questions or corrections</div>
    <div class="support-footer-body">
      <p>To report incorrect information, add a source, or suggest a missing record, use the <a href="/contact/">contact page</a> or <a href="https://github.com/badjoke-lab/stable-or-gone/issues">GitHub Issues</a>.</p>
      <p>Stable or Gone provides historical information only. Check current issuer terms, exchange notices, and market data before making decisions.</p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const status = document.querySelector('[data-copy-status]');
      const buttons = document.querySelectorAll('[data-copy-address]');
      const fallbackCopy = (value) => {
        const textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        const copied = document.execCommand('copy');
        textarea.remove();
        return copied;
      };
      buttons.forEach((button) => {
        button.addEventListener('click', async () => {
          const address = button.getAttribute('data-copy-address') || '';
          const originalLabel = button.textContent;
          let copied = false;
          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(address);
              copied = true;
            } else {
              copied = fallbackCopy(address);
            }
          } catch {
            copied = fallbackCopy(address);
          }
          button.textContent = copied ? 'Copied' : 'Copy failed';
          button.setAttribute('data-copy-state', copied ? 'success' : 'error');
          if (status) status.textContent = copied ? 'Address copied to clipboard.' : 'Could not copy automatically. Select and copy the address manually.';
          window.setTimeout(() => {
            button.textContent = originalLabel;
            button.removeAttribute('data-copy-state');
          }, 1800);
        });
      });
    })();
  </script>

  <style>
    .support-hero p { max-width: 72ch; }
    .support-intro { margin-top: 20px; }
    .support-intro-body, .support-footer-body { display: grid; gap: 12px; padding: 18px; }
    .support-intro-body p, .support-footer-body p { max-width: none; }
    .wallet-section { margin-top: 28px; }
    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 18px; margin-bottom: 16px; }
    .section-heading .prompt { margin-bottom: 8px; }
    .section-heading h2 { font-size: clamp(26px, 4vw, 40px); }
    .section-heading > p { text-align: right; font-size: 12px; }
    .wallet-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .wallet-card { min-width: 0; padding: 18px; }
    .wallet-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 16px; }
    .wallet-card-header > div { min-width: 0; }
    .asset-symbol { display: block; color: var(--green); font-size: 12px; letter-spacing: 0.1em; margin-bottom: 4px; }
    .wallet-card h3 { font-size: 20px; letter-spacing: -0.03em; }
    .network-chip { flex: 0 0 auto; max-width: 52%; border: 1px solid var(--line); color: var(--gold); padding: 5px 8px; font-size: 10px; line-height: 1.35; text-align: right; }
    .address-block { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px 12px; align-items: center; padding: 14px; border: 1px solid var(--line-soft); background: rgba(6, 16, 24, 0.58); }
    .address-label { grid-column: 1 / -1; color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; }
    .address-block code { min-width: 0; color: var(--text); font-size: 12px; line-height: 1.55; overflow-wrap: anywhere; word-break: break-word; user-select: all; }
    .copy-button { min-height: 40px; border: 1px solid rgba(113, 214, 255, 0.55); background: rgba(113, 214, 255, 0.08); color: var(--cyan); padding: 8px 11px; cursor: pointer; white-space: nowrap; }
    .copy-button:hover, .copy-button:focus-visible { border-color: var(--cyan); background: rgba(113, 214, 255, 0.14); outline: none; }
    .copy-button[data-copy-state='success'] { color: var(--green); border-color: rgba(102, 209, 158, 0.7); background: rgba(102, 209, 158, 0.1); }
    .copy-button[data-copy-state='error'] { color: var(--red); border-color: rgba(221, 109, 109, 0.7); background: rgba(221, 109, 109, 0.1); }
    .network-note { margin-top: 12px; padding-left: 11px; border-left: 2px solid var(--amber); color: var(--amber); font-size: 12px; max-width: none; }
    .copy-status { min-height: 1.5em; margin-top: 10px; color: var(--green); font-size: 12px; }
    .support-principles { margin-top: 8px; }
    .support-footer-note { margin-top: 20px; }
    @media (max-width: 820px) {
      .wallet-grid { grid-template-columns: 1fr; }
      .section-heading { display: grid; align-items: start; }
      .section-heading > p { text-align: left; }
    }
    @media (max-width: 560px) {
      .wallet-card { padding: 14px; }
      .wallet-card-header { display: grid; }
      .network-chip { max-width: 100%; width: fit-content; text-align: left; }
      .address-block { grid-template-columns: 1fr; }
      .address-label { grid-column: auto; }
      .copy-button { width: 100%; }
    }
  </style>
</BaseLayout>