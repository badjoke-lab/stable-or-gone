---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPublicLabel, formatStatusLabel } from '../../utils/displayLabels';
import { issuerPublicSummaries } from '../../data/issuerPublicCopy';
import issuersData from '../../../data/issuers.json';
import issuersExtraData from '../../../data/issuers-extra.json';
import stablecoinsData from '../../../data/stablecoins.json';
import stablecoinsExtraData from '../../../data/stablecoins-extra.json';
import eventsData from '../../../data/events.json';
import eventsPr036Data from '../../../data/events-pr036.json';
import eventsPr037Data from '../../../data/events-pr037.json';
import eventsPr038Data from '../../../data/events-pr038.json';
import evidenceData from '../../../data/evidence.json';
import evidenceExtraData from '../../../data/evidence-extra.json';
import evidenceEventsPr036Data from '../../../data/evidence-events-pr036.json';
import evidenceEventsPr037Data from '../../../data/evidence-events-pr037.json';
import evidenceEventsPr038Data from '../../../data/evidence-events-pr038.json';

type IssuerRow = { id: string; slug: string; name: string; summary?: string; issuer_type?: string; jurisdiction?: string; related_stablecoins?: string[]; official_url?: string; confidence?: string; last_verified_at?: string; notes?: string; };
type StablecoinRow = { id: string; slug: string; name: string; symbol?: string; status?: string; issuer_id?: string; };
type EventRow = { id: string; issuer_id?: string; title: string; event_type?: string; event_date?: string | null; };
type EvidenceRow = { id: string; issuer_id?: string; stablecoin_id?: string; title: string; url: string; source_type?: string; };

export function getStaticPaths() {
  const issuers = [...(issuersData as IssuerRow[]), ...(issuersExtraData as IssuerRow[])];
  return issuers.map((issuer) => ({ params: { slug: issuer.slug }, props: { issuer } }));
}

const { issuer } = Astro.props as { issuer: IssuerRow };
const allStablecoins = [...(stablecoinsData as StablecoinRow[]), ...(stablecoinsExtraData as StablecoinRow[])];
const allEvents = [...(eventsData as EventRow[]), ...(eventsPr036Data as EventRow[]), ...(eventsPr037Data as EventRow[]), ...(eventsPr038Data as EventRow[])];
const allEvidence = [...(evidenceData as EvidenceRow[]), ...(evidenceExtraData as EvidenceRow[]), ...(evidenceEventsPr036Data as EvidenceRow[]), ...(evidenceEventsPr037Data as EvidenceRow[]), ...(evidenceEventsPr038Data as EvidenceRow[])];
const stablecoins = allStablecoins.filter((coin) => coin.issuer_id === issuer.id);
const stablecoinIds = new Set(stablecoins.map((coin) => coin.id));
const events = allEvents.filter((event) => event.issuer_id === issuer.id);
const evidence = allEvidence.filter((source) => source.issuer_id === issuer.id || (source.stablecoin_id && stablecoinIds.has(source.stablecoin_id)));
const summary = issuerPublicSummaries[issuer.slug] ?? issuer.summary ?? 'A summary has not yet been added.';
const title = `${issuer.name} — Stablecoin Issuer and Protocol History | Stable or Gone`;
const description = `${issuer.name} profile, related stablecoins, major events, jurisdiction, official links, and sources.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: issuer.name,
  url: issuer.official_url || `https://sog.badjoke-lab.com/issuer/${issuer.slug}/`,
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  sameAs: issuer.official_url ? [issuer.official_url] : undefined
};
---
<BaseLayout title={title} description={description} canonicalPath={`/issuer/${issuer.slug}/`} jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">Issuer and protocol record</div>
      <h1>{issuer.name}</h1>
      <p>{summary}</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Stablecoins</span><strong>{stablecoins.length}</strong></div>
      <div class="stat"><span>Sources</span><strong>{evidence.length}</strong></div>
    </div>
  </section>

  <section class="section-grid" aria-label="Related pages">
    <a class="panel mini-card" href="/issuers/"><h2>All issuers</h2><p>Browse every company, protocol, and organization in the archive.</p></a>
    <a class="panel mini-card" href="/stablecoins/"><h2>All stablecoins</h2><p>Open the asset records connected to these issuer and protocol profiles.</p></a>
    <a class="panel mini-card" href="/guides/reserve-disclosure-basics/"><h2>Reading reserve disclosures</h2><p>Understand issuer reports, attestations, audits, and protocol collateral data.</p></a>
  </section>

  <section class="panel registry">
    <div class="bar">Overview</div>
    <table><tbody>
      <tr><th>Type</th><td>{formatPublicLabel(issuer.issuer_type)}</td></tr>
      <tr><th>Jurisdiction</th><td>{formatPublicLabel(issuer.jurisdiction, 'Unknown')}</td></tr>
      <tr><th>Official website</th><td>{issuer.official_url ? <a href={issuer.official_url}>{issuer.official_url}</a> : '—'}</td></tr>
      <tr><th>Record confidence</th><td>{formatPublicLabel(issuer.confidence)}</td></tr>
      <tr><th>Last reviewed</th><td>{issuer.last_verified_at ?? '—'}</td></tr>
    </tbody></table>
  </section>

  <section class="panel registry"><div class="bar">Related stablecoins</div><table><thead><tr><th>Name</th><th>Symbol</th><th>Status</th></tr></thead><tbody>{stablecoins.length === 0 ? <tr><td colspan="3">No related stablecoins have been added yet.</td></tr> : stablecoins.map((coin) => (<tr><td><a href={`/stablecoin/${coin.slug}/`}>{coin.name}</a></td><td>{coin.symbol ?? '—'}</td><td><span class={`chip ${coin.status ?? 'unknown'}`}>{formatStatusLabel(coin.status)}</span></td></tr>))}</tbody></table></section>
  <section class="panel registry"><div class="bar">Events</div><table><thead><tr><th>Date</th><th>Event</th><th>Type</th></tr></thead><tbody>{events.length === 0 ? <tr><td colspan="3">No issuer-level events have been added yet.</td></tr> : events.map((event) => (<tr><td>{event.event_date ?? '—'}</td><td><a href={`/event/${event.id}/`}>{event.title}</a></td><td>{formatPublicLabel(event.event_type)}</td></tr>))}</tbody></table></section>
  <section class="panel registry"><div class="bar">Sources</div><table><thead><tr><th>Source</th><th>Type</th></tr></thead><tbody>{evidence.length === 0 ? <tr><td colspan="2">No sources have been added yet.</td></tr> : evidence.map((source) => (<tr><td><a href={source.url}>{source.title}</a></td><td>{formatPublicLabel(source.source_type)}</td></tr>))}</tbody></table></section>

  <section class="panel report-box">
    <h2>Suggest a correction</h2>
    <p>Report incorrect information, add a stronger source, or suggest a missing event.</p>
    <div class="report-actions"><a data-primary="true" href="https://github.com/badjoke-lab/stable-or-gone/issues/new/choose">Start a report</a><a href="/contact/">Submission guide</a></div>
  </section>
</BaseLayout>