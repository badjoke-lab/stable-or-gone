---
import OrganizationEditorialRecord from '../../components/OrganizationEditorialRecord.astro';
import { getOrganizations, type OrganizationRow } from '../../lib/data/registry';

export function getStaticPaths() {
  return getOrganizations().map((organization) => ({ params: { slug: organization.slug }, props: { organization } }));
}

const { organization } = Astro.props as { organization: OrganizationRow };
---
<OrganizationEditorialRecord organization={organization} />
