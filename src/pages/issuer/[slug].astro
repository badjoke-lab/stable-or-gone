---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPublicLabel, formatStatusLabel } from '../../utils/displayLabels';
import { issuerPublicSummaries } from '../../data/issuerPublicCopy';
import { eventPublicCopy } from '../../data/eventPublicCopy';
import { getOrganizations, getStablecoins, getEvents, getEvidence } from '../../lib/data/registry';

export function getStaticPaths() {
  return getOrganizations().map((organization) => ({ params: { slug: organization.slug }, props: { organization } }));
}

const { organization } = Astro.props;
const allStablecoins = getStablecoins();
const allEvents = getEvents();
const allEvidence = getEvidence();
const stablecoins = allStablecoins.filter((coin) => coin.issuer_id === organization.id);
const stablecoinIds = new Set(stablecoins.map((coin) => coin.id));
const events = allEvents.filter((event) => event.issuer_id === organization.id);
const evidence = allEvidence.filter((source) => source.issuer_id === organization.id || (source.stablecoin_id && stablecoinIds.has(source.stablecoin_id)));
const summary = issuerPublicSummaries[organization.slug] ?? organization.summary ?? 'A summary has not yet been added.';
const title = `${organization.name} — Stablecoin Issuer and Protocol History | Stable or Gone`;
const description = `${organization.name} profile, related stablecoins, major events, jurisdiction, official links, and sources.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: organization.name,
  url: organization.official_url || `https://sog.badjoke-lab.com/issuer/${organization.slug}/`,
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  sameAs: organization.official_url ? [organization.official_url] : undefined
};
---
<BaseLayout title={title} description={description} canonicalPath={`/issuer/${organization.slug}/`} jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main"><div class="prompt">Issuer and protocol record</div><h1>{organization.name}</h1><p>{summary}</p></div>
    <div class="panel stats"><div class="stat"><span>Stablecoins</span><strong>{stablecoins.length}</strong></div><div class="stat"><span>Sources</span><strong>{evidence.length}</strong></div></div>
  </section>

  <section class="section-grid" aria-label="Related pages">
    <a class="panel mini-card" href="/issuers/"><h2>All issuers</h2><p>Browse every company, protocol, and organization in the archive.</p></a>
    <a class="panel mini-card" href="/stablecoins/"><h2>All stablecoins</h2><p>Open the asset records connected to these issuer and protocol profiles.</p></a>
    <a class="panel mini-card" href="/guides/reserve-disclosure-basics/"><h2>Reading reserve disclosures</h2><p>Understand issuer reports, attestations, audits, and protocol collateral data.</p></a>
  </section>

  <section class="panel registry"><div class="bar">Overview</div><table><tbody>
    <tr><th>Type</th><td>{formatPublicLabel(organization.issuer_type)}</td></tr>
    <tr><th>Jurisdiction</th><td>{formatPublicLabel(organization.jurisdiction, 'Unknown')}</td></tr>
    <tr><th>Official website</th><td>{organization.official_url ? <a href={organization.official_url}>{organization.official_url}</a> : '—'}</td></tr>
    <tr><th>Record confidence</th><td>{formatPublicLabel(organization.confidence)}</td></tr>
    <tr><th>Last reviewed</th><td>{organization.last_verified_at ?? '—'}</td></tr>
  </tbody></table></section>

  <section class="panel registry"><div class="bar">Related stablecoins</div><table><thead><tr><th>Name</th><th>Symbol</th><th>Status</th></tr></thead><tbody>{stablecoins.length === 0 ? <tr><td colspan="3">No related stablecoins have been added yet.</td></tr> : stablecoins.map((coin) => (<tr><td><a href={`/stablecoin/${coin.slug}/`}>{coin.name}</a></td><td>{coin.symbol ?? '—'}</td><td><span class={`chip ${coin.status ?? 'unknown'}`}>{formatStatusLabel(coin.status)}</span></td></tr>))}</tbody></table></section>
  <section class="panel registry"><div class="bar">Events</div><table><thead><tr><th>Date</th><th>Event</th><th>Type</th></tr></thead><tbody>{events.length === 0 ? <tr><td colspan="3">No issuer-level events have been added yet.</td></tr> : events.map((event) => (<tr><td>{event.event_date ?? '—'}</td><td><a href={`/event/${event.id}/`}>{eventPublicCopy[event.id]?.title ?? event.title}</a></td><td>{formatPublicLabel(event.event_type)}</td></tr>))}</tbody></table></section>
  <section class="panel registry"><div class="bar">Sources</div><table><thead><tr><th>Source</th><th>Type</th></tr></thead><tbody>{evidence.length === 0 ? <tr><td colspan="2">No sources have been added yet.</td></tr> : evidence.map((source) => (<tr><td><a href={source.url}>{source.title}</a></td><td>{formatPublicLabel(source.source_type)}</td></tr>))}</tbody></table></section>

  <section class="panel report-box"><h2>Suggest a correction</h2><p>Report incorrect information, add a stronger source, or suggest a missing event.</p><div class="report-actions"><a data-primary="true" href="https://github.com/badjoke-lab/stable-or-gone/issues/new/choose">Start a report</a><a href="/contact/">Submission guide</a></div></section>
</BaseLayout>
