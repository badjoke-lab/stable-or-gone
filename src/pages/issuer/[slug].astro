---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IssuerControlEvents from '../../components/IssuerControlEvents.astro';
import { formatPublicLabel, formatStatusLabel } from '../../utils/displayLabels';
import { issuerPublicSummaries } from '../../data/issuerPublicCopy';
import { eventPublicCopy } from '../../data/eventPublicCopy';
import { getOrganizations, getStablecoins, getRelationships, getEvents, getEvidence } from '../../lib/data/registry';

export function getStaticPaths() {
  return getOrganizations().map((organization) => ({ params: { slug: organization.slug }, props: { organization } }));
}

const { organization } = Astro.props;
const allStablecoins = getStablecoins();
const allRelationships = getRelationships();
const allEvents = getEvents();
const allEvidence = getEvidence();
const relationships = allRelationships.filter((relationship) => relationship.organization_id === organization.id);
const stablecoinById = new Map(allStablecoins.map((coin) => [coin.id, coin] as const));
const stablecoins = relationships.map((relationship) => stablecoinById.get(relationship.stablecoin_id)).filter(Boolean);
const stablecoinIds = new Set(relationships.map((relationship) => relationship.stablecoin_id));
const events = allEvents.filter((event) => event.issuer_id === organization.id || event.subject_organization_ids?.includes(organization.id));
const issuerControlEvents = events.filter((event) => event.event_detail_kind === 'issuer_control' || event.event_type === 'issuer_freeze');
const evidence = allEvidence.filter((source) => source.issuer_id === organization.id || source.organization_ids?.includes(organization.id) || (source.stablecoin_id && stablecoinIds.has(source.stablecoin_id)) || source.stablecoin_ids?.some((id) => stablecoinIds.has(id)));
const summary = issuerPublicSummaries[organization.slug] ?? organization.summary ?? 'A summary has not yet been added.';
const title = `${organization.name} — Stablecoin Organization History | Stable or Gone`;
const description = `${organization.name} profile, stablecoin relationships, roles, major events, jurisdiction, official links, and sources.`;
const canonicalUrl = `https://sog.badjoke-lab.com/issuer/${organization.slug}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: organization.name,
  url: canonicalUrl,
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  sameAs: organization.official_url ? [organization.official_url] : undefined
};
---
<BaseLayout title={title} description={description} canonicalPath={`/issuer/${organization.slug}/`} jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main"><div class="prompt">Organization record</div><h1>{organization.name}</h1><p>{summary}</p></div>
    <div class="panel stats"><div class="stat"><span>Stablecoins</span><strong>{stablecoins.length}</strong></div><div class="stat"><span>Relationships</span><strong>{relationships.length}</strong></div><div class="stat"><span>Sources</span><strong>{evidence.length}</strong></div></div>
  </section>

  <section class="section-grid" aria-label="Related pages">
    <a class="panel mini-card" href="/issuers/"><h2>All organizations</h2><p>Browse every company, protocol, network, and reserve organization in the archive.</p></a>
    <a class="panel mini-card" href="/stablecoins/"><h2>All stablecoins</h2><p>Open the asset records connected to these organization profiles.</p></a>
    <a class="panel mini-card" href="/guides/reserve-disclosure-basics/"><h2>Reading reserve disclosures</h2><p>Understand issuer reports, attestations, audits, and protocol collateral data.</p></a>
  </section>

  <section class="panel registry"><div class="bar">Overview</div><table data-table-kind="organization-overview" data-mobile-table="scroll-preserve"><tbody>
    <tr><th>Type</th><td>{formatPublicLabel(organization.organization_type)}</td></tr>
    <tr><th>Jurisdiction</th><td>{formatPublicLabel(organization.jurisdiction, 'Unknown')}</td></tr>
    <tr><th>Official website</th><td>{organization.official_url ? <a href={organization.official_url}>{organization.official_url}</a> : '—'}</td></tr>
    <tr><th>Record confidence</th><td>{formatPublicLabel(organization.confidence)}</td></tr>
    <tr><th>Last reviewed</th><td>{organization.last_verified_at ?? '—'}</td></tr>
    <tr><th>Compatibility URL</th><td><code>{`/issuer/${organization.slug}/`}</code></td></tr>
  </tbody></table></section>

  <section class="panel registry"><div class="bar">Stablecoin relationships</div><table data-table-kind="organization-relationships" data-mobile-table="scroll-preserve"><thead><tr><th>Stablecoin</th><th>Symbol</th><th>Role</th><th>From</th><th>Until</th><th>Relationship status</th><th>Lifecycle status</th></tr></thead><tbody>{relationships.length === 0 ? <tr><td colspan="7">No stablecoin relationships have been added yet.</td></tr> : relationships.map((relationship) => { const coin = stablecoinById.get(relationship.stablecoin_id); return <tr><td>{coin ? <a href={`/stablecoin/${coin.slug}/`}>{coin.name}</a> : relationship.stablecoin_id}</td><td>{coin?.symbol ?? '—'}</td><td>{formatPublicLabel(relationship.role)}</td><td>{relationship.start_date ?? '—'}</td><td>{relationship.end_date ?? '—'}</td><td>{formatPublicLabel(relationship.status)}</td><td>{coin ? <span class={`chip ${coin.lifecycle_status ?? coin.status ?? 'unknown'}`}>{formatStatusLabel(coin.lifecycle_status ?? coin.status)}</span> : '—'}</td></tr>; })}</tbody></table></section>

  <IssuerControlEvents events={issuerControlEvents} title="Enforcement and control actions" />
  <section class="panel registry"><div class="bar">Events</div><table data-table-kind="organization-events" data-mobile-table="scroll-preserve"><thead><tr><th>Date</th><th>Event</th><th>Detail kind</th></tr></thead><tbody>{events.length === 0 ? <tr><td colspan="3">No organization-level events have been added yet.</td></tr> : events.map((event) => (<tr><td>{event.event_date ?? '—'}</td><td><a href={`/event/${event.id}/`}>{eventPublicCopy[event.id]?.title ?? event.title}</a></td><td>{formatPublicLabel(event.event_detail_kind ?? event.event_type)}</td></tr>))}</tbody></table></section>
  <section class="panel registry"><div class="bar">Sources</div><table data-table-kind="organization-sources" data-mobile-table="scroll-preserve"><thead><tr><th>Source</th><th>Type</th><th>Evidence scope</th></tr></thead><tbody>{evidence.length === 0 ? <tr><td colspan="3">No sources have been added yet.</td></tr> : evidence.map((source) => (<tr><td><a href={source.url}>{source.title}</a></td><td>{formatPublicLabel(source.source_type)}</td><td>{source.claim_scopes?.map((item) => formatPublicLabel(item)).join(', ') ?? formatPublicLabel(source.claim_scope)}</td></tr>))}</tbody></table></section>

  <section class="panel report-box"><h2>Suggest a correction</h2><p>Report an incorrect role, date, relationship, source, or missing organization connection.</p><div class="report-actions"><a data-primary="true" href="https://github.com/badjoke-lab/stable-or-gone/issues/new/choose">Start a report</a><a href="/contact/">Submission guide</a></div></section>
</BaseLayout>
