---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MetricCard from '../../components/MetricCard.astro';
import IssuerControlEvents from '../../components/IssuerControlEvents.astro';
import EvidenceSourceTable from '../../components/EvidenceSourceTable.astro';
import ValueStateText from '../../components/ValueStateText.astro';
import '../../styles/organization-detail.css';
import { formatPublicLabel } from '../../utils/displayLabels';
import { formatLifecycleLabel, lifecycleChipClass } from '../../utils/publicTaxonomy';
import { resolveEventTaxonomy } from '../../utils/eventTaxonomy';
import { resolvePrimaryRelationshipForStablecoin } from '../../utils/primaryDisplayRelationship';
import { getFunctionalRoleLabel, getRelationshipStatusLabel, resolveOrganizationTaxonomy } from '../../utils/organizationTaxonomy';
import { issuerPublicSummaries } from '../../data/issuerPublicCopy';
import { eventPublicCopy } from '../../data/eventPublicCopy';
import { getOrganizations, getStablecoins, getRelationships, getEvents, getEvidence, getKnownUnknowns, type OrganizationRow } from '../../lib/data/registry';
import { getCanonicalEvidenceRelations, getEvidenceSourceIdentities } from '../../lib/data/evidenceSources';
import { resolveEvidenceIdentityId } from '../../../config/evidence-source-identities.mjs';

export function getStaticPaths() {
  return getOrganizations().map((organization) => ({ params: { slug: organization.slug }, props: { organization } }));
}

const { organization } = Astro.props as { organization: OrganizationRow };
const allStablecoins = getStablecoins();
const allRelationships = getRelationships();
const allEvents = getEvents();
const allEvidence = getEvidence();
const stablecoinById = new Map(allStablecoins.map((coin) => [coin.id, coin] as const));
const relationships = allRelationships
  .filter((relationship) => relationship.organization_id === organization.id)
  .map((relationship) => ({
    relationship,
    coin: stablecoinById.get(relationship.stablecoin_id),
    isPrimary: resolvePrimaryRelationshipForStablecoin(relationship.stablecoin_id, allRelationships).relationship?.id === relationship.id
  }))
  .sort((left, right) => {
    const leftHistorical = left.relationship.status === 'ended' || Boolean(left.relationship.end_date);
    const rightHistorical = right.relationship.status === 'ended' || Boolean(right.relationship.end_date);
    return Number(leftHistorical) - Number(rightHistorical) || String(left.coin?.name ?? '').localeCompare(String(right.coin?.name ?? ''));
  });
const stablecoinIds = new Set(relationships.map((item) => item.relationship.stablecoin_id));
const stablecoins = Array.from(stablecoinIds).map((id) => stablecoinById.get(id)).filter(Boolean);
const currentRelationships = relationships.filter((item) => item.relationship.status !== 'ended' && !item.relationship.end_date);
const historicalRelationships = relationships.filter((item) => item.relationship.status === 'ended' || Boolean(item.relationship.end_date));
const primaryDisplayRelationshipCount = relationships.filter((item) => item.isPrimary).length;
const events = allEvents
  .filter((event) => event.issuer_id === organization.id || event.subject_organization_ids?.includes(organization.id))
  .sort((left, right) => String(right.event_date ?? '').localeCompare(String(left.event_date ?? '')));
const issuerControlEvents = events.filter((event) => event.event_detail_kind === 'issuer_control' || event.event_type === 'issuer_freeze');
const evidenceRelations = getCanonicalEvidenceRelations().filter((relation) => relation.organization_ids.includes(organization.id));
const sourceIdentityIds = new Set(evidenceRelations.map((relation) => relation.evidence_id));
const evidence = allEvidence.filter((source) => sourceIdentityIds.has(resolveEvidenceIdentityId(source.id)));
const sourceIdentities = getEvidenceSourceIdentities().filter((source) => sourceIdentityIds.has(source.id));
const knownUnknowns = getKnownUnknowns().filter((item) => item.issuer_id === organization.id);
const summary = issuerPublicSummaries[organization.slug] ?? organization.summary ?? 'A summary has not yet been added.';
const taxonomy = resolveOrganizationTaxonomy(organization);
const functionalRoles = Array.from(new Set(relationships.map((item) => item.relationship.role))).sort((a, b) => getFunctionalRoleLabel(a).localeCompare(getFunctionalRoleLabel(b)));
const relationshipStates = Array.from(new Set(relationships.map((item) => item.relationship.status ?? 'unknown'))).sort((a, b) => getRelationshipStatusLabel(a).localeCompare(getRelationshipStatusLabel(b)));
const organizationInitials = organization.name.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase();
const title = `${organization.name} — Stablecoin Organization History | Stable or Gone`;
const description = `${organization.name} organization category, legal-form state, regulatory character, jurisdiction, functional roles, stablecoin relationships, major events, and sources.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: organization.name,
  url: `https://sog.badjoke-lab.com/issuer/${organization.slug}/`,
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  sameAs: organization.official_url ? [organization.official_url] : undefined,
  keywords: [taxonomy.public_category_label, taxonomy.regulatory_character_label, taxonomy.jurisdiction_label, ...functionalRoles.map(getFunctionalRoleLabel)]
};
---
<BaseLayout title={title} description={description} canonicalPath={`/issuer/${organization.slug}/`} jsonLd={jsonLd}>
  <article class="organization-detail-page" data-ui-v2-organization-detail>
    <PageHero eyebrow="Organization record" title={organization.name} description={summary} className="organization-detail-hero-v2">
      <div slot="actions" class="organization-detail-hero-actions"><a class="ui-button" href="/issuers/">Back to Organizations</a>{organization.official_url && <a class="ui-button ui-button--secondary" href={organization.official_url}>Official website</a>}</div>
      <div slot="visual" class="organization-detail-initial-badge"><strong>{organizationInitials || 'ORG'}</strong><span>{organization.id}</span></div>
    </PageHero>

    <section class="organization-detail-metrics" aria-label="Organization record summary">
      <MetricCard label="Category" value={taxonomy.public_category_label} detail={taxonomy.regulatory_character_label} icon="C" />
      <MetricCard label="Jurisdiction" value={taxonomy.jurisdiction_label} detail={taxonomy.jurisdiction_scope_label} icon="J" />
      <MetricCard label="Connected assets" value={String(stablecoins.length)} detail={`${currentRelationships.length} current relationships`} icon="A" />
      <MetricCard label="Relationships" value={String(relationships.length)} detail={`${historicalRelationships.length} historical relationships`} icon="R" />
      <MetricCard label="Events" value={String(events.length)} detail={`${issuerControlEvents.length} control or enforcement actions`} icon="E" />
      <MetricCard label="Source identities" value={String(sourceIdentities.length)} detail={`${knownUnknowns.length} organization-level unknowns`} icon="S" />
    </section>

    <nav class="organization-detail-nav" aria-label="Organization record sections">
      <a href="#overview">Overview</a><a href="#relationships">Relationships</a><a href="#events">Events</a><a href="#evidence">Evidence</a><a href="#unknowns">Known unknowns</a><a href="#corrections">Corrections</a>
    </nav>

    <section class="panel organization-detail-section" id="overview">
      <div class="organization-detail-section-heading"><p>Reviewed identity</p><h2>Organization overview</h2><span>Taxonomy, jurisdiction, roles, confidence, and review state remain explicit.</span></div>
      <div class="organization-detail-table"><table data-table-kind="organization-overview" data-mobile-table="scroll-preserve"><caption>Organization identity and reviewed taxonomy</caption><tbody>
        <tr><th>Organization category</th><td>{taxonomy.public_category_label}</td></tr><tr><th>Canonical organization type</th><td>{formatPublicLabel(taxonomy.canonical_organization_type)}</td></tr><tr><th>Legal form</th><td>{taxonomy.legal_form_label}</td></tr><tr><th>Legal-form state</th><td>{formatPublicLabel(taxonomy.legal_form_state)}</td></tr><tr><th>Regulatory character</th><td>{taxonomy.regulatory_character_label}</td></tr><tr><th>Jurisdiction</th><td>{taxonomy.jurisdiction_label}</td></tr><tr><th>Jurisdiction scope</th><td>{taxonomy.jurisdiction_scope_label}</td></tr><tr><th>Functional roles</th><td>{functionalRoles.length > 0 ? functionalRoles.map(getFunctionalRoleLabel).join(', ') : <ValueStateText value={null} />}</td></tr><tr><th>Relationship states</th><td>{relationshipStates.length > 0 ? relationshipStates.map(getRelationshipStatusLabel).join(', ') : <ValueStateText value={null} />}</td></tr><tr><th>Primary display relationships</th><td>{primaryDisplayRelationshipCount}</td></tr><tr><th>Official website</th><td>{organization.official_url ? <a href={organization.official_url}>{organization.official_url}</a> : <ValueStateText value={null} />}</td></tr><tr><th>Record confidence</th><td><ValueStateText value={organization.confidence} displayValue={formatPublicLabel(organization.confidence)} /></td></tr><tr><th>Last reviewed</th><td><ValueStateText value={organization.last_verified_at} /></td></tr>
      </tbody></table></div>
      <dl class="organization-overview-cards" data-mobile-representation-for="organization-overview">
        <div><dt>Organization category</dt><dd>{taxonomy.public_category_label}</dd></div><div><dt>Canonical organization type</dt><dd>{formatPublicLabel(taxonomy.canonical_organization_type)}</dd></div><div><dt>Legal form</dt><dd>{taxonomy.legal_form_label}</dd></div><div><dt>Legal-form state</dt><dd>{formatPublicLabel(taxonomy.legal_form_state)}</dd></div><div><dt>Regulatory character</dt><dd>{taxonomy.regulatory_character_label}</dd></div><div><dt>Jurisdiction scope</dt><dd>{taxonomy.jurisdiction_scope_label}</dd></div><div><dt>Functional roles</dt><dd>{functionalRoles.length ? functionalRoles.map(getFunctionalRoleLabel).join(', ') : 'Not recorded'}</dd></div><div><dt>Relationship states</dt><dd>{currentRelationships.length} current · {historicalRelationships.length} historical</dd></div><div><dt>Primary display relationships</dt><dd>{primaryDisplayRelationshipCount}</dd></div><div><dt>Record confidence</dt><dd>{formatPublicLabel(organization.confidence)}</dd></div>
      </dl>
    </section>

    <section class="panel organization-detail-section" id="relationships">
      <div class="organization-detail-section-heading"><p>Connected assets</p><h2>Stablecoin relationships</h2><span>Primary display is navigation only; every current, ended, and unknown relationship remains visible.</span></div>
      <p class="organization-detail-note">Primary display is a navigation and summary choice only. All current and historical relationships remain visible.</p>
      <div class="organization-detail-table"><table data-table-kind="organization-relationships" data-mobile-table="scroll-preserve"><caption>Current and historical stablecoin relationships</caption><thead><tr><th>Stablecoin</th><th>Symbol</th><th>Functional role</th><th>Display priority</th><th>From</th><th>Until</th><th>Relationship state</th><th>Stablecoin lifecycle</th></tr></thead><tbody>{relationships.length === 0 ? <tr><td colspan="8">No stablecoin relationships have been added yet.</td></tr> : relationships.map(({ relationship, coin, isPrimary }) => <tr><td>{coin ? <a href={`/stablecoin/${coin.slug}/`}>{coin.name}</a> : relationship.stablecoin_id}</td><td><ValueStateText value={coin?.symbol} /></td><td>{getFunctionalRoleLabel(relationship.role)}</td><td>{isPrimary ? 'Primary display' : 'Additional relationship'}</td><td><ValueStateText value={relationship.start_date} /></td><td><ValueStateText value={relationship.end_date} /></td><td>{getRelationshipStatusLabel(relationship.status ?? 'unknown')}</td><td>{coin ? <span class={lifecycleChipClass(coin.lifecycle_status)}>{formatLifecycleLabel(coin.lifecycle_status)}</span> : <ValueStateText value={null} />}</td></tr>)}</tbody></table></div>
      <div class="organization-relationship-cards" data-mobile-representation-for="organization-relationships">{relationships.map(({ relationship, coin, isPrimary }) => <article><header><h3>{coin ? <a href={`/stablecoin/${coin.slug}/`}>{coin.name}</a> : relationship.stablecoin_id}</h3><span>{isPrimary ? 'Primary display' : 'Additional relationship'}</span></header><dl><div><dt>Functional role</dt><dd>{getFunctionalRoleLabel(relationship.role)}</dd></div><div><dt>Relationship state</dt><dd>{getRelationshipStatusLabel(relationship.status ?? 'unknown')}</dd></div><div><dt>From</dt><dd>{relationship.start_date ?? 'Not recorded'}</dd></div><div><dt>Until</dt><dd>{relationship.end_date ?? 'Not recorded'}</dd></div></dl></article>)}</div>
    </section>

    <section class="panel organization-detail-section" id="events">
      <div class="organization-detail-section-heading"><p>Historical context</p><h2>Events</h2><span>Typed events and organization control actions remain linked to their evidence.</span></div>
      <IssuerControlEvents events={issuerControlEvents} title="Enforcement and control actions" />
      <div class="organization-detail-table"><table data-table-kind="organization-events" data-mobile-table="scroll-preserve"><caption>Events connected to this organization</caption><thead><tr><th>Date</th><th>Event</th><th>Category</th><th>Subtype</th><th>Status effect</th></tr></thead><tbody>{events.length === 0 ? <tr><td colspan="5">No organization-level events have been added yet.</td></tr> : events.map((event) => { const eventTaxonomy = resolveEventTaxonomy(event); return <tr><td><ValueStateText value={event.event_date} /></td><td><a href={`/event/${event.id}/`}>{eventPublicCopy[event.id]?.title ?? event.title}</a></td><td>{eventTaxonomy.public_category_label}</td><td>{eventTaxonomy.canonical_subtype_label}</td><td>{eventTaxonomy.status_effect_label}</td></tr>; })}</tbody></table></div>
      <div class="organization-event-cards" data-mobile-representation-for="organization-events">{events.map((event) => { const eventTaxonomy = resolveEventTaxonomy(event); return <article><time>{event.event_date ?? 'Date not recorded'}</time><h3><a href={`/event/${event.id}/`}>{eventPublicCopy[event.id]?.title ?? event.title}</a></h3><p>{eventTaxonomy.public_category_label} · {eventTaxonomy.canonical_subtype_label}</p><small>{eventTaxonomy.status_effect_label}</small></article>; })}</div>
    </section>

    <section class="panel organization-detail-section" id="evidence">
      <div class="organization-detail-section-heading"><p>Source record</p><h2>Evidence</h2><span>Source identity, publication date, reliability, archive state, and relation count remain separate.</span></div>
      <div class="organization-detail-table"><EvidenceSourceTable evidence={evidence} tableKind="organization-sources" emptyMessage="No organization-related sources have been added yet." /></div>
      <div class="organization-source-cards" data-mobile-representation-for="organization-sources">{sourceIdentities.map((source) => <article><span class="record-kicker">Source identity</span><h3><a href={source.url}>{source.title}</a></h3><dl><div><dt>Publisher</dt><dd>{source.publisher ?? 'Not recorded'}</dd></div><div><dt>Published</dt><dd>{source.published_at ?? 'Not recorded'}</dd></div><div><dt>Reliability</dt><dd>{formatPublicLabel(source.reliability)}</dd></div><div><dt>Evidence relations</dt><dd>{evidenceRelations.filter((relation) => relation.evidence_id === source.id).length}</dd></div></dl>{source.archived_url && <a href={source.archived_url}>Open archive</a>}</article>)}</div>
    </section>

    <section class="panel organization-detail-section" id="unknowns">
      <div class="organization-detail-section-heading"><p>Open record state</p><h2>Known unknowns</h2><span>Unresolved organization-level questions remain visible and dated.</span></div>
      <div class="organization-unknown-cards">{knownUnknowns.map((item) => <article><span class="record-kicker">Known unknown</span><h3>{item.topic}</h3><p>{item.description}</p><dl><div><dt>Severity</dt><dd>{formatPublicLabel(item.severity)}</dd></div><div><dt>Last checked</dt><dd>{item.last_checked_at ?? 'Not recorded'}</dd></div></dl></article>)}</div>
      {knownUnknowns.length === 0 && <p class="organization-detail-empty">No organization-level known unknown is recorded. Stablecoin dossiers may still contain relationship-specific unresolved questions.</p>}
    </section>

    <section class="panel organization-detail-section" id="corrections"><div class="organization-detail-section-heading"><p>Record maintenance</p><h2>Corrections and further reading</h2><span>Use the documented correction path and methodology.</span></div><div class="organization-detail-actions"><a href="/contact/">Submit a correction</a><a href="/methodology/">Read the methodology</a><a href="/issuers/">Back to Organizations</a><a href="/data/manifest.json">Data manifest</a></div></section>
  </article>
</BaseLayout>
