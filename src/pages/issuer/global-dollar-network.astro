---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Global Dollar Network issuer file — Stable or Gone';
const description = 'Issuer and network file for Global Dollar Network, associated with Global Dollar / USDG in the Stable or Gone registry.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Global Dollar Network', url: 'https://www.globaldollar.com/', description };
---
<BaseLayout title={title} description={description} canonicalPath="/issuer/global-dollar-network/" jsonLd={jsonLd}>
  <section class="hero"><div class="panel hero-main"><div class="prompt">&gt; open issuer/global-dollar-network</div><h1>Global Dollar Network</h1><p>Organization associated with Global Dollar / USDG.</p></div></section>
  <section class="section-grid"><a class="panel mini-card" href="/stablecoin/usdg/"><h2>USDG</h2><p>Open the Global Dollar stablecoin record.</p></a><a class="panel mini-card" href="/stablecoins/"><h2>Stablecoin registry</h2><p>Return to all stablecoin records.</p></a><a class="panel mini-card" href="/guides/stablecoin-lifecycle-terms/"><h2>Lifecycle terms</h2><p>How SOG records issuer, network, and lifecycle context.</p></a></section>
  <section class="panel registry"><div class="bar">issuer facts</div><table><tbody><tr><th>Type</th><td>network_or_company_group</td></tr><tr><th>Jurisdiction</th><td>multi_jurisdiction</td></tr><tr><th>Official URL</th><td><a href="https://www.globaldollar.com/">https://www.globaldollar.com/</a></td></tr><tr><th>Related stablecoin</th><td><a href="/stablecoin/usdg/">USDG</a></td></tr><tr><th>Notes</th><td>PR-026 seed issuer. Issuer-entity and partner-network context need deeper source-backed review.</td></tr></tbody></table></section>
</BaseLayout>
