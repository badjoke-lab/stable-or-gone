---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/compare-v1.css';
import '../../styles/compare-v1-accessibility.css';
import '../../styles/compare-presets.css';
import '../../styles/ui-remediation-r8.css';
import compareConfig from '../../../config/compare-v1-dimensions.json';
import comparePresets from '../../../config/compare-v1-presets.json';
import { getPublicComparisonProjection } from '../../lib/comparisonData.mjs';

type CompareAssetOption = { asset_id: string; slug: string; name: string; symbol: string | null };
type CompareGroupOption = { id: string; label: string; description: string };
type ComparePresetOption = { id: string; label: string; description: string; asset_slugs: string[]; visible_group_ids: string[] };

const projection = getPublicComparisonProjection();
const assets: CompareAssetOption[] = projection.assets
  .map((asset: CompareAssetOption) => ({ asset_id: asset.asset_id, slug: asset.slug, name: asset.name, symbol: asset.symbol }))
  .sort((left: CompareAssetOption, right: CompareAssetOption) => left.name.localeCompare(right.name) || left.slug.localeCompare(right.slug));
const groups: CompareGroupOption[] = compareConfig.groups.map((group: CompareGroupOption) => ({ id: group.id, label: group.label, description: group.description }));
const presets: ComparePresetOption[] = comparePresets.presets;
const title = 'Compare Stablecoin Records — Stable or Gone';
const description = 'Compare two to four canonical stablecoin records without scores, rankings, or inferred conclusions.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Compare stablecoin records',
  url: 'https://sog.badjoke-lab.com/compare/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' }
};
const configJson = JSON.stringify(compareConfig).replace(/</g, '\u003c');
const presetJson = JSON.stringify(comparePresets).replace(/</g, '\u003c');
const projectionJson = JSON.stringify(projection).replace(/</g, '\u003c');
---
<BaseLayout title={title} description={description} canonicalPath="/compare/" jsonLd={jsonLd}>
  <main class="compare-page r8-compare-page" data-compare-page data-min-assets="2" data-max-assets="4" data-r8-surface="compare">
    <header class="compare-masthead r8-masthead">
      <div class="compare-masthead__copy">
        <p class="compare-eyebrow">Registry tool / comparison</p>
        <h1>Compare stablecoin records</h1>
        <p>Select records first. Canonical values, explicit unknowns, readiness, and freshness remain separate. This tool does not calculate a score or ranking.</p>
      </div>
      <dl class="compare-contract-summary" aria-label="Comparison inventory">
        <div><dt>Available records</dt><dd>{projection.asset_count}</dd></div>
        <div><dt>Facets</dt><dd>{projection.dimension_count}</dd></div>
      </dl>
    </header>

    <section class="compare-controls r8-primary-surface" aria-labelledby="compare-selection-heading">
      <div class="compare-section-heading r8-section-heading">
        <div>
          <p class="compare-eyebrow">Step 1</p>
          <h2 id="compare-selection-heading">Choose two to four records</h2>
          <p>The matrix appears only after two different records are selected.</p>
        </div>
        <a class="compare-projection-note" href="/data/comparison.json">Download comparison JSON</a>
      </div>

      <div class="compare-slot-grid" aria-label="Stablecoin comparison selection">
        {[0, 1, 2, 3].map((index) => (
          <label class="compare-slot">
            <span>{index < 2 ? `Required record ${index + 1}` : `Optional record ${index + 1}`}</span>
            <select class="ui-field" data-compare-slot data-slot-index={index} aria-label={`Comparison asset ${index + 1}`}>
              <option value="">Choose a stablecoin</option>
              {assets.map((asset: CompareAssetOption) => <option value={asset.slug}>{asset.name}{asset.symbol ? ` (${asset.symbol})` : ''}</option>)}
            </select>
          </label>
        ))}
      </div>

      <details class="r8-secondary-disclosure compare-preset-panel">
        <summary>Use a preset or change visible facet groups</summary>
        <div class="r8-secondary-disclosure__body">
          <section aria-labelledby="compare-preset-heading">
            <div class="compare-preset-heading"><h3 id="compare-preset-heading">Presets</h3><p>Presets only choose records and visible groups.</p></div>
            <div class="compare-preset-grid" data-compare-preset-list>
              {presets.map((preset: ComparePresetOption) => (
                <button class="compare-preset" type="button" data-compare-preset-id={preset.id} aria-pressed="false">
                  <strong>{preset.label}</strong><span>{preset.description}</span><small>{preset.asset_slugs.join(' · ')}</small>
                </button>
              ))}
            </div>
          </section>

          <fieldset class="compare-group-filter" data-compare-group-filter>
            <legend>Visible facet groups</legend>
            <div class="compare-group-filter__grid">
              {groups.map((group: CompareGroupOption) => (
                <label class="compare-group-toggle">
                  <input type="checkbox" value={group.id} data-compare-group-toggle checked />
                  <span><strong>{group.label}</strong><small>{group.description}</small></span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>
      </details>

      <div class="compare-actions">
        <button class="ui-button" type="button" data-compare-clear>Clear selection</button>
        <button class="ui-button" type="button" data-compare-copy>Copy comparison link</button>
        <span data-compare-link-status aria-live="polite"></span>
      </div>
      <p class="compare-selection-status" data-compare-status aria-live="polite">Choose at least two stablecoins to start a comparison.</p>
      <div class="compare-preset-status" data-compare-preset-status aria-live="polite"></div>
      <div class="compare-alert r8-error" data-compare-alert role="alert" aria-live="assertive" hidden>
        <strong>Comparison unavailable</strong>
        <p>The comparison could not be prepared.</p>
        <button type="button" data-compare-retry>Retry</button>
      </div>
    </section>

    <section class="compare-matrix-section" aria-labelledby="compare-matrix-heading">
      <div class="compare-section-heading r8-section-heading">
        <div><p class="compare-eyebrow">Step 2</p><h2 id="compare-matrix-heading">Comparison</h2></div>
      </div>

      <div class="compare-empty r8-empty" data-compare-empty>
        <strong>No comparison yet</strong>
        <p>Select two records above. Empty and error states are kept separate.</p>
      </div>

      <div class="compare-output" data-compare-output hidden>
        <label class="r8-mobile-facet-control" hidden>
          <span>Mobile facet</span>
          <select data-compare-mobile-facet></select>
        </label>
        <div class="compare-column-header" data-compare-column-header></div>
        <div class="compare-groups" data-compare-groups></div>
      </div>
    </section>

    <details class="compare-method-note r8-method-note">
      <summary>How to read values, readiness, and freshness</summary>
      <div class="compare-method-grid">
        <article><h3>Value</h3><p>The canonical registry value or bounded record set.</p></article>
        <article><h3>Readiness</h3><p>Whether the facet can be compared structurally. It is not a quality score.</p></article>
        <article><h3>Freshness</h3><p>The age or absence of an explicit canonical date anchor.</p></article>
      </div>
      <p class="compare-disclaimer">Historical registry context only. This is not a ranking, recommendation, legal opinion, or investment assessment.</p>
    </details>
  </main>
  <script id="compare-dimension-config" type="application/json" set:html={configJson}></script>
  <script id="compare-preset-config" type="application/json" set:html={presetJson}></script>
  <script id="compare-projection-data" type="application/json" set:html={projectionJson}></script>
  <script>
    import '../../scripts/compare-v1';
    import '../../scripts/compare-presets';
  </script>
</BaseLayout>
