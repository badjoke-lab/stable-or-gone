---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/maintenance-log.css';
import '../../styles/ui-remediation-r7.css';
import { getPublicMaintenanceLog } from '../../lib/maintenanceLogData.mjs';
type MaintenanceCheck = { check_id: string; result: string; summary: string };
type MaintenanceRelease = { id: string; label: string; route: string };
type MaintenanceEntry = { month: string; status: string; as_of: string; public_summary: string; checks: MaintenanceCheck[]; counts: Record<string, number>; public_surface_releases: MaintenanceRelease[]; next_focus: string[] };
const log = getPublicMaintenanceLog();
const entries = log.entries as MaintenanceEntry[];
const latest = entries[0];
const previous = entries.slice(1);
const headlineCounts = latest ? Object.entries(latest.counts).slice(0, 4) : [];
const title = 'Maintenance Log — Stable or Gone';
const description = 'Monthly public maintenance checkpoints for Stable or Gone, limited to public-safe aggregate outcomes, contract checks, released surfaces, and next maintenance priorities.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url: 'https://sog.badjoke-lab.com/maintenance/', description, isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' } };
---
<BaseLayout title={title} description={description} canonicalPath="/maintenance/" jsonLd={jsonLd}>
  <div class="maintenance-page r7-maintenance-page" data-maintenance-log-page data-r7-page="maintenance">
    <header class="maintenance-masthead"><div><p class="maintenance-eyebrow">Project / public operations</p><h1>Maintenance status</h1><p>Current public-safe maintenance state, followed by append-only monthly checkpoints. Internal monitoring rows, unreviewed candidates, private notes, and source queues remain private.</p></div><dl class="maintenance-contract-summary"><div><dt>Latest month</dt><dd>{log.summary.latest_month ?? 'None'}</dd></div><div><dt>Checkpoints</dt><dd>{log.summary.entry_count}</dd></div><div><dt>Safety</dt><dd>Public aggregates only</dd></div></dl></header>

    {latest ? <section class="r7-maintenance-current" aria-labelledby="current-maintenance-title"><header><div><p class="maintenance-eyebrow">Current public state · {latest.as_of}</p><h2 id="current-maintenance-title">{latest.status === 'closed' ? 'Latest checkpoint closed' : 'Maintenance in progress'}</h2><p>{latest.public_summary}</p></div><span class="r7-maintenance-status">{latest.status.replaceAll('_', ' ')}</span></header><dl class="r7-maintenance-counts">{headlineCounts.map(([key, value]) => <div><dt>{key.replaceAll('_', ' ')}</dt><dd>{value}</dd></div>)}</dl><section class="r7-section"><div class="r7-section-heading"><h2>Next focus</h2><p>Published priorities for the next maintenance sequence.</p></div><ol>{latest.next_focus.map((item) => <li>{item}</li>)}</ol></section><details class="r7-disclosure" data-disclosure><summary>Latest contract checks and releases</summary><div class="r7-disclosure-body"><dl class="r7-row-list">{latest.checks.map((check) => <div><dt>{check.check_id.replaceAll('_', ' ')}</dt><dd><strong>{check.result.replaceAll('_', ' ')}</strong> · {check.summary}</dd></div>)}</dl><div class="r7-secondary-links">{latest.public_surface_releases.map((release) => <a href={release.route}>{release.label}</a>)}</div></div></details></section> : <section class="r7-maintenance-current"><h2>No public checkpoint recorded</h2><p>The machine-readable maintenance log does not yet contain a public entry.</p></section>}

    <section class="maintenance-ledger" aria-labelledby="maintenance-history-title"><div class="maintenance-section-heading"><div><p class="maintenance-eyebrow">Append-only history</p><h2 id="maintenance-history-title">Previous monthly checkpoints</h2><p>Closed months remain immutable. Open each month for public-safe checks, counts, releases, and next priorities.</p></div><p class="maintenance-machine-link"><a href="/data/maintenance-log.json">Machine-readable log</a></p></div><div class="r7-maintenance-history">{previous.length ? previous.map((entry) => <details class="r7-disclosure r7-maintenance-month" data-maintenance-month={entry.month}><summary><strong>{entry.month}</strong><span>{entry.public_summary}</span><span>{entry.status.replaceAll('_', ' ')}</span></summary><div class="r7-maintenance-month-body"><section><h3>Contract checks</h3><dl class="r7-row-list">{entry.checks.map((check) => <div><dt>{check.check_id.replaceAll('_', ' ')}</dt><dd><strong>{check.result.replaceAll('_', ' ')}</strong> · {check.summary}</dd></div>)}</dl></section><section><h3>Public counts</h3><dl class="r7-row-list">{Object.entries(entry.counts).map(([key, value]) => <div><dt>{key.replaceAll('_', ' ')}</dt><dd>{value}</dd></div>)}</dl></section><section><h3>Released public surfaces</h3><div class="r7-secondary-links">{entry.public_surface_releases.map((release) => <a href={release.route}>{release.label}</a>)}</div></section><section><h3>Next focus</h3><ol>{entry.next_focus.map((item) => <li>{item}</li>)}</ol></section></div></details>) : <p>No earlier public checkpoints.</p>}</div></section>

    <details class="r7-disclosure maintenance-boundary" data-disclosure><summary>What the public maintenance log includes and excludes</summary><div class="r7-disclosure-body"><dl class="r7-row-list"><div><dt>Public</dt><dd>Aggregate counts, contract outcomes, public-surface releases, maintenance status, and next public priorities.</dd></div><div><dt>Internal</dt><dd>Monitoring rows, unreviewed candidates, private source queues, private notes, candidate URLs, credentials, and secrets.</dd></div><div><dt>Not a live status feed</dt><dd>This log does not replace the Update Feed, Change Timeline, service monitoring, a risk score, or a ranking.</dd></div></dl></div></details>

    <section class="maintenance-related"><p class="maintenance-eyebrow">Related public layers</p><h2>Read the right record for the right question</h2><div class="r7-secondary-links"><a href="/updates/">Update Feed</a><a href="/timeline/">Change Timeline</a><a href="/methodology/">Methodology</a></div></section>
  </div>
</BaseLayout>
