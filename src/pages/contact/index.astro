---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialPageHeader from '../../components/EditorialPageHeader.astro';
const googleFormUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSeEUxdPktIm46X0HgwuYvk8vpx0N3R0EezOaC2fz64nfE6JjA/viewform?usp=dialog';
const githubIssueUrl = 'https://github.com/badjoke-lab/stable-or-gone/issues/new/choose';
const githubIssuesUrl = 'https://github.com/badjoke-lab/stable-or-gone/issues';
const title = 'Contact / Report an Issue — Stable or Gone';
const description = 'Contact Stable or Gone, report incorrect registry information, submit missing stablecoins or events, add sources, or flag broken links.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'ContactPage', name: title, url: 'https://www.stableorgone.com/contact/', description, isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://www.stableorgone.com/' } };
---
<BaseLayout title={title} description={description} canonicalPath="/contact/" jsonLd={jsonLd}>
  <article class="editorial-utility-page" data-ui-v3-utility="contact-corrections">
    <EditorialPageHeader kind="utility" eyebrow="Utility / corrections and contact" title="Report a correction, missing record, or broken source" description="Use the Google Form for normal contact and private reports. Use GitHub Issues for public, source-backed corrections that can be discussed openly." facts={[{ label: 'Primary route', value: 'Google Form' }, { label: 'Public route', value: 'GitHub Issues' }, { label: 'Review', value: 'Manual' }]} />
    <section class="utility-section">
      <div class="utility-section-heading"><h2>Choose a reporting route</h2><p>Use the private form for normal submissions. Use GitHub only when the report and supporting sources may remain public.</p></div>
      <nav class="contact-actions" aria-label="Contact routes">
        <a class="contact-card-primary" href={googleFormUrl} target="_blank" rel="noopener noreferrer"><h2>Submit via Google Form</h2><p>Best for corrections, missing records, broken links, source suggestions, general contact, or reports that do not need public discussion.</p></a>
        <a href={githubIssueUrl} target="_blank" rel="noopener noreferrer"><h2>Open a GitHub Issue</h2><p>Best for public, source-backed corrections where discussion, review notes, and acceptance history should remain visible.</p></a>
        <a href={githubIssuesUrl} target="_blank" rel="noopener noreferrer"><h2>View existing reports</h2><p>Check open and closed reports before submitting a duplicate.</p></a>
      </nav>
    </section>
    <section class="utility-section">
      <div class="utility-section-heading"><h2>What to report</h2><p>Include the affected record, the disputed or missing claim, and a source that supports the requested change.</p></div>
      <table><tbody><tr><th>Record correction</th><td>Link the affected page, identify the incorrect statement, and provide a source supporting the change.</td></tr><tr><th>Missing stablecoin</th><td>Provide the name, symbol, issuer or protocol, launch information, and at least one reliable source.</td></tr><tr><th>Missing event</th><td>Include the stablecoin, date, event description, outcome, and source links.</td></tr><tr><th>Reserve or redemption information</th><td>Submit issuer pages, reserve reports, redemption terms, regulator notices, archived pages, or other verifiable references.</td></tr><tr><th>Broken link</th><td>Share the affected page and source title. An archived replacement is helpful when available.</td></tr><tr><th>General contact</th><td>Use the form for non-public messages or questions about the archive.</td></tr></tbody></table>
    </section>
    <section class="utility-section">
      <div class="utility-section-heading"><h2>Important limits</h2><p>Stable or Gone is a historical registry and cannot provide issuer, exchange, wallet, legal, tax, or account support.</p></div>
      <table><tbody><tr><th>No private secrets</th><td>Do not submit private keys, seed phrases, passwords, wallet credentials, exchange account details, bank information, identification documents, or sensitive personal information.</td></tr><tr><th>No account support</th><td>Stable or Gone is not an issuer, exchange, wallet provider, redemption desk, investment adviser, legal adviser, or tax adviser.</td></tr><tr><th>Manual review</th><td>Reports are reviewed manually. A response is not guaranteed, and records may change only after verification.</td></tr><tr><th>Public GitHub issues</th><td>GitHub Issues are public. Use the Google Form when the report should not be discussed publicly.</td></tr></tbody></table>
    </section>
    <section class="utility-section" aria-labelledby="methodology-before-reporting">
      <div class="utility-section-heading"><h2 id="methodology-before-reporting">Before reporting</h2><p>Review the methodology when the issue concerns status labels, event treatment, evidence quality, relationship roles, or unresolved questions.</p></div>
      <div class="report-actions"><a href="/methodology/">Read methodology</a><a href={googleFormUrl} target="_blank" rel="noopener noreferrer" data-primary="true">Submit via Google Form</a><a href={githubIssueUrl} target="_blank" rel="noopener noreferrer">Open GitHub Issue</a></div>
    </section>
  </article>
</BaseLayout>
