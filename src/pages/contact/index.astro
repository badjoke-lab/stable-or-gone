---
import BaseLayout from '../../layouts/BaseLayout.astro';

const googleFormUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSeEUxdPktIm46X0HgwuYvk8vpx0N3R0EezOaC2fz64nfE6JjA/viewform?usp=dialog';
const githubIssueUrl = 'https://github.com/badjoke-lab/stable-or-gone/issues/new/choose';
const githubIssuesUrl = 'https://github.com/badjoke-lab/stable-or-gone/issues';

const title = 'Contact / Report an Issue — Stable or Gone';
const description = 'Contact Stable or Gone, report incorrect registry information, submit missing stablecoins or events, add sources, or flag broken links.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  url: 'https://sog.badjoke-lab.com/contact/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' }
};
---
<BaseLayout title={title} description={description} canonicalPath="/contact/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">Contact / Report an Issue</div>
      <h1>Report a correction, missing record, or broken source.</h1>
      <p>Use the Google Form for normal contact and private reports. Use GitHub Issues for public, source-backed corrections that can be discussed openly.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Primary route</span><strong>Form</strong></div>
      <div class="stat"><span>Public route</span><strong>GitHub</strong></div>
    </div>
  </section>

  <section class="section-grid contact-actions" aria-label="Contact routes">
    <a class="panel mini-card contact-card-primary" href={googleFormUrl} target="_blank" rel="noopener noreferrer">
      <h2>Submit via Google Form</h2>
      <p>Best for corrections, missing records, broken links, source suggestions, general contact, or reports that do not need public discussion.</p>
    </a>
    <a class="panel mini-card" href={githubIssueUrl} target="_blank" rel="noopener noreferrer">
      <h2>Open a GitHub Issue</h2>
      <p>Best for public, source-backed corrections where discussion, review notes, and acceptance history should remain visible.</p>
    </a>
    <a class="panel mini-card" href={githubIssuesUrl} target="_blank" rel="noopener noreferrer">
      <h2>View existing reports</h2>
      <p>Check open and closed reports before submitting a duplicate.</p>
    </a>
  </section>

  <section class="panel registry">
    <div class="bar">What to report</div>
    <table>
      <tbody>
        <tr><th>Record correction</th><td>Link the affected page, identify the incorrect statement, and provide a source supporting the change.</td></tr>
        <tr><th>Missing stablecoin</th><td>Provide the name, symbol, issuer or protocol, launch information, and at least one reliable source.</td></tr>
        <tr><th>Missing event</th><td>Include the stablecoin, date, event description, outcome, and source links.</td></tr>
        <tr><th>Reserve or redemption information</th><td>Submit issuer pages, reserve reports, redemption terms, regulator notices, archived pages, or other verifiable references.</td></tr>
        <tr><th>Broken link</th><td>Share the affected page and source title. An archived replacement is helpful when available.</td></tr>
        <tr><th>General contact</th><td>Use the form for non-public messages or questions about the archive.</td></tr>
      </tbody>
    </table>
  </section>

  <section class="panel registry">
    <div class="bar">Important limits</div>
    <table><tbody>
      <tr><th>No private secrets</th><td>Do not submit private keys, seed phrases, passwords, wallet credentials, exchange account details, bank information, identification documents, or sensitive personal information.</td></tr>
      <tr><th>No account support</th><td>Stable or Gone is not an issuer, exchange, wallet provider, redemption desk, investment adviser, legal adviser, or tax adviser.</td></tr>
      <tr><th>Manual review</th><td>Reports are reviewed manually. A response is not guaranteed, and records may change only after verification.</td></tr>
      <tr><th>Public GitHub issues</th><td>GitHub Issues are public. Use the Google Form when the report should not be discussed publicly.</td></tr>
    </tbody></table>
  </section>

  <section class="panel report-box" aria-labelledby="methodology-before-reporting">
    <h2 id="methodology-before-reporting">Before reporting</h2>
    <p>Review the methodology if the issue is about status labels, event treatment, evidence quality, or unresolved questions.</p>
    <div class="report-actions">
      <a href="/methodology/">Read methodology</a>
      <a href={googleFormUrl} target="_blank" rel="noopener noreferrer" data-primary="true">Submit via Google Form</a>
      <a href={githubIssueUrl} target="_blank" rel="noopener noreferrer">Open GitHub Issue</a>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-actions { grid-template-columns: repeat(3, 1fr); }
  .contact-card-primary { border-color: rgba(214, 180, 111, 0.7); background: linear-gradient(180deg, rgba(214, 180, 111, 0.1), rgba(11, 23, 34, 0.86)); }
  .contact-card-primary h2 { color: var(--gold); }
  @media (max-width: 820px) {
    .contact-actions { grid-template-columns: 1fr; }
  }
</style>
