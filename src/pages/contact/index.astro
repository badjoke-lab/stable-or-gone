---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/ui-remediation-r7.css';
const googleFormUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSeEUxdPktIm46X0HgwuYvk8vpx0N3R0EezOaC2fz64nfE6JjA/viewform?usp=dialog';
const githubIssueUrl = 'https://github.com/badjoke-lab/stable-or-gone/issues/new/choose';
const githubIssuesUrl = 'https://github.com/badjoke-lab/stable-or-gone/issues';
const title = 'Contact / Report an Issue — Stable or Gone';
const description = 'Contact Stable or Gone, report incorrect registry information, submit missing stablecoins or events, add sources, or flag broken links.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'ContactPage', name: title, url: 'https://sog.badjoke-lab.com/contact/', description, isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' } };
---
<BaseLayout title={title} description={description} canonicalPath="/contact/" jsonLd={jsonLd}>
  <article class="r7-page" data-r7-page="contact" data-ui-v3-utility="contact-corrections">
    <header class="r7-masthead">
      <div class="r7-masthead-copy"><p class="r7-eyebrow">Utility / corrections</p><h1>Report a correction or missing record</h1><p class="r7-lead">Use the private form for normal reports. Include the affected page, the disputed or missing claim, and a source that supports the requested change.</p></div>
      <dl class="r7-facts"><div><dt>Primary route</dt><dd>Google Form</dd></div><div><dt>Review</dt><dd>Manual</dd></div><div><dt>Public discussion</dt><dd>GitHub Issues</dd></div><div><dt>Private secrets</dt><dd>Never submit</dd></div></dl>
    </header>

    <section class="r7-contact-primary" aria-labelledby="contact-primary-title"><p class="r7-eyebrow">Primary action</p><h2 id="contact-primary-title">Submit through the correction form</h2><p>Use this route for incorrect wording, missing records or events, broken links, additional Evidence, general contact, or a report that should not begin as a public GitHub discussion.</p><a class="r7-primary-action" href={googleFormUrl} target="_blank" rel="noopener noreferrer">Open correction form</a></section>

    <section class="r7-section"><div class="r7-section-heading"><h2>Secondary routes</h2><p>Use these only when the report belongs in a public or technical workflow.</p></div><nav class="r7-contact-routes" aria-label="Secondary contact routes"><a href={githubIssueUrl} target="_blank" rel="noopener noreferrer"><strong>Public source-backed issue</strong><span>Open a GitHub Issue when the report, sources, and review discussion may remain public.</span></a><a href={githubIssuesUrl} target="_blank" rel="noopener noreferrer"><strong>Existing reports</strong><span>Check open and closed issues before submitting a duplicate.</span></a><a href="https://github.com/badjoke-lab/stable-or-gone/issues/new?labels=bug" target="_blank" rel="noopener noreferrer"><strong>Technical problem</strong><span>Report a broken page, runtime error, accessibility problem, or machine-readable output failure.</span></a></nav></section>

    <section class="r7-section"><div class="r7-section-heading"><h2>What to include</h2><p>A concise, source-backed report is easier to verify and less likely to be misinterpreted.</p></div><dl class="r7-row-list"><div><dt>Record correction</dt><dd>Link the affected Stable or Gone page, quote or identify the incorrect statement, and provide a supporting source.</dd></div><div><dt>Missing stablecoin</dt><dd>Provide the name, symbol, issuer or protocol, launch information, official page, and at least one reliable independent or primary source.</dd></div><div><dt>Missing event</dt><dd>Include the stablecoin, date, event description, outcome, and source links.</dd></div><div><dt>Reserve or redemption</dt><dd>Submit issuer pages, reserve reports, redemption terms, regulator notices, archived pages, or direct protocol references.</dd></div><div><dt>Broken Evidence link</dt><dd>Share the affected page and source title. Include an archived or replacement URL when available.</dd></div></dl></section>

    <details class="r7-disclosure" data-disclosure><summary>Important privacy and support limits</summary><div class="r7-disclosure-body"><dl class="r7-row-list"><div><dt>No private secrets</dt><dd>Do not submit private keys, seed phrases, passwords, wallet credentials, exchange account details, bank information, identification documents, or sensitive personal information.</dd></div><div><dt>No account support</dt><dd>Stable or Gone is not an issuer, exchange, wallet provider, redemption desk, investment adviser, legal adviser, or tax adviser.</dd></div><div><dt>Manual review</dt><dd>A response is not guaranteed. Records change only after the submitted claim and sources are verified.</dd></div><div><dt>Public GitHub issues</dt><dd>GitHub Issues are public. Use the correction form when the report should not be discussed publicly.</dd></div></dl></div></details>

    <div class="r7-secondary-links"><a href="/methodology/">Read methodology</a><a href="/evidence/">Browse Evidence</a><a href="/maintenance/">Maintenance status</a></div>
  </article>
</BaseLayout>
