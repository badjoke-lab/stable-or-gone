---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPublicLabel } from '../../utils/displayLabels';
import { getOrganizations, getStablecoins } from '../../lib/data/registry';

const organizations = getOrganizations();
const stablecoins = getStablecoins();
const stablecoinBySlug = new Map(stablecoins.map((coin) => [coin.slug, coin] as const));
const title = 'Stablecoin Issuers and Protocols — Stable or Gone';
const description = 'Browse the companies, protocols, and organizations connected to the stablecoins in Stable or Gone.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: 'https://sog.badjoke-lab.com/issuers/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  about: ['stablecoin issuers', 'stablecoin protocols', 'reserve disclosure', 'issuer history']
};
---
<BaseLayout title={title} description={description} canonicalPath="/issuers/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">Issuer and protocol directory</div>
      <h1>Who is behind each stablecoin?</h1>
      <p>Browse the companies, protocols, and organizations linked to the stablecoins in the archive.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Issuer records</span><strong>{organizations.length}</strong></div>
      <div class="stat"><span>Stablecoins linked</span><strong>{stablecoins.length}</strong></div>
    </div>
  </section>

  <section class="section-grid" aria-label="Helpful links">
    <a class="panel mini-card" href="/stablecoins/"><h2>Browse stablecoins</h2><p>Open the asset records connected to each issuer or protocol.</p></a>
    <a class="panel mini-card" href="/guides/reserve-disclosure-basics/"><h2>Read reserve disclosures</h2><p>Understand the difference between issuer reports and protocol collateral data.</p></a>
    <a class="panel mini-card" href="/methodology/"><h2>How records are reviewed</h2><p>See how sources, status labels, and open questions are handled.</p></a>
  </section>

  <section class="panel registry">
    <div class="bar">All issuers and protocols</div>
    <table>
      <thead><tr><th>Name</th><th>Type</th><th>Jurisdiction</th><th>Stablecoins</th><th>Record confidence</th></tr></thead>
      <tbody>
        {organizations.length === 0 ? (
          <tr><td colspan="5">No issuer records available.</td></tr>
        ) : organizations.map((organization) => {
          const related = (organization.related_stablecoins ?? []).map((slug) => stablecoinBySlug.get(slug)).filter(Boolean);
          return (
            <tr>
              <td><a href={`/issuer/${organization.slug}/`}>{organization.name}</a></td>
              <td>{formatPublicLabel(organization.issuer_type)}</td>
              <td>{formatPublicLabel(organization.jurisdiction, 'Unknown')}</td>
              <td>{related.length > 0 ? related.map((coin, index) => (<>{coin?.name}{coin?.symbol ? ` (${coin.symbol})` : ''}{index < related.length - 1 ? <span> · </span> : null}</>)) : '—'}</td>
              <td>{formatPublicLabel(organization.confidence)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </section>
</BaseLayout>
