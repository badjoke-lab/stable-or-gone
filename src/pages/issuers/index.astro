---
import BaseLayout from '../../layouts/BaseLayout.astro';
import issuersData from '../../../data/issuers.json';
import issuersExtraData from '../../../data/issuers-extra.json';

type IssuerRow = {
  slug: string;
  name: string;
  issuer_type?: string;
  jurisdiction?: string;
  related_stablecoins?: string[];
  confidence?: string;
};

const issuers = [...(issuersData as IssuerRow[]), ...(issuersExtraData as IssuerRow[])];
const title = 'Stablecoin Issuers and Protocols — Stable or Gone';
const description = 'Browse stablecoin issuer, protocol, company, jurisdiction, related stablecoin, confidence, and evidence context records in Stable or Gone.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: 'https://sog.badjoke-lab.com/issuers/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  about: ['stablecoin issuers', 'stablecoin protocols', 'reserve disclosure', 'issuer lifecycle history']
};
---
<BaseLayout title={title} description={description} canonicalPath="/issuers/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="panel hero-main">
      <div class="prompt">&gt; list issuers</div>
      <h1>Issuer Files</h1>
      <p>Issuer, protocol, company, jurisdiction, and related stablecoin references.</p>
    </div>
    <div class="panel stats">
      <div class="stat"><span>Issuers</span><strong>{issuers.length}</strong></div>
      <div class="stat"><span>Mode</span><strong>v0</strong></div>
    </div>
  </section>

  <section class="section-grid" aria-label="Issuer guide links">
    <a class="panel mini-card" href="/stablecoins/"><h2>Stablecoin registry</h2><p>Open stablecoin records connected to issuer and protocol files.</p></a>
    <a class="panel mini-card" href="/guides/reserve-disclosure-basics/"><h2>Reserve disclosure</h2><p>How issuer disclosures, attestations, and protocol collateral sources are handled.</p></a>
    <a class="panel mini-card" href="/methodology/"><h2>Methodology</h2><p>How SOG separates evidence, events, status labels, and visible uncertainty.</p></a>
  </section>

  <section class="panel registry">
    <div class="bar">source: data/issuers.json + data/issuers-extra.json</div>
    <table>
      <thead><tr><th>Name</th><th>Type</th><th>Jurisdiction</th><th>Stablecoins</th><th>Confidence</th></tr></thead>
      <tbody>
        {issuers.length === 0 ? (
          <tr><td colspan="5">No issuer records yet.</td></tr>
        ) : issuers.map((issuer) => (
          <tr>
            <td><a href={`/issuer/${issuer.slug}/`}>{issuer.name}</a></td>
            <td>{issuer.issuer_type ?? '—'}</td>
            <td>{issuer.jurisdiction ?? '—'}</td>
            <td>{issuer.related_stablecoins?.join(', ') ?? '—'}</td>
            <td>{issuer.confidence ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</BaseLayout>
