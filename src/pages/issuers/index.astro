---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrganizationIndexRow from '../../components/OrganizationIndexRow.astro';
import OrganizationIndexCard from '../../components/OrganizationIndexCard.astro';
import '../../styles/organization-index.css';
import {
  getFunctionalRoleLabel,
  getRelationshipStatusLabel,
  resolveOrganizationTaxonomy
} from '../../utils/organizationTaxonomy';
import { formatPublicLabel } from '../../utils/displayLabels';
import { getOrganizations, getRelationships, getStablecoins } from '../../lib/data/registry';
import { getCanonicalEvidenceRelations } from '../../lib/data/evidenceSources';

const organizations = getOrganizations();
const stablecoins = getStablecoins();
const relationships = getRelationships();
const evidenceRelations = getCanonicalEvidenceRelations();
const stablecoinById = new Map(stablecoins.map((coin) => [coin.id, coin] as const));
const unique = <T,>(values: T[]) => [...new Set(values)];

const records = organizations.map((organization) => {
  const taxonomy = resolveOrganizationTaxonomy(organization);
  const relatedRelationships = relationships.filter((relationship) => relationship.organization_id === organization.id);
  const relatedCoins = unique(relatedRelationships.map((relationship) => stablecoinById.get(relationship.stablecoin_id)).filter(Boolean));
  const roles = unique(relatedRelationships.map((relationship) => relationship.role)).sort();
  const relationshipStatuses = unique(relatedRelationships.map((relationship) => relationship.status ?? 'unknown')).sort();
  const sourceIdentityCount = new Set(evidenceRelations.filter((relation) => relation.organization_ids.includes(organization.id)).map((relation) => relation.evidence_id)).size;
  const assetNames = relatedCoins.map((coin) => coin!.name).sort();
  const search = [
    organization.name,
    organization.slug,
    organization.organization_type,
    organization.legacy_issuer_type,
    taxonomy.public_category_label,
    taxonomy.regulatory_character_label,
    taxonomy.jurisdiction_label,
    taxonomy.jurisdiction_scope_label,
    ...roles.map(getFunctionalRoleLabel),
    ...relationshipStatuses.map(getRelationshipStatusLabel),
    ...relatedCoins.flatMap((coin) => [coin!.name, coin!.symbol])
  ].filter(Boolean).join(' ').normalize('NFKC').toLocaleLowerCase().trim().replace(/\s+/g, ' ');
  return {
    slug: organization.slug,
    name: organization.name,
    search,
    category: taxonomy.public_category,
    categoryLabel: taxonomy.public_category_label,
    regulatory: taxonomy.regulatory_character,
    regulatoryLabel: taxonomy.regulatory_character_label,
    jurisdictionScope: taxonomy.jurisdiction_scope,
    jurisdictionLabel: `${taxonomy.jurisdiction_label} · ${taxonomy.jurisdiction_scope_label}`,
    roles,
    relationshipStatuses,
    assetCount: relatedCoins.length,
    assetNames,
    relationshipCount: relatedRelationships.length,
    sourceIdentityCount,
    confidenceLabel: formatPublicLabel(organization.confidence)
  };
}).sort((left, right) => left.name.localeCompare(right.name));

const option = (value: string, label: string) => ({ value, label });
const filters = [
  { id: 'category', label: 'Category', options: unique(records.map((record) => record.category)).sort().map((value) => option(value, records.find((record) => record.category === value)!.categoryLabel)) },
  { id: 'regulatory', label: 'Regulatory character', options: unique(records.map((record) => record.regulatory)).sort().map((value) => option(value, records.find((record) => record.regulatory === value)!.regulatoryLabel)) },
  { id: 'jurisdiction', label: 'Jurisdiction scope', options: unique(records.map((record) => record.jurisdictionScope)).sort().map((value) => option(value, formatPublicLabel(value))) },
  { id: 'role', label: 'Functional role', options: unique(records.flatMap((record) => record.roles)).sort().map((value) => option(value, getFunctionalRoleLabel(value))) },
  { id: 'relationship_status', label: 'Relationship state', options: unique(records.flatMap((record) => record.relationshipStatuses)).sort().map((value) => option(value, getRelationshipStatusLabel(value))) }
];
const title = 'Organizations — Stable or Gone';
const description = 'Browse organizations connected to stablecoin records, including category, jurisdiction, functional roles, relationship states, connected assets, and evidence.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Stablecoin Organizations', url: 'https://sog.badjoke-lab.com/issuers/', description, isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' } };
---
<BaseLayout title={title} description={description} canonicalPath="/issuers/" jsonLd={jsonLd}>
  <div class="organization-index-page" data-organization-index>
    <section class="organization-index-intro">
      <div class="panel organization-index-intro-main"><div class="prompt">Organization registry</div><h1>Browse connected organizations</h1><p>Organizations are not treated as synonymous with issuers. Search legal issuers, reserve managers, protocol operators, governance bodies, custodians, technology providers, and other recorded roles while preserving current and historical relationships.</p></div>
      <div class="panel organization-index-intro-stats" aria-label="Organization registry totals"><div class="organization-index-stat"><span>Organizations</span><strong>{records.length}</strong></div><div class="organization-index-stat"><span>Relationships</span><strong>{relationships.length}</strong></div><div class="organization-index-stat"><span>Connected assets</span><strong>{new Set(relationships.map((relationship) => relationship.stablecoin_id)).size}</strong></div><div class="organization-index-stat"><span>Source identities</span><strong>{new Set(evidenceRelations.filter((relation) => relation.organization_ids.length > 0).map((relation) => relation.evidence_id)).size}</strong></div></div>
    </section>

    <section class="panel organization-index-registry" aria-labelledby="organization-index-heading">
      <div class="bar" id="organization-index-heading">All organization records</div>
      <div class="organization-index-toolbar">
        <label><span>Search</span><input data-organization-search type="search" name="q" placeholder="Name, jurisdiction, asset, role" autocomplete="off" /></label>
        <label><span>Sort</span><select data-organization-sort name="sort"><option value="name_asc">Name A–Z</option><option value="name_desc">Name Z–A</option><option value="assets_most">Most connected assets</option><option value="relationships_most">Most relationships</option><option value="evidence_most">Most source identities</option></select></label>
        <button class="organization-index-action" type="button" data-organization-clear-all>Clear all</button>
      </div>

      <div class="organization-index-filter-grid" aria-label="Organization filters">
        {filters.map((filter) => <details class="organization-index-filter"><summary data-summary-label="0 selected">{filter.label} <span aria-hidden="true" data-organization-filter-count={filter.id}>0</span></summary><div class="organization-index-filter-options">{filter.options.map((item) => <label><input type="checkbox" data-organization-filter-group={filter.id} data-label={item.label} value={item.value} /><span>{item.label}</span></label>)}</div></details>)}
      </div>

      <div class="organization-index-summary"><div class="organization-index-active-filters" data-organization-active-filters aria-label="Active organization filters"></div><div class="organization-index-result-count" aria-live="polite"><span data-organization-result-count>{records.length}</span> of {records.length} organizations</div></div>
      <div class="organization-index-table"><table data-table-kind="organization-index" data-mobile-table="scroll-preserve"><caption>Organization registry results. Compact record cards follow in the same document for small screens.</caption><thead><tr><th>Organization</th><th>Organization category</th><th>Regulatory character</th><th>Jurisdiction</th><th>Functional roles</th><th>Relationship state</th><th>Connected assets</th><th>Evidence</th></tr></thead><tbody data-organization-body>{records.map((record) => <OrganizationIndexRow record={record} />)}</tbody></table></div>
      <div class="organization-index-cards" data-organization-card-body aria-label="Organization compact records">{records.map((record) => <OrganizationIndexCard record={record} />)}</div>
      <div class="organization-index-no-results" data-organization-no-results hidden><strong>No organizations match this state.</strong><span>Clear the search and filters to restore all organization records.</span><button class="organization-index-action" type="button" data-organization-clear-all>Clear all</button></div>
    </section>
  </div>
  <script>import '../../scripts/organization-index';</script>
</BaseLayout>
