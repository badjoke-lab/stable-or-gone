---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const siteUrl = 'https://sog.badjoke-lab.com';
const gaMeasurementId = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '').trim();
const {
  title = 'Stable or Gone — Stablecoin History Registry',
  description = 'A terminal-style stablecoin history registry for stablecoin records, depeg events, issuers, reserve references, redemption context, lifecycle changes, and source-backed evidence.',
  canonicalPath = Astro.url.pathname,
  ogImage = '/og/sog-og.svg',
  jsonLd
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const structuredData = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
const gaLoaderUrl = gaMeasurementId ? `https://www.google${'tagmanager'}.com/gtag/js?id=${gaMeasurementId}` : '';
const gaInline = gaMeasurementId
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaMeasurementId}');`
  : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Stable or Gone" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {gaLoaderUrl && <script async src={gaLoaderUrl}></script>}
    {gaInline && <script set:html={gaInline} />}
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Stable or Gone home">
          <strong>STABLE OR GONE</strong>
          <span>terminal registry / source-backed stablecoin records</span>
        </a>
        <nav class="nav" aria-label="Primary navigation">
          <a href="/stablecoins/">Stablecoins</a>
          <a href="/issuers/">Issuers</a>
          <a href="/events/">Events</a>
          <a href="/guides/">Guides</a>
          <a href="/glossary/">Glossary</a>
          <a href="/methodology/">Methodology</a>
          <a href="/updates/">Updates</a>
          <a href="/contact/">Contact</a>
          <a href="/support/" data-primary="true">Support</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>SOG is a registry, not a stablecoin safety ranking or investment guide.</span>
        <span><a href="/contact/">Contact / submit correction</a> · <a href="https://github.com/badjoke-lab/stable-or-gone/issues">GitHub Issues</a></span>
      </footer>
    </div>
  </body>
</html>
