---
import BrandLockup from '../components/BrandLockup.astro';
import { PUBLIC_ORIGIN } from '../../config/public-origin.mjs';
import { aboutNavigation, footerNavigationGroups, globalNavigationGroups } from '../../config/site-architecture.mjs';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  language?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const siteUrl = PUBLIC_ORIGIN;
const gaMeasurementId = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '').trim();
const {
  title = 'Stable or Gone — Stablecoin History Registry',
  description = 'Explore stablecoin histories, major events, organizations, reserve information, redemption terms, and the sources behind each record.',
  canonicalPath = Astro.url.pathname,
  ogImage = '/og/sog-og.svg',
  language = 'en',
  jsonLd
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const structuredData = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\u003c') : '';
const gaLoaderUrl = gaMeasurementId ? `https://www.google${'tagmanager'}.com/gtag/js?id=${gaMeasurementId}` : '';
const gaInline = gaMeasurementId
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaMeasurementId}');`
  : '';

const routeFamilies: Record<string, string[]> = {
  '/stablecoins/': ['/stablecoins/', '/stablecoin/'],
  '/issuers/': ['/issuers/', '/issuer/'],
  '/events/': ['/events/', '/event/'],
  '/guides/': ['/guides/'],
  '/timeline/': ['/timeline/'],
  '/compare/': ['/compare/'],
  '/access-regulation/': ['/access-regulation/'],
  '/stats/': ['/stats/'],
  '/glossary/': ['/glossary/'],
  '/models/': ['/models/'],
  '/methodology/': ['/methodology/'],
  '/updates/': ['/updates/'],
  '/maintenance/': ['/maintenance/'],
  '/about/': ['/about/'],
  '/contact/': ['/contact/'],
  '/support/': ['/support/']
};

const editorialPrefixes = ['/guides/', '/glossary/', '/models/', '/methodology/', '/updates/', '/maintenance/', '/about/', '/contact/', '/support/'];
const pageFamily = editorialPrefixes.some((prefix) => pathname === prefix || pathname.startsWith(prefix)) ? 'editorial' : 'registry';
const isGuideIndex = pathname === '/guides/';
const isGuideArticle = pathname.startsWith('/guides/') && !isGuideIndex;
const isReferencePage = ['/models/', '/glossary/', '/updates/'].includes(pathname);
const isLongformPage = ['/methodology/', '/about/'].includes(pathname);
const isUtilityPage = ['/contact/', '/support/'].includes(pathname);
const isHomePage = pathname === '/';
const isSupportPage = pathname === '/support/';
const showFooterSupport = !isHomePage && !isSupportPage;
const pageKind = isGuideIndex ? 'guide-index' : isGuideArticle ? 'guide-article' : isReferencePage ? 'reference' : isLongformPage ? 'longform' : isUtilityPage ? 'utility' : undefined;
const isCurrent = (href: string) => (routeFamilies[href] ?? [href]).some((prefix) => pathname === prefix || pathname.startsWith(prefix));

const allNavigation = new Map<string, { label: string; href: string }>();
for (const group of globalNavigationGroups) {
  for (const item of group.items) allNavigation.set(item.href, item);
}
for (const item of aboutNavigation) allNavigation.set(item.href, item);

const primaryPaths = ['/stablecoins/', '/issuers/', '/events/', '/compare/', '/timeline/', '/stats/', '/guides/'];
const secondaryPaths = ['/access-regulation/', '/glossary/', '/models/', '/methodology/', '/updates/', '/maintenance/', '/about/'];
const primaryNavigation = primaryPaths.map((href) => allNavigation.get(href)).filter(Boolean) as { label: string; href: string }[];
const secondaryNavigation = secondaryPaths.map((href) => allNavigation.get(href)).filter(Boolean) as { label: string; href: string }[];

const dataLinks = [
  { label: 'Version JSON', href: '/version.json' },
  { label: 'Data manifest', href: '/data/manifest.json' },
  { label: 'LLM guide', href: '/llms.txt' },
  { label: 'AI entrypoint', href: '/ai.txt' }
];
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/brand/sog-mark-on-light.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={language} href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="alternate" type="application/json" href="/version.json" title="SOG production version" />
    <link rel="alternate" type="application/json" href="/data/manifest.json" title="SOG public data manifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="SOG LLM guide" />
    <link rel="alternate" type="text/plain" href="/ai.txt" title="SOG AI entrypoint" />
    <meta property="og:site_name" content="Stable or Gone" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {gaLoaderUrl && <script async src={gaLoaderUrl}></script>}
    {gaInline && <script set:html={gaInline} />}
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-frame">
      <header class="site-header">
        <div class="masthead-row v3-masthead-row site-shell">
          <div class="brand v3-brand-block">
            <BrandLockup class="site-brand" surface="dark" href="/" />
            <span class="brand-copy v3-brand-copy" aria-hidden="true">
              <strong>Stablecoin history registry</strong>
              <small>Evidence, lifecycle, access, and institutional context</small>
            </span>
          </div>
          <div class="masthead-actions" aria-label="Project actions">
            {isSupportPage ? (
              <span class="support-cta support-cta--header" aria-current="page"><span class="support-cta-label--full">Support this archive</span><span class="support-cta-label--compact" aria-hidden="true">Support</span></span>
            ) : (
              <a class="support-cta support-cta--header" href="/support/" aria-label="Support this archive"><span class="support-cta-label--full">Support this archive</span><span class="support-cta-label--compact" aria-hidden="true">Support</span></a>
            )}
            <a class="correction-link" href="/contact/">Submit correction</a>
          </div>
        </div>
        <div class="nav-rule">
          <div class="site-navigation-shell site-shell">
            <nav class="site-nav site-primary-navigation" aria-label="Primary navigation">
              {primaryNavigation.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
              ))}
            </nav>
            <details class="site-more-navigation" data-disclosure>
              <summary aria-label="Open additional navigation">More</summary>
              <nav class="site-more-navigation-panel" aria-label="Additional navigation">
                {secondaryNavigation.map((item) => (
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
                ))}
                <a href="/contact/">Corrections</a>
              </nav>
            </details>
          </div>
        </div>
      </header>

      <main id="main-content" class="site-main site-shell" tabindex="-1" data-page-family={pageFamily} data-page-kind={pageKind}>
        {isGuideArticle ? (
          <article class="guide-article-layout" data-guide-article>
            <details class="guide-article-toc" data-guide-toc data-disclosure open>
              <summary aria-controls="guide-article-contents" aria-expanded="true">On this page</summary>
              <ol id="guide-article-contents" data-guide-toc-list></ol>
            </details>
            <div class="guide-article-content"><slot /></div>
            <aside class="context-support-callout" aria-label="Support Stable or Gone">
              <p><strong>Help keep this archive public.</strong> Support source checks, broken-link review, record updates, and long-term maintenance.</p>
              <a class="support-cta" href="/support/">View support options</a>
            </aside>
            <nav class="guide-article-footer" aria-label="Guide reference navigation">
              <a href="/guides/">All guides</a>
              <a href="/glossary/">Glossary</a>
              <a href="/methodology/">Methodology</a>
              <a href="/support/">Support</a>
              <a href="/contact/">Submit a correction</a>
            </nav>
          </article>
        ) : isLongformPage ? (
          <article class="longform-layout" data-longform-article>
            <details class="longform-toc" data-longform-toc data-disclosure open>
              <summary aria-controls="longform-contents" aria-expanded="true">On this page</summary>
              <ol id="longform-contents" data-longform-toc-list></ol>
            </details>
            <div class="longform-content"><slot /></div>
            <aside class="context-support-callout" aria-label="Support Stable or Gone">
              <p><strong>Stable or Gone is independently maintained.</strong> Support the research, source review, and upkeep behind the public registry.</p>
              <a class="support-cta" href="/support/">View support options</a>
            </aside>
            <nav class="longform-footer" aria-label="Project reference navigation">
              <a href="/glossary/">Glossary</a>
              <a href="/models/">Models</a>
              <a href="/updates/">Updates</a>
              <a href="/support/">Support</a>
              <a href="/contact/">Corrections</a>
            </nav>
          </article>
        ) : <slot />}
      </main>

      <footer class="site-footer">
        {showFooterSupport && (
          <div class="footer-support site-shell">
            <div>
              <strong>Help keep Stable or Gone public</strong>
              <p>Support source verification, record updates, broken-link review, and long-term archive maintenance. Support does not buy listings or editorial influence.</p>
            </div>
            <a class="support-cta" href="/support/">View support options</a>
          </div>
        )}
        <div class="footer-navigation site-shell">
          {footerNavigationGroups.map((group) => (
            <details class="footer-navigation-group" data-footer-group data-disclosure open>
              <summary>{group.label}</summary>
              <nav aria-label={`${group.label} footer navigation`}>
                {String(group.id) === 'discovery' && (
                  <span aria-current="page">
                    <strong>Stable or Gone</strong>
                    <small> · Current project</small>
                  </span>
                )}
                {group.items.map((item) => isSupportPage && item.href === '/support/' ? (
                  <span aria-current="page">Support</span>
                ) : (
                  <a href={item.href}>{item.label}</a>
                ))}
                {String(group.id) === 'discovery' && (
                  <a href="https://mag.badjoke-lab.com/">Minted &amp; Gone</a>
                )}
              </nav>
            </details>
          ))}
          <details class="footer-navigation-group footer-data-links" data-footer-group data-disclosure open>
            <summary>Public data</summary>
            <nav aria-label="Public data links">
              {dataLinks.map((item) => <a href={item.href}>{item.label}</a>)}
            </nav>
          </details>
        </div>
        <div class="footer-legal site-shell">
          <p>Stable or Gone is a source-backed historical registry, not a ranking, recommendation, or real-time market dashboard.</p>
        </div>
      </footer>
    </div>

    <script>
      const initialiseDisclosure = (details: HTMLDetailsElement) => {
        const trigger = details.querySelector(':scope > summary');
        if (!(trigger instanceof HTMLElement)) return;
        const sync = () => trigger.setAttribute('aria-expanded', String(details.open));
        sync();
        details.addEventListener('toggle', sync);
        details.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || !details.open) return;
          event.preventDefault();
          details.open = false;
          trigger.focus();
        });
      };
      document.querySelectorAll('[data-disclosure]').forEach((item) => {
        if (item instanceof HTMLDetailsElement) initialiseDisclosure(item);
      });
      if (window.matchMedia('(max-width: 640px)').matches) {
        document.querySelectorAll('[data-footer-group]').forEach((item) => {
          if (item instanceof HTMLDetailsElement) item.open = false;
        });
      }

      const buildContents = (articleSelector: string, tocSelector: string, listSelector: string, sectionSelector: string, headingSelector: string) => {
        const article = document.querySelector(articleSelector);
        const toc = document.querySelector(tocSelector);
        const list = document.querySelector(listSelector);
        if (!(article instanceof HTMLElement) || !(toc instanceof HTMLDetailsElement) || !(list instanceof HTMLOListElement)) return;
        const usedIds = new Set<string>();
        const makeId = (value: string) => {
          const base = String(value || 'section').normalize('NFKD').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'section';
          let next = base;
          let suffix = 2;
          while (usedIds.has(next) || document.getElementById(next)) next = `${base}-${suffix++}`;
          usedIds.add(next);
          return next;
        };
        [...article.querySelectorAll(sectionSelector)].forEach((section) => {
          let heading = section.querySelector(headingSelector);
          if (!(heading instanceof HTMLElement)) return;
          if (heading.classList.contains('bar') && heading.tagName !== 'H2') {
            const replacement = document.createElement('h2');
            replacement.className = heading.className;
            replacement.innerHTML = heading.innerHTML;
            heading.replaceWith(replacement);
            heading = replacement;
          }
          const label = heading.textContent?.trim();
          if (!label) return;
          if (!section.id) section.id = makeId(label);
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${section.id}`;
          link.textContent = label;
          item.append(link);
          list.append(item);
        });
        if (list.children.length === 0) toc.hidden = true;
        else if (window.matchMedia('(max-width: 820px)').matches) toc.open = true;
      };

      buildContents(
        '[data-guide-article]',
        '[data-guide-toc]',
        '[data-guide-toc-list]',
        '.guide-article-content > section.panel.registry, .guide-article-content > section[data-guide-section]',
        ':scope > .bar, :scope > .guide-article-section-title'
      );
      buildContents(
        '[data-longform-article]',
        '[data-longform-toc]',
        '[data-longform-toc-list]',
        '.longform-content > section.panel.registry, .longform-content > section[data-longform-section]',
        ':scope > .bar, :scope > .longform-section-title'
      );

      const focusAnchorTarget = (hash: string) => {
        if (!hash || hash === '#') return;
        const target = document.getElementById(decodeURIComponent(hash.slice(1)));
        if (!(target instanceof HTMLElement)) return;
        if (!target.matches('a,button,input,select,textarea,summary,[tabindex]')) target.setAttribute('tabindex', '-1');
        target.setAttribute('data-anchor-focus', 'true');
        target.focus({ preventScroll: true });
      };
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a[href^="#"]') : null;
        if (!(link instanceof HTMLAnchorElement)) return;
        window.setTimeout(() => focusAnchorTarget(link.hash), 0);
      });
      window.addEventListener('hashchange', () => focusAnchorTarget(window.location.hash));
      if (window.location.hash) window.setTimeout(() => focusAnchorTarget(window.location.hash), 0);

      const fallbackCopy = (value: string) => {
        const textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.append(textarea);
        textarea.select();
        const copied = document.execCommand('copy');
        textarea.remove();
        return copied;
      };

      document.querySelectorAll('[data-copy-value]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', async () => {
          const value = button.dataset.copyValue ?? '';
          const original = button.textContent ?? 'Copy';
          let copied = false;
          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(value);
              copied = true;
            } else copied = fallbackCopy(value);
          } catch {
            copied = fallbackCopy(value);
          }
          const card = button.closest('[data-copy-container]');
          const feedback = card?.querySelector('[data-copy-feedback]');
          button.textContent = copied ? 'Copied' : 'Copy failed';
          button.dataset.copyState = copied ? 'success' : 'error';
          if (feedback instanceof HTMLElement) {
            feedback.setAttribute('aria-live', 'polite');
            feedback.textContent = copied
              ? 'Full identifier copied to clipboard.'
              : 'Could not copy automatically. Select and copy the full identifier manually.';
          }
          window.setTimeout(() => {
            button.textContent = original;
            delete button.dataset.copyState;
          }, 1800);
        });
      });
    </script>
  </body>
</html>