---
import '../styles/global.css';
import '../styles/shell.css';
import '../styles/accessibility-utilities.css';
import '../styles/editorial-v2.css';
import '../styles/editorial-ledger-v3.css';
import '../styles/guide-editorial-v3.css';
import BrandLockup from '../components/BrandLockup.astro';
import { aboutNavigation, footerNavigationGroups, primaryNavigation } from '../../config/site-architecture.mjs';
interface Props { title?: string; description?: string; canonicalPath?: string; ogImage?: string; jsonLd?: Record<string, unknown> | Record<string, unknown>[]; }
const siteUrl = 'https://sog.badjoke-lab.com';
const gaMeasurementId = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '').trim();
const { title = 'Stable or Gone — Stablecoin History Registry', description = 'Explore stablecoin histories, major events, organizations, reserve information, redemption terms, and the sources behind each record.', canonicalPath = Astro.url.pathname, ogImage = '/og/sog-og.svg', jsonLd } = Astro.props;
const pathname = Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const structuredData = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\u003c') : '';
const gaLoaderUrl = gaMeasurementId ? `https://www.google${'tagmanager'}.com/gtag/js?id=${gaMeasurementId}` : '';
const gaInline = gaMeasurementId ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaMeasurementId}');` : '';
const routeFamilies: Record<string, string[]> = {
  '/stablecoins/': ['/stablecoins/', '/stablecoin/'], '/issuers/': ['/issuers/', '/issuer/'], '/events/': ['/events/', '/event/'], '/guides/': ['/guides/'], '/glossary/': ['/glossary/'], '/models/': ['/models/'], '/methodology/': ['/methodology/'], '/updates/': ['/updates/'], '/about/': ['/about/'], '/contact/': ['/contact/'], '/support/': ['/support/']
};
const editorialPrefixes = ['/guides/', '/glossary/', '/models/', '/methodology/', '/updates/', '/about/', '/contact/', '/support/'];
const pageFamily = editorialPrefixes.some((prefix) => pathname === prefix || pathname.startsWith(prefix)) ? 'editorial' : 'registry';
const isGuideIndex = pathname === '/guides/';
const isGuideArticle = pathname.startsWith('/guides/') && !isGuideIndex;
const pageKind = isGuideIndex ? 'guide-index' : isGuideArticle ? 'guide-article' : undefined;
const isCurrent = (href: string) => (routeFamilies[href] ?? [href]).some((prefix) => pathname === prefix || pathname.startsWith(prefix));
const isAboutCurrent = aboutNavigation.some((item) => isCurrent(item.href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/brand/sog-mark-on-light.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="alternate" type="application/json" href="/version.json" title="SOG production version" />
    <link rel="alternate" type="application/json" href="/data/manifest.json" title="SOG public data manifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="SOG LLM guide" />
    <link rel="alternate" type="text/plain" href="/ai.txt" title="SOG AI entrypoint" />
    <meta property="og:site_name" content="Stable or Gone" /><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImageUrl} />
    {gaLoaderUrl && <script async src={gaLoaderUrl}></script>}{gaInline && <script set:html={gaInline} />}{structuredData && <script type="application/ld+json" set:html={structuredData} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <BrandLockup class="site-brand" surface="light" />
        <nav class="site-primary-navigation" aria-label="Primary navigation">
          {primaryNavigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <form class="site-search" action="/stablecoins/" method="get" role="search">
          <label class="visually-hidden" for="site-search-input">Search stablecoin records</label>
          <input id="site-search-input" type="search" name="q" placeholder="Search register" autocomplete="off" />
          <button type="submit">Search</button>
        </form>
        <details class="site-about-menu">
          <summary aria-current={isAboutCurrent ? 'page' : undefined}>About</summary>
          <nav class="site-about-panel" aria-label="About and project navigation">
            {aboutNavigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
          </nav>
        </details>
        <details class="mobile-navigation" data-mobile-navigation>
          <summary aria-label="Open navigation menu">Menu</summary>
          <div class="mobile-navigation-panel">
            <nav class="mobile-navigation-links" aria-label="Mobile primary navigation">
              {primaryNavigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
            </nav>
            <form class="mobile-site-search" action="/stablecoins/" method="get" role="search">
              <label for="mobile-site-search-input">Search stablecoin records</label>
              <div><input id="mobile-site-search-input" type="search" name="q" placeholder="Search register" autocomplete="off" /><button type="submit">Search</button></div>
            </form>
            <nav class="mobile-navigation-secondary" aria-label="Mobile project navigation">
              {aboutNavigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
            </nav>
          </div>
        </details>
      </div>
    </header>
    <main id="main-content" class="site-main" tabindex="-1" data-page-family={pageFamily} data-page-kind={pageKind}>
      {isGuideArticle ? (
        <article class="guide-article-layout" data-guide-article>
          <details class="guide-article-toc" data-guide-toc open>
            <summary>On this page</summary>
            <ol data-guide-toc-list></ol>
          </details>
          <div class="guide-article-content"><slot /></div>
          <nav class="guide-article-footer" aria-label="Guide reference navigation"><a href="/guides/">All guides</a><a href="/glossary/">Glossary</a><a href="/methodology/">Methodology</a><a href="/contact/">Submit a correction</a></nav>
        </article>
      ) : <slot />}
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="site-footer-intro">
          <BrandLockup surface="light" />
          <p>Historical information only. Stable or Gone is a source-backed registry, not a ranking or recommendation service.</p>
        </div>
        {footerNavigationGroups.map((group) => (
          <nav class="site-footer-group" aria-labelledby={`footer-${group.id}`}>
            <h2 id={`footer-${group.id}`}>{group.label}</h2>
            {group.items.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
        ))}
        <nav class="site-footer-group site-footer-data" aria-labelledby="footer-data">
          <h2 id="footer-data">Data access</h2>
          <a href="/version.json">Version JSON</a>
          <a href="/data/manifest.json">Data manifest</a>
          <a href="/llms.txt">LLM guide</a>
          <a href="/ai.txt">AI entrypoint</a>
        </nav>
        <p class="site-footer-meta">Canonical records, evidence relations, and known unknowns are preserved across desktop and compact layouts.</p>
      </div>
    </footer>
    <script>
      const navigation = document.querySelector('[data-mobile-navigation]');
      if (navigation instanceof HTMLDetailsElement) {
        const trigger = navigation.querySelector('summary');
        navigation.addEventListener('keydown', (event) => { if (event.key !== 'Escape' || !navigation.open) return; event.preventDefault(); navigation.open = false; if (trigger instanceof HTMLElement) trigger.focus(); });
        navigation.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { navigation.open = false; }));
      }
      document.addEventListener('click', (event) => {
        document.querySelectorAll('.site-about-menu[open]').forEach((menu) => {
          if (menu instanceof HTMLDetailsElement && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
        });
      });
      const guideArticle = document.querySelector('[data-guide-article]');
      const guideToc = document.querySelector('[data-guide-toc]');
      const guideTocList = document.querySelector('[data-guide-toc-list]');
      if (guideArticle instanceof HTMLElement && guideToc instanceof HTMLDetailsElement && guideTocList instanceof HTMLOListElement) {
        const usedIds = new Set();
        const makeId = (value) => {
          const base = String(value || 'section').normalize('NFKD').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'section';
          let next = base;
          let suffix = 2;
          while (usedIds.has(next) || document.getElementById(next)) next = `${base}-${suffix++}`;
          usedIds.add(next);
          return next;
        };
        const sections = [...guideArticle.querySelectorAll('.guide-article-content > section.panel.registry, .guide-article-content > section[data-guide-section]')];
        sections.forEach((section) => {
          let heading = section.querySelector(':scope > .bar, :scope > .guide-article-section-title');
          if (!(heading instanceof HTMLElement)) return;
          if (heading.classList.contains('bar') && heading.tagName !== 'H2') {
            const replacement = document.createElement('h2');
            replacement.className = heading.className;
            replacement.innerHTML = heading.innerHTML;
            heading.replaceWith(replacement);
            heading = replacement;
          }
          const label = heading.textContent?.trim();
          if (!label) return;
          if (!section.id) section.id = makeId(label);
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${section.id}`;
          link.textContent = label;
          item.append(link);
          guideTocList.append(item);
        });
        if (guideTocList.children.length === 0) guideToc.hidden = true;
        if (window.matchMedia('(max-width: 820px)').matches) guideToc.open = false;
      }
    </script>
  </body>
</html>
