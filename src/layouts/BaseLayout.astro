---
import '../styles/global.css';
import '../styles/shell.css';
import '../styles/accessibility-utilities.css';
import '../styles/editorial-ledger-v3.css';
import '../styles/guide-editorial-v3.css';
import '../styles/reference-utility-v3.css';
import '../styles/mobile-accessibility-v3.css';
import BrandLockup from '../components/BrandLockup.astro';
import { footerNavigationGroups, globalNavigationGroups, utilityNavigation } from '../../config/site-architecture.mjs';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  language?: string;
}

const siteUrl = 'https://sog.badjoke-lab.com';
const gaMeasurementId = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '').trim();
const {
  title = 'Stable or Gone — Stablecoin History Registry',
  description = 'Explore stablecoin histories, major events, organizations, reserve information, redemption terms, and the sources behind each record.',
  canonicalPath = Astro.url.pathname,
  ogImage = '/og/sog-og.svg',
  jsonLd,
  language = 'en'
} = Astro.props;
const pathname = Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const structuredData = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
const gaLoaderUrl = gaMeasurementId ? `https://www.google${'tagmanager'}.com/gtag/js?id=${gaMeasurementId}` : '';
const gaInline = gaMeasurementId ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaMeasurementId}');` : '';

const routeFamilies: Record<string, string[]> = {
  '/': ['/'],
  '/stablecoins/': ['/stablecoins/', '/stablecoin/'],
  '/compare/': ['/compare/'],
  '/access-regulation/': ['/access-regulation/'],
  '/timeline/': ['/timeline/'],
  '/issuers/': ['/issuers/', '/issuer/'],
  '/events/': ['/events/', '/event/'],
  '/stats/': ['/stats/'],
  '/guides/': ['/guides/'],
  '/glossary/': ['/glossary/'],
  '/models/': ['/models/'],
  '/methodology/': ['/methodology/'],
  '/updates/': ['/updates/'],
  '/maintenance/': ['/maintenance/'],
  '/about/': ['/about/'],
  '/contact/': ['/contact/'],
  '/support/': ['/support/']
};
const editorialPrefixes = ['/guides/', '/glossary/', '/models/', '/methodology/', '/updates/', '/maintenance/', '/about/', '/contact/', '/support/'];
const pageFamily = editorialPrefixes.some((prefix) => pathname === prefix || pathname.startsWith(prefix)) ? 'editorial' : 'registry';
const isGuideIndex = pathname === '/guides/';
const isGuideArticle = pathname.startsWith('/guides/') && !isGuideIndex;
const isReferencePage = ['/models/', '/glossary/', '/updates/', '/maintenance/'].includes(pathname);
const isLongformPage = ['/methodology/', '/about/'].includes(pathname);
const isUtilityPage = ['/contact/', '/support/'].includes(pathname);
const pageKind = isGuideIndex ? 'guide-index' : isGuideArticle ? 'guide-article' : isReferencePage ? 'reference' : isLongformPage ? 'longform' : isUtilityPage ? 'utility' : undefined;
const isCurrent = (href: string) => {
  if (href === '/') return pathname === '/';
  return (routeFamilies[href] ?? [href]).some((prefix) => pathname === prefix || pathname.startsWith(prefix));
};
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/brand/sog-mark-on-light.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={language} href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="alternate" type="application/json" href="/version.json" title="SOG production version" />
    <link rel="alternate" type="application/json" href="/data/manifest.json" title="SOG public data manifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="SOG LLM guide" />
    <link rel="alternate" type="text/plain" href="/ai.txt" title="SOG AI entrypoint" />
    <meta property="og:site_name" content="Stable or Gone" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={language === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {gaLoaderUrl && <script async src={gaLoaderUrl}></script>}
    {gaInline && <script set:html={gaInline} />}
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header" data-shell="evidence-registry-pr411">
      <div class="site-header-primary">
        <div class="site-header-inner">
          <div class="site-brand-cluster">
            <BrandLockup class="site-brand" surface="light" />
            <span class="site-brand-purpose">Evidence-backed stablecoin registry</span>
          </div>

          <form class="site-search" action="/stablecoins/" method="get" role="search">
            <label class="visually-hidden" for="site-search-input">Search stablecoin records</label>
            <div class="site-search-control">
              <span class="site-search-icon" aria-hidden="true">⌕</span>
              <input id="site-search-input" type="search" name="q" placeholder="Search stablecoins, issuers, events" autocomplete="off" />
              <button type="submit">Search</button>
            </div>
          </form>

          <nav class="utility-navigation" aria-label="Utility navigation">
            {utilityNavigation.map((item) => (
              <a
                href={item.href}
                class:list={[item.prominence === 'primary_utility' ? 'utility-primary' : 'utility-secondary']}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <details class="mobile-navigation" data-mobile-navigation data-disclosure>
            <summary aria-label="Open navigation menu" aria-controls="mobile-navigation-panel" aria-expanded="false">
              <span>Menu</span>
              <span class="mobile-navigation-icon" aria-hidden="true"><i></i><i></i><i></i></span>
            </summary>
            <div class="mobile-navigation-panel" id="mobile-navigation-panel">
              <form class="mobile-site-search" action="/stablecoins/" method="get" role="search">
                <label for="mobile-site-search-input">Search the registry</label>
                <div class="site-search-control">
                  <span class="site-search-icon" aria-hidden="true">⌕</span>
                  <input id="mobile-site-search-input" type="search" name="q" placeholder="Stablecoin, issuer, event" autocomplete="off" />
                  <button type="submit">Search</button>
                </div>
              </form>

              {globalNavigationGroups.map((group) => (
                <section class="mobile-navigation-group" aria-labelledby={`mobile-navigation-${group.id}`}>
                  <h2 id={`mobile-navigation-${group.id}`}>{group.label}</h2>
                  <nav class="mobile-navigation-links" aria-label={`${group.label} navigation`}>
                    {group.items.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
                  </nav>
                </section>
              ))}

              <nav class="mobile-navigation-utilities" aria-label="Mobile utility navigation">
                {utilityNavigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
              </nav>
            </div>
          </details>
        </div>
      </div>

      <div class="site-navigation-bar">
        <div class="site-navigation-inner">
          <nav class="grouped-navigation" aria-label="Primary navigation">
            {globalNavigationGroups.map((group) => (
              <section class="navigation-group" aria-labelledby={`navigation-${group.id}`}>
                <span class="navigation-group-label" id={`navigation-${group.id}`}>{group.label}</span>
                <div class="navigation-group-links">
                  {group.items.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
                </div>
              </section>
            ))}
          </nav>
          <p class="site-navigation-context">Historical records · evidence links · unresolved questions</p>
        </div>
      </div>
    </header>

    <main id="main-content" class="site-main" tabindex="-1" data-page-family={pageFamily} data-page-kind={pageKind}>
      {isGuideArticle ? (
        <article class="guide-article-layout" data-guide-article>
          <details class="guide-article-toc" data-guide-toc data-disclosure open>
            <summary aria-controls="guide-article-contents" aria-expanded="true">On this page</summary>
            <ol id="guide-article-contents" data-guide-toc-list></ol>
          </details>
          <div class="guide-article-content"><slot /></div>
          <nav class="guide-article-footer" aria-label="Guide reference navigation">
            <a href="/guides/">All guides</a><a href="/glossary/">Glossary</a><a href="/methodology/">Methodology</a><a href="/contact/">Submit a correction</a>
          </nav>
        </article>
      ) : isLongformPage ? (
        <article class="longform-layout" data-longform-article>
          <details class="longform-toc" data-longform-toc data-disclosure open>
            <summary aria-controls="longform-contents" aria-expanded="true">On this page</summary>
            <ol id="longform-contents" data-longform-toc-list></ol>
          </details>
          <div class="longform-content"><slot /></div>
          <nav class="longform-footer" aria-label="Project reference navigation">
            <a href="/glossary/">Glossary</a><a href="/models/">Models</a><a href="/updates/">Updates</a><a href="/contact/">Corrections</a>
          </nav>
        </article>
      ) : <slot />}
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <section class="site-footer-summary" aria-label="Stable or Gone project statement">
          <BrandLockup surface="light" />
          <p>Stable or Gone is a source-backed historical registry. It records lifecycle changes, organizations, evidence, and unresolved questions; it is not a ranking or recommendation service.</p>
          <div class="site-footer-principles" aria-label="Registry principles">
            <span>Canonical records</span><span>Source relations</span><span>Known unknowns</span>
          </div>
        </section>

        <div class="site-footer-navigation">
          {footerNavigationGroups.map((group) => (
            <nav class="site-footer-group" aria-labelledby={`footer-${group.id}`}>
              <h2 id={`footer-${group.id}`}>{group.label}</h2>
              {group.items.map((item) => <a href={item.href}>{item.label}</a>)}
            </nav>
          ))}
          <nav class="site-footer-group site-footer-data" aria-labelledby="footer-data">
            <h2 id="footer-data">Data access</h2>
            <a href="/version.json">Version JSON</a>
            <a href="/data/manifest.json">Data manifest</a>
            <a href="/llms.txt">LLM guide</a>
            <a href="/ai.txt">AI entrypoint</a>
          </nav>
        </div>

        <p class="site-footer-meta">Routes, canonical records, evidence relations, and public machine-readable outputs are preserved across desktop and mobile layouts.</p>
      </div>
    </footer>

    <script>
      const initialiseDisclosure = (details: HTMLDetailsElement) => {
        const trigger = details.querySelector(':scope > summary');
        if (!(trigger instanceof HTMLElement)) return;
        const sync = () => trigger.setAttribute('aria-expanded', String(details.open));
        sync();
        details.addEventListener('toggle', sync);
        details.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || !details.open) return;
          event.preventDefault();
          details.open = false;
          trigger.focus();
        });
      };
      document.querySelectorAll('[data-disclosure]').forEach((item) => {
        if (item instanceof HTMLDetailsElement) initialiseDisclosure(item);
      });

      const navigation = document.querySelector('[data-mobile-navigation]');
      if (navigation instanceof HTMLDetailsElement) {
        navigation.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { navigation.open = false; }));
        document.addEventListener('click', (event) => {
          if (!navigation.open || !(event.target instanceof Node) || navigation.contains(event.target)) return;
          navigation.open = false;
        });
      }

      const buildContents = (articleSelector: string, tocSelector: string, listSelector: string, sectionSelector: string, headingSelector: string) => {
        const article = document.querySelector(articleSelector);
        const toc = document.querySelector(tocSelector);
        const list = document.querySelector(listSelector);
        if (!(article instanceof HTMLElement) || !(toc instanceof HTMLDetailsElement) || !(list instanceof HTMLOListElement)) return;
        const usedIds = new Set<string>();
        const makeId = (value: string) => {
          const base = String(value || 'section').normalize('NFKD').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'section';
          let next = base;
          let suffix = 2;
          while (usedIds.has(next) || document.getElementById(next)) next = `${base}-${suffix++}`;
          usedIds.add(next);
          return next;
        };
        [...article.querySelectorAll(sectionSelector)].forEach((section) => {
          let heading = section.querySelector(headingSelector);
          if (!(heading instanceof HTMLElement)) return;
          if (heading.classList.contains('bar') && heading.tagName !== 'H2') {
            const replacement = document.createElement('h2');
            replacement.className = heading.className;
            replacement.innerHTML = heading.innerHTML;
            heading.replaceWith(replacement);
            heading = replacement;
          }
          const label = heading.textContent?.trim();
          if (!label) return;
          if (!section.id) section.id = makeId(label);
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${section.id}`;
          link.textContent = label;
          item.append(link);
          list.append(item);
        });
        if (list.children.length === 0) toc.hidden = true;
        if (window.matchMedia('(max-width: 820px)').matches) toc.open = false;
      };
      buildContents('[data-guide-article]', '[data-guide-toc]', '[data-guide-toc-list]', '.guide-article-content > section.panel.registry, .guide-article-content > section[data-guide-section]', ':scope > .bar, :scope > .guide-article-section-title');
      buildContents('[data-longform-article]', '[data-longform-toc]', '[data-longform-toc-list]', '.longform-content > section.panel.registry, .longform-content > section[data-longform-section]', ':scope > .bar, :scope > .longform-section-title');

      const focusAnchorTarget = (hash: string) => {
        if (!hash || hash === '#') return;
        const target = document.getElementById(decodeURIComponent(hash.slice(1)));
        if (!(target instanceof HTMLElement)) return;
        if (!target.matches('a,button,input,select,textarea,summary,[tabindex]')) target.setAttribute('tabindex', '-1');
        target.setAttribute('data-anchor-focus', 'true');
        target.focus({ preventScroll: true });
      };
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a[href^="#"]') : null;
        if (!(link instanceof HTMLAnchorElement)) return;
        window.setTimeout(() => focusAnchorTarget(link.hash), 0);
      });
      window.addEventListener('hashchange', () => focusAnchorTarget(window.location.hash));
      if (window.location.hash) window.setTimeout(() => focusAnchorTarget(window.location.hash), 0);

      const fallbackCopy = (value: string) => {
        const textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.append(textarea);
        textarea.select();
        const copied = document.execCommand('copy');
        textarea.remove();
        return copied;
      };
      document.querySelectorAll('[data-copy-value]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', async () => {
          const value = button.dataset.copyValue ?? '';
          const original = button.textContent ?? 'Copy';
          let copied = false;
          try {
            if (navigator.clipboard && window.isSecureContext) { await navigator.clipboard.writeText(value); copied = true; }
            else copied = fallbackCopy(value);
          } catch { copied = fallbackCopy(value); }
          const card = button.closest('[data-copy-container]');
          const feedback = card?.querySelector('[data-copy-feedback]');
          button.textContent = copied ? 'Copied' : 'Copy failed';
          button.dataset.copyState = copied ? 'success' : 'error';
          if (feedback instanceof HTMLElement) {
            feedback.setAttribute('aria-live', 'polite');
            feedback.textContent = copied ? 'Full identifier copied to clipboard.' : 'Could not copy automatically. Select and copy the full identifier manually.';
          }
          window.setTimeout(() => { button.textContent = original; delete button.dataset.copyState; }, 1800);
        });
      });
    </script>
  </body>
</html>
