---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  headline: string;
  sectionLabel: string;
  deck: string;
  publishedAt: string;
  updatedAt?: string;
  treatment: string;
  scope: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath,
  headline,
  sectionLabel,
  deck,
  publishedAt,
  updatedAt = publishedAt,
  treatment,
  scope,
  jsonLd
} = Astro.props;
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <article class="guide-article-layout" data-guide-article data-article-surface>
    <details class="guide-article-toc" data-guide-toc data-disclosure open>
      <summary aria-controls="article-contents" aria-expanded="true">On this page</summary>
      <ol id="article-contents" data-guide-toc-list></ol>
    </details>

    <div class="guide-article-content">
      <header class="guide-article-masthead">
        <div class="guide-article-overline">
          <span>Articles / {sectionLabel}</span>
          <a href="/articles/">Return to article archive</a>
        </div>
        <h1>{headline}</h1>
        <p class="guide-article-deck">{deck}</p>
        <dl class="guide-article-meta" aria-label="Article publication information">
          <div><dt>Published</dt><dd>{publishedAt}</dd></div>
          <div><dt>Last updated</dt><dd>{updatedAt}</dd></div>
          <div><dt>Treatment</dt><dd>{treatment}</dd></div>
          <div><dt>Scope</dt><dd>{scope}</dd></div>
        </dl>
      </header>

      <slot />
    </div>

    <nav class="guide-article-footer" aria-label="Article reference navigation">
      <a href="/articles/">All articles</a>
      <a href="/guides/">Guides</a>
      <a href="/methodology/">Methodology</a>
      <a href="/support/">Support</a>
      <a href="/contact/">Submit a correction</a>
    </nav>
  </article>

  <script>
    const buildArticleMobileTables = () => {
      const article = document.querySelector('[data-article-surface]');
      if (!(article instanceof HTMLElement) || article.dataset.mobileTablesBuilt === 'true') return;
      article.dataset.mobileTablesBuilt = 'true';

      article.querySelectorAll<HTMLTableElement>('.guide-article-content table').forEach((table, tableIndex) => {
        if (table.dataset.mobileTableBuilt === 'true') return;
        table.dataset.mobileTableBuilt = 'true';
        table.dataset.mobileTable = 'guide-records';

        const headers = Array.from(table.querySelectorAll<HTMLTableCellElement>('thead th, thead td'))
          .map((cell) => cell.textContent?.trim() || '');
        const bodyRows = Array.from(table.querySelectorAll<HTMLTableRowElement>('tbody tr'));
        const fallbackRows = bodyRows.length > 0
          ? bodyRows
          : Array.from(table.querySelectorAll<HTMLTableRowElement>('tr')).filter((row) => !row.closest('thead'));
        const list = document.createElement('div');
        const representationId = `article-table-${tableIndex + 1}`;
        list.className = 'mobile-record-list guide-mobile-table-records';
        list.dataset.mobileRepresentationFor = representationId;
        list.setAttribute('aria-label', table.caption?.textContent?.trim() || `Article table ${tableIndex + 1}`);

        fallbackRows.forEach((row) => {
          const cells = Array.from(row.children).filter((cell): cell is HTMLTableCellElement => cell instanceof HTMLTableCellElement);
          if (cells.length === 0) return;
          const record = document.createElement('article');
          record.className = 'mobile-table-record';
          const definitions = document.createElement('dl');

          cells.forEach((cell, cellIndex) => {
            const pair = document.createElement('div');
            const term = document.createElement('dt');
            const definition = document.createElement('dd');
            const firstCellIsHeading = cells[0]?.tagName === 'TH';
            term.textContent = headers[cellIndex]
              || (cell.tagName === 'TH' ? 'Item' : firstCellIsHeading && cellIndex === 1 ? 'Details' : `Field ${cellIndex + 1}`);
            definition.append(...Array.from(cell.childNodes).map((node) => node.cloneNode(true)));
            pair.append(term, definition);
            definitions.append(pair);
          });

          record.append(definitions);
          list.append(record);
        });

        if (list.children.length > 0) table.insertAdjacentElement('afterend', list);
      });
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', buildArticleMobileTables, { once: true });
    else buildArticleMobileTables();
  </script>
</BaseLayout>
