---
import { formatPublicLabel } from '../utils/displayLabels';
import { cleanPublicText } from '../utils/publicText';
import { valueStatePresentation, type PublicValueState } from '../utils/valueState';

const { event } = Astro.props as { event: Record<string, any> };
const sections = [
  { key: 'depeg_detail', label: 'Price and peg' },
  { key: 'regulatory_detail', label: 'Regulatory action' },
  { key: 'reserve_change_detail', label: 'Reserve change' },
  { key: 'redemption_change_detail', label: 'Redemption change' },
  { key: 'migration_detail', label: 'Migration' },
  { key: 'issuer_control_detail', label: 'Issuer control' },
  { key: 'security_incident_detail', label: 'Security incident' },
  { key: 'oracle_failure_detail', label: 'Oracle failure' },
  { key: 'collateral_impairment_detail', label: 'Collateral impairment' },
  { key: 'insolvency_detail', label: 'Insolvency' },
  { key: 'governance_change_detail', label: 'Governance change' },
  { key: 'bridge_or_chain_incident_detail', label: 'Bridge or chain incident' },
  { key: 'termination_detail', label: 'Termination' },
  { key: 'launch_detail', label: 'Launch' }
].map((section) => ({ ...section, value: event[section.key] })).filter((section) => section.value && typeof section.value === 'object');

const fieldLabels: Record<string, string> = {
  peg_reference: 'Peg reference', direction: 'Direction', extreme_price: 'Extreme price', maximum_deviation_bps: 'Maximum deviation', duration_minutes: 'Duration', recovery_status: 'Recovery status', recovery_date: 'Recovery date', cause_summary: 'Cause summary', price_source_ids: 'Price-source records', jurisdiction: 'Jurisdiction', authority: 'Authority', action_type: 'Action type', case_reference: 'Case reference', effective_date: 'Effective date', resolution_date: 'Resolution date', summary: 'Summary', status: 'Status', event_subtype: 'Control action', related_category: 'Related category', deployment_id: 'Deployment record', network: 'Network', token_standard: 'Token standard', affected_addresses: 'Affected addresses', blacklist_transaction_hash: 'Blacklist transaction', related_transaction_hashes: 'Related transactions', reported_frozen_amount: 'Reported restricted amount', related_flow: 'Related flow', trigger: 'Trigger', legal_basis: 'Legal basis', requesting_authority: 'Requesting authority', source_incident: 'Source incident', status_effect: 'Status effect', market_status_effect: 'Market-status effect', reserve_effect: 'Reserve effect', redemption_effect: 'Redemption effect', depeg_effect: 'Depeg effect', verification_status: 'Verification status', loss_or_exposure_text: 'Loss or exposure', affected_deployment_ids: 'Affected deployments', related_organization_ids: 'Related organizations'
};
function labelFor(key: string) { return fieldLabels[key] ?? formatPublicLabel(key); }
type PresentedValue = { text: string; state: PublicValueState; label: string };
function knownValue(text: string): PresentedValue { return { text, state: 'known', label: 'Known' }; }
function valueFor(key: string, value: unknown): PresentedValue {
  const policy = key === 'verification_status' ? 'verification' : 'default';
  const structurallyMissing = value === null || value === undefined || (typeof value === 'string' && value.trim().length === 0) || (Array.isArray(value) && value.length === 0);
  if (structurallyMissing) return valueStatePresentation(value, { policy });
  if (key.endsWith('_summary') || key === 'summary') return valueStatePresentation(value, { policy, detect_markers: false, display_value: cleanPublicText(String(value)) });
  if (typeof value === 'boolean') return knownValue(value ? 'Yes' : 'No');
  if (Array.isArray(value)) return valueStatePresentation(value, { policy, display_value: value.map((item) => String(item)).join(', ') });
  if (value && typeof value === 'object') {
    const record = value as Record<string, unknown>;
    if (typeof record.display_text === 'string' && record.display_text.length > 0) return valueStatePresentation(record.display_text, { policy, display_value: cleanPublicText(record.display_text) });
    const valueText = record.value !== null && record.value !== undefined ? String(record.value) : '';
    const symbol = typeof record.symbol === 'string' ? record.symbol : '';
    if (valueText) return knownValue(`${valueText}${symbol ? ` ${symbol}` : ''}`);
    const nested = Object.entries(record).filter(([, item]) => item !== null && item !== undefined && item !== '').map(([nestedKey, item]) => `${labelFor(nestedKey)}: ${Array.isArray(item) ? item.join(', ') : String(item)}`).join(' · ');
    return valueStatePresentation(nested, { policy, display_value: nested });
  }
  let displayValue = String(value);
  if (key.endsWith('_bps')) displayValue = `${displayValue} bps`;
  else if (key.endsWith('_minutes')) displayValue = `${displayValue} minutes`;
  else if (!isTechnicalKey(key)) displayValue = formatPublicLabel(displayValue, displayValue);
  return valueStatePresentation(value, { policy, display_value: displayValue });
}
function isTechnicalKey(key: string) {
  return /(?:^|_)(?:id|ids|hash|hashes|address|addresses|reference)$/.test(key)
    || key === 'deployment_id'
    || key === 'case_reference';
}
const groups = sections.map((section) => ({
  label: section.label,
  fields: Object.entries(section.value as Record<string, unknown>).map(([key, value]) => ({
    label: labelFor(key),
    presentation: valueFor(key, value),
    technical: isTechnicalKey(key)
  }))
}));
---
{groups.length > 0 && (
  <div class="event-structured-detail">
    {groups.map((group) => (
      <section class="structured-fact-group" aria-label={group.label}>
        <h3>{group.label}</h3>
        <dl>
          {group.fields.map((field) => (
            <div>
              <dt>{field.label}</dt>
              <dd>
                {field.technical
                  ? <code data-technical-value>{field.presentation.text}</code>
                  : <span class={`value-state value-state--${field.presentation.state}`} data-value-state={field.presentation.state} title={field.presentation.label}>{field.presentation.text}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
)}
