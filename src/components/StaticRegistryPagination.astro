---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Item {
  title: string;
  href: string;
  meta?: string;
  description?: string;
}

interface Props {
  sectionLabel: string;
  title: string;
  description: string;
  basePath: string;
  page: number;
  totalPages: number;
  totalRecords: number;
  items: Item[];
}

const {
  sectionLabel,
  title,
  description,
  basePath,
  page,
  totalPages,
  totalRecords,
  items
} = Astro.props;

const pageHref = (target: number) => target === 1 ? basePath : `${basePath}page/${target}/`;
const canonicalPath = pageHref(page);
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
const rangeStart = (page - 1) * 20 + 1;
const rangeEnd = Math.min(page * 20, totalRecords);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: `https://sog.badjoke-lab.com${canonicalPath}`,
  description,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Stable or Gone',
    url: 'https://sog.badjoke-lab.com/'
  }
};
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <article class="static-registry-page" data-ui-v3-static-pagination>
    <header class="static-registry-header">
      <div class="static-registry-headerline">
        <p class="static-registry-eyebrow">{sectionLabel}</p>
        <p class="static-registry-range">Records {rangeStart}–{rangeEnd} of {totalRecords}</p>
      </div>
      <h1>{title}</h1>
      <p class="static-registry-description">{description}</p>
      <p class="static-registry-note">Bounded page {page} of {totalPages}. Every record remains available through an ordinary HTML link.</p>
    </header>

    <ol class="static-registry-list" start={rangeStart}>
      {items.map((item, index) => (
        <li>
          <span class="static-registry-number" aria-hidden="true">{String(rangeStart + index).padStart(2, '0')}</span>
          <div class="static-registry-item-copy">
            <a href={item.href}>{item.title}</a>
            {item.meta && <p class="static-registry-meta">{item.meta}</p>}
            {item.description && <p class="static-registry-item-description">{item.description}</p>}
          </div>
        </li>
      ))}
    </ol>

    <footer class="static-registry-footer">
      <nav class="static-registry-pagination" aria-label={`${sectionLabel} pages`}>
        {page > 1 && <a class="static-registry-direction" rel="prev" href={pageHref(page - 1)}>Previous</a>}
        {pageNumbers.map((number) => (
          <a href={pageHref(number)} aria-current={number === page ? 'page' : undefined}>{number}</a>
        ))}
        {page < totalPages && <a class="static-registry-direction" rel="next" href={pageHref(page + 1)}>Next</a>}
      </nav>
      <p class="static-registry-return"><a href={basePath}>Open the interactive {sectionLabel.toLocaleLowerCase()}</a></p>
    </footer>
  </article>
</BaseLayout>

<style>
  .static-registry-page {
    width: 100%;
    margin: 0 auto;
    padding: 1.25rem 0 3.5rem;
    color: var(--v3-text);
    font-family: var(--v3-sans);
  }

  .static-registry-header {
    padding: 1rem 0 1.5rem;
    border-top: 1px solid var(--v3-text);
    border-bottom: 1px solid var(--v3-rule-strong);
  }

  .static-registry-headerline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .static-registry-eyebrow,
  .static-registry-range {
    margin: 0;
    color: var(--v3-text-quiet);
    font-family: var(--v3-sans);
    font-size: .75rem;
    font-weight: 750;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .static-registry-header h1 {
    max-width: 24ch;
    margin: 0;
    color: var(--v3-text);
    font-family: var(--v3-sans);
    font-size: clamp(2.35rem, 4.2vw, 3.75rem);
    font-weight: 760;
    line-height: 1.06;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  .static-registry-description {
    max-width: 760px;
    margin: 1.15rem 0 0;
    color: var(--v3-text-muted);
    font-family: var(--v3-sans);
    font-size: 1rem;
    line-height: 1.62;
  }

  .static-registry-note {
    max-width: 760px;
    margin: .55rem 0 0;
    color: var(--v3-text-quiet);
    font-family: var(--v3-sans);
    font-size: .875rem;
    line-height: 1.55;
  }

  .static-registry-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--v3-rule-strong);
    border-left: 1px solid var(--v3-rule-strong);
  }

  .static-registry-list li {
    min-width: 0;
    min-height: 112px;
    padding: 1rem;
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: .8rem;
    align-content: start;
    border-right: 1px solid var(--v3-rule-strong);
    border-bottom: 1px solid var(--v3-rule-strong);
    background: transparent;
  }

  .static-registry-number {
    color: var(--v3-text-quiet);
    font-family: var(--v3-sans);
    font-size: .75rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
  }

  .static-registry-item-copy {
    min-width: 0;
  }

  .static-registry-list a {
    color: var(--v3-text);
    font-family: var(--v3-sans);
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.3;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .static-registry-list a:hover,
  .static-registry-list a:focus-visible {
    color: var(--v3-text);
    text-decoration-color: var(--v3-accent);
  }

  .static-registry-meta,
  .static-registry-item-description {
    margin: .45rem 0 0;
    color: var(--v3-text-quiet);
    font-family: var(--v3-sans);
    font-size: .875rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .static-registry-item-description {
    color: var(--v3-text-muted);
  }

  .static-registry-footer {
    margin-top: 1.5rem;
    padding-top: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1.25rem;
    align-items: center;
    border-top: 1px solid var(--v3-rule-strong);
  }

  .static-registry-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .4rem;
  }

  .static-registry-pagination a {
    min-width: 44px;
    min-height: 44px;
    padding: .5rem .7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--v3-rule-strong);
    color: var(--v3-text-muted);
    background: transparent;
    font-family: var(--v3-sans);
    font-size: .875rem;
    font-weight: 750;
    text-decoration: none;
  }

  .static-registry-pagination a:hover,
  .static-registry-pagination a:focus-visible {
    border-color: var(--v3-accent);
    color: var(--v3-text);
  }

  .static-registry-pagination a[aria-current="page"] {
    border-color: var(--v3-accent);
    background: var(--v3-accent);
    color: var(--v3-bg);
  }

  .static-registry-direction {
    padding-inline: .9rem !important;
  }

  .static-registry-return {
    margin: 0;
    font-family: var(--v3-sans);
    font-size: .875rem;
    text-align: right;
  }

  .static-registry-return a {
    color: var(--v3-text-muted);
  }

  @media (max-width: 720px) {
    .static-registry-page {
      padding-top: .5rem;
    }

    .static-registry-headerline,
    .static-registry-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .static-registry-header h1 {
      max-width: none;
      font-size: clamp(2rem, 8vw, 2.4rem);
      line-height: 1.1;
      letter-spacing: -.025em;
      text-wrap: pretty;
    }

    .static-registry-list {
      grid-template-columns: 1fr;
    }

    .static-registry-list li {
      min-height: 0;
      padding: 1rem .75rem;
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .static-registry-return {
      text-align: left;
    }
  }
</style>
