---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventEditorialHeader from './EventEditorialHeader.astro';
import EventEditorialBody from './EventEditorialBody.astro';
import { buildEventDetailView } from '../lib/views/eventDetailView';
const { event } = Astro.props;
const view = buildEventDetailView(event);

function compactMetaDescription(value: string, maxLength = 155) {
  const normalized = value.replace(/\s+/g, ' ').trim();
  if (normalized.length <= maxLength) return normalized;

  const clipped = normalized.slice(0, maxLength - 1);
  const sentenceBreak = clipped.lastIndexOf('. ');
  if (sentenceBreak >= 100) return clipped.slice(0, sentenceBreak + 1);

  const wordBreak = clipped.lastIndexOf(' ');
  const safeEnd = wordBreak >= 110 ? wordBreak : clipped.length;
  return `${clipped.slice(0, safeEnd).replace(/[,:;.!?\s]+$/, '')}…`;
}

const seoOverrides: Record<string, { title?: string; description?: string }> = {
  sog_ev_usdn_xtn_transition: {
    title: 'USDN to XTN: Neutrino Begins Waves Asset Rename | SOG',
    description: "Neutrino began the USDN-to-XTN rename on Waves on January 31, 2023, ending USDN's original hard-USD stablecoin classification during a staged rollout."
  },
  sog_ev_fei_2022_09_final_redemption: {
    title: 'FEI Final Redemption: Tribe DAO Vote Concludes | SOG'
  },
  sog_ev_fxusd_v2_upgrade_2025: {
    title: 'fxUSD Upgrades to f(x) Protocol V2 | SOG'
  },
  sog_ev_musd_2026_01_legacy_transition: {
    title: 'mUSD Legacy Status During the mStable Relaunch | SOG'
  }
};
const seo = seoOverrides[event.id];
const title = seo?.title ?? `${view.eventTitle} — SOG Event`;
const description = seo?.description ?? compactMetaDescription(view.eventDescription);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: view.eventTitle,
  url: `https://www.stableorgone.com/event/${event.id}/`,
  description,
  datePublished: event.event_date,
  image: 'https://www.stableorgone.com/og/sog-og.svg'
};
---
<BaseLayout title={title} description={description} canonicalPath={`/event/${event.id}/`} jsonLd={jsonLd}>
  <article class="event-detail-page" data-ui-v3-event-detail>
    <EventEditorialHeader event={event} view={view} />
    <nav class="event-detail-nav" aria-label="Event record sections"><a href="#subjects">Affected records</a><a href="#sources">Evidence</a><a href="#record-details">Record details</a><a href="#corrections">Corrections</a></nav>
    <EventEditorialBody event={event} view={view} />
  </article>
</BaseLayout>
