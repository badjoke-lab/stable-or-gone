<script>
  const lifecycleTone = (value: string) => {
    const normalized = value.trim().toLowerCase();
    if (/\b(active|operational|available|open|recovered)\b/.test(normalized)) return 'active';
    if (/\b(limited|restricted|review|watch|partial)\b/.test(normalized)) return 'limited';
    if (/\b(impaired|depeg|stressed|suspended)\b/.test(normalized)) return 'impaired';
    if (/\b(failed|failure|collapsed)\b/.test(normalized)) return 'failed';
    if (/\b(migrated|migration)\b/.test(normalized)) return 'migrated';
    if (/\b(discontinued|inactive|closed|wind[- ]?down|terminated)\b/.test(normalized)) return 'discontinued';
    if (/\b(unknown|not recorded|unverified|unclear)\b/.test(normalized)) return 'unknown';
    return null;
  };

  const applyObservatorySemantics = () => {
    document.querySelectorAll<HTMLElement>('main small, footer small, header small').forEach((element) => {
      if (element.matches('[data-ui-mono]') || element.closest('[data-ui-mono]')) return;
      element.style.fontFamily = 'var(--ui-sans)';
    });

    document.querySelectorAll<HTMLElement>([
      'main time',
      '.timeline-item__date',
      '.update-feed-item__date',
      '.home-material-list__date',
      '.home-event-list__date',
      '.update-feed-date',
      '.event-index-card-r5-meta time',
      '.event-index-row-r5 time'
    ].join(', ')).forEach((element) => {
      element.dataset.tone = 'temporal';
      element.dataset.uiMono = 'true';
    });

    document.querySelectorAll<HTMLElement>([
      '.value-state',
      '.chip',
      '[class*="badge"]',
      '[class*="status-chip"]',
      '[class*="status-badge"]',
      '.home-status-label',
      '.update-feed-category',
      '.ar-chip',
      '.ar-lifecycle',
      '.archive-note',
      '.directory-number',
      '.ticker-badge'
    ].join(', ')).forEach((element) => {
      const tone = lifecycleTone(element.textContent || '');
      if (tone && (!element.dataset.tone || element.dataset.tone === 'neutral')) element.dataset.tone = tone;
    });

    document.querySelectorAll<HTMLElement>([
      '.contract-address',
      '.transaction-hash',
      '[data-long-value]',
      '[data-technical-value]',
      '.directory-number',
      '.ticker-badge'
    ].join(', ')).forEach((element) => {
      element.dataset.uiMono = 'true';
    });

    document.querySelectorAll<HTMLElement>('.support-cta, .footer-support, .context-support-callout').forEach((element) => {
      if (element.dataset.tone === 'neutral') delete element.dataset.tone;
      element.style.removeProperty('background');
      element.style.removeProperty('color');
      element.style.removeProperty('border-color');
    });
  };

  applyObservatorySemantics();
  const observer = new MutationObserver(applyObservatorySemantics);
  observer.observe(document.body, { childList: true, subtree: true });
</script>