---
import TickerBadge from './TickerBadge.astro';
import { formatLifecycleLabel, lifecycleChipClass } from '../utils/publicTaxonomy';
const { record, initiallyVisible = true } = Astro.props;
const data = {
  'data-record-slug': record.slug,
  'data-search': record.search,
  'data-name': record.name.toLocaleLowerCase(),
  'data-lifecycle': record.lifecycle,
  'data-issuance': record.issuance,
  'data-asset-class': record.assetClass,
  'data-reference': record.referenceCategory,
  'data-backing': record.backingCategory,
  'data-stabilization': record.stabilization,
  'data-launch-date': record.launchDate,
  'data-evidence-count': String(record.sourceIdentityCount)
};
---
<tr data-registry-row hidden={initiallyVisible ? undefined : true} {...data}>
  <td>
    <div class="stablecoin-record-identity stablecoin-record-identity-r3">
      <label class="comparison-choice comparison-choice-icon"><input type="checkbox" data-compare-select value={record.slug} aria-label={`Compare ${record.name}`} /><span class="visually-hidden">Compare</span></label>
      <TickerBadge symbol={record.symbol || record.name} label={`${record.name} ticker badge`} size="small" />
      <div><a class="record-name" href={`/stablecoin/${record.slug}/`}>{record.name}</a><small>{record.symbol || 'No symbol'}</small></div>
    </div>
  </td>
  <td><span class={lifecycleChipClass(record.lifecycle)}>{formatLifecycleLabel(record.lifecycle)}</span></td>
  <td>{record.referenceLabel}</td>
  <td>{record.primaryOrganizationSlug ? <a href={`/issuer/${record.primaryOrganizationSlug}/`}>{record.primaryOrganizationName}</a> : record.primaryOrganizationName}</td>
  <td>{record.backingLabel}</td>
  <td><time datetime={record.reviewedAt || undefined}>{record.reviewedAt || 'Not recorded'}</time><small>{record.sourceIdentityCount} sources</small></td>
</tr>
