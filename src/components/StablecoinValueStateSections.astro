---
import ValueStateText from './ValueStateText.astro';
import { formatPublicLabel } from '../utils/displayLabels';
import { cleanPublicText } from '../utils/publicText';

type CoinRecord = {
  reserve_disclosure_status?: string | null;
  redemption_status?: string | null;
  who_can_redeem?: string | null;
  retail_redemption?: string | null;
  institutional_redemption?: string | null;
  minimum_redemption?: string | null;
  redemption_region_notes?: string | null;
};
type ReserveProfile = { disclosure_status?: string | null; backing_types?: string[] | null; summary?: string | null; as_of_date?: string | null; confidence?: string | null; } | null | undefined;
type RedemptionProfile = { status?: string | null; settlement_asset?: string | null; eligible_parties?: string | null; retail_access?: string | null; institutional_access?: string | null; minimum_amount_text?: string | null; fee_text?: string | null; settlement_time_text?: string | null; jurisdiction_restrictions?: string[] | null; } | null | undefined;
type BackingModel = { canonical_backing_types: string[]; };
type ReserveReport = { report_date?: string | null; url?: string | null; publisher?: string | null; report_type?: string | null; asset_categories?: string[] | null; confidence?: string | null; };
type RegulatoryNote = { note_date?: string | null; source_url: string; title: string; authority_or_source?: string | null; note_type?: string | null; summary?: string | null; };
type OpenQuestion = { topic?: string | null; description?: string | null; severity?: string | null; last_checked_at?: string | null; };
type SectionMode = 'all' | 'reserves' | 'legal' | 'unknowns';

const { coin, reserveProfile, redemptionProfile, model, reserveReports, regulatoryNotes, openQuestions, mode = 'all' } = Astro.props as { coin: CoinRecord; reserveProfile: ReserveProfile; redemptionProfile: RedemptionProfile; model: BackingModel; reserveReports: ReserveReport[]; regulatoryNotes: RegulatoryNote[]; openQuestions: OpenQuestion[]; mode?: SectionMode; };
const disclosureStatus = reserveProfile?.disclosure_status ?? coin.reserve_disclosure_status;
const backingTypes: string[] = reserveProfile?.backing_types?.length ? reserveProfile.backing_types : model.canonical_backing_types;
const reserveSummary = reserveProfile?.summary;
const redemptionStatus = redemptionProfile?.status ?? coin.redemption_status;
const settlementAsset = redemptionProfile?.settlement_asset;
const eligibleParties = redemptionProfile?.eligible_parties ?? coin.who_can_redeem;
const retailAccess = redemptionProfile?.retail_access ?? coin.retail_redemption;
const institutionalAccess = redemptionProfile?.institutional_access ?? coin.institutional_redemption;
const minimumAmount = redemptionProfile?.minimum_amount_text ?? coin.minimum_redemption;
const regionalRestrictions: string[] | null = redemptionProfile?.jurisdiction_restrictions?.length ? redemptionProfile.jurisdiction_restrictions : null;
const showReserves = mode === 'all' || mode === 'reserves';
const showLegal = mode === 'all' || mode === 'legal';
const showUnknowns = mode === 'all' || mode === 'unknowns';
---
{showReserves && <section class="ui-panel registry stablecoin-reserve-profile">
  <div class="bar">Reserve profile</div>
  <table class="organization-detail-table" data-table-kind="stablecoin-reserve-profile" data-mobile-table="scroll-preserve"><tbody>
    <tr><th>Disclosure status</th><td><ValueStateText value={disclosureStatus} displayValue={formatPublicLabel(disclosureStatus)} policy="public_disclosure" /></td></tr>
    <tr><th>Backing types</th><td>{backingTypes.length ? backingTypes.map((item, index) => <>{index > 0 ? ', ' : ''}<ValueStateText value={item} displayValue={formatPublicLabel(item)} /></>) : <ValueStateText value={null} />}</td></tr>
    <tr><th>Summary</th><td><ValueStateText value={reserveSummary} displayValue={reserveSummary ? cleanPublicText(reserveSummary) : null} detectMarkers={false} /></td></tr>
    <tr><th>As of</th><td><ValueStateText value={reserveProfile?.as_of_date} /></td></tr>
    <tr><th>Profile confidence</th><td><ValueStateText value={reserveProfile?.confidence} displayValue={formatPublicLabel(reserveProfile?.confidence)} /></td></tr>
  </tbody></table>
  <dl class="mobile-definition-list" data-mobile-representation-for="stablecoin-reserve-profile">
    <div><dt>Disclosure status</dt><dd><ValueStateText value={disclosureStatus} displayValue={formatPublicLabel(disclosureStatus)} policy="public_disclosure" /></dd></div>
    <div><dt>Backing types</dt><dd>{backingTypes.length ? backingTypes.map((item, index) => <>{index > 0 ? ', ' : ''}<ValueStateText value={item} displayValue={formatPublicLabel(item)} /></>) : <ValueStateText value={null} />}</dd></div>
    <div><dt>Summary</dt><dd><ValueStateText value={reserveSummary} displayValue={reserveSummary ? cleanPublicText(reserveSummary) : null} detectMarkers={false} /></dd></div>
    <div><dt>As of</dt><dd><ValueStateText value={reserveProfile?.as_of_date} /></dd></div>
    <div><dt>Profile confidence</dt><dd><ValueStateText value={reserveProfile?.confidence} displayValue={formatPublicLabel(reserveProfile?.confidence)} /></dd></div>
  </dl>
</section>}

{showReserves && <section class="ui-panel registry stablecoin-redemption-profile">
  <div class="bar">Redemption profile</div>
  <table class="organization-detail-table" data-table-kind="stablecoin-redemption-profile" data-mobile-table="scroll-preserve"><tbody>
    <tr><th>Current status</th><td><ValueStateText value={redemptionStatus} displayValue={formatPublicLabel(redemptionStatus)} /></td></tr>
    <tr><th>Settlement asset</th><td><ValueStateText value={settlementAsset} displayValue={formatPublicLabel(settlementAsset)} /></td></tr>
    <tr><th>Eligible parties</th><td><ValueStateText value={eligibleParties} displayValue={eligibleParties ? cleanPublicText(eligibleParties) : null} detectMarkers={false} /></td></tr>
    <tr><th>Retail access</th><td><ValueStateText value={retailAccess} displayValue={formatPublicLabel(retailAccess)} /></td></tr>
    <tr><th>Institutional access</th><td><ValueStateText value={institutionalAccess} displayValue={formatPublicLabel(institutionalAccess)} /></td></tr>
    <tr><th>Minimum amount</th><td><ValueStateText value={minimumAmount} displayValue={formatPublicLabel(minimumAmount)} /></td></tr>
    <tr><th>Fee</th><td><ValueStateText value={redemptionProfile?.fee_text} displayValue={formatPublicLabel(redemptionProfile?.fee_text)} /></td></tr>
    <tr><th>Settlement time</th><td><ValueStateText value={redemptionProfile?.settlement_time_text} displayValue={formatPublicLabel(redemptionProfile?.settlement_time_text)} /></td></tr>
    <tr><th>Regional limits</th><td>{regionalRestrictions ? regionalRestrictions.map((item, index) => <>{index > 0 ? ', ' : ''}<ValueStateText value={item} displayValue={formatPublicLabel(item)} /></>) : <ValueStateText value={coin.redemption_region_notes} displayValue={coin.redemption_region_notes ? cleanPublicText(coin.redemption_region_notes) : null} detectMarkers={false} />}</td></tr>
  </tbody></table>
  <dl class="mobile-definition-list" data-mobile-representation-for="stablecoin-redemption-profile">
    <div><dt>Current status</dt><dd><ValueStateText value={redemptionStatus} displayValue={formatPublicLabel(redemptionStatus)} /></dd></div>
    <div><dt>Settlement asset</dt><dd><ValueStateText value={settlementAsset} displayValue={formatPublicLabel(settlementAsset)} /></dd></div>
    <div><dt>Eligible parties</dt><dd><ValueStateText value={eligibleParties} displayValue={eligibleParties ? cleanPublicText(eligibleParties) : null} detectMarkers={false} /></dd></div>
    <div><dt>Retail access</dt><dd><ValueStateText value={retailAccess} displayValue={formatPublicLabel(retailAccess)} /></dd></div>
    <div><dt>Institutional access</dt><dd><ValueStateText value={institutionalAccess} displayValue={formatPublicLabel(institutionalAccess)} /></dd></div>
    <div><dt>Minimum amount</dt><dd><ValueStateText value={minimumAmount} displayValue={formatPublicLabel(minimumAmount)} /></dd></div>
    <div><dt>Fee</dt><dd><ValueStateText value={redemptionProfile?.fee_text} displayValue={formatPublicLabel(redemptionProfile?.fee_text)} /></dd></div>
    <div><dt>Settlement time</dt><dd><ValueStateText value={redemptionProfile?.settlement_time_text} displayValue={formatPublicLabel(redemptionProfile?.settlement_time_text)} /></dd></div>
    <div><dt>Regional limits</dt><dd>{regionalRestrictions ? regionalRestrictions.map((item) => formatPublicLabel(item)).join(', ') : cleanPublicText(coin.redemption_region_notes, 'Not recorded')}</dd></div>
  </dl>
</section>}

{showReserves && <section class="ui-panel registry stablecoin-reserve-history">
  <div class="bar">Reserve and attestation history</div>
  <table class="organization-detail-table" data-table-kind="stablecoin-reserve-history" data-mobile-table="scroll-preserve"><thead><tr><th>Date</th><th>Publisher</th><th>Type</th><th>Assets covered</th><th>Record confidence</th></tr></thead><tbody>{reserveReports.length === 0 ? <tr><td colspan="5">No reserve reports have been added yet.</td></tr> : reserveReports.map((report) => <tr><td><ValueStateText value={report.report_date} /></td><td>{report.url ? <a href={report.url}><ValueStateText value={report.publisher} displayValue={formatPublicLabel(report.publisher, 'Source')} /></a> : <ValueStateText value={report.publisher} displayValue={formatPublicLabel(report.publisher, 'Source not recorded')} />}</td><td><ValueStateText value={report.report_type} displayValue={formatPublicLabel(report.report_type)} /></td><td>{report.asset_categories?.length ? report.asset_categories.map((item, index) => <>{index > 0 ? ', ' : ''}<ValueStateText value={item} displayValue={formatPublicLabel(item)} /></>) : <ValueStateText value={null} />}</td><td><ValueStateText value={report.confidence} displayValue={formatPublicLabel(report.confidence)} /></td></tr>)}</tbody></table>
  <div class="mobile-record-list" data-mobile-representation-for="stablecoin-reserve-history">{reserveReports.length === 0 ? <p class="mobile-empty-record">No reserve reports have been added yet.</p> : reserveReports.map((report) => <article><header><h3>{report.url ? <a href={report.url}>{formatPublicLabel(report.publisher, 'Source')}</a> : formatPublicLabel(report.publisher, 'Source not recorded')}</h3><ValueStateText value={report.report_date} /></header><dl><div><dt>Type</dt><dd><ValueStateText value={report.report_type} displayValue={formatPublicLabel(report.report_type)} /></dd></div><div><dt>Assets covered</dt><dd>{report.asset_categories?.length ? report.asset_categories.map((item) => formatPublicLabel(item)).join(', ') : 'Not recorded'}</dd></div><div><dt>Record confidence</dt><dd><ValueStateText value={report.confidence} displayValue={formatPublicLabel(report.confidence)} /></dd></div></dl></article>)}</div>
</section>}

{showLegal && <section class="ui-panel registry stablecoin-regulatory-notices" id="legal-context">
  <div class="bar">Regulatory and official notices</div>
  <table class="organization-detail-table" data-table-kind="stablecoin-regulatory-notices" data-mobile-table="scroll-preserve"><thead><tr><th>Date</th><th>Title</th><th>Authority / publisher</th><th>Type</th><th>Summary</th></tr></thead><tbody>{regulatoryNotes.length === 0 ? <tr><td colspan="5">No regulatory notes have been added yet.</td></tr> : regulatoryNotes.map((note) => <tr><td><ValueStateText value={note.note_date} /></td><td><a href={note.source_url}>{note.title}</a></td><td><ValueStateText value={note.authority_or_source} /></td><td><ValueStateText value={note.note_type} displayValue={formatPublicLabel(note.note_type)} /></td><td><ValueStateText value={note.summary} displayValue={note.summary ? cleanPublicText(note.summary) : null} detectMarkers={false} /></td></tr>)}</tbody></table>
  <div class="mobile-record-list" data-mobile-representation-for="stablecoin-regulatory-notices">{regulatoryNotes.length === 0 ? <p class="mobile-empty-record">No regulatory notes have been added yet.</p> : regulatoryNotes.map((note) => <article><header><h3><a href={note.source_url}>{note.title}</a></h3><ValueStateText value={note.note_date} /></header><p>{cleanPublicText(note.summary, 'No summary recorded.')}</p><dl><div><dt>Authority / publisher</dt><dd><ValueStateText value={note.authority_or_source} /></dd></div><div><dt>Type</dt><dd><ValueStateText value={note.note_type} displayValue={formatPublicLabel(note.note_type)} /></dd></div></dl></article>)}</div>
</section>}

{showUnknowns && <section class="ui-panel registry stablecoin-open-questions" id="known-unknowns">
  <div class="bar">Open questions</div>
  <table class="organization-detail-table" data-table-kind="stablecoin-open-questions" data-mobile-table="scroll-preserve"><thead><tr><th>Topic</th><th>What remains unclear</th><th>Value state</th><th>Priority</th><th>Last checked</th></tr></thead><tbody>{openQuestions.length === 0 ? <tr><td colspan="5">No open questions are currently listed.</td></tr> : openQuestions.map((item) => <tr><td>{formatPublicLabel(item.topic)}</td><td>{cleanPublicText(item.description)}</td><td><ValueStateText value="unknown" /></td><td><ValueStateText value={item.severity} displayValue={formatPublicLabel(item.severity)} /></td><td><ValueStateText value={item.last_checked_at} /></td></tr>)}</tbody></table>
  <div class="mobile-record-list" data-mobile-representation-for="stablecoin-open-questions">{openQuestions.length === 0 ? <p class="mobile-empty-record">No open questions are currently listed.</p> : openQuestions.map((item) => <article><h3>{formatPublicLabel(item.topic)}</h3><p>{cleanPublicText(item.description)}</p><dl><div><dt>Value state</dt><dd><ValueStateText value="unknown" /></dd></div><div><dt>Priority</dt><dd><ValueStateText value={item.severity} displayValue={formatPublicLabel(item.severity)} /></dd></div><div><dt>Last checked</dt><dd><ValueStateText value={item.last_checked_at} /></dd></div></dl></article>)}</div>
</section>}
