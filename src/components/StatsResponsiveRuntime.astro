<script>
  const installStatsResponsiveSections = () => {
    const page = document.querySelector<HTMLElement>('.stats-page');
    if (!page || page.dataset.responsiveSectionsInstalled === 'true') return;
    page.dataset.responsiveSectionsInstalled = 'true';

    const panelGrid = page.querySelector<HTMLElement>('.stats-v4-panel-grid');
    if (!panelGrid) return;

    const panels = Array.from(panelGrid.children)
      .filter((item): item is HTMLElement => item instanceof HTMLElement && item.classList.contains('stats-v4-panel'));
    if (panels.length < 2) return;

    const desktop = window.matchMedia('(min-width: 981px)');
    const tablet = window.matchMedia('(min-width: 701px) and (max-width: 980px)');
    let activeColumnCount = 0;

    const restoreSourceOrder = () => {
      panelGrid.replaceChildren(...panels);
    };

    const buildColumns = (columnCount: number) => {
      restoreSourceOrder();
      if (columnCount === 1) return;

      const columns = Array.from({ length: columnCount }, (_, index) => {
        const column = document.createElement('div');
        column.className = 'stats-v4-bar-list';
        column.dataset.statsCompositionColumn = String(index + 1);
        return column;
      });

      const minimumSize = Math.floor(panels.length / columnCount);
      const largerColumns = panels.length % columnCount;
      let cursor = 0;

      columns.forEach((column, index) => {
        const size = minimumSize + (index < largerColumns ? 1 : 0);
        for (let offset = 0; offset < size; offset += 1) {
          const panel = panels[cursor++];
          const slot = document.createElement('div');
          slot.dataset.statsCompositionSlot = 'true';
          slot.append(panel);
          column.append(slot);
        }
      });

      panelGrid.replaceChildren(...columns);
    };

    const sync = () => {
      const nextColumnCount = desktop.matches ? 3 : tablet.matches ? 2 : 1;
      if (nextColumnCount === activeColumnCount) return;
      activeColumnCount = nextColumnCount;
      buildColumns(nextColumnCount);
    };

    sync();
    desktop.addEventListener?.('change', sync);
    tablet.addEventListener?.('change', sync);
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', installStatsResponsiveSections, { once: true });
  else installStatsResponsiveSections();
</script>
