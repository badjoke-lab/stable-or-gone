---
const { record, initiallyVisible = true } = Astro.props;
const data = {
  'data-record-id': record.id,
  'data-search': record.search,
  'data-title': record.title.toLocaleLowerCase(),
  'data-category': record.category,
  'data-subtype': record.subtype,
  'data-status-effect': record.statusEffect,
  'data-recovery': record.recovery,
  'data-year': record.year,
  'data-event-date': record.eventDate,
  'data-evidence-count': String(record.sourceIdentityCount)
};
---
<article class="event-index-card" data-event-card data-mobile-representation-for="event-index" hidden={initiallyVisible ? undefined : true} {...data}>
  <header><time datetime={record.eventDate || undefined}>{record.eventDate || 'Date not recorded'}</time><h2><a href={`/event/${record.id}/`}>{record.title}</a></h2><span class="event-impact-label">{record.impactLabel}</span></header>
  <dl class="mobile-card-primary">
    <div><dt>Category</dt><dd>{record.categoryLabel}</dd></div>
    <div><dt>Subjects</dt><dd>{record.subjectNames.join(', ') || 'Not recorded'}</dd></div>
    <div><dt>Lifecycle effect</dt><dd>{record.statusEffectLabel}</dd></div>
    <div><dt>Evidence</dt><dd>{record.sourceIdentityCount} sources</dd></div>
  </dl>
  <details class="mobile-card-details">
    <summary>More event details</summary>
    <dl>
      <div><dt>Subtype</dt><dd>{record.subtypeLabel}</dd></div>
      <div><dt>Recovery</dt><dd>{record.recoveryLabel}</dd></div>
      <div><dt>Record confidence</dt><dd>{record.confidenceLabel}</dd></div>
      <div><dt>Event ID</dt><dd><code>{record.id}</code></dd></div>
    </dl>
  </details>
</article>
