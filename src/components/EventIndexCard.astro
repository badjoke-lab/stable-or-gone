---
const { record, initiallyVisible = true } = Astro.props;
const data = {
  'data-record-id': record.id,
  'data-search': record.search,
  'data-title': record.title.toLocaleLowerCase(),
  'data-category': record.category,
  'data-subtype': record.subtype,
  'data-status-effect': record.statusEffect,
  'data-recovery': record.recovery,
  'data-year': record.year,
  'data-event-date': record.eventDate,
  'data-evidence-count': String(record.sourceIdentityCount)
};
---
<article class="event-index-card event-index-card-r5" data-event-card data-mobile-representation-for="event-index" hidden={initiallyVisible ? undefined : true} {...data}>
  <div class="event-index-card-r5-meta">
    <time datetime={record.eventDate || undefined}>{record.eventDate || 'Date not recorded'}</time>
    <span class="event-impact-label">{record.impactLabel}</span>
  </div>
  <h2><a href={`/event/${record.id}/`}>{record.title}</a></h2>
  <p class="event-index-card-r5-subject">{record.subjectNames.join(', ') || 'Subject not recorded'}</p>
  <p class="event-index-card-r5-effect"><strong>{record.statusEffectLabel}</strong><span>{record.recoveryLabel}</span></p>
  <details class="event-index-card-details">
    <summary>More event context</summary>
    <dl>
      <div><dt>Category</dt><dd>{record.categoryLabel}</dd></div>
      <div><dt>Subtype</dt><dd>{record.subtypeLabel}</dd></div>
      <div><dt>Evidence</dt><dd>{record.sourceIdentityCount} source{record.sourceIdentityCount === 1 ? '' : 's'}</dd></div>
    </dl>
  </details>
</article>
