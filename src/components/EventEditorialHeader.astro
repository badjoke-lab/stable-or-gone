---
import ValueStateText from './ValueStateText.astro';
const { event, view } = Astro.props;
---
<header class="event-detail-masthead">
  <div class="event-detail-overline"><span>Event record</span><div><a href="/events/">Return to register</a><a href="#sources">Open sources</a></div></div>
  <div class="event-detail-title"><div><p>Record <code>{event.id}</code></p><h1>{view.eventTitle}</h1></div><p>{view.eventDescription}</p></div>
  <dl class="event-detail-ledger" aria-label="Current reviewed event facts">
    <div><dt>Date</dt><dd><ValueStateText value={event.event_date} /></dd></div>
    <div><dt>Category</dt><dd>{view.taxonomy.public_category_label}</dd></div>
    <div><dt>Subtype</dt><dd>{view.taxonomy.canonical_subtype_label}</dd></div>
    <div><dt>Status effect</dt><dd>{view.taxonomy.status_effect_label}</dd></div>
    <div><dt>Recovery</dt><dd>{view.taxonomy.recovery_label}<small><ValueStateText value={view.recoveryDate} /></small></dd></div>
    <div><dt>Evidence</dt><dd><a href="#sources">{view.sourceIdentities.length} source record{view.sourceIdentities.length === 1 ? '' : 's'}</a><small>{view.eventRelations.length} relations</small></dd></div>
  </dl>
</header>
