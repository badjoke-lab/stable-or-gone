---
import ValueStateText from './ValueStateText.astro';
import { formatPublicLabel } from '../utils/displayLabels';
import { cleanPublicText } from '../utils/publicText';
import type { PublicValueState } from '../utils/valueState';

type SubjectRecord = {
  id: string;
  name: string;
  slug: string;
};

type EventRecord = Record<string, any> & {
  event_date?: string | null;
  impact_level?: string | null;
  failure_mechanism?: string | null;
  recovery_date?: string | null;
  depeg_detail?: { recovery_date?: string | null } | null;
  confidence?: string | null;
};

type EventTaxonomy = {
  public_category_label: string;
  canonical_subtype_label: string;
  detail_kind_label: string;
  status_effect_label: string;
  canonical_status_effect: string;
  recovery_category: string;
  recovery_label: string;
};

const {
  event,
  taxonomy,
  subjectStablecoins,
  subjectOrganizations,
  detailSummary,
  hasStructuredDetail
} = Astro.props as {
  event: EventRecord;
  taxonomy: EventTaxonomy;
  subjectStablecoins: SubjectRecord[];
  subjectOrganizations: SubjectRecord[];
  detailSummary?: string | null;
  hasStructuredDetail: boolean;
};

const recoveryDate = event.depeg_detail?.recovery_date ?? event.recovery_date;
const recoveryNullState: PublicValueState = taxonomy.recovery_category === 'not_applicable'
  ? 'not_applicable'
  : taxonomy.recovery_category === 'unknown'
    ? 'unknown_after_review'
    : 'not_recorded';
const causeOrMechanism = detailSummary ?? event.failure_mechanism;
---
<tr><th>Date</th><td><ValueStateText value={event.event_date} /></td></tr>
<tr><th>Public event category</th><td>{taxonomy.public_category_label}</td></tr>
<tr><th>Canonical event subtype</th><td>{taxonomy.canonical_subtype_label}</td></tr>
<tr><th>Structured detail kind</th><td>{taxonomy.detail_kind_label}</td></tr>
<tr><th>Stablecoin subjects</th><td>{subjectStablecoins.map((item, index) => <>{index > 0 ? ', ' : ''}{item.slug ? <a href={`/stablecoin/${item.slug}/`}>{item.name}</a> : item.name}</>)}</td></tr>
<tr><th>Organization subjects</th><td>{subjectOrganizations.map((item, index) => <>{index > 0 ? ', ' : ''}{item.slug ? <a href={`/issuer/${item.slug}/`}>{item.name}</a> : item.name}</>)}</td></tr>
<tr><th>Impact</th><td><ValueStateText value={event.impact_level} displayValue={formatPublicLabel(event.impact_level)} /></td></tr>
<tr><th>Effect on stablecoin lifecycle</th><td>{taxonomy.status_effect_label}</td></tr>
<tr><th>Canonical status-effect value</th><td><ValueStateText value={taxonomy.canonical_status_effect} displayValue={formatPublicLabel(taxonomy.canonical_status_effect)} /></td></tr>
<tr><th>Recovery or reversal</th><td>{taxonomy.recovery_label}</td></tr>
<tr><th>Recovery date</th><td><ValueStateText value={recoveryDate} nullState={recoveryNullState} /></td></tr>
<tr><th>Cause or mechanism</th><td><ValueStateText value={causeOrMechanism} displayValue={causeOrMechanism ? cleanPublicText(causeOrMechanism) : null} /></td></tr>
<tr><th>Structured detail coverage</th><td>{hasStructuredDetail ? 'Structured fields available below' : 'Description and source record only'}</td></tr>
<tr><th>Record confidence</th><td><ValueStateText value={event.confidence} displayValue={formatPublicLabel(event.confidence)} /></td></tr>
