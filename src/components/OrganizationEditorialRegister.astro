---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrganizationIndexRow from './OrganizationIndexRow.astro';
import OrganizationIndexCard from './OrganizationIndexCard.astro';
import '../styles/organization-index.css';
import '../styles/events-organizations-pr417.css';
import '../styles/events-organizations-pr417-mobile.css';
import '../styles/terminal-index-pagination.css';
import { buildOrganizationIndexView } from '../lib/views/organizationIndexView';

const PAGE_SIZE = 20;
const { records, filters, relationshipCount, connectedAssetCount, sourceIdentityCount } = buildOrganizationIndexView();
const title = 'Organizations — Stable or Gone';
const description = 'Browse organizations connected to stablecoin records, including category, jurisdiction, functional roles, relationship states, connected assets, and evidence.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Stablecoin Organizations', url: 'https://sog.badjoke-lab.com/issuers/', description, isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' } };
---
<BaseLayout title={title} description={description} canonicalPath="/issuers/" jsonLd={jsonLd}>
  <div class="organization-index-page" data-organization-index data-ui-v3-organizations data-register-version="pr417-organizations" data-page-size={PAGE_SIZE}>
    <header class="organization-index-masthead">
      <div class="organization-index-overline"><span>Organization register</span><nav aria-label="Related registers"><a href="/stablecoins/">Stablecoins</a><a href="/events/">Events</a></nav></div>
      <div class="organization-index-title"><div><p>Reviewed responsible bodies and connected roles</p><h1>Organizations</h1></div><span>Legal issuers, reserve managers, protocol operators, governance bodies, custodians, technology providers, and other reviewed relationships. An organization record does not automatically imply issuer status.</span></div>
      <dl class="organization-index-ledger" aria-label="Organization register totals"><div><dt>Organizations</dt><dd>{records.length}</dd></div><div><dt>Relationships</dt><dd>{relationshipCount}</dd></div><div><dt>Connected assets</dt><dd>{connectedAssetCount}</dd></div><div><dt>Source identities</dt><dd>{sourceIdentityCount}</dd></div></dl>
    </header>

    <section class="organization-index-registry" aria-labelledby="organization-index-heading">
      <div class="organization-index-section-heading"><p>Relationship registry</p><h2 id="organization-index-heading">Review role, jurisdiction, and connected assets</h2><span>Filter by taxonomy, jurisdiction, functional role, and relationship state. Twenty matching records are shown per page.</span></div>
      <div class="organization-index-toolbar"><label><span>Search</span><input data-organization-search type="search" name="q" placeholder="Name, jurisdiction, asset, role" autocomplete="off" /></label><label><span>Sort</span><select data-organization-sort name="sort"><option value="name_asc">Name A–Z</option><option value="name_desc">Name Z–A</option><option value="assets_most">Most connected assets</option><option value="relationships_most">Most relationships</option><option value="evidence_most">Most source identities</option></select></label><button class="organization-index-action" type="button" data-organization-clear-all>Clear all</button></div>
      <div class="organization-index-filter-grid" aria-label="Organization filters" data-organization-category data-organization-regulatory data-organization-jurisdiction data-organization-role data-organization-status>{filters.map((filter) => <details class="organization-index-filter"><summary data-summary-label="All">{filter.label} <span aria-hidden="true" data-organization-filter-count={filter.id} data-option-total={filter.options.length}>{filter.options.length}</span></summary><div class="organization-index-filter-options">{filter.options.map((item) => <label><input type="checkbox" data-organization-filter-group={filter.id} data-label={item.label} value={item.value} /><span>{item.label}</span></label>)}</div></details>)}</div>
      <div class="organization-index-summary"><div class="organization-index-active-filters" data-organization-active-filters aria-label="Active organization filters"></div><div class="organization-index-result-count" aria-live="polite"><span data-organization-visible-range>1–{Math.min(PAGE_SIZE, records.length)}</span> of <span data-organization-result-count>{records.length}</span> organizations</div></div>
      <div class="organization-index-table"><table data-table-kind="organization-index" data-mobile-table="scroll-preserve"><caption>Organization registry results. Compact records follow for small screens.</caption><thead><tr><th>Organization</th><th>Regulatory / jurisdiction</th><th>Functional roles</th><th>Relationship state</th><th>Assets / relationships</th><th>Sources / confidence</th></tr></thead><tbody data-organization-body>{records.map((record, index) => <OrganizationIndexRow record={record} initiallyVisible={index < PAGE_SIZE} />)}</tbody></table></div>
      <div class="organization-index-cards" data-organization-card-body aria-label="Organization compact records">{records.map((record, index) => <OrganizationIndexCard record={record} initiallyVisible={index < PAGE_SIZE} />)}</div>
      <div class="organization-index-no-results" data-organization-no-results hidden><strong>No organizations match this state.</strong><span>Clear the search and filters to restore all organization records.</span><button class="organization-index-action" type="button" data-organization-clear-all>Clear all</button></div>
      <nav class="organization-index-pagination" data-organization-pagination aria-label="Organization register pages"><button class="organization-index-action" type="button" data-organization-page-prev>Previous</button><span data-organization-page-status aria-live="polite">Page 1 of {Math.max(1, Math.ceil(records.length / PAGE_SIZE))}</span><button class="organization-index-action" type="button" data-organization-page-next>Next</button></nav>
    </section>
  </div>
  <script>import '../scripts/organization-index';</script>
</BaseLayout>
