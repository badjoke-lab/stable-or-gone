---
interface Props {
  symbol: string;
  label?: string;
  size?: 'small' | 'medium' | 'large';
}

const { symbol, label = symbol, size = 'medium' } = Astro.props;
const display = String(symbol || '?').trim().toUpperCase().slice(0, 6) || '?';
---
<span class:list={['ticker-badge', `ticker-badge--${size}`]} role="img" aria-label={label} title={label}>{display}</span>
