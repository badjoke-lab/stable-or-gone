---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guides, guideCategoryDescriptions, guideCategoryLabels, type GuideCategory } from '../data/guideCatalog';

const featuredGuide = guides.find((guide) => guide.slug === 'global-stablecoin-regulation-2026');
const categoryOrder: GuideCategory[] = ['regulation', 'asset-comparisons', 'core-concepts'];
const categories = categoryOrder
  .map((category) => ({ category, entries: guides.filter((guide) => guide.category === category && guide.slug !== featuredGuide?.slug) }))
  .filter((group) => group.entries.length > 0);
const published = guides.filter((guide) => Boolean(guide.publishedAt));
const currentThrough = [...guides].map((guide) => guide.informationCurrentThrough).sort().at(-1) ?? 'Not recorded';
const title = 'Guides — Stable or Gone';
const description = 'Beginner-friendly guides to stablecoin regulation, asset structures, depegs, reserves, redemption, lifecycle events, and the records behind each claim.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: 'https://www.stableorgone.com/guides/',
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://www.stableorgone.com/' },
  hasPart: published.map((guide) => ({ '@type': 'Article', name: guide.title, url: `https://www.stableorgone.com/guides/${guide.slug}/`, datePublished: guide.publishedAt }))
};
---
<BaseLayout title={title} description={description} canonicalPath="/guides/" jsonLd={jsonLd}>
  <article class="guide-index-page" data-ui-v3-guides>
    <header class="guide-index-masthead">
      <div class="guide-index-overline"><span>Editorial archive</span><span>Stablecoin guides and explainers</span></div>
      <div class="guide-index-title"><h1>Guides</h1><p>Readable explanations of regulation, asset structures, reserve and redemption systems, lifecycle events, and the record distinctions used throughout Stable or Gone.</p></div>
      <dl class="guide-index-ledger" aria-label="Guide archive summary">
        <div><dt>Guide records</dt><dd>{guides.length}</dd></div>
        <div><dt>Dated publications</dt><dd>{published.length}</dd></div>
        <div><dt>Sections</dt><dd>{categories.length}</dd></div>
        <div><dt>Information current through</dt><dd>{currentThrough}</dd></div>
      </dl>
    </header>

    <nav class="guide-index-nav" aria-label="Guide categories">
      {featuredGuide && <a href="#guide-featured">Global overview</a>}
      {categories.map(({ category }) => <a href={`#guide-category-${category}`}>{guideCategoryLabels[category]}</a>)}
      <a href="#guide-reference">How to use the archive</a>
    </nav>

    {featuredGuide && (
      <section class="panel registry" id="guide-featured" aria-labelledby="guide-featured-title">
        <div class="bar">Featured / Global overview</div>
        <h2 id="guide-featured-title"><a href={`/guides/${featuredGuide.slug}/`}>{featuredGuide.title}</a></h2>
        <p>{featuredGuide.summary}</p>
        <p><strong>{featuredGuide.regionLabel}</strong> · Published {featuredGuide.publishedAt} · Current through {featuredGuide.informationCurrentThrough}</p>
        <p><a href={`/guides/${featuredGuide.slug}/`}>Open the 2026 global comparison →</a></p>
      </section>
    )}

    {categories.map(({ category, entries }) => (
      <section class="guide-index-section" id={`guide-category-${category}`}>
        <div class="guide-index-section-heading"><h2>{guideCategoryLabels[category]}</h2><p>{guideCategoryDescriptions[category]}</p></div>
        <div class="guide-index-table">
          <table>
            <thead><tr><th>Guide</th><th>Region or scope</th><th>Publication</th><th>Current through</th></tr></thead>
            <tbody>
              {entries.map((guide) => <tr><td><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3><p>{guide.summary}</p></td><td>{guide.regionLabel ?? guideCategoryLabels[guide.category]}</td><td><span class="guide-index-status">{guide.publishedAt ?? 'Publication date not recorded'}</span></td><td>{guide.informationCurrentThrough}</td></tr>)}
            </tbody>
          </table>
        </div>
        <div class="guide-index-mobile" aria-label={`${guideCategoryLabels[category]} guides`}>
          {entries.map((guide) => <article><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3><p>{guide.summary}</p><p><small>{guide.regionLabel ?? guideCategoryLabels[guide.category]} · {guide.publishedAt ? `Published ${guide.publishedAt}` : 'Publication date not recorded'} · Current through {guide.informationCurrentThrough}</small></p></article>)}
        </div>
      </section>
    ))}

    <section class="guide-index-section" id="guide-reference">
      <div class="guide-index-section-heading"><h2>How to use the archive</h2><p>Guides explain the framework. Registry records, event files, evidence relations, and known unknowns remain the factual source surfaces.</p></div>
      <nav class="guide-index-reference" aria-label="Guide reference links">
        <a href="/glossary/"><strong>Glossary</strong><span>Definitions of recurring legal, reserve, redemption, lifecycle, and evidence terms.</span></a>
        <a href="/methodology/"><strong>Methodology</strong><span>How records, events, relationships, sources, and uncertainty are reviewed.</span></a>
        <a href="/stablecoins/"><strong>Stablecoin register</strong><span>Open the canonical records behind claims and examples used in the guides.</span></a>
      </nav>
    </section>
  </article>
</BaseLayout>
