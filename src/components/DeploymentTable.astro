---
import ValueStateText from './ValueStateText.astro';
import { formatPublicLabel } from '../utils/displayLabels';
import { cleanPublicText } from '../utils/publicText';
import { resolveDeploymentTaxonomy } from '../utils/deploymentTaxonomy';
import type { DeploymentV3View } from '../lib/data/registryV3';

const { deployments } = Astro.props as { deployments: DeploymentV3View[] };
const rows = deployments.map((deployment) => {
  const taxonomy = resolveDeploymentTaxonomy(deployment);
  const freezeValue = deployment.freeze_capability === true ? 'Yes' : deployment.freeze_capability === false ? 'No' : null;
  const blacklistValue = deployment.blacklist_capability === true ? 'Yes' : deployment.blacklist_capability === false ? 'No' : null;
  return {
    deployment,
    taxonomy,
    rawStatusLabel: formatPublicLabel(taxonomy.canonical_status_raw),
    freezeValue,
    blacklistValue,
    identifier: taxonomy.contract_identity_state === 'recorded_identifier' ? deployment.contract_address : taxonomy.contract_identity_state_label
  };
});
---
<section class="panel registry stablecoin-deployment-panel">
  <div class="bar">Blockchain deployments</div>
  <div class="organization-detail-table stablecoin-deployment-table-wrap">
    <table data-table-kind="stablecoin-deployments" data-mobile-table="scroll-preserve">
      <thead>
        <tr>
          <th>Network</th>
          <th>Standard</th>
          <th>Deployment type</th>
          <th>Operational state</th>
          <th>Contract or identifier</th>
        </tr>
      </thead>
      <tbody>
        {rows.length === 0 ? <tr><td colspan="5">No deployment records have been added yet.</td></tr> : rows.map(({ deployment, taxonomy, rawStatusLabel, freezeValue, blacklistValue, identifier }) => <>
          <tr>
            <td><ValueStateText value={deployment.chain} /></td>
            <td><ValueStateText value={deployment.token_standard} /></td>
            <td>{taxonomy.public_category_label}</td>
            <td>{taxonomy.operational_state_label}</td>
            <td data-technical-value>{identifier}</td>
          </tr>
          <tr>
            <td colspan="5">
              <details class="stablecoin-mechanism-details">
                <summary>Technical, canonicality, and control fields</summary>
                <dl class="stablecoin-mechanism-ledger stablecoin-mechanism-ledger--secondary">
                  <div><dt>Network record state</dt><dd>{taxonomy.network_identity_state_label}</dd></div>
                  <div><dt>Canonical deployment type</dt><dd>{formatPublicLabel(taxonomy.canonical_deployment_type)}</dd></div>
                  <div><dt>Recorded status</dt><dd><ValueStateText value={taxonomy.canonical_status_raw} displayValue={rawStatusLabel} /></dd></div>
                  <div><dt>Change or proposal state</dt><dd>{taxonomy.change_state_label}</dd></div>
                  <div><dt>Canonicality</dt><dd>{taxonomy.canonicality_label}</dd></div>
                  <div><dt>Canonicality record state</dt><dd>{taxonomy.canonicality_record_state_label}</dd></div>
                  <div><dt>Verification state</dt><dd>{taxonomy.verification_state_label}</dd></div>
                  <div><dt>Contract identity state</dt><dd>{taxonomy.contract_identity_state_label}</dd></div>
                  <div><dt>Freeze</dt><dd><ValueStateText value={freezeValue} /></dd></div>
                  <div><dt>Blacklist</dt><dd><ValueStateText value={blacklistValue} /></dd></div>
                  <div><dt>Control events</dt><dd>{deployment.control_event_ids?.length ?? 0}</dd></div>
                  <div class="wide"><dt>Notes</dt><dd>{cleanPublicText(deployment.notes, 'No deployment-specific note has been recorded.')}</dd></div>
                </dl>
              </details>
            </td>
          </tr>
        </>)}
      </tbody>
    </table>
  </div>

  <div class="mobile-record-list stablecoin-deployment-cards" data-mobile-representation-for="stablecoin-deployments">
    {rows.length === 0 ? <p class="mobile-empty-record">No deployment records have been added yet.</p> : rows.map(({ deployment, taxonomy, rawStatusLabel, freezeValue, blacklistValue, identifier }) => <article>
      <header>
        <div><span class="record-kicker">Network</span><h3>{formatPublicLabel(deployment.chain, 'Network not recorded')}</h3></div>
        <span>{taxonomy.operational_state_label}</span>
      </header>
      <dl>
        <div><dt>Standard</dt><dd><ValueStateText value={deployment.token_standard} /></dd></div>
        <div><dt>Deployment type</dt><dd>{taxonomy.public_category_label}</dd></div>
        <div><dt>Contract or identifier</dt><dd data-technical-value>{identifier}</dd></div>
      </dl>
      <details class="stablecoin-mechanism-details">
        <summary>Technical, canonicality, and control fields</summary>
        <dl class="stablecoin-mechanism-ledger stablecoin-mechanism-ledger--secondary">
          <div><dt>Network record state</dt><dd>{taxonomy.network_identity_state_label}</dd></div>
          <div><dt>Canonical deployment type</dt><dd>{formatPublicLabel(taxonomy.canonical_deployment_type)}</dd></div>
          <div><dt>Recorded status</dt><dd><ValueStateText value={taxonomy.canonical_status_raw} displayValue={rawStatusLabel} /></dd></div>
          <div><dt>Change or proposal state</dt><dd>{taxonomy.change_state_label}</dd></div>
          <div><dt>Canonicality</dt><dd>{taxonomy.canonicality_label}</dd></div>
          <div><dt>Canonicality record state</dt><dd>{taxonomy.canonicality_record_state_label}</dd></div>
          <div><dt>Verification state</dt><dd>{taxonomy.verification_state_label}</dd></div>
          <div><dt>Contract identity state</dt><dd>{taxonomy.contract_identity_state_label}</dd></div>
          <div><dt>Freeze</dt><dd><ValueStateText value={freezeValue} /></dd></div>
          <div><dt>Blacklist</dt><dd><ValueStateText value={blacklistValue} /></dd></div>
          <div><dt>Control events</dt><dd>{deployment.control_event_ids?.length ?? 0}</dd></div>
          <div class="wide"><dt>Notes</dt><dd>{cleanPublicText(deployment.notes, 'No deployment-specific note has been recorded.')}</dd></div>
        </dl>
      </details>
    </article>)}
  </div>
</section>
