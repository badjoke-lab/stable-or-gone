---
import StablecoinMark from './StablecoinMark.astro';
import { formatIssuanceLabel, formatLifecycleLabel } from '../utils/publicTaxonomy';
const { record } = Astro.props;
const deploymentLabel = `${record.deploymentCount} recorded deployment${record.deploymentCount === 1 ? '' : 's'}`;
const eventLabel = `${record.eventCount} linked event${record.eventCount === 1 ? '' : 's'}`;
---
<div
  class="comparison-source"
  data-comparison-source
  data-record-slug={record.slug}
  data-record-name={record.name}
  data-record-symbol={record.symbol || 'No symbol'}
  data-record-href={`/stablecoin/${record.slug}/`}
  hidden
>
  <span data-comparison-source-mark>
    <StablecoinMark slug={record.slug} symbol={record.symbol || ''} name={record.name} size="small" />
  </span>
  <span data-compare-value="lifecycle">{formatLifecycleLabel(record.lifecycle)}</span>
  <span data-compare-value="issuance">{formatIssuanceLabel(record.issuance)}</span>
  <span data-compare-value="asset_class">{record.assetClassLabel}</span>
  <span data-compare-value="launch">{record.launchDate || 'Not recorded'}</span>
  <span data-compare-value="reference">{record.referenceLabel}</span>
  <span data-compare-value="backing">{record.backingLabel}</span>
  <span data-compare-value="stabilization">{record.stabilizationLabel}</span>
  <span data-compare-value="reserve_disclosure">{record.reserveSummary}</span>
  <span data-compare-value="redemption">{record.redemptionSummary}</span>
  <span data-compare-value="organizations_control">{record.organizationSummary}</span>
  <span data-compare-value="deployments">{deploymentLabel}</span>
  <span data-compare-value="linked_events">{eventLabel}</span>
  <span data-compare-value="source_identities">{record.sourceIdentityCount}</span>
  <span data-compare-value="evidence_relations">{record.evidenceRelationCount}</span>
  <span data-compare-value="known_unknowns">{record.knownUnknownCount}</span>
</div>
