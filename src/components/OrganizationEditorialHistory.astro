---
import IssuerControlEvents from './IssuerControlEvents.astro';
import EvidenceSourceTable from './EvidenceSourceTable.astro';
import ValueStateText from './ValueStateText.astro';
import { formatPublicLabel } from '../utils/displayLabels';
const { view } = Astro.props;
---
<section class="organization-detail-section" id="events">
  <div class="organization-detail-section-heading"><p>Material history</p><h2>Events</h2><span>Typed events and organization control actions remain linked to evidence.</span></div>
  <IssuerControlEvents events={view.issuerControlEvents} title="Enforcement and control actions" />
  <div class="organization-detail-table"><table data-table-kind="organization-events" data-mobile-table="scroll-preserve"><thead><tr><th>Date</th><th>Event</th><th>Category</th><th>Subtype</th><th>Status effect</th></tr></thead><tbody>
    {view.events.length === 0 ? <tr><td colspan="5">No organization-level events have been added.</td></tr> : view.events.map(({ event, taxonomy, title }) => <tr><td><ValueStateText value={event.event_date} /></td><td><a href={`/event/${event.id}/`}>{title}</a></td><td>{taxonomy.public_category_label}</td><td>{taxonomy.canonical_subtype_label}</td><td>{taxonomy.status_effect_label}</td></tr>)}
  </tbody></table></div>
  <div class="organization-event-cards" data-mobile-representation-for="organization-events">{view.events.map(({ event, taxonomy, title }) => <article><time datetime={event.event_date ?? undefined}>{event.event_date ?? 'Date not recorded'}</time><h3><a href={`/event/${event.id}/`}>{title}</a></h3><p>{taxonomy.public_category_label} · {taxonomy.canonical_subtype_label}</p><small>{taxonomy.status_effect_label}</small></article>)}</div>
</section>

<section class="organization-detail-section" id="evidence">
  <div class="organization-detail-section-heading"><p>Provenance</p><h2>Evidence</h2><span>Source identity, publication date, reliability, archive state, and relation count remain separate.</span></div>
  <div class="organization-detail-table"><EvidenceSourceTable evidence={view.evidence} tableKind="organization-sources" emptyMessage="No organization-related sources have been added." /></div>
  <div class="organization-source-cards" data-mobile-representation-for="organization-sources">{view.sourceIdentities.map((source) => <article><h3><a href={source.url}>{source.title}</a></h3><dl><div><dt>Publisher</dt><dd>{source.publisher ?? 'Not recorded'}</dd></div><div><dt>Published</dt><dd>{source.published_at ?? 'Not recorded'}</dd></div><div><dt>Reliability</dt><dd>{formatPublicLabel(source.reliability)}</dd></div></dl>{source.archived_url && <a href={source.archived_url}>Open archive</a>}</article>)}</div>
</section>

<section class="organization-detail-section" id="unknowns">
  <div class="organization-detail-section-heading"><p>Uncertainty</p><h2>Known unknowns</h2><span>Reviewed gaps remain visible instead of being converted into false certainty.</span></div>
  {view.knownUnknowns.length === 0 ? <p class="organization-detail-empty">No organization-specific known unknowns are currently recorded.</p> : <div class="organization-unknown-cards">{view.knownUnknowns.map((item) => <article><h3>{item.question}</h3><p>{item.notes ?? 'No public resolution is recorded.'}</p><dl><div><dt>Value state</dt><dd>{formatPublicLabel(item.value_state)}</dd></div><div><dt>Priority</dt><dd>{formatPublicLabel(item.priority)}</dd></div><div><dt>Last checked</dt><dd><ValueStateText value={item.last_checked_at} /></dd></div></dl></article>)}</div>}
</section>

<section class="organization-detail-section" id="corrections">
  <div class="organization-detail-section-heading"><p>Maintenance</p><h2>Corrections and further reading</h2><span>Report a record problem or inspect methodology and machine-readable data.</span></div>
  <div class="organization-detail-actions"><a href="/contact/">Submit a correction</a><a href="/methodology/">Methodology</a><a href="/data/manifest.json">Data manifest</a></div>
</section>
