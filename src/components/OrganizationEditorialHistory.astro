---
import IssuerControlEvents from './IssuerControlEvents.astro';
import EvidenceSourceTable from './EvidenceSourceTable.astro';
import ValueStateText from './ValueStateText.astro';
import { formatPublicLabel, formatPublicText } from '../utils/displayLabels';
import { buildOrganizationDetailView } from '../lib/views/organizationDetailView';
type View = ReturnType<typeof buildOrganizationDetailView>;
const { view } = Astro.props as { view: View };
const visibleEvents = view.events.slice(0, 5);
const remainingEvents = view.events.slice(5);
const visibleEvidence = view.evidence.slice(0, 10);
const remainingEvidence = view.evidence.slice(10);
---
<section class="organization-detail-section" id="events">
  <div class="organization-detail-section-heading"><p>Material history</p><h2>Events</h2><span>The five latest typed events are shown first. Control actions remain linked to evidence.</span></div>
  <IssuerControlEvents events={view.issuerControlEvents} title="Enforcement and control actions" />
  <div class="organization-detail-table organization-events-r5"><table data-table-kind="organization-events" data-mobile-table="scroll-preserve"><thead><tr><th>Date</th><th>Event</th><th>Type</th><th>Effect</th></tr></thead><tbody>
    {visibleEvents.length === 0 ? <tr><td colspan="4">No organization-level events have been added.</td></tr> : visibleEvents.map(({ event, taxonomy, title }) => <tr><td><ValueStateText value={event.event_date} /></td><td><a href={`/event/${event.id}/`}>{title}</a></td><td>{taxonomy.canonical_subtype_label}<small>{taxonomy.public_category_label}</small></td><td>{taxonomy.status_effect_label}</td></tr>)}
  </tbody></table></div>
  <div class="organization-event-cards organization-event-cards-r5" data-mobile-representation-for="organization-events">
    {visibleEvents.length === 0
      ? <article class="mobile-empty-record"><p>No organization-level events have been added.</p></article>
      : visibleEvents.map(({ event, taxonomy, title }) => <article><time datetime={event.event_date ?? undefined}>{event.event_date ?? 'Date not recorded'}</time><h3><a href={`/event/${event.id}/`}>{title}</a></h3><p>{taxonomy.canonical_subtype_label}</p><small>{taxonomy.status_effect_label}</small></article>)}
  </div>
  {remainingEvents.length > 0 && <details class="organization-detail-more-r5"><summary>Show {remainingEvents.length} earlier event{remainingEvents.length === 1 ? '' : 's'}</summary><ul>{remainingEvents.map(({ event, taxonomy, title }) => <li><time datetime={event.event_date ?? undefined}>{event.event_date ?? 'Date not recorded'}</time><a href={`/event/${event.id}/`}>{title}</a><span>{taxonomy.status_effect_label}</span></li>)}</ul></details>}
</section>

<section class="organization-detail-section" id="evidence">
  <div class="organization-detail-section-heading"><p>Provenance</p><h2>Evidence</h2><span>The first ten source records are shown initially. Source identity, publication date, reliability, and archive state remain separate.</span></div>
  <div class="organization-evidence-r5"><EvidenceSourceTable evidence={visibleEvidence} tableKind="organization-sources" emptyMessage="No organization-related sources have been added." /></div>
  {remainingEvidence.length > 0 && <details class="organization-detail-more-r5"><summary>Show {remainingEvidence.length} additional source record{remainingEvidence.length === 1 ? '' : 's'}</summary><div><EvidenceSourceTable evidence={remainingEvidence} tableKind="organization-sources" /></div></details>}
</section>

<details class="organization-detail-section organization-unknowns-r5" id="unknowns" open>
  <summary><span><small>Uncertainty</small><strong>Known unknowns</strong></span><b>{view.knownUnknowns.length}</b></summary>
  <div class="organization-unknown-list-r5">
    {view.knownUnknowns.length === 0 ? <p class="organization-detail-empty">No organization-specific known unknowns are currently recorded.</p> : view.knownUnknowns.map((item) => <article><h3>{formatPublicLabel(item.topic)}</h3><p>{formatPublicText(item.description)}</p><small>{formatPublicLabel(item.severity)} · last checked <ValueStateText value={item.last_checked_at} /></small>{item.notes && <p>{formatPublicText(item.notes)}</p>}</article>)}
  </div>
</details>

<section class="organization-detail-section organization-corrections-r5" id="corrections">
  <div class="organization-detail-section-heading"><p>Maintenance</p><h2>Corrections and further reading</h2><span>Report a record problem or inspect methodology and machine-readable data.</span></div>
  <div class="organization-detail-actions"><a href="/contact/">Submit a correction</a><a href="/methodology/">Methodology</a><a href="/data/manifest.json">Data manifest</a></div>
</section>
