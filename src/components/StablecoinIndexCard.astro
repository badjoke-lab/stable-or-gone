---
import { formatLifecycleLabel, lifecycleChipClass } from '../utils/publicTaxonomy';
const { record, initiallyVisible = true } = Astro.props;
const data = {
  'data-record-slug': record.slug,
  'data-search': record.search,
  'data-name': record.name.toLocaleLowerCase(),
  'data-lifecycle': record.lifecycle,
  'data-issuance': record.issuance,
  'data-asset-class': record.assetClass,
  'data-reference': record.referenceCategory,
  'data-backing': record.backingCategory,
  'data-stabilization': record.stabilization,
  'data-launch-date': record.launchDate,
  'data-evidence-count': String(record.sourceIdentityCount)
};
---
<article class="stablecoin-index-card stablecoin-index-card-r3" data-registry-card data-mobile-representation-for="stablecoin-index" hidden={initiallyVisible ? undefined : true} {...data}>
  <div class="stablecoin-index-card-heading">
    <a class="stablecoin-index-card-identity" href={`/stablecoin/${record.slug}/`}>
      <span><strong>{record.name}</strong><small>{record.symbol || 'No symbol'} · {record.primaryOrganizationName}</small></span>
    </a>
    <div class="stablecoin-index-card-actions">
      <span class={lifecycleChipClass(record.lifecycle)}>{formatLifecycleLabel(record.lifecycle)}</span>
      <label class="comparison-choice comparison-choice-card comparison-choice-icon"><input type="checkbox" data-compare-select value={record.slug} aria-label={`Compare ${record.name}`} /><span class="visually-hidden">Compare</span></label>
    </div>
  </div>
  <p class="stablecoin-index-card-meta"><span>{record.referenceLabel}</span><span>{record.backingLabel}</span><span>{record.sourceIdentityCount} sources</span><span>{record.reviewedAt || 'Not reviewed'}</span></p>
</article>

<style is:global>
  .stablecoin-index-page-r3 .stablecoin-index-card-r3 {
    box-sizing: border-box !important;
    min-height: 0 !important;
    padding: 0.45rem 0.6rem !important;
  }

  .stablecoin-index-page-r3 .stablecoin-index-card-r3 .stablecoin-index-card-heading {
    gap: 0.45rem !important;
  }

  .stablecoin-index-page-r3 .stablecoin-index-card-r3 .stablecoin-index-card-meta {
    margin-top: 0.2rem !important;
    line-height: 1.2 !important;
  }
</style>
