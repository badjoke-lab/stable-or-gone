---
interface Props {
  label: string;
  value: string | number;
  detail?: string;
  href?: string;
  icon?: string;
}

const { label, value, detail, href, icon } = Astro.props;
const Tag = href ? 'a' : 'article';
---
<Tag class="metric-card ui-panel" href={href}>
  {icon && <span class="metric-card__icon" aria-hidden="true">{icon}</span>}
  <span class="metric-card__label">{label}</span>
  <strong class="metric-card__value">{value}</strong>
  {detail && <span class="metric-card__detail">{detail}</span>}
</Tag>
