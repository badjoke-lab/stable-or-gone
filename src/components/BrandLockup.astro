---
import { uiV3BrandAssets } from '../../config/ui-v3-foundation.mjs';
import '../styles/public-ui.css';
import MobileTableRuntime from './MobileTableRuntime.astro';
import DisclosureRuntime from './DisclosureRuntime.astro';
import TechnicalTokenRuntime from './TechnicalTokenRuntime.astro';
import ResponsiveNavigationRuntime from './ResponsiveNavigationRuntime.astro';
import StatsResponsiveRuntime from './StatsResponsiveRuntime.astro';
import SemanticToneRuntime from './SemanticToneRuntime.astro';

interface Props {
  compact?: boolean;
  surface?: 'dark' | 'light';
  href?: string;
  class?: string;
}

const {
  compact = false,
  surface = 'light',
  href = '/',
  class: className = ''
} = Astro.props;
const asset = compact
  ? (surface === 'dark' ? uiV3BrandAssets.mark_on_dark : uiV3BrandAssets.mark_on_light)
  : (surface === 'dark' ? uiV3BrandAssets.lockup_on_dark : uiV3BrandAssets.lockup_on_light);
const loadsGlobalRuntime = className.split(/\s+/).includes('site-brand');
---
<a class:list={['brand-lockup', compact && 'brand-lockup--compact', className]} href={href} aria-label="Stable or Gone home">
  <img src={asset} alt="Stable or Gone" width={compact ? 56 : 228} height={compact ? 56 : 56} decoding="async" />
</a>
{loadsGlobalRuntime && <><MobileTableRuntime /><DisclosureRuntime /><TechnicalTokenRuntime /><ResponsiveNavigationRuntime /><StatsResponsiveRuntime /><SemanticToneRuntime /></>}
