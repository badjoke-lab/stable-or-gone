---
import { uiV3BrandAssets } from '../../config/ui-v3-foundation.mjs';
import MobileTableRuntime from './MobileTableRuntime.astro';
import DisclosureRuntime from './DisclosureRuntime.astro';
import TerminalContentRuntime from './TerminalContentRuntime.astro';

interface Props {
  compact?: boolean;
  surface?: 'dark' | 'light';
  href?: string;
  class?: string;
}

const {
  compact = false,
  surface = 'light',
  href = '/',
  class: className = ''
} = Astro.props;
const asset = compact
  ? (surface === 'dark' ? uiV3BrandAssets.mark_on_dark : uiV3BrandAssets.mark_on_light)
  : (surface === 'dark' ? uiV3BrandAssets.lockup_on_dark : uiV3BrandAssets.lockup_on_light);
const loadsGlobalRuntime = className.split(/\s+/).includes('site-brand');
---
<a class:list={['brand-lockup', compact && 'brand-lockup--compact', className]} href={href} aria-label="Stable or Gone home">
  <img src={asset} alt="Stable or Gone" width={compact ? 56 : 228} height={compact ? 56 : 56} decoding="async" />
</a>
{loadsGlobalRuntime && <script is:inline>
  (() => {
    const root = document.documentElement;
    if (root.dataset.uiRemediationR2Runtime === 'installed') return;
    root.dataset.uiRemediationR2Runtime = 'installed';

    const important = (element, property, value) => {
      if (element instanceof HTMLElement || element instanceof SVGElement) {
        element.style.setProperty(property, value, 'important');
      }
    };

    const apply = () => {
      const width = window.innerWidth;
      const headerHeight = width <= 719 ? 56 : width <= 1120 ? 60 : 64;
      const titleSize = width <= 719 ? 36 : width <= 860 ? 40 : 48;
      const interfaceFont = 'ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';

      important(document.body, 'font-family', interfaceFont);
      important(document.body, 'font-size', '16px');
      important(document.body, 'line-height', '1.62');
      important(document.body, 'background', 'var(--sog-background)');
      important(document.body, 'background-image', 'none');

      const header = document.querySelector('.site-header');
      const primary = document.querySelector('.site-header-primary');
      const inner = document.querySelector('.site-header-inner');
      const navBar = document.querySelector('.site-navigation-bar');
      const purpose = document.querySelector('.site-brand-purpose');
      const brandCluster = document.querySelector('.site-brand-cluster');

      for (const element of [header, primary, inner]) {
        important(element, 'height', `${headerHeight}px`);
        important(element, 'min-height', `${headerHeight}px`);
        important(element, 'max-height', `${headerHeight}px`);
      }
      important(header, 'padding', '0');
      important(header, 'background', 'var(--sog-background)');
      important(header, 'background-image', 'none');
      important(header, 'box-shadow', 'none');
      important(header, 'backdrop-filter', 'none');
      important(header, '-webkit-backdrop-filter', 'none');
      important(primary, 'border-bottom', '0');
      important(navBar, 'display', 'none');
      important(purpose, 'display', 'none');
      important(brandCluster, 'display', 'block');

      if (inner instanceof HTMLElement) {
        const columns = width <= 860
          ? 'minmax(0, 1fr) auto'
          : width <= 1120
            ? 'minmax(150px, 190px) minmax(220px, 1fr) auto'
            : 'minmax(150px, 190px) minmax(240px, 1fr) auto auto';
        inner.style.setProperty('grid-template-columns', columns, 'important');
        inner.style.setProperty('gap', width <= 719 ? '0.5rem' : 'clamp(0.65rem, 1.4vw, 1.25rem)', 'important');
      }

      document.querySelectorAll('.site-search-control, .mobile-navigation-panel, .site-search input, .mobile-site-search input, .site-search button, .mobile-site-search button').forEach((element) => {
        important(element, 'border-radius', '0');
      });
      document.querySelectorAll('.site-search-control, .mobile-navigation-panel').forEach((element) => {
        important(element, 'box-shadow', 'none');
        important(element, 'background-image', 'none');
      });

      document.querySelectorAll('h1').forEach((heading) => {
        important(heading, 'font-family', interfaceFont);
        important(heading, 'font-size', `${titleSize}px`);
        important(heading, 'line-height', '1.12');
        important(heading, 'letter-spacing', '-0.02em');
        important(heading, 'overflow-wrap', 'normal');
        important(heading, 'word-break', 'normal');
      });

      document.querySelectorAll('table th, table td').forEach((cell) => {
        important(cell, 'font-family', interfaceFont);
        important(cell, 'font-size', '14px');
        important(cell, 'line-height', '1.48');
      });

      document.querySelectorAll('h1, h2, h3, h4, h5, h6, p, li, dt, dd, label, button, input, select, textarea, summary, a, span, strong, small, time, i, em, blockquote').forEach((element) => {
        if (!element.closest('code, pre, kbd, samp, [data-long-value], .contract-address, .transaction-hash, .stablecoin-record-id')) {
          important(element, 'font-family', interfaceFont);
        }
      });

      root.dataset.uiRemediationR2 = 'ready';
    };

    apply();
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply, { once: true });
    window.addEventListener('resize', apply, { passive: true });
  })();
</script>}
{loadsGlobalRuntime && <><MobileTableRuntime /><DisclosureRuntime /><TerminalContentRuntime /></>}
