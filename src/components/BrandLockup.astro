---
import { uiV3BrandAssets } from '../../config/ui-v3-foundation.mjs';
import '../styles/v3-cya-dark-shell.css';
import '../styles/v3-cya-dark-shell-corrections.css';
import '../styles/v3-cya-dark-registry.css';
import '../styles/v3-cya-dark-registry-corrections.css';
import '../styles/v3-cya-dark-home.css';
import '../styles/v3-cya-dark-detail.css';
import '../styles/v3-cya-dark-detail-corrections.css';
import '../styles/v3-cya-dark-indexes.css';
import '../styles/v3-cya-dark-secondary-details.css';
import '../styles/v3-cya-dark-analysis.css';
import '../styles/v3-cya-dark-research-longform.css';
import '../styles/v3-cya-dark-phase5-corrections.css';
import '../styles/v3-cya-dark-longform-corrections.css';
import '../styles/v3-exhaustive-remediation.css';
import '../styles/v3-color-system-remediation.css';
import MobileTableRuntime from './MobileTableRuntime.astro';
import DisclosureRuntime from './DisclosureRuntime.astro';

interface Props {
  compact?: boolean;
  surface?: 'dark' | 'light';
  href?: string;
  class?: string;
}

const {
  compact = false,
  surface = 'light',
  href = '/',
  class: className = ''
} = Astro.props;
const asset = compact
  ? (surface === 'dark' ? uiV3BrandAssets.mark_on_dark : uiV3BrandAssets.mark_on_light)
  : (surface === 'dark' ? uiV3BrandAssets.lockup_on_dark : uiV3BrandAssets.lockup_on_light);
const loadsGlobalRuntime = className.split(/\s+/).includes('site-brand');
---
<a class:list={['brand-lockup', compact && 'brand-lockup--compact', className]} href={href} aria-label="Stable or Gone home">
  <img src={asset} alt="Stable or Gone" width={compact ? 56 : 228} height={compact ? 56 : 56} decoding="async" />
</a>
{loadsGlobalRuntime && <><MobileTableRuntime /><DisclosureRuntime /></>}
