---
import type { GuideRevision } from '../data/guideCatalog';
interface Props { revisions: GuideRevision[]; }
const { revisions } = Astro.props;
---
{revisions.length > 0 && (
  <section class="guide-revision-history" aria-labelledby="revision-history-title">
    <h2 id="revision-history-title">Revision history</h2>
    <table>
      <thead><tr><th>Date</th><th>Change</th></tr></thead>
      <tbody>
        {revisions.map((revision) => (
          <tr><td>{revision.date}</td><td><strong>{revision.kind === 'correction' ? 'Correction: ' : ''}</strong>{revision.note}</td></tr>
        ))}
      </tbody>
    </table>
  </section>
)}
