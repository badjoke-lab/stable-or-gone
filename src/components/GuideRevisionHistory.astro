---
import type { GuideRevision } from '../data/guideCatalog';
interface Props { revisions: GuideRevision[]; }
const { revisions } = Astro.props;
---
{revisions.length > 0 && (
  <section data-guide-section aria-labelledby="revision-history-title">
    <h2 class="guide-article-section-title" id="revision-history-title">Revision history</h2>
    <div class="guide-revision-table">
      <table>
        <thead><tr><th>Date</th><th>Change</th></tr></thead>
        <tbody>{revisions.map((revision) => <tr><td>{revision.date}</td><td><strong>{revision.kind === 'correction' ? 'Correction: ' : ''}</strong>{revision.note}</td></tr>)}</tbody>
      </table>
    </div>
  </section>
)}
