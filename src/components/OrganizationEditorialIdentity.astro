---
import ValueStateText from './ValueStateText.astro';
import { formatLifecycleLabel, lifecycleChipClass } from '../utils/publicTaxonomy';
import { formatPublicLabel } from '../utils/displayLabels';
import { getFunctionalRoleLabel, getRelationshipStatusLabel } from '../utils/organizationTaxonomy';
import type { OrganizationRow } from '../lib/data/registry';
import { buildOrganizationDetailView } from '../lib/views/organizationDetailView';
type View = ReturnType<typeof buildOrganizationDetailView>;
const { organization, view } = Astro.props as { organization: OrganizationRow; view: View };
---
<section class="organization-detail-section organization-overview-r5" id="overview">
  <div class="organization-detail-section-heading"><p>Reviewed identity</p><h2>Organization summary</h2><span>The primary category, regulatory character, jurisdiction, asset count, relationship count, and Evidence count are already shown above.</span></div>
  <p class="organization-detail-summary-r5">{view.summary}</p>
  <dl class="organization-detail-secondary-r5">
    <div><dt>Legal form</dt><dd>{view.taxonomy.legal_form_label}</dd></div>
    <div><dt>Functional roles</dt><dd>{view.functionalRoles.length ? view.functionalRoles.map(getFunctionalRoleLabel).join(', ') : 'Not recorded'}</dd></div>
    <div><dt>Official website</dt><dd>{organization.official_url ? <a href={organization.official_url}>{organization.official_url}</a> : 'Not recorded'}</dd></div>
    <div><dt>Record confidence</dt><dd><ValueStateText value={organization.confidence} displayValue={formatPublicLabel(organization.confidence)} /></dd></div>
    <div><dt>Last reviewed</dt><dd><ValueStateText value={organization.last_verified_at} /></dd></div>
  </dl>
</section>

<section class="organization-detail-section" id="relationships">
  <div class="organization-detail-section-heading"><p>Connected assets</p><h2>Relationships</h2><span>Current, ended, and unknown relationships remain separate. Primary display is navigation only.</span></div>
  <div class="organization-detail-table organization-relationships-r5"><table data-table-kind="organization-relationships" data-mobile-table="scroll-preserve"><thead><tr><th>Stablecoin</th><th>Role</th><th>Period</th><th>State</th><th>Lifecycle</th></tr></thead><tbody>
    {view.relationships.length === 0 ? <tr><td colspan="5">No stablecoin relationships have been added.</td></tr> : view.relationships.map(({ relationship, coin, isPrimary }) => <tr><td>{coin ? <a href={`/stablecoin/${coin.slug}/`}>{coin.name}</a> : relationship.stablecoin_id}<small>{isPrimary ? 'Primary display' : 'Additional relationship'}</small></td><td>{getFunctionalRoleLabel(relationship.role)}</td><td><ValueStateText value={relationship.start_date} /> – <ValueStateText value={relationship.end_date} /></td><td>{getRelationshipStatusLabel(relationship.status ?? 'unknown')}</td><td>{coin ? <span class={lifecycleChipClass(coin.lifecycle_status)}>{formatLifecycleLabel(coin.lifecycle_status)}</span> : 'Not recorded'}</td></tr>)}
  </tbody></table></div>
  <div class="organization-relationship-cards organization-relationship-cards-r5" data-mobile-representation-for="organization-relationships">{view.relationships.map(({ relationship, coin, isPrimary }) => <article><header><h3>{coin ? <a href={`/stablecoin/${coin.slug}/`}>{coin.name}</a> : relationship.stablecoin_id}</h3><span>{isPrimary ? 'Primary' : getRelationshipStatusLabel(relationship.status ?? 'unknown')}</span></header><p>{getFunctionalRoleLabel(relationship.role)}</p><small>{relationship.start_date ?? 'Start not recorded'} – {relationship.end_date ?? 'Present / not recorded'}</small></article>)}</div>
</section>
