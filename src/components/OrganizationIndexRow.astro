---
import { formatPublicLabel } from '../utils/displayLabels';
const { record, initiallyVisible = true } = Astro.props as { record: { search: string; name: string; category: string; regulatory: string; jurisdictionScope: string; roles: string[]; relationshipStatuses: string[]; assetCount: number; relationshipCount: number; sourceIdentityCount: number; slug: string; categoryLabel: string; regulatoryLabel: string; jurisdictionLabel: string; confidenceLabel: string }; initiallyVisible?: boolean };
const data = {
  'data-record-slug': record.slug,
  'data-search': record.search,
  'data-name': record.name.toLocaleLowerCase(),
  'data-category': record.category,
  'data-regulatory': record.regulatory,
  'data-jurisdiction': record.jurisdictionScope,
  'data-role': record.roles.join(','),
  'data-relationship-status': record.relationshipStatuses.join(','),
  'data-assets-count': String(record.assetCount),
  'data-relationships-count': String(record.relationshipCount),
  'data-evidence-count': String(record.sourceIdentityCount)
};
const roleLabel = record.roles.length ? record.roles.map((role: string) => formatPublicLabel(role)).join(', ') : 'Not recorded';
const relationshipLabel = record.relationshipStatuses.length ? record.relationshipStatuses.map((status: string) => formatPublicLabel(status)).join(', ') : 'Not recorded';
---
<tr data-organization-row hidden={initiallyVisible ? undefined : true} {...data}>
  <td><a class="record-name" href={`/issuer/${record.slug}/`}>{record.name}</a><small>{record.categoryLabel}</small></td>
  <td>{roleLabel}<small>{record.regulatoryLabel}</small></td>
  <td>{record.jurisdictionLabel}</td>
  <td><strong class="organization-asset-count">{record.assetCount}</strong><small>{record.sourceIdentityCount} source{record.sourceIdentityCount === 1 ? '' : 's'}</small></td>
  <td>{record.relationshipCount}<small>{relationshipLabel}</small></td>
</tr>
