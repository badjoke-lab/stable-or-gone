---
import BaseLayout from '../layouts/BaseLayout.astro';
import StableAssetClassificationRows from './StableAssetClassificationRows.astro';
import IssuerControlEvents from './IssuerControlEvents.astro';
import StablecoinEventTimeline from './StablecoinEventTimeline.astro';
import RelatedGuides from './RelatedGuides.astro';
import EvidenceSourceTable from './EvidenceSourceTable.astro';
import DeploymentTable from './DeploymentTable.astro';
import StablecoinValueStateSections from './StablecoinValueStateSections.astro';
import ValueStateText from './ValueStateText.astro';
import { formatPublicLabel } from '../utils/displayLabels';
import { formatIssuanceLabel, formatLifecycleLabel, lifecycleChipClass } from '../utils/publicTaxonomy';
import { resolveReferenceTarget } from '../utils/referenceTarget';
import { resolveBackingModel } from '../utils/backingModel';
import { cleanPublicText } from '../utils/publicText';
import { resolvePrimaryRelationshipForStablecoin } from '../utils/primaryDisplayRelationship';
import { eventPublicCopy } from '../data/eventPublicCopy';
import { getRelatedGuidesForStablecoin } from '../data/stablecoinGuideLinks';
import { getStablecoinPublicSummary } from '../data/stablecoinPublicCopy';
import { resolveEvidenceIdentityId } from '../../config/evidence-source-identities.mjs';
import {
  getOrganizations,
  getRelationships,
  getEvents,
  getEvidence,
  getReserveReports,
  getKnownUnknowns,
  getRegulatoryNotes
} from '../lib/data/registry';
import { getDeploymentsV3, getReserveComponentsFor } from '../lib/data/registryV3';

const modelChangeTerms = new Set<string | undefined>([
  'governance_change', 'migration', 'protocol_model_update', 'protocol_transition',
  'protocol_upgrade', 'rebrand_and_classification_change', 'rebrand_or_lifecycle_transition',
  'reserve_change', 'token_migration'
]);

const { coin } = Astro.props;
const organizations = getOrganizations();
const organizationById = new Map(organizations.map((organization) => [organization.id, organization] as const));
const allRelationships = getRelationships();
const primaryResolution = resolvePrimaryRelationshipForStablecoin(coin.id, allRelationships);
const relationships = primaryResolution.candidates;
const primaryRelationship = primaryResolution.relationship;
const primaryOrganization = primaryRelationship ? organizationById.get(primaryRelationship.organization_id) : undefined;
const allEvents = getEvents();
const allEvidence = getEvidence();
const allReserveReports = getReserveReports();
const allKnownUnknowns = getKnownUnknowns();
const allRegulatoryNotes = getRegulatoryNotes();
const allDeployments = getDeploymentsV3();

const events = allEvents.filter((item) => item.subject_stablecoin_ids?.includes(coin.id) || item.stablecoin_id === coin.id).sort((a, b) => String(a.event_date ?? '').localeCompare(String(b.event_date ?? '')));
const issuerControlEvents = events.filter((item) => item.event_detail_kind === 'issuer_control' || item.event_type === 'issuer_freeze');
const modelHistoryEvents = events.filter((event) => modelChangeTerms.has(event.event_type) || modelChangeTerms.has(event.event_detail_kind) || /model|collateral|reserve|migration|transition|upgrade|rebrand/i.test(`${event.title ?? ''} ${event.description ?? ''}`));
const evidence = allEvidence.filter((item) => item.stablecoin_ids?.includes(coin.id) || item.stablecoin_id === coin.id);
const evidenceSourceIdentityCount = new Set(evidence.map((item) => resolveEvidenceIdentityId(item.id))).size;
const reserveReports = allReserveReports.filter((item) => item.stablecoin_id === coin.id);
const reserveComponents = getReserveComponentsFor(coin.id);
const openQuestions = allKnownUnknowns.filter((item) => item.stablecoin_id === coin.id);
const regulatoryNotes = allRegulatoryNotes.filter((item) => item.stablecoin_id === coin.id);
const deployments = allDeployments.filter((item) => item.stablecoin_id === coin.id);
const relatedGuides = getRelatedGuidesForStablecoin(coin.slug);
const publicSummary = getStablecoinPublicSummary(coin.slug, coin.summary);
const statusClass = lifecycleChipClass(coin.lifecycle_status);
const reference = resolveReferenceTarget(coin);
const model = resolveBackingModel(coin);
const title = `${coin.name} (${coin.symbol ?? coin.slug}) — Stablecoin History | Stable or Gone`;
const description = `${coin.name} lifecycle, issuance, reference target, backing category, canonical backing types, stabilization mechanism, redemption terms, major events, reserve information, and sources.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${coin.name} stablecoin history`,
  url: `https://sog.badjoke-lab.com/stablecoin/${coin.slug}/`,
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  keywords: [coin.name, coin.symbol, coin.lifecycle_status, coin.issuance_status, reference.public_label, reference.comparison_category_label, model.public_label, model.stabilization_label, ...model.canonical_backing_type_labels].filter(Boolean),
  ...(relatedGuides.length > 0 ? {
    subjectOf: relatedGuides.map((guide) => ({
      '@type': 'Article',
      name: guide.title,
      url: `https://sog.badjoke-lab.com${guide.href}`
    }))
  } : {})
};
const coverageRows = [
  { label: 'Organizations', count: relationships.length },
  { label: 'Evidence records', count: evidence.length },
  { label: 'Source identities', count: evidenceSourceIdentityCount },
  { label: 'Reserve reports', count: reserveReports.length },
  { label: 'Reserve components', count: reserveComponents.length },
  { label: 'Model-history events', count: modelHistoryEvents.length },
  { label: 'Regulatory notes', count: regulatoryNotes.length },
  { label: 'Deployments', count: deployments.length },
  { label: 'Issuer-control actions', count: issuerControlEvents.length },
  { label: 'Open questions', count: openQuestions.length },
  { label: 'Events', count: events.length }
];
const reserveProfile = coin.reserve_profile;
const redemptionProfile = coin.redemption_profile;
---
<BaseLayout title={title} description={description} canonicalPath={`/stablecoin/${coin.slug}/`} jsonLd={jsonLd}>
  <section class="hero"><div class="panel hero-main"><div class="prompt">Stablecoin record</div><h1>{coin.name}</h1><p>{publicSummary}</p></div><div class="panel stats"><div class="stat"><span>Lifecycle</span><strong>{formatLifecycleLabel(coin.lifecycle_status)}</strong></div><div class="stat"><span>Issuance</span><strong>{formatIssuanceLabel(coin.issuance_status)}</strong></div><div class="stat"><span>Events</span><strong>{events.length}</strong></div><div class="stat"><span>Source identities</span><strong>{evidenceSourceIdentityCount}</strong></div></div></section>

  <section class="panel registry"><div class="bar">Overview</div><table data-table-kind="stablecoin-overview" data-mobile-table="scroll-preserve"><tbody>
    <tr><th>Symbol</th><td><ValueStateText value={coin.symbol} /></td></tr>
    <StableAssetClassificationRows coin={coin} />
    <tr><th>Lifecycle status</th><td><span class={statusClass}>{formatLifecycleLabel(coin.lifecycle_status)}</span></td></tr>
    <tr><th>Issuance status</th><td>{formatIssuanceLabel(coin.issuance_status)}</td></tr>
    <tr><th>Reference target</th><td>{reference.public_label}</td></tr>
    <tr><th>Reference kind</th><td>{reference.reference_kind_label}</td></tr>
    <tr><th>Comparison category</th><td>{reference.comparison_category_label}</td></tr>
    <tr><th>Target value</th><td><ValueStateText value={reference.target_value} /></td></tr>
    <tr><th>Reference methodology</th><td><ValueStateText value={reference.methodology_description} displayValue={reference.methodology_description} detectMarkers={false} /></td></tr>
    <tr><th>Public backing model</th><td>{model.public_label}</td></tr>
    <tr><th>Canonical backing types</th><td>{model.canonical_backing_types.length ? model.canonical_backing_types.map((item, index) => <>{index > 0 ? ', ' : ''}<ValueStateText value={item} displayValue={formatPublicLabel(item)} /></>) : <ValueStateText value={null} />}</td></tr>
    <tr><th>Reserve component categories</th><td>{reserveComponents.length ? reserveComponents.map((component, index) => <>{index > 0 ? ', ' : ''}<ValueStateText value={component.asset_category} displayValue={formatPublicLabel(component.asset_category)} /></>) : <ValueStateText value={null} />}</td></tr>
    <tr><th>Primary stabilization mechanism</th><td>{model.stabilization_label}</td></tr>
    <tr><th>Recorded model description</th><td><ValueStateText value={model.recorded_model_description} displayValue={model.recorded_model_description} detectMarkers={false} /></td></tr>
    <tr><th>Governance</th><td><ValueStateText value={coin.governance_model} displayValue={formatPublicLabel(coin.governance_model)} /></td></tr>
    <tr><th>Primary display organization</th><td>{primaryOrganization ? <a href={`/issuer/${primaryOrganization.slug}/`}>{primaryOrganization.name}</a> : <ValueStateText value={null} />}</td></tr>
    <tr><th>Primary display role</th><td><ValueStateText value={primaryRelationship?.role} displayValue={formatPublicLabel(primaryRelationship?.role)} /></td></tr>
    <tr><th>Display selection mode</th><td>{formatPublicLabel(primaryResolution.selection_mode)}</td></tr>
    <tr><th>Last reviewed</th><td><ValueStateText value={coin.last_verified_at} /></td></tr>
  </tbody></table></section>

  <section class="panel registry"><div class="bar">Reserve components</div>{reserveComponents.length === 0 ? <p>No reserve components have been recorded.</p> : <ul>{reserveComponents.map((component) => <li><strong>{component.asset_label ?? formatPublicLabel(component.asset_category)}</strong> — <ValueStateText value={component.asset_category} displayValue={formatPublicLabel(component.asset_category)} />{component.share_percent !== null && component.share_percent !== undefined ? ` · ${component.share_percent}%` : ''}{component.liquidity_class ? ` · liquidity ${formatPublicLabel(component.liquidity_class)}` : ''}{component.maturity_bucket ? ` · maturity ${formatPublicLabel(component.maturity_bucket)}` : ''}{component.as_of_date ? ` · as of ${component.as_of_date}` : ''}{component.notes ? ` · ${cleanPublicText(component.notes)}` : ''}</li>)}</ul>}</section>

  <section class="panel registry"><div class="bar">Historical model changes</div>{modelHistoryEvents.length === 0 ? <p>No separate model-change event is currently recorded.</p> : <ul>{modelHistoryEvents.map((event) => <li><ValueStateText value={event.event_date} /> — <a href={`/event/${event.id}/`}>{eventPublicCopy[event.id]?.title ?? event.title}</a> · {formatPublicLabel(event.event_detail_kind ?? event.event_type)}</li>)}</ul>}</section>

  <section class="panel registry"><div class="bar">Organizations and roles</div><p><small>Primary display is a navigation and summary choice only. It does not replace other organizations or imply sole legal responsibility, operational control, reserve custody, or historical continuity.</small></p><table data-table-kind="stablecoin-organizations" data-mobile-table="scroll-preserve"><thead><tr><th>Organization</th><th>Role</th><th>Display priority</th><th>From</th><th>Until</th><th>Relationship status</th></tr></thead><tbody>{relationships.length === 0 ? <tr><td colspan="6">No organization relationships have been added yet.</td></tr> : relationships.map((relationship) => { const organization = organizationById.get(relationship.organization_id); const isPrimary = relationship.id === primaryRelationship?.id; return <tr><td>{organization ? <a href={`/issuer/${organization.slug}/`}>{organization.name}</a> : relationship.organization_id}</td><td>{formatPublicLabel(relationship.role)}</td><td>{isPrimary ? 'Primary display' : 'Additional relationship'}</td><td><ValueStateText value={relationship.start_date} /></td><td><ValueStateText value={relationship.end_date} /></td><td>{formatPublicLabel(relationship.status)}</td></tr>; })}</tbody></table></section>

  <section class="section-grid" aria-label="Related pages"><a class="panel mini-card" href="/stablecoins/"><h2>All stablecoins</h2><p>Compare this record with the rest of the archive.</p></a>{primaryOrganization && <a class="panel mini-card" href={`/issuer/${primaryOrganization.slug}/`}><h2>{primaryOrganization.name}</h2><p>Primary display relationship · {formatPublicLabel(primaryRelationship?.role)}. Open the organization page for all connected assets and roles.</p></a>}<a class="panel mini-card" href="/events/"><h2>Event history</h2><p>{events.length} event{events.length === 1 ? '' : 's'} connected to this stablecoin.</p></a></section>
  <RelatedGuides guides={relatedGuides} />

  <StablecoinValueStateSections coin={coin} reserveProfile={reserveProfile} redemptionProfile={redemptionProfile} model={model} reserveReports={reserveReports} regulatoryNotes={regulatoryNotes} openQuestions={openQuestions} />

  <section class="panel registry"><div class="bar">Record coverage</div><table data-table-kind="stablecoin-record-coverage" data-mobile-table="scroll-preserve"><thead><tr><th>Section</th><th>Entries</th></tr></thead><tbody>{coverageRows.map((row) => (<tr><td>{row.label}</td><td>{row.count}</td></tr>))}</tbody></table></section>
  <IssuerControlEvents events={issuerControlEvents} />
  <StablecoinEventTimeline events={events} />
  <DeploymentTable deployments={deployments} />
  <section class="panel registry"><div class="bar">Sources</div><EvidenceSourceTable evidence={evidence} tableKind="stablecoin-sources" /></section>
</BaseLayout>
