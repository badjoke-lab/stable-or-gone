---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import MetricCard from './MetricCard.astro';
import TickerBadge from './TickerBadge.astro';
import IssuerControlEvents from './IssuerControlEvents.astro';
import StablecoinEventTimeline from './StablecoinEventTimeline.astro';
import RelatedGuides from './RelatedGuides.astro';
import EvidenceSourceTable from './EvidenceSourceTable.astro';
import DeploymentTable from './DeploymentTable.astro';
import StablecoinValueStateSections from './StablecoinValueStateSections.astro';
import ValueStateText from './ValueStateText.astro';
import StablecoinOrganizationsControl from './StablecoinOrganizationsControl.astro';
import '../styles/stablecoin-dossier.css';
import { formatPublicLabel } from '../utils/displayLabels';
import { formatIssuanceLabel, formatLifecycleLabel, lifecycleChipClass } from '../utils/publicTaxonomy';
import { resolveReferenceTarget } from '../utils/referenceTarget';
import { resolveBackingModel } from '../utils/backingModel';
import { resolveOrganizationTaxonomy } from '../utils/organizationTaxonomy';
import { cleanPublicText } from '../utils/publicText';
import { resolvePrimaryRelationshipForStablecoin } from '../utils/primaryDisplayRelationship';
import { eventPublicCopy } from '../data/eventPublicCopy';
import { getRelatedGuidesForStablecoin } from '../data/stablecoinGuideLinks';
import { getStablecoinPublicSummary } from '../data/stablecoinPublicCopy';
import {
  getOrganizations,
  getRelationships,
  getEvents,
  getEvidence,
  getReserveReports,
  getKnownUnknowns,
  getRegulatoryNotes
} from '../lib/data/registry';
import { getDeploymentsV3, getReserveComponentsFor } from '../lib/data/registryV3';

const modelChangeTerms = new Set<string | undefined>([
  'governance_change', 'migration', 'protocol_model_update', 'protocol_transition',
  'protocol_upgrade', 'rebrand_and_classification_change', 'rebrand_or_lifecycle_transition',
  'reserve_change', 'token_migration'
]);

const { coin } = Astro.props;
const publicSummary = getStablecoinPublicSummary(coin);
const organizations = getOrganizations();
const organizationById = new Map(organizations.map((organization) => [organization.id, organization] as const));
const allRelationships = getRelationships();
const primaryResolution = resolvePrimaryRelationshipForStablecoin(coin.id, allRelationships);
const relationships = primaryResolution.candidates;
const primaryRelationship = primaryResolution.relationship;
const primaryOrganization = primaryRelationship ? organizationById.get(primaryRelationship.organization_id) : undefined;
const primaryOrganizationTaxonomy = primaryOrganization ? resolveOrganizationTaxonomy(primaryOrganization) : null;
const allEvents = getEvents();
const allEvidence = getEvidence();
const allReserveReports = getReserveReports();
const allKnownUnknowns = getKnownUnknowns();
const allRegulatoryNotes = getRegulatoryNotes();
const allDeployments = getDeploymentsV3();

const events = allEvents.filter((item) => item.subject_stablecoin_ids?.includes(coin.id) || item.stablecoin_id === coin.id).sort((a, b) => String(a.event_date ?? '').localeCompare(String(b.event_date ?? '')));
const issuerControlEvents = events.filter((item) => item.event_detail_kind === 'issuer_control' || item.event_type === 'issuer_freeze');
const modelHistoryEvents = events.filter((event) => modelChangeTerms.has(event.event_type) || modelChangeTerms.has(event.event_detail_kind) || /model|collateral|reserve|migration|transition|upgrade|rebrand/i.test(`${event.title ?? ''} ${event.description ?? ''}`));
const evidence = allEvidence.filter((item) => item.stablecoin_ids?.includes(coin.id) || item.stablecoin_id === coin.id);
const reserveReports = allReserveReports.filter((item) => item.stablecoin_id === coin.id);
const reserveComponents = getReserveComponentsFor(coin.id);
const openQuestions = allKnownUnknowns.filter((item) => item.stablecoin_id === coin.id);
const regulatoryNotes = allRegulatoryNotes.filter((item) => item.stablecoin_id === coin.id);
const deployments = allDeployments.filter((item) => item.stablecoin_id === coin.id);
const relatedGuides = getRelatedGuidesForStablecoin(coin.slug);
const statusClass = lifecycleChipClass(coin.lifecycle_status);
const reference = resolveReferenceTarget(coin);
const model = resolveBackingModel(coin);
const assetClass = coin.asset_class ?? 'stablecoin';
const exitModel = coin.redemption_or_exit_model ?? coin.redemption_profile?.status ?? coin.redemption_status ?? 'unknown';
const valuationSource = coin.valuation_source;
const valuationText = valuationSource
  ? valuationSource.label ?? formatPublicLabel(valuationSource.source_type, 'Unknown valuation source')
  : 'Public information is incomplete';
const yieldProfile = coin.yield_or_rebase_profile;
const yieldText = yieldProfile
  ? [formatPublicLabel(yieldProfile.mode), yieldProfile.accrual_target ? `Accrual: ${formatPublicLabel(yieldProfile.accrual_target)}` : null].filter(Boolean).join(' · ')
  : 'None recorded';
const title = `${coin.name} (${coin.symbol ?? coin.slug}) — Stablecoin History | Stable or Gone`;
const description = `${coin.name} lifecycle, issuance, reference target, backing category, canonical backing types, stabilization mechanism, redemption terms, major events, reserve information, and sources.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${coin.name} stablecoin history`,
  url: `https://sog.badjoke-lab.com/stablecoin/${coin.slug}/`,
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  keywords: [coin.name, coin.symbol, coin.lifecycle_status, coin.issuance_status, reference.public_label, reference.comparison_category_label, model.public_label, model.stabilization_label, ...model.canonical_backing_type_labels].filter(Boolean),
  ...(relatedGuides.length > 0 ? {
    subjectOf: relatedGuides.map((guide) => ({ '@type': 'Article', name: guide.title, url: `https://sog.badjoke-lab.com${guide.href}` }))
  } : {})
};
const coverageRows = [
  { label: 'Organizations', count: relationships.length },
  { label: 'Sources', count: evidence.length },
  { label: 'Reserve reports', count: reserveReports.length },
  { label: 'Reserve components', count: reserveComponents.length },
  { label: 'Model-history events', count: modelHistoryEvents.length },
  { label: 'Regulatory notes', count: regulatoryNotes.length },
  { label: 'Deployments', count: deployments.length },
  { label: 'Issuer-control actions', count: issuerControlEvents.length },
  { label: 'Open questions', count: openQuestions.length },
  { label: 'Events', count: events.length }
];
const reserveProfile = coin.reserve_profile;
const redemptionProfile = coin.redemption_profile;
---
<BaseLayout title={title} description={description} canonicalPath={`/stablecoin/${coin.slug}/`} jsonLd={jsonLd}>
  <article class="stablecoin-dossier">
    <PageHero className="stablecoin-dossier-hero" eyebrow="Stablecoin record" title={coin.name} description={publicSummary}>
      <div slot="actions" class="stablecoin-dossier-hero-actions">
        <span class={statusClass}>{formatLifecycleLabel(coin.lifecycle_status)}</span>
        <span class="ui-chip">{formatIssuanceLabel(coin.issuance_status)}</span>
        <a class="ui-button" href="/stablecoins/">Back to registry</a>
      </div>
      <div slot="visual" class="stablecoin-dossier-identity-mark">
        <TickerBadge symbol={coin.symbol ?? coin.name} label={`${coin.name} ticker badge`} size="large" />
        <strong>{coin.symbol ?? 'Symbol not recorded'}</strong>
        <span>{coin.id}</span>
      </div>
    </PageHero>

    <section class="stablecoin-current-state" aria-label="Current reviewed state">
      <MetricCard label="Lifecycle" value={formatLifecycleLabel(coin.lifecycle_status)} detail="Current reviewed lifecycle" icon="L" />
      <MetricCard label="Reference target" value={reference.public_label} detail={reference.reference_kind_label} icon="R" />
      <MetricCard label="Backing model" value={model.public_label} detail={model.stabilization_label} icon="B" />
      <MetricCard label="Issuance" value={formatIssuanceLabel(coin.issuance_status)} detail="Recorded issuance state" icon="I" />
      <MetricCard label="Primary organization" value={primaryOrganization?.name ?? 'Not recorded'} detail={primaryOrganizationTaxonomy?.jurisdiction_label ?? 'Jurisdiction not recorded'} href={primaryOrganization ? `/issuer/${primaryOrganization.slug}/` : undefined} icon="O" />
      <MetricCard label="Last reviewed" value={coin.last_verified_at ?? 'Not recorded'} detail={`${evidence.length} source records · ${events.length} events`} icon="✓" />
    </section>

    <nav class="stablecoin-dossier-nav" aria-label="Stablecoin dossier sections">
      <a href="#identity-current-state">Profile</a><a href="#organizations-control">Organizations</a><a href="#how-it-works">Mechanics</a><a href="#reserves-redemption">Reserves</a><a href="#deployments-legal-context">Deployments</a><a href="#history">History</a><a href="#evidence">Evidence</a><a href="#known-unknowns">Unknowns</a><a href="#more">More</a>
    </nav>

    <section class="ui-panel stablecoin-identity-section" id="identity-current-state">
      <div class="stablecoin-section-heading"><p>Record profile</p><h2>Identity and current state</h2><span>Canonical values and explicit value states</span></div>
      <div class="stablecoin-identity-table"><table data-table-kind="stablecoin-overview" data-mobile-table="scroll-preserve"><caption>Stablecoin identity and current reviewed state</caption><tbody>
        <tr><th>Name</th><td>{coin.name}</td></tr>
        <tr><th>Symbol</th><td><ValueStateText value={coin.symbol} /></td></tr>
        <tr><th>Asset class</th><td>{formatPublicLabel(assetClass, 'Unknown')}</td></tr>
        <tr><th>Lifecycle status</th><td><span class={statusClass}>{formatLifecycleLabel(coin.lifecycle_status)}</span></td></tr>
        <tr><th>Issuance status</th><td>{formatIssuanceLabel(coin.issuance_status)}</td></tr>
        <tr><th>Canonical record ID</th><td><code>{coin.id}</code></td></tr>
        <tr><th>Route slug</th><td><code>{coin.slug}</code></td></tr>
        <tr><th>Record confidence</th><td><ValueStateText value={coin.confidence} displayValue={formatPublicLabel(coin.confidence)} /></td></tr>
        <tr><th>Last reviewed</th><td><ValueStateText value={coin.last_verified_at} /></td></tr>
      </tbody></table></div>
      <dl class="stablecoin-identity-cards" data-mobile-representation-for="stablecoin-overview">
        <div><dt>Name</dt><dd>{coin.name}</dd></div><div><dt>Symbol</dt><dd>{coin.symbol ?? 'Not recorded'}</dd></div><div><dt>Asset class</dt><dd>{formatPublicLabel(assetClass, 'Unknown')}</dd></div><div><dt>Lifecycle status</dt><dd>{formatLifecycleLabel(coin.lifecycle_status)}</dd></div><div><dt>Issuance status</dt><dd>{formatIssuanceLabel(coin.issuance_status)}</dd></div><div><dt>Canonical record ID</dt><dd><code>{coin.id}</code></dd></div><div><dt>Route slug</dt><dd><code>{coin.slug}</code></dd></div><div><dt>Record confidence</dt><dd>{formatPublicLabel(coin.confidence)}</dd></div><div><dt>Last reviewed</dt><dd>{coin.last_verified_at ?? 'Not recorded'}</dd></div>
      </dl>
    </section>

    <StablecoinOrganizationsControl
      coin={coin}
      relationships={relationships}
      primaryResolution={primaryResolution}
      primaryRelationship={primaryRelationship}
      primaryOrganization={primaryOrganization}
      organizations={organizations}
      deployments={deployments}
      issuerControlEvents={issuerControlEvents}
    />

    <section class="ui-panel stablecoin-preview-section" id="how-it-works">
      <div class="stablecoin-section-heading"><p>Mechanics</p><h2>How the asset works</h2><span>Reference, backing, stabilization, exit, valuation, and yield fields remain separate.</span></div>
      <dl class="stablecoin-preview-grid">
        <div><dt>Reference target</dt><dd>{reference.public_label}</dd></div><div><dt>Reference kind</dt><dd>{reference.reference_kind_label}</dd></div><div><dt>Comparison category</dt><dd>{reference.comparison_category_label}</dd></div><div><dt>Target value</dt><dd><ValueStateText value={reference.target_value} /></dd></div><div><dt>Reference methodology</dt><dd><ValueStateText value={reference.methodology_description} displayValue={reference.methodology_description} detectMarkers={false} /></dd></div><div><dt>Public backing model</dt><dd>{model.public_label}</dd></div><div><dt>Canonical backing types</dt><dd>{model.canonical_backing_type_labels.join(', ') || 'Not recorded'}</dd></div><div><dt>Reserve component categories</dt><dd>{reserveComponents.map((component) => formatPublicLabel(component.asset_category)).join(', ') || 'Not recorded'}</dd></div><div><dt>Primary stabilization mechanism</dt><dd>{model.stabilization_label}</dd></div><div><dt>Recorded model description</dt><dd>{model.recorded_model_description ?? 'Not recorded'}</dd></div><div><dt>Redemption / exit model</dt><dd>{formatPublicLabel(exitModel, 'Unknown')}</dd></div><div><dt>Valuation source</dt><dd>{valuationSource?.url ? <a href={valuationSource.url}>{valuationText}</a> : valuationText}</dd></div><div><dt>Yield / rebase profile</dt><dd>{yieldText}</dd></div><div><dt>Classification notes</dt><dd>{coin.classification_notes ?? 'Not recorded'}</dd></div>
      </dl>
    </section>

    <section class="ui-panel registry stablecoin-reserve-components" id="reserves-redemption"><div class="stablecoin-section-heading"><p>Backing detail</p><h2>Reserve components</h2><span>Recorded components only; missing shares and dates remain explicit.</span></div>{reserveComponents.length === 0 ? <p class="stablecoin-empty-state">No reserve components have been recorded.</p> : <ul>{reserveComponents.map((component) => <li><strong>{component.asset_label ?? formatPublicLabel(component.asset_category)}</strong> — <ValueStateText value={component.asset_category} displayValue={formatPublicLabel(component.asset_category)} />{component.share_percent !== null && component.share_percent !== undefined ? ` · ${component.share_percent}%` : ''}{component.liquidity_class ? ` · liquidity ${formatPublicLabel(component.liquidity_class)}` : ''}{component.maturity_bucket ? ` · maturity ${formatPublicLabel(component.maturity_bucket)}` : ''}{component.as_of_date ? ` · as of ${component.as_of_date}` : ''}{component.notes ? ` · ${cleanPublicText(component.notes)}` : ''}</li>)}</ul>}</section>

    <div class="stablecoin-value-state-group"><StablecoinValueStateSections coin={coin} reserveProfile={reserveProfile} redemptionProfile={redemptionProfile} model={model} reserveReports={reserveReports} regulatoryNotes={regulatoryNotes} openQuestions={openQuestions} /></div>

    <div id="deployments-legal-context" class="stablecoin-deployment-group"><DeploymentTable deployments={deployments} /></div>

    <section class="ui-panel registry stablecoin-model-history" id="history"><div class="stablecoin-section-heading"><p>Historical changes</p><h2>Model and lifecycle changes</h2><span>Current classification remains separate from dated historical events.</span></div>{modelHistoryEvents.length === 0 ? <p class="stablecoin-empty-state">No separate model-change event is currently recorded.</p> : <ul>{modelHistoryEvents.map((event) => <li><ValueStateText value={event.event_date} /> — <a href={`/event/${event.id}/`}>{eventPublicCopy[event.id]?.title ?? event.title}</a> · {formatPublicLabel(event.event_detail_kind ?? event.event_type)}</li>)}</ul>}</section>

    <IssuerControlEvents events={issuerControlEvents} />
    <StablecoinEventTimeline events={events} />

    <section class="ui-panel registry stablecoin-evidence-section" id="evidence"><div class="stablecoin-section-heading"><p>Source record</p><h2>Evidence</h2><span>Publisher, provenance, supported claims, archive state, reliability, and publication date remain separate.</span></div><EvidenceSourceTable evidence={evidence} tableKind="stablecoin-sources" /></section>

    <section class="ui-panel registry stablecoin-coverage-section"><div class="stablecoin-section-heading"><p>Coverage</p><h2>Record coverage</h2><span>Entry counts describe coverage, not quality.</span></div><table data-table-kind="stablecoin-record-coverage" data-mobile-table="scroll-preserve"><thead><tr><th>Section</th><th>Entries</th></tr></thead><tbody>{coverageRows.map((row) => (<tr><td>{row.label}</td><td>{row.count}</td></tr>))}</tbody></table></section>

    <div id="more" class="stablecoin-more-group">
      <RelatedGuides guides={relatedGuides} />
      <section class="stablecoin-further-reading" aria-label="Corrections and further reading">
        <a class="ui-panel" href="/stablecoins/"><h2>All stablecoins</h2><p>Compare this record with the rest of the archive.</p></a>
        {primaryOrganization && <a class="ui-panel" href={`/issuer/${primaryOrganization.slug}/`}><h2>{primaryOrganization.name}</h2><p>Open the organization page for all connected assets and roles.</p></a>}
        <a class="ui-panel" href="/events/"><h2>Event registry</h2><p>{events.length} connected event{events.length === 1 ? '' : 's'} are recorded.</p></a>
        <a class="ui-panel" href="/methodology/"><h2>Methodology</h2><p>Read classification, evidence, and value-state rules.</p></a>
        <a class="ui-panel" href="/contact/"><h2>Corrections</h2><p>Report a source, relationship, or record problem.</p></a>
        <a class="ui-panel" href="/data/manifest.json"><h2>Data manifest</h2><p>Inspect the machine-readable public layer.</p></a>
      </section>
    </div>
  </article>
</BaseLayout>
