---
import BaseLayout from '../layouts/BaseLayout.astro';
import StableAssetClassificationRows from './StableAssetClassificationRows.astro';
import IssuerControlEvents from './IssuerControlEvents.astro';
import RelatedGuides from './RelatedGuides.astro';
import { formatPublicLabel } from '../utils/displayLabels';
import { formatIssuanceLabel, formatLifecycleLabel, lifecycleChipClass } from '../utils/publicTaxonomy';
import { resolveReferenceTarget } from '../utils/referenceTarget';
import { cleanPublicText } from '../utils/publicText';
import { eventPublicCopy } from '../data/eventPublicCopy';
import { getRelatedGuidesForStablecoin } from '../data/stablecoinGuideLinks';
import {
  getOrganizations,
  getRelationships,
  getEvents,
  getEvidence,
  getReserveReports,
  getKnownUnknowns,
  getRegulatoryNotes,
  getDeployments
} from '../lib/data/registry';

const publicSummaries: Record<string, string> = {
  usdt: 'A US dollar-pegged stablecoin issued by Tether across multiple blockchains. Its record includes reserves, redemption, regulation, deployments, and documented exercises of issuer-controlled blacklist or freeze authority.',
  usdc: 'A US dollar-pegged stablecoin issued by Circle, supported by reserve reports, institutional redemption through Circle Mint, and a documented recovery from the March 2023 depeg.',
  dai: 'A decentralized, multi-collateral stablecoin created through MakerDAO and now connected to the wider Sky ecosystem.',
  ust: 'An algorithmic stablecoin from the Terra ecosystem that collapsed in May 2022 and did not recover its original function.',
  busd: 'A Paxos-issued US dollar stablecoin branded with Binance that entered wind-down after new issuance stopped in 2023.',
  frax: 'A stablecoin from the Frax ecosystem that has used a mix of collateral, protocol mechanisms, and market operations over time.',
  tusd: 'A US dollar stablecoin associated with TrueUSD, with issuer redemption, attestation, and multi-chain history.',
  fdusd: 'A US dollar stablecoin issued by First Digital, with issuer redemption limited to eligible clients and broad exchange use.',
  pyusd: 'A US dollar stablecoin launched by PayPal and issued by Paxos, available through PayPal and selected blockchain networks.',
  usdd: 'A US dollar-pegged stablecoin associated with TRON DAO Reserve, using crypto reserves and protocol-based stabilization mechanisms.',
  gusd: 'A US dollar-backed stablecoin issued by Gemini, with direct redemption through eligible Gemini accounts.',
  lusd: 'A crypto-collateralized stablecoin from Liquity V1, distinct from the BOLD stablecoin introduced with Liquity V2.',
  crvusd: 'A crypto-collateralized stablecoin from Curve Finance that uses LLAMMA-based lending and liquidation mechanics.',
  usde: 'A synthetic dollar from Ethena that uses hedged crypto positions and related reserve assets rather than a simple fiat reserve model.',
  susd: 'A synthetic dollar from the Synthetix ecosystem, whose role has changed across Synthetix V2 and V3.',
  rlusd: 'A US dollar stablecoin launched by Ripple, with issuer reserve and redemption arrangements tied to Ripple and its service providers.',
  eurc: 'A euro-backed stablecoin issued by Circle, with reserve reporting and direct institutional redemption under Circle terms.',
  usdp: 'A US dollar stablecoin issued by Paxos, supported by issuer reserve reports and redemption through eligible Paxos accounts.',
  usdg: 'A US dollar stablecoin connected to the Global Dollar Network and issued through Paxos-related arrangements.',
  usds: 'A US dollar stablecoin in the Sky ecosystem, introduced alongside the transition from MakerDAO branding and products.'
};

const { coin } = Astro.props;
const organizations = getOrganizations();
const organizationById = new Map(organizations.map((organization) => [organization.id, organization] as const));
const relationships = getRelationships().filter((relationship) => relationship.stablecoin_id === coin.id);
const allEvents = getEvents();
const allEvidence = getEvidence();
const allReserveReports = getReserveReports();
const allKnownUnknowns = getKnownUnknowns();
const allRegulatoryNotes = getRegulatoryNotes();
const allDeployments = getDeployments();

const primaryRelationship = relationships[0];
const primaryOrganization = primaryRelationship ? organizationById.get(primaryRelationship.organization_id) : undefined;
const events = allEvents.filter((item) => item.subject_stablecoin_ids?.includes(coin.id) || item.stablecoin_id === coin.id).sort((a, b) => String(a.event_date ?? '').localeCompare(String(b.event_date ?? '')));
const issuerControlEvents = events.filter((item) => item.event_detail_kind === 'issuer_control' || item.event_type === 'issuer_freeze');
const evidence = allEvidence.filter((item) => item.stablecoin_ids?.includes(coin.id) || item.stablecoin_id === coin.id);
const reserveReports = allReserveReports.filter((item) => item.stablecoin_id === coin.id);
const openQuestions = allKnownUnknowns.filter((item) => item.stablecoin_id === coin.id);
const regulatoryNotes = allRegulatoryNotes.filter((item) => item.stablecoin_id === coin.id);
const deployments = allDeployments.filter((item) => item.stablecoin_id === coin.id);
const relatedGuides = getRelatedGuidesForStablecoin(coin.slug);
const statusClass = lifecycleChipClass(coin.lifecycle_status);
const reference = resolveReferenceTarget(coin);
const title = `${coin.name} (${coin.symbol ?? coin.slug}) — Stablecoin History | Stable or Gone`;
const description = `${coin.name} lifecycle, issuance, reference target, organization relationships, backing model, redemption terms, major events, reserve information, and sources.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${coin.name} stablecoin history`,
  url: `https://sog.badjoke-lab.com/stablecoin/${coin.slug}/`,
  description,
  isPartOf: { '@type': 'WebSite', name: 'Stable or Gone', url: 'https://sog.badjoke-lab.com/' },
  keywords: [coin.name, coin.symbol, coin.lifecycle_status, coin.issuance_status, reference.public_label, reference.comparison_category_label, ...(coin.backing_types ?? [coin.collateral_model])].filter(Boolean),
  ...(relatedGuides.length > 0 ? {
    subjectOf: relatedGuides.map((guide) => ({
      '@type': 'Article',
      name: guide.title,
      url: `https://sog.badjoke-lab.com${guide.href}`
    }))
  } : {})
};
const coverageRows = [
  { label: 'Organizations', count: relationships.length },
  { label: 'Sources', count: evidence.length },
  { label: 'Reserve reports', count: reserveReports.length },
  { label: 'Regulatory notes', count: regulatoryNotes.length },
  { label: 'Deployments', count: deployments.length },
  { label: 'Issuer-control actions', count: issuerControlEvents.length },
  { label: 'Open questions', count: openQuestions.length },
  { label: 'Events', count: events.length }
];
const backingTypes = coin.backing_types?.map((item: string) => formatPublicLabel(item)).join(', ') ?? formatPublicLabel(coin.collateral_model);
const reserveProfile = coin.reserve_profile;
const redemptionProfile = coin.redemption_profile;
---
<BaseLayout title={title} description={description} canonicalPath={`/stablecoin/${coin.slug}/`} jsonLd={jsonLd}>
  <section class="hero"><div class="panel hero-main"><div class="prompt">Stablecoin record</div><h1>{coin.name}</h1><p>{publicSummaries[coin.slug] ?? cleanPublicText(coin.summary, 'A summary has not yet been added for this stablecoin.')}</p></div><div class="panel stats"><div class="stat"><span>Lifecycle</span><strong>{formatLifecycleLabel(coin.lifecycle_status)}</strong></div><div class="stat"><span>Issuance</span><strong>{formatIssuanceLabel(coin.issuance_status)}</strong></div><div class="stat"><span>Events</span><strong>{events.length}</strong></div><div class="stat"><span>Sources</span><strong>{evidence.length}</strong></div></div></section>

  <section class="panel registry"><div class="bar">Overview</div><table data-table-kind="stablecoin-overview" data-mobile-table="scroll-preserve"><tbody>
    <tr><th>Symbol</th><td>{coin.symbol ?? '—'}</td></tr>
    <StableAssetClassificationRows coin={coin} />
    <tr><th>Lifecycle status</th><td><span class={statusClass}>{formatLifecycleLabel(coin.lifecycle_status)}</span></td></tr>
    <tr><th>Issuance status</th><td>{formatIssuanceLabel(coin.issuance_status)}</td></tr>
    <tr><th>Reference target</th><td>{reference.public_label}</td></tr>
    <tr><th>Reference kind</th><td>{reference.reference_kind_label}</td></tr>
    <tr><th>Comparison category</th><td>{reference.comparison_category_label}</td></tr>
    <tr><th>Target value</th><td>{reference.target_value ?? 'Defined by the recorded methodology'}</td></tr>
    <tr><th>Reference methodology</th><td>{reference.methodology_description ?? 'No methodology description has been recorded.'}</td></tr>
    <tr><th>Backing types</th><td>{backingTypes}</td></tr>
    <tr><th>Stabilization</th><td>{formatPublicLabel(coin.stabilization_mechanism, 'Unknown')}</td></tr>
    <tr><th>Governance</th><td>{formatPublicLabel(coin.governance_model, 'Unknown')}</td></tr>
    <tr><th>Primary organization</th><td>{primaryOrganization ? <a href={`/issuer/${primaryOrganization.slug}/`}>{primaryOrganization.name}</a> : 'Unknown'}</td></tr>
    <tr><th>Primary role</th><td>{formatPublicLabel(primaryRelationship?.role, 'Unknown')}</td></tr>
    <tr><th>Last reviewed</th><td>{coin.last_verified_at ?? '—'}</td></tr>
  </tbody></table></section>

  <section class="panel registry"><div class="bar">Organizations and roles</div><table data-table-kind="stablecoin-organizations" data-mobile-table="scroll-preserve"><thead><tr><th>Organization</th><th>Role</th><th>From</th><th>Until</th><th>Relationship status</th></tr></thead><tbody>{relationships.length === 0 ? <tr><td colspan="5">No organization relationships have been added yet.</td></tr> : relationships.map((relationship) => { const organization = organizationById.get(relationship.organization_id); return <tr><td>{organization ? <a href={`/issuer/${organization.slug}/`}>{organization.name}</a> : relationship.organization_id}</td><td>{formatPublicLabel(relationship.role)}</td><td>{relationship.start_date ?? '—'}</td><td>{relationship.end_date ?? '—'}</td><td>{formatPublicLabel(relationship.status)}</td></tr>; })}</tbody></table></section>

  <section class="section-grid" aria-label="Related pages"><a class="panel mini-card" href="/stablecoins/"><h2>All stablecoins</h2><p>Compare this record with the rest of the archive.</p></a>{primaryOrganization && <a class="panel mini-card" href={`/issuer/${primaryOrganization.slug}/`}><h2>{primaryOrganization.name}</h2><p>{formatPublicLabel(primaryOrganization.organization_type, 'Organization')} · {formatPublicLabel(primaryOrganization.jurisdiction, 'Jurisdiction unknown')}</p></a>}<a class="panel mini-card" href="/events/"><h2>Event history</h2><p>{events.length} event{events.length === 1 ? '' : 's'} connected to this stablecoin.</p></a></section>
  <RelatedGuides guides={relatedGuides} />

  <section class="panel registry"><div class="bar">Reserve profile</div><table data-table-kind="stablecoin-reserve-profile" data-mobile-table="scroll-preserve"><tbody><tr><th>Disclosure status</th><td>{formatPublicLabel(reserveProfile?.disclosure_status ?? coin.reserve_disclosure_status, 'Public information is incomplete')}</td></tr><tr><th>Backing types</th><td>{reserveProfile?.backing_types?.map((item: string) => formatPublicLabel(item)).join(', ') ?? backingTypes}</td></tr><tr><th>Summary</th><td>{cleanPublicText(reserveProfile?.summary, 'Public information is incomplete.')}</td></tr><tr><th>As of</th><td>{reserveProfile?.as_of_date ?? '—'}</td></tr><tr><th>Profile confidence</th><td>{formatPublicLabel(reserveProfile?.confidence, 'Unknown')}</td></tr></tbody></table></section>

  <section class="panel registry"><div class="bar">Redemption profile</div><table data-table-kind="stablecoin-redemption-profile" data-mobile-table="scroll-preserve"><tbody><tr><th>Current status</th><td>{formatPublicLabel(redemptionProfile?.status ?? coin.redemption_status, 'Public information is incomplete')}</td></tr><tr><th>Settlement asset</th><td>{formatPublicLabel(redemptionProfile?.settlement_asset, 'Public information is incomplete')}</td></tr><tr><th>Eligible parties</th><td>{cleanPublicText(redemptionProfile?.eligible_parties ?? coin.who_can_redeem, 'Public information is incomplete.')}</td></tr><tr><th>Retail access</th><td>{formatPublicLabel(redemptionProfile?.retail_access ?? coin.retail_redemption, 'Public information is incomplete')}</td></tr><tr><th>Institutional access</th><td>{formatPublicLabel(redemptionProfile?.institutional_access ?? coin.institutional_redemption, 'Public information is incomplete')}</td></tr><tr><th>Minimum amount</th><td>{formatPublicLabel(redemptionProfile?.minimum_amount_text ?? coin.minimum_redemption, 'Public information is incomplete')}</td></tr><tr><th>Fee</th><td>{formatPublicLabel(redemptionProfile?.fee_text, 'Public information is incomplete')}</td></tr><tr><th>Settlement time</th><td>{formatPublicLabel(redemptionProfile?.settlement_time_text, 'Public information is incomplete')}</td></tr><tr><th>Regional limits</th><td>{redemptionProfile?.jurisdiction_restrictions?.map((item: string) => formatPublicLabel(item)).join(', ') ?? cleanPublicText(coin.redemption_region_notes, 'Public information is incomplete.')}</td></tr></tbody></table></section>

  <section class="panel registry"><div class="bar">Record coverage</div><table data-table-kind="stablecoin-record-coverage" data-mobile-table="scroll-preserve"><thead><tr><th>Section</th><th>Entries</th></tr></thead><tbody>{coverageRows.map((row) => (<tr><td>{row.label}</td><td>{row.count}</td></tr>))}</tbody></table></section>
  <IssuerControlEvents events={issuerControlEvents} />
  <section class="panel registry"><div class="bar">Event timeline</div><table data-table-kind="stablecoin-event-timeline" data-mobile-table="scroll-preserve"><thead><tr><th>Date</th><th>Event</th><th>Type</th><th>Detail kind</th><th>Recovered</th></tr></thead><tbody>{events.length === 0 ? <tr><td colspan="5">No events have been added yet.</td></tr> : events.map((event) => (<tr><td>{event.event_date ?? '—'}</td><td><a href={`/event/${event.id}/`}>{eventPublicCopy[event.id]?.title ?? event.title}</a></td><td>{formatPublicLabel(event.event_type)}</td><td>{formatPublicLabel(event.event_detail_kind)}</td><td>{event.depeg_detail?.recovery_status ? formatPublicLabel(event.depeg_detail.recovery_status) : event.recovered === true ? 'Yes' : event.recovered === false ? 'No' : '—'}</td></tr>))}</tbody></table></section>
  <section class="panel registry"><div class="bar">Reserve and attestation history</div><table data-table-kind="stablecoin-reserve-history" data-mobile-table="scroll-preserve"><thead><tr><th>Date</th><th>Publisher</th><th>Type</th><th>Assets covered</th><th>Record confidence</th></tr></thead><tbody>{reserveReports.length === 0 ? <tr><td colspan="5">No reserve reports have been added yet.</td></tr> : reserveReports.map((report) => (<tr><td>{report.report_date ?? '—'}</td><td>{report.url ? <a href={report.url}>{report.publisher ?? 'Source'}</a> : (report.publisher ?? '—')}</td><td>{formatPublicLabel(report.report_type)}</td><td>{report.asset_categories?.map((item) => formatPublicLabel(item)).join(', ') ?? '—'}</td><td>{formatPublicLabel(report.confidence)}</td></tr>))}</tbody></table></section>
  <section class="panel registry"><div class="bar">Regulatory and official notices</div><table data-table-kind="stablecoin-regulatory-notices" data-mobile-table="scroll-preserve"><thead><tr><th>Date</th><th>Title</th><th>Authority / publisher</th><th>Type</th><th>Summary</th></tr></thead><tbody>{regulatoryNotes.length === 0 ? <tr><td colspan="5">No regulatory notes have been added yet.</td></tr> : regulatoryNotes.map((note) => (<tr><td>{note.note_date ?? '—'}</td><td><a href={note.source_url}>{note.title}</a></td><td>{note.authority_or_source ?? '—'}</td><td>{formatPublicLabel(note.note_type)}</td><td>{cleanPublicText(note.summary)}</td></tr>))}</tbody></table></section>
  <section class="panel registry"><div class="bar">Blockchain deployments</div><table data-table-kind="stablecoin-deployments" data-mobile-table="scroll-preserve"><thead><tr><th>Chain</th><th>Standard</th><th>Deployment</th><th>Status</th><th>Freeze</th><th>Blacklist</th><th>Control events</th><th>Contract</th><th>Notes</th></tr></thead><tbody>{deployments.length === 0 ? <tr><td colspan="9">No deployment records have been added yet.</td></tr> : deployments.map((deployment) => (<tr><td>{deployment.chain}</td><td>{deployment.token_standard ?? '—'}</td><td>{formatPublicLabel(deployment.deployment_type)}</td><td>{formatPublicLabel(deployment.status)}</td><td>{deployment.freeze_capability === true ? 'Yes' : deployment.freeze_capability === false ? 'No' : 'Unknown'}</td><td>{deployment.blacklist_capability === true ? 'Yes' : deployment.blacklist_capability === false ? 'No' : 'Unknown'}</td><td>{deployment.control_event_ids?.length ?? 0}</td><td>{deployment.contract_address ?? 'Not yet verified'}</td><td>{cleanPublicText(deployment.notes)}</td></tr>))}</tbody></table></section>
  <section class="panel registry"><div class="bar">Sources</div><table data-table-kind="stablecoin-sources" data-mobile-table="scroll-preserve"><thead><tr><th>Source</th><th>Publisher</th><th>Type</th><th>Evidence scope</th><th>Reliability</th></tr></thead><tbody>{evidence.length === 0 ? <tr><td colspan="5">No sources have been added yet.</td></tr> : evidence.map((source) => (<tr><td><a href={source.url}>{source.title}</a></td><td>{source.publisher ?? '—'}</td><td>{formatPublicLabel(source.source_type)}</td><td>{source.claim_scopes?.map((item) => formatPublicLabel(item)).join(', ') ?? formatPublicLabel(source.claim_scope)}</td><td>{formatPublicLabel(source.reliability)}</td></tr>))}</tbody></table></section>
  <section class="panel registry"><div class="bar">Open questions</div><table data-table-kind="stablecoin-open-questions" data-mobile-table="scroll-preserve"><thead><tr><th>Topic</th><th>What remains unclear</th><th>Priority</th><th>Last checked</th></tr></thead><tbody>{openQuestions.length === 0 ? <tr><td colspan="4">No open questions are currently listed.</td></tr> : openQuestions.map((item) => (<tr><td>{formatPublicLabel(item.topic)}</td><td>{cleanPublicText(item.description)}</td><td>{formatPublicLabel(item.severity)}</td><td>{item.last_checked_at ?? '—'}</td></tr>))}</tbody></table></section>
</BaseLayout>
