---
import { guideLatestUpdates } from '../data/guideLatestUpdates';
interface Props {
  category: string;
  title: string;
  description: string;
  publishedAt: string | null;
  informationCurrentThrough: string;
  updatedAt: string | null;
}
const { category, title, description, publishedAt, informationCurrentThrough, updatedAt } = Astro.props;
const latestUpdate = guideLatestUpdates[title];
---
<header class="guide-article-masthead">
  <div class="guide-article-overline"><span>Guides / {category}</span><a href="/guides/">Return to guide archive</a></div>
  <h1>{title}</h1>
  <p class="guide-article-deck">{description}</p>
  <dl class="guide-article-meta" aria-label="Guide publication information">
    <div><dt>Published</dt><dd>{publishedAt ?? 'Publication date not recorded'}</dd></div>
    <div><dt>Information current through</dt><dd>{informationCurrentThrough}</dd></div>
    <div><dt>Last updated</dt><dd>{updatedAt ?? publishedAt ?? 'Not recorded'}</dd></div>
  </dl>
  {latestUpdate && (
    <aside class="guide-article-update" aria-label="Latest reviewed update">
      <div class="guide-article-overline"><span>{latestUpdate.title}</span><a href={latestUpdate.sourceUrl}>Source</a></div>
      <p class="guide-article-deck">{latestUpdate.body}</p>
    </aside>
  )}
</header>
<script>
  const buildGuideMobileTables = () => {
    const article = document.querySelector('[data-guide-article]');
    if (!(article instanceof HTMLElement) || article.dataset.mobileTablesBuilt === 'true') return;
    article.dataset.mobileTablesBuilt = 'true';

    article.querySelectorAll<HTMLTableElement>('.guide-article-content table').forEach((table, tableIndex) => {
      if (table.dataset.mobileTableBuilt === 'true') return;
      table.dataset.mobileTableBuilt = 'true';
      table.dataset.mobileTable = 'guide-records';

      const headers = Array.from(table.querySelectorAll<HTMLTableCellElement>('thead th, thead td'))
        .map((cell) => cell.textContent?.trim() || '');
      const bodyRows = Array.from(table.querySelectorAll<HTMLTableRowElement>('tbody tr'));
      const fallbackRows = bodyRows.length > 0 ? bodyRows : Array.from(table.querySelectorAll<HTMLTableRowElement>('tr')).filter((row) => !row.closest('thead'));
      const list = document.createElement('div');
      const representationId = `guide-table-${tableIndex + 1}`;
      list.className = 'mobile-record-list guide-mobile-table-records';
      list.dataset.mobileRepresentationFor = representationId;
      list.setAttribute('aria-label', table.caption?.textContent?.trim() || `Guide table ${tableIndex + 1}`);

      fallbackRows.forEach((row) => {
        const cells = Array.from(row.children).filter((cell): cell is HTMLTableCellElement => cell instanceof HTMLTableCellElement);
        if (cells.length === 0) return;
        const record = document.createElement('article');
        record.className = 'mobile-table-record';
        const definitions = document.createElement('dl');

        cells.forEach((cell, cellIndex) => {
          const pair = document.createElement('div');
          const term = document.createElement('dt');
          const definition = document.createElement('dd');
          const firstCellIsHeading = cells[0]?.tagName === 'TH';
          term.textContent = headers[cellIndex]
            || (cell.tagName === 'TH' ? 'Item' : firstCellIsHeading && cellIndex === 1 ? 'Details' : `Field ${cellIndex + 1}`);
          definition.append(...Array.from(cell.childNodes).map((node) => node.cloneNode(true)));
          pair.append(term, definition);
          definitions.append(pair);
        });

        record.append(definitions);
        list.append(record);
      });

      if (list.children.length > 0) table.insertAdjacentElement('afterend', list);
    });
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', buildGuideMobileTables, { once: true });
  else buildGuideMobileTables();
</script>
