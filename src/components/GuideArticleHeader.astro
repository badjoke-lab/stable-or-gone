---
interface Props {
  category: string;
  title: string;
  description: string;
  publishedAt: string | null;
  informationCurrentThrough: string;
  updatedAt: string | null;
}

const {
  category,
  title,
  description,
  publishedAt,
  informationCurrentThrough,
  updatedAt
} = Astro.props;
---
<section class="hero">
  <div class="panel hero-main">
    <div class="prompt">Guides / {category}</div>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>

<section class="panel registry" aria-label="Guide publication information">
  <div class="bar">Publication information</div>
  <table>
    <tbody>
      <tr>
        <th>Published</th>
        <td>{publishedAt ?? 'Pending production publication'}</td>
      </tr>
      <tr>
        <th>Information current through</th>
        <td>{informationCurrentThrough}</td>
      </tr>
      {updatedAt && (
        <tr>
          <th>Last updated</th>
          <td>{updatedAt}</td>
        </tr>
      )}
    </tbody>
  </table>
</section>
