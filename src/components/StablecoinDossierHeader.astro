---
import StablecoinMark from './StablecoinMark.astro';
import ValueStateText from './ValueStateText.astro';
import { formatPublicLabel } from '../utils/displayLabels';
import { formatIssuanceLabel, formatLifecycleLabel } from '../utils/publicTaxonomy';

const {
  coin,
  aliases,
  statusClass,
  reference,
  primaryOrganization,
  additionalRelationshipCount,
  exitModel,
  model,
  evidenceCount,
  latestMaterialEvent,
  latestMaterialEventTitle,
  latestMaterialEventSummary
} = Astro.props;
---
<header class="stablecoin-dossier-masthead">
  <div class="stablecoin-dossier-overline">
    <span>Stablecoin dossier</span>
    <a href="/stablecoins/">Return to register</a>
  </div>

  <div class="stablecoin-dossier-title-row">
    <div class="stablecoin-dossier-heading-identity">
      <StablecoinMark slug={coin.slug} symbol={coin.symbol ?? coin.name} name={coin.name} size="large" />
      <div>
        <p class="stablecoin-record-id">Record <code>{coin.id}</code></p>
        <h1><span>{coin.symbol ?? '—'}</span><i aria-hidden="true">/</i><wbr />{coin.name}</h1>
        <p class="stablecoin-aliases">
          {aliases.length > 0 ? <>Also recorded as {aliases.join(', ')}</> : 'No additional aliases are recorded.'}
        </p>
      </div>
    </div>
    <span class={statusClass}>{formatLifecycleLabel(coin.lifecycle_status)}</span>
  </div>

  <dl class="stablecoin-dossier-facts" aria-label="Current reviewed stablecoin facts">
    <div><dt>Lifecycle</dt><dd>{formatLifecycleLabel(coin.lifecycle_status)}</dd></div>
    <div><dt>Issuance</dt><dd>{formatIssuanceLabel(coin.issuance_status)}</dd></div>
    <div><dt>Reference target</dt><dd>{reference.public_label}</dd></div>
    <div>
      <dt>Primary organization</dt>
      <dd>
        {primaryOrganization ? <a href={`/issuer/${primaryOrganization.slug}/`}>{primaryOrganization.name}</a> : 'Not recorded'}
        <br />
        <small>{additionalRelationshipCount > 0 ? `${additionalRelationshipCount} additional relationship${additionalRelationshipCount === 1 ? '' : 's'}` : 'No additional recorded relationship'}</small>
      </dd>
    </div>
    <div><dt>Launch</dt><dd><ValueStateText value={coin.launch_date} /></dd></div>
    <div><dt>Redemption</dt><dd>{formatPublicLabel(exitModel, 'Unknown')}</dd></div>
    <div><dt>Backing</dt><dd>{model.public_label}</dd></div>
    <div><dt>Stabilization</dt><dd>{model.stabilization_label}</dd></div>
    <div><dt>Last review</dt><dd><ValueStateText value={coin.last_verified_at} /></dd></div>
    <div><dt>Evidence</dt><dd><a href="#evidence">{evidenceCount} source record{evidenceCount === 1 ? '' : 's'}</a></dd></div>
  </dl>

  <aside class="stablecoin-material-change" aria-label="Latest material change">
    <span class="record-kicker">Latest material change</span>
    {latestMaterialEvent ? (
      <div>
        <time datetime={latestMaterialEvent.event_date ?? undefined}>{latestMaterialEvent.event_date}</time>
        <p><a href={`/event/${latestMaterialEvent.id}/`}>{latestMaterialEventTitle}</a></p>
        {latestMaterialEventSummary && <small>{latestMaterialEventSummary}</small>}
      </div>
    ) : <p>No dated material event is currently recorded.</p>}
  </aside>
</header>
