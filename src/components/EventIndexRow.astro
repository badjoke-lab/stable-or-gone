---
const { record } = Astro.props as { record: { search: string; title: string; category: string; subtype: string; statusEffect: string; recovery: string; year: string; eventDate: string; sourceIdentityCount: number; id: string; categoryLabel: string; subtypeLabel: string; impactLabel: string; statusEffectLabel: string; recoveryLabel: string } };
const data = {
  'data-search': record.search,
  'data-title': record.title.toLocaleLowerCase(),
  'data-category': record.category,
  'data-subtype': record.subtype,
  'data-status-effect': record.statusEffect,
  'data-recovery': record.recovery,
  'data-year': record.year,
  'data-event-date': record.eventDate,
  'data-evidence-count': String(record.sourceIdentityCount)
};
---
<tr data-event-row {...data}>
  <td>{record.eventDate || 'Not recorded'}</td>
  <td><a class="record-name" href={`/event/${record.id}/`}>{record.title}</a><small>{record.categoryLabel}</small></td>
  <td>{record.subtypeLabel}</td>
  <td>{record.impactLabel}<small>{record.statusEffectLabel}</small></td>
  <td>{record.recoveryLabel}</td>
  <td>{record.sourceIdentityCount} source{record.sourceIdentityCount === 1 ? '' : 's'}</td>
</tr>
