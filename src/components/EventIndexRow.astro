---
const { record, initiallyVisible = true } = Astro.props as { record: { search: string; title: string; category: string; subtype: string; statusEffect: string; recovery: string; year: string; eventDate: string; sourceIdentityCount: number; id: string; categoryLabel: string; subtypeLabel: string; impactLabel: string; statusEffectLabel: string; recoveryLabel: string; subjectNames: string[] }; initiallyVisible?: boolean };
const data = {
  'data-record-id': record.id,
  'data-search': record.search,
  'data-title': record.title.toLocaleLowerCase(),
  'data-category': record.category,
  'data-subtype': record.subtype,
  'data-status-effect': record.statusEffect,
  'data-recovery': record.recovery,
  'data-year': record.year,
  'data-event-date': record.eventDate,
  'data-evidence-count': String(record.sourceIdentityCount)
};
---
<tr data-event-row hidden={initiallyVisible ? undefined : true} {...data}>
  <td><time datetime={record.eventDate || undefined}>{record.eventDate || 'Not recorded'}</time></td>
  <td><strong class="event-impact-label">{record.impactLabel}</strong></td>
  <td><a class="record-name" href={`/event/${record.id}/`}>{record.title}</a><small>{record.subtypeLabel}</small></td>
  <td>{record.subjectNames.join(', ') || 'Not recorded'}<small>{record.categoryLabel}</small></td>
  <td>{record.statusEffectLabel}<small>{record.recoveryLabel}</small></td>
</tr>
