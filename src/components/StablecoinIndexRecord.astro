---
import { formatIssuanceLabel, formatLifecycleLabel, lifecycleChipClass } from '../utils/publicTaxonomy';

type IndexRecord = {
  id: string;
  slug: string;
  name: string;
  symbol: string;
  search: string;
  lifecycle: string;
  issuance: string;
  assetClass: string;
  assetClassLabel: string;
  referenceCategory: string;
  referenceLabel: string;
  backingCategory: string;
  backingLabel: string;
  stabilization: string;
  stabilizationLabel: string;
  launchDate: string;
  primaryOrganizationName: string;
  primaryOrganizationSlug: string;
  primaryRoleLabel: string;
  relationshipCount: number;
  organizationCount: number;
  organizationSummary: string;
  reserveSummary: string;
  redemptionSummary: string;
  deploymentCount: number;
  eventCount: number;
  sourceIdentityCount: number;
  evidenceRelationCount: number;
  knownUnknownCount: number;
};

const { record } = Astro.props as { record: IndexRecord };
const data = {
  'data-record-slug': record.slug,
  'data-search': record.search,
  'data-name': record.name.toLocaleLowerCase(),
  'data-lifecycle': record.lifecycle,
  'data-issuance': record.issuance,
  'data-asset-class': record.assetClass,
  'data-reference': record.referenceCategory,
  'data-backing': record.backingCategory,
  'data-stabilization': record.stabilization,
  'data-launch-date': record.launchDate,
  'data-evidence-count': String(record.sourceIdentityCount)
};
---
<tr data-registry-row {...data}>
  <td>
    <label class="comparison-choice">
      <input type="checkbox" data-compare-select value={record.slug} aria-label={`Compare ${record.name}`} />
      <span aria-hidden="true">Compare</span>
    </label>
    <a class="record-name" href={`/stablecoin/${record.slug}/`}>{record.name}</a>
  </td>
  <td>{record.symbol || '—'}</td>
  <td>
    {record.primaryOrganizationSlug ? <a href={`/issuer/${record.primaryOrganizationSlug}/`}>{record.primaryOrganizationName}</a> : record.primaryOrganizationName}
    {record.relationshipCount > 1 && <small class="relationship-summary">{record.relationshipCount} relationships · {record.organizationCount} organizations</small>}
  </td>
  <td>{record.primaryRoleLabel}</td>
  <td>{record.referenceLabel}</td>
  <td>{record.backingLabel}</td>
  <td><span class={lifecycleChipClass(record.lifecycle)}>{formatLifecycleLabel(record.lifecycle)}</span></td>
  <td>{formatIssuanceLabel(record.issuance)}</td>
  <td>{record.sourceIdentityCount} sources</td>
</tr>

<article class="stablecoin-index-card" data-registry-card {...data}>
  <div class="stablecoin-index-card-heading">
    <div>
      <span class="record-symbol">{record.symbol || 'No symbol'}</span>
      <h2><a href={`/stablecoin/${record.slug}/`}>{record.name}</a></h2>
    </div>
    <span class={lifecycleChipClass(record.lifecycle)}>{formatLifecycleLabel(record.lifecycle)}</span>
  </div>
  <dl class="stablecoin-index-card-grid">
    <div><dt>Issuance</dt><dd>{formatIssuanceLabel(record.issuance)}</dd></div>
    <div><dt>Reference</dt><dd>{record.referenceLabel}</dd></div>
    <div><dt>Backing</dt><dd>{record.backingLabel}</dd></div>
    <div><dt>Asset class</dt><dd>{record.assetClassLabel}</dd></div>
    <div><dt>Organization</dt><dd>{record.primaryOrganizationName}</dd></div>
    <div><dt>Relationships</dt><dd>{record.relationshipCount} across {record.organizationCount}</dd></div>
    <div><dt>Evidence</dt><dd>{record.sourceIdentityCount} sources</dd></div>
    <div><dt>Known unknowns</dt><dd>{record.knownUnknownCount}</dd></div>
  </dl>
  <label class="comparison-choice comparison-choice-card">
    <input type="checkbox" data-compare-select value={record.slug} aria-label={`Compare ${record.name}`} />
    <span>Add to comparison</span>
  </label>
</article>

<article class="comparison-source" data-comparison-source data-record-slug={record.slug} hidden>
  <header><span class="record-symbol">{record.symbol || 'No symbol'}</span><h3><a href={`/stablecoin/${record.slug}/`}>{record.name}</a></h3></header>
  <section><h4>Identity and current state</h4><dl><div><dt>Lifecycle</dt><dd>{formatLifecycleLabel(record.lifecycle)}</dd></div><div><dt>Issuance</dt><dd>{formatIssuanceLabel(record.issuance)}</dd></div><div><dt>Asset class</dt><dd>{record.assetClassLabel}</dd></div><div><dt>Launch</dt><dd>{record.launchDate || 'Not recorded'}</dd></div></dl></section>
  <section><h4>Reference, backing, stabilization</h4><dl><div><dt>Reference</dt><dd>{record.referenceLabel}</dd></div><div><dt>Backing</dt><dd>{record.backingLabel}</dd></div><div><dt>Stabilization</dt><dd>{record.stabilizationLabel}</dd></div></dl></section>
  <section><h4>Reserve and redemption</h4><dl><div><dt>Reserve disclosure</dt><dd>{record.reserveSummary}</dd></div><div><dt>Redemption</dt><dd>{record.redemptionSummary}</dd></div></dl></section>
  <section><h4>Organizations and control</h4><p>{record.organizationSummary}</p></section>
  <section><h4>Deployments</h4><p>{record.deploymentCount} recorded deployment{record.deploymentCount === 1 ? '' : 's'}</p></section>
  <section><h4>Event summary</h4><p>{record.eventCount} linked event{record.eventCount === 1 ? '' : 's'}</p></section>
  <section><h4>Evidence and known unknowns</h4><dl><div><dt>Source identities</dt><dd>{record.sourceIdentityCount}</dd></div><div><dt>Evidence relations</dt><dd>{record.evidenceRelationCount}</dd></div><div><dt>Known unknowns</dt><dd>{record.knownUnknownCount}</dd></div></dl></section>
</article>
