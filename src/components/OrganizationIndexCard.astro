---
import { formatPublicLabel } from '../utils/displayLabels';
const { record, initiallyVisible = true } = Astro.props;
const data = {
  'data-record-slug': record.slug,
  'data-search': record.search,
  'data-name': record.name.toLocaleLowerCase(),
  'data-category': record.category,
  'data-regulatory': record.regulatory,
  'data-jurisdiction': record.jurisdictionScope,
  'data-role': record.roles.join(','),
  'data-relationship-status': record.relationshipStatuses.join(','),
  'data-assets-count': String(record.assetCount),
  'data-relationships-count': String(record.relationshipCount),
  'data-evidence-count': String(record.sourceIdentityCount)
};
const roleLabel = record.roles.length ? record.roles.map((role) => formatPublicLabel(role)).join(', ') : 'Role not recorded';
const relationshipLabel = record.relationshipStatuses.length ? record.relationshipStatuses.map((status) => formatPublicLabel(status)).join(', ') : 'State not recorded';
---
<article class="organization-index-card organization-index-card-r5" data-organization-card data-mobile-representation-for="organization-index" hidden={initiallyVisible ? undefined : true} {...data}>
  <div class="organization-index-card-r5-heading">
    <span class="record-kicker">{record.categoryLabel}</span>
    <span class="organization-asset-count">{record.assetCount} asset{record.assetCount === 1 ? '' : 's'}</span>
  </div>
  <h2><a href={`/issuer/${record.slug}/`}>{record.name}</a></h2>
  <p class="organization-index-card-r5-role">{roleLabel}<span>{record.regulatoryLabel}</span></p>
  <p class="organization-index-card-r5-jurisdiction">{record.jurisdictionLabel}</p>
  <p class="organization-index-card-r5-relationships">{record.relationshipCount} relationship{record.relationshipCount === 1 ? '' : 's'}<span>{relationshipLabel} · {record.sourceIdentityCount} source{record.sourceIdentityCount === 1 ? '' : 's'}</span></p>
</article>
