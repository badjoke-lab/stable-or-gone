---
import { formatPublicLabel } from '../utils/displayLabels';
interface OrganizationCardRecord {
  slug: string;
  search: string;
  name: string;
  category: string;
  regulatory: string;
  jurisdictionScope: string;
  roles: string[];
  relationshipStatuses: string[];
  assetCount: number;
  relationshipCount: number;
  sourceIdentityCount: number;
  categoryLabel: string;
  regulatoryLabel: string;
  jurisdictionLabel: string;
}
const { record, initiallyVisible = true } = Astro.props as { record: OrganizationCardRecord; initiallyVisible?: boolean };
const data = {
  'data-record-slug': record.slug,
  'data-search': record.search,
  'data-name': record.name.toLocaleLowerCase(),
  'data-category': record.category,
  'data-regulatory': record.regulatory,
  'data-jurisdiction': record.jurisdictionScope,
  'data-role': record.roles.join(','),
  'data-relationship-status': record.relationshipStatuses.join(','),
  'data-assets-count': String(record.assetCount),
  'data-relationships-count': String(record.relationshipCount),
  'data-evidence-count': String(record.sourceIdentityCount)
};
const roleLabel = record.roles.length ? record.roles.map((role: string) => formatPublicLabel(role)).join(', ') : 'Role not recorded';
const relationshipLabel = record.relationshipStatuses.length ? record.relationshipStatuses.map((status: string) => formatPublicLabel(status)).join(', ') : 'State not recorded';
---
<article class="organization-index-card organization-index-card-r5" data-organization-card data-mobile-representation-for="organization-index" hidden={initiallyVisible ? undefined : true} {...data}>
  <div class="organization-index-card-r5-heading">
    <span class="record-kicker">{record.categoryLabel}</span>
    <span aria-hidden="true"> · </span>
    <span class="organization-asset-count">{record.assetCount} asset{record.assetCount === 1 ? '' : 's'}</span>
  </div>

  <h2><a href={`/issuer/${record.slug}/`}>{record.name}</a></h2>
  <p class="organization-index-card-r5-role">{roleLabel}</p>
  <p class="organization-index-card-r5-jurisdiction">{record.jurisdictionLabel}</p>

  <details class="organization-index-card-details">
    <summary>More organization context</summary>
    <dl>
      <div><dt>Regulatory context</dt><dd>{record.regulatoryLabel}</dd></div>
      <div><dt>Relationships</dt><dd>{record.relationshipCount}</dd></div>
      <div><dt>Relationship states</dt><dd>{relationshipLabel}</dd></div>
      <div><dt>Evidence</dt><dd>{record.sourceIdentityCount} source{record.sourceIdentityCount === 1 ? '' : 's'}</dd></div>
    </dl>
  </details>
</article>
