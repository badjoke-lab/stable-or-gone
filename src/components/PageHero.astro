---
interface Props {
  title: string;
  titleAccent?: string;
  description?: string;
  eyebrow?: string;
  compact?: boolean;
  className?: string;
}

const { title, titleAccent, description, eyebrow, compact = false, className = '' } = Astro.props;
---
<header class:list={['page-hero', compact && 'page-hero--compact', className]}>
  <div class="page-hero__content">
    {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
    <h1>{title}{titleAccent && <span>{titleAccent}</span>}</h1>
    <slot name="description">
      {description && <p class="page-hero__description">{description}</p>}
    </slot>
    <slot name="actions" />
  </div>
  <div class="page-hero__visual" aria-hidden="true"><slot name="visual" /></div>
</header>
