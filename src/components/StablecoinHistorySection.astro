---
import ValueStateText from './ValueStateText.astro';
import { eventPublicCopy } from '../data/eventPublicCopy';
import { formatPublicLabel } from '../utils/displayLabels';
const { events } = Astro.props;
const orderedEvents = [...events].sort((left: any, right: any) => String(right.event_date ?? '').localeCompare(String(left.event_date ?? '')) || String(right.id).localeCompare(String(left.id)));
const visibleEvents = orderedEvents.slice(0, 5);
const remainingEvents = orderedEvents.slice(5);
const renderEvent = (event: any) => ({
  event,
  title: eventPublicCopy[event.id]?.title ?? event.title,
  description: eventPublicCopy[event.id]?.description ?? event.description
});
---
<details class="stablecoin-dossier-section stablecoin-r4-disclosure stablecoin-history" id="events" open>
  <summary class="stablecoin-r4-section-summary"><span><small>Lifecycle</small><strong>Material events</strong></span><b>{events.length}</b></summary>
  <div class="stablecoin-r4-section-body">
    <p class="stablecoin-r4-section-intro">Current classification remains separate from dated changes and incidents. The five latest records are shown first.</p>
    {visibleEvents.length === 0 ? <p class="stablecoin-empty-state">No material event is currently recorded.</p> : (
      <ol class="stablecoin-r4-event-list">
        {visibleEvents.map((item: any) => {
          const row = renderEvent(item);
          return <li><time datetime={row.event.event_date ?? undefined}><ValueStateText value={row.event.event_date} /></time><div><span>{formatPublicLabel(row.event.event_type ?? row.event.event_detail_kind, 'Event')}</span><h3><a href={`/event/${row.event.id}/`}>{row.title}</a></h3>{row.description && <p>{row.description}</p>}</div></li>;
        })}
      </ol>
    )}
    {remainingEvents.length > 0 && (
      <details class="stablecoin-r4-more-list">
        <summary>Show {remainingEvents.length} earlier event{remainingEvents.length === 1 ? '' : 's'}</summary>
        <ol class="stablecoin-r4-event-list stablecoin-r4-event-list--earlier">
          {remainingEvents.map((item: any) => {
            const row = renderEvent(item);
            return <li><time datetime={row.event.event_date ?? undefined}><ValueStateText value={row.event.event_date} /></time><div><span>{formatPublicLabel(row.event.event_type ?? row.event.event_detail_kind, 'Event')}</span><h3><a href={`/event/${row.event.id}/`}>{row.title}</a></h3></div></li>;
          })}
        </ol>
      </details>
    )}
  </div>
</details>
